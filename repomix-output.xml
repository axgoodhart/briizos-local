        svg {
            width: 98px;
            height: 98px;
        }
    }

}



#customSelectWrapper {

    position: fixed;
    z-index: 10000;
    left: calc( 50vw - 50px );
    top: calc( 50vh - 50px );
    width: 100px;
    height: 100px;
    overflow: visible;
    border-radius: 50%;

    select#customSelect {

        width: 100px;
        height: 100px;
        border-radius: 50%;
        border: none;
        appearance: none;
        text-align: center;
