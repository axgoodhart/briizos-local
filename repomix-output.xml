        function init() {
            // Scene Setup
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x020205); // Deep space dark blue/black
            // Teal fog with FogExp2
            scene.fog = new THREE.FogExp2(0x020205, 0.012);


            // Camera
            camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 10000);
            camera.position.set(0, 3, 5); // Start slightly above ground

            // Renderer with WebGL error handling
            try {
                renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
                renderer.setPixelRatio(window.devicePixelRatio);
                renderer.setSize(window.innerWidth, window.innerHeight);
                renderer.toneMapping = THREE.ACESFilmicToneMapping;
                renderer.toneMappingExposure = 1.5;
                document.getElementById('canvas-container').appendChild(renderer.domElement);
            } catch (e) {
                ErrorLogger.log('WEBGL', 'WebGL initialization failed', { error: e.message });
                showErrorModal(
                    'WEBGL NOT AVAILABLE',
                    'Your browser or device does not support WebGL. Please try a different browser or enable hardware acceleration.',
                    null
                );
                throw e;
            }

            // Lights
            ambientLight = new THREE.AmbientLight(0xffffff, 0.5);
            scene.add(ambientLight);

            // A point light attached to the camera (like a flashlight/miner's helm)
            camLight = new THREE.PointLight(0xccffff, 1, 50);
            camera.add(camLight);
            scene.add(camera);

            // Environment
            createInfiniteGrid();
            starField = createStars();

            // Load saved projects or use initial data
            const savedProjects = Storage.load();
            const projectsToLoad = savedProjects && savedProjects.length > 0 ? savedProjects : initialProjects;
            projectsToLoad.forEach(p => createChrysalis(p));

            // Event Listeners
            window.addEventListener('resize', onWindowResize);
            window.addEventListener('mousemove', onMouseMove);
            window.addEventListener('click', onClick);
            window.addEventListener('dblclick', onDoubleClick);

            // Initialize Navigation Controller
            NavController.init();
            NavController.updateMouseLook(); // Initialize cursor state

            // Load saved flight settings (deferred to ensure all code is parsed)
            setTimeout(loadSavedFlightSettings, 0);
        }

        // --- Environment Generation ---

        function createInfiniteGrid() {
            // We create two large grids that we leapfrog to simulate infinity
            const size = 200;
            const divisions = 100;
            
            // Grid 1
            grid = new THREE.GridHelper(size, divisions, 0x00ffff, 0x112244);
            grid.position.y = -1; // Slightly below y=0 so projects float
            scene.add(grid);

            // Grid 2 (starts ahead)
            grid2 = new THREE.GridHelper(size, divisions, 0x00ffff, 0x112244);
            grid2.position.y = -1;
            grid2.position.z = -size;
            scene.add(grid2);
            
            // Reflective Floor Plane (for that glass effect)
            const planeGeo = new THREE.PlaneGeometry(500, 500);
            const planeMat = new THREE.MeshPhysicalMaterial({
                color: 0x0F0000,
                metalness: 1,
                roughness: 0.1,
                reflectivity: 1,
                clearcoat: 1,
                clearcoatRoughness: 0.1,
            });
            const plane = new THREE.Mesh(planeGeo, planeMat);
            plane.rotation.x = -Math.PI / 2;
            plane.position.y = -1.1; // Just below grid
            scene.add(plane);
        }

        function createStars() {
            const starsGeometry = new THREE.BufferGeometry();
            const starsCount = 320000;
            const posArray = new Float32Array(starsCount * 3);

            for(let i = 0; i < starsCount * 3; i++) {
                posArray[i] = (Math.random() - 0.5) * 1000; // Spread wide
            }

            starsGeometry.setAttribute('position', new THREE.BufferAttribute(posArray, 3));

            const starsMaterial = new THREE.PointsMaterial({
                size: 0.08,
                color: 0xffffff,
                transparent: true,
                opacity: 0.58,
                sizeAttenuation: true
            });

            const stars = new THREE.Points(starsGeometry, starsMaterial);
            scene.add(stars);
            return stars; // Return for theme updates
        }

        // --- Project Entity: The Chrysalis ---

        function createChrysalis(data) {
            const group = new THREE.Group();
            group.position.set(data.pos.x, data.pos.y, data.pos.z);
            
            // Store data in userData for raycasting retrieval (extended model)
            group.userData = {
                isProject: true,
                id: data.id || crypto.randomUUID?.() || Date.now().toString(36),
                name: data.name,
                category: data.category,
                description: data.description || '',
                stats: data.stats,
                date: data.date || "JUST NOW",
                shardsCount: data.shards,
                baseColor: data.color,
                tags: data.tags || [],
                priority: data.priority || 'MEDIUM',
                links: data.links || [],
                notes: data.notes || '',
                createdAt: data.createdAt || Date.now(),
                updatedAt: data.updatedAt || Date.now()
            };

            // 1. Core Crystal (Icosahedron)
            const geometry = new THREE.IcosahedronGeometry(Math.random() * 2 + 10, 1   );
            const material = new THREE.MeshPhysicalMaterial({
                color: data.color,
                metalness: 20,
                roughness: 0,
                transmission: -8, // Glass-like
                thickness: .3, // Volume
                envMapIntensity: 1,
                clearcoat: 2,
                emissive: data.color,
                emissiveIntensity: 0.2
            });
            const crystal = new THREE.Mesh(geometry, material);
            crystal.userData = group.userData; // Propagate data to mesh for click detection
            group.add(crystal);

            // 2. Inner Wireframe (Tech feel)
            const wireGeo = new THREE.WireframeGeometry(geometry);
            const wireMat = new THREE.LineBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.3 });
            const wireframe = new THREE.LineSegments(wireGeo, wireMat);
            group.add(wireframe);

            // 3. Orbiting Shards (Moons)
            const shardCount = data.shards || 3;
            const shardGeo = new THREE.TetrahedronGeometry(0.2);
            
            for (let i = 0; i < shardCount; i++) {
                const shardMat = new THREE.MeshBasicMaterial({ color: data.color });
                const shard = new THREE.Mesh(shardGeo, shardMat);
                
                // Random orbit parameters
                const distance = 2 + Math.random() * 1.5;
                const speed = 0.01 + Math.random() * 0.02;
                const axis = new THREE.Vector3(Math.random(), Math.random(), Math.random()).normalize();
                
                // Attach update function to shard for animation loop
                shard.userData = {
                    orbit: { distance, speed, axis, angle: Math.random() * Math.PI * 2 }
                };
                
                group.add(shard);
                // We'll manually update positions in animate() via the group
                group.userData.shards = group.children.filter(c => c.userData.orbit);
            }

            // 4. Project Label (using cached texture)
            const labelTex = getLabelTexture(data.name);
            const labelMat = new THREE.SpriteMaterial({ map: labelTex, transparent: true, opacity: 0.8 });
            const labelSprite = new THREE.Sprite(labelMat);
            labelSprite.position.y = 2.5;
            labelSprite.scale.set(4, 1, 1);
            group.add(labelSprite);

            scene.add(group);
            AppState.addProject(group);
        }

        // --- Main Loop ---

        function animate() {
            requestAnimationFrame(animate);

            const time = Date.now() * 0.001;

            // 1. Update Navigation Controller (handles all camera movement)
            NavController.update(camera);

            // 1.5. Update Weather System
            if (weatherSystem.enabled) {
                weatherSystem.update();
            }

            // 2. Infinite Grid Logic - leapfrog grids for endless effect
            if (camera.position.z < grid.position.z - 100) {
                grid.position.z -= 400;
            }
            if (camera.position.z < grid2.position.z - 100) {
                grid2.position.z -= 400;
            }
            // Also handle backward movement
            if (camera.position.z > grid.position.z + 100) {
                grid.position.z += 400;
            }
            if (camera.position.z > grid2.position.z + 100) {
                grid2.position.z += 400;
            }

            // 3. Animate Projects
            projects.forEach(group => {
                // Rotate main crystal
                group.children[0].rotation.y += 0.005;
                group.children[0].rotation.z += 0.002;
                group.children[1].rotation.y -= 0.005; // Wireframe counter-rotate

                // Animate Shards
                if (group.userData.shards) {
                    group.userData.shards.forEach(shard => {
                        const orbit = shard.userData.orbit;
                        orbit.angle += orbit.speed;
                        
                        // Calculate new position based on orbit axis
                        // Simple circular orbit logic on XZ plane rotated by axis?
                        // Simplified: Just simple sin/cos on flat plane + axis offset
                        shard.position.x = Math.cos(orbit.angle) * orbit.distance;
                        shard.position.z = Math.sin(orbit.angle) * orbit.distance;
                        shard.position.y = Math.sin(orbit.angle * 2) * 0.5; // Bob up and down
                        
                        shard.rotation.x += 0.02;
                        shard.rotation.y += 0.02;
                    });
                }
                
                // Hover float effect for the whole group
                group.position.y = (group.userData.stats ? group.userData.stats.length : 2) * 0.2 + Math.sin(time + group.position.x) * 0.2;
            });

            // 4. Raycaster for Hover Cursor
            raycaster.setFromCamera(mouse, camera);
            const intersects = raycaster.intersectObjects(scene.children, true);
            
            let foundProject = false;
            if (intersects.length > 0) {
                // Traverse up to find the group or mesh with userData
                let obj = intersects[0].object;
                while(obj.parent && !obj.userData.isProject) {
                    obj = obj.parent;
                }
                
                if (obj.userData.isProject) {
                    foundProject = true;
                    document.body.style.cursor = 'pointer';
                }
            }
            
            if (!foundProject) {
                document.body.style.cursor = 'default';
            }

            // Update UI Coordinates
            const zPos = Math.abs(Math.floor(camera.position.z));
            document.getElementById('coords-display').innerText = `${Math.floor(camera.position.x)}, ${Math.floor(camera.position.y)}, ${zPos}`;

            // Update speed display
            const speed = NavController.getSpeed();
            const speedDisplay = document.getElementById('speed-display');
            speedDisplay.innerText = speed.toFixed(2);

            // Color speed based on velocity
            if (speed > 0.5) {
                speedDisplay.className = 'text-red-400 font-mono text-sm';
            } else if (speed > 0.2) {
                speedDisplay.className = 'text-yellow-400 font-mono text-sm';
            } else if (speed > 0.05) {
                speedDisplay.className = 'text-cyan-400 font-mono text-sm';
            } else {
                speedDisplay.className = 'text-cyan-600 font-mono text-sm';
            }

            renderer.render(scene, camera);
        }

        // --- Interaction Helpers ---

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        function onMouseMove(event) {
            // Normalized device coordinates for raycasting (hover detection)
            mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
            mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;
            // Camera rotation is now controlled by WASD via NavController
        }

        function onClick(event) {
            raycaster.setFromCamera(mouse, camera);
            const intersects = raycaster.intersectObjects(scene.children, true);

            if (intersects.length > 0) {
                let obj = intersects[0].object;
                // Climb hierarchy to find the project root
                while(obj.parent && obj.userData && !obj.userData.isProject) {
                    obj = obj.parent;
                }

                if (obj.userData && obj.userData.isProject) {
                    currentlySelectedProject = obj;
                    openHUD(obj.userData);
                } else {
                    // Clicked space? maybe close HUD
                    // closeHUD();
                }
            }
        }

        // Double-click to navigate to a project
        function onDoubleClick(event) {
            raycaster.setFromCamera(mouse, camera);
            const intersects = raycaster.intersectObjects(scene.children, true);

            if (intersects.length > 0) {
                let obj = intersects[0].object;
                while(obj.parent && obj.userData && !obj.userData.isProject) {
                    obj = obj.parent;
                }

                if (obj.userData && obj.userData.isProject) {
                    // Navigate to the project
                    NavController.navigateTo(obj, () => {
                        currentlySelectedProject = obj;
                        openHUD(obj.userData);
                    });
                }
            }
        }

