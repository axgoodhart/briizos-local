    --palette-text-dim: #655f58;
    --palette-white: #f5f1ea;
    --ui-body-bg: #0b141c;
    --ui-app-bg: #0a1117;
    --ui-app-border: 3px solid #0f1a22;
    --ui-app-shadow: inset 0 0 12px #071018;
    --ui-text-primary: var(--palette-text-main);
    --ui-header-text: var(--palette-white);
    --ui-header-bg: linear-gradient(to bottom, #0a1117 75%, #5f4a44);
