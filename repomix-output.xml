/* =====================
   Briiztorm Overlay Styles
   ===================== */

.briiztorm-overlay {
  position: fixed;
  top: 40px; /* Below header */
  left: 0;
  right: 0;
  bottom: 0;
  background: #0a0a0a;
  z-index: 400;
  display: flex;
  flex-direction: column;
  transform: translateY(-100%);
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

/* State: Opening/Open - slide down */
.briiztorm-overlay.opening,
.briiztorm-overlay.open,
.briiztorm-overlay.sleeping,
.briiztorm-overlay.closing {
  transform: translateY(0);
}

/* State: Closing - slide up after blur */
.briiztorm-overlay.closed {
  transform: translateY(-100%);
}

/* Header Bar */
.briiztorm-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 16px;
  background: linear-gradient(90deg, rgba(0, 50, 70, 0.9) 0%, rgba(0, 30, 50, 0.9) 100%);
  border-bottom: 1px solid rgba(0, 200, 200, 0.3);
  flex-shrink: 0;
}

.briiztorm-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--palette-accent-cyan);
  text-transform: uppercase;
  letter-spacing: 1px;
  text-shadow: 0 0 10px rgba(0, 200, 200, 0.5);
}

.briiztorm-controls {
  display: flex;
  gap: 8px;
}

.briiztorm-btn {
  width: 1  28px;
  height: 28px;
  border-radius: 4px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  background: rgba(0, 0, 0, 0.4);
  color: var(--palette-text-soft);
  font-size: 14px;
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.briiztorm-btn:hover {
  background: rgba(0, 100, 120, 0.5);
  border-color: rgba(0, 200, 200, 0.5);
  color: var(--palette-white);
}

.briiztorm-btn.close:hover {
  background: rgba(150, 30, 30, 0.6);
  border-color: rgba(255, 100, 100, 0.5);
  color: var(--palette-danger);
}

/* Content Container */
.briiztorm-content {
  flex: 1;
  position: relative;
  overflow: hidden;
}

/* The iframe/webview */
.briiztorm-frame {
  width: 100%;
  height: 100%;
  border: none;
  filter: blur(0px) hue-rotate(0deg);
  transition: filter 0.4s ease-out;
}

/* State: Opening - start blurred, clear up */
.briiztorm-overlay.opening .briiztorm-frame {
  filter: blur(20px) hue-rotate(10deg);
  animation: wake-up 0.4s ease-out forwards;
}

@keyframes wake-up {
  from {
    filter: blur(20px) hue-rotate(10deg);
  }
  to {
    filter: blur(0px) hue-rotate(0deg);
  }
}

/* State: Sleeping - blur + animated hue drift */
.briiztorm-overlay.sleeping .briiztorm-frame {
  filter: blur(30px) saturate(1.2);
  animation: hue-drift 3s ease-in-out infinite;
}

@keyframes hue-drift {
  0% {
    filter: blur(30px) hue-rotate(0deg) saturate(1.2);
  }
  50% {
    filter: blur(30px) hue-rotate(45deg) saturate(1.4);
  }
  100% {
    filter: blur(30px) hue-rotate(0deg) saturate(1.2);
  }
}

/* State: Closing - blur out */
.briiztorm-overlay.closing .briiztorm-frame {
  filter: blur(30px) hue-rotate(20deg);
  transition: filter 0.3s ease-out;
}

/* Sleep Indicator Overlay */
.briiztorm-overlay.sleeping::after {
  content: '💤';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 48px;
  opacity: 0.6;
  animation: sleep-bounce 2s ease-in-out infinite;
  pointer-events: none;
}

@keyframes sleep-bounce {
  0%, 100% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 0.4;
  }
  50% {
    transform: translate(-50%, -60%) scale(1.1);
    opacity: 0.7;
  }
}
