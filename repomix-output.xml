    --ui-title-icon-glow: 0 0 8px #4aa3a066;
    --ui-title-gradient: linear-gradient(
        120deg,
        #2c6f73,   /* muted sea */
        #0a1117,   /* ink */
        #6b4f47,   /* riverbank dusk */
        #a77b67,   /* sunset clay */
        #2b5f63,   /* deep teal */
        #0a1117,
        #2c6f73
