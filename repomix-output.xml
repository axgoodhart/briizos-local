.org-qa-select:focus {
  outline: none;
  border-color: rgba(0, 200, 200, 0.5);
}

.org-qa-interval {
  width: 50px;
}

.org-qa-btn {
  padding: 7px 14px;
  background: rgba(0, 150, 180, 0.5);
  border: 1px solid rgba(0, 200, 200, 0.4);
  border-radius: 6px;
  color: var(--palette-accent-cyan);
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s ease;
}

.org-qa-btn:hover {
  background: rgba(0, 180, 200, 0.6);
}

.org-qa-details {
  flex-wrap: wrap;
}

.org-qa-date,
.org-qa-time,
.org-qa-duration {
  padding: 6px 8px;
  background: rgba(20, 40, 60, 0.6);
  border: 1px solid rgba(0, 200, 200, 0.15);
  border-radius: 5px;
  color: var(--palette-text-faint);
  font-size: 11px;
}

.org-qa-date { width: 130px; }
.org-qa-time { width: 100px; }
.org-qa-duration { width: 60px; }

.org-qa-date:focus,
.org-qa-time:focus,
.org-qa-duration:focus {
  outline: none;
  border-color: rgba(0, 200, 200, 0.4);
}

.org-qa-rec-toggle {
  padding: 5px 8px;
  background: rgba(0, 0, 0, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 5px;
  color: var(--palette-text-subtle);
  font-size: 14px;
  cursor: pointer;
  transition: all 0.15s ease;
}

.org-qa-rec-toggle:hover {
  color: var(--palette-text-faint);
}

.org-qa-rec-toggle.active {
  color: var(--palette-accent-cyan);
  border-color: rgba(0, 200, 200, 0.3);
  background: rgba(0, 200, 200, 0.1);
}

/* =====================
   Recurrence Panel
   ===================== */

.org-rec-panel {
  margin-top: 8px;
  padding: 8px;
  background: rgba(0, 0, 0, 0.15);
  border: 1px solid rgba(0, 200, 200, 0.1);
  border-radius: 6px;
}

.org-rec-row {
  display: flex;
  align-items: center;
  gap: 6px;
}

.org-rec-label {
  font-size: 11px;
  color: var(--palette-text-subtle);
}

.org-rec-days {
  display: flex;
  gap: 3px;
  margin-top: 6px;
}

.org-rec-day {
  width: 26px;
  height: 26px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  font-weight: 600;
  color: #777;
  background: rgba(0, 0, 0, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 50%;
  cursor: pointer;
  transition: all 0.15s ease;
}

.org-rec-day:hover {
  border-color: rgba(0, 200, 200, 0.3);
  color: var(--palette-text-faint);
}

.org-rec-day.active {
  color: var(--palette-accent-cyan);
  background: rgba(0, 200, 200, 0.15);
  border-color: rgba(0, 200, 200, 0.4);
}

/* =====================
   Item List
   ===================== */

.org-item-list {
  display: flex;
  flex-direction: column;
}

.org-section {
  margin-bottom: 8px;
}

.org-section-done {
  opacity: 0.7;
}

.org-section-title {
  font-size: 11px;
  font-weight: 600;
  color: var(--palette-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin: 0 0 6px 0;
  padding-bottom: 4px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

/* =====================
   Item Row
   ===================== */

.org-item-row {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 10px;
  background: rgba(30, 50, 70, 0.3);
  border: 1px solid rgba(0, 200, 200, 0.08);
  border-radius: 6px;
  margin-bottom: 4px;
  transition: all 0.15s ease;
}

.org-item-row:hover {
  background: rgba(0, 100, 120, 0.2);
  border-color: rgba(0, 200, 200, 0.2);
}

.org-item-row.done {
  opacity: 0.55;
}

.org-item-check {
  width: 22px;
  height: 22px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: 1.5px solid rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  color: var(--palette-text-subtle);
  font-size: 12px;
  cursor: pointer;
  transition: all 0.15s ease;
}

.org-item-check:hover {
  border-color: var(--palette-accent-cyan);
  color: var(--palette-accent-cyan);
}

.org-item-check.checked {
  border-color: var(--palette-success);
  color: var(--palette-success);
  background: rgba(76, 175, 80, 0.1);
}

.org-item-type {
  font-size: 14px;
  flex-shrink: 0;
  width: 20px;
  text-align: center;
}

.org-item-info {
  flex: 1;
  min-width: 0;
}

.org-item-name {
  font-size: 13px;
  font-weight: 500;
  color: var(--palette-text-main);
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.org-item-name.strike {
  text-decoration: line-through;
}

.org-item-meta {
  display: flex;
  gap: 8px;
  margin-top: 2px;
}

.org-item-date,
.org-item-time {
  font-size: 10px;
  color: var(--palette-text-subtle);
}

.org-item-tag {
  font-size: 9px;
  color: var(--palette-accent-cyan);
  background: rgba(0, 200, 200, 0.1);
  padding: 1px 5px;
  border-radius: 3px;
  text-transform: uppercase;
}

.org-item-rec {
  font-size: 11px;
  color: #a855f7;
}

.org-item-delete {
  background: none;
  border: none;
  color: var(--palette-text-dim);
  font-size: 18px;
  cursor: pointer;
  padding: 0 4px;
  line-height: 1;
  transition: color 0.15s ease;
  flex-shrink: 0;
  opacity: 0;
  transition: opacity 0.15s ease, color 0.15s ease;
}

.org-item-row:hover .org-item-delete {
  opacity: 1;
}

.org-item-delete:hover {
  color: var(--palette-danger);
}

/* =====================
   Loading & Empty States
   ===================== */

.loading-state,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px;
  color: var(--palette-text-muted);
  font-size: 14px;
  text-align: center;
  gap: 16px;
}

/* =====================
   Footer
   ===================== */

.organizer-footer {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  padding: 12px 20px;
  border-top: 1px solid rgba(0, 200, 200, 0.1);
}

.organizer-btn {
  padding: 8px 16px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
}

.organizer-btn.secondary {
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: var(--palette-text-subtle);
}

.organizer-btn.secondary:hover {
  background: rgba(255, 255, 255, 0.05);
  color: var(--palette-text-soft);
}

.projects-count {
  font-size: 12px;
  color: var(--palette-text-muted);
  margin-right: auto;
  display: flex;
  align-items: center;
}
</file>

<file path="src/styles/original-component-css/LoginOverlay.css">
/**
 * LoginOverlay Styles - Matching briizOS-Dev aesthetic
 */

/* Login Overlay Container */
.login-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: linear-gradient(135deg, rgba(106, 58, 90, 0.95), rgba(26, 10, 74, 0.95));
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100000;
  transition: opacity 1s ease;
  transition-delay: 0.8s;
}

.login-overlay.hide {
  opacity: 0;
  pointer-events: none;
}

/* Login Container */
.login-container {
  border-radius: 2rem;
  padding: 3rem;
  backdrop-filter: blur(10px);
  text-align: center;
  min-width: 400px;
  max-width: 500px;
}

/* Logo Styles */
.login-logo-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 2rem;
}

.login-logo-circle {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: linear-gradient(135deg, #00ffcc, #ff4da6, var(--palette-accent-cyan));
  background-size: 200% 200%;
  animation: logoGradient 5s ease infinite;
  box-shadow: 0 0 40px rgba(0, 255, 204, 0.4), 0 0 80px rgba(255, 77, 166, 0.2);
  margin-bottom: 1rem;
}

@keyframes logoGradient {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.login-logo-text {
  font-family: Chillax, 'Josefin Sans', sans-serif;
  font-size: 3rem;
  font-weight: 600;
  background: linear-gradient(90deg, #00ffcc, #ff4da6);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-shadow: 0 0 30px rgba(0, 255, 204, 0.3);
}

/* Subtitle */
.login-subtitle {
  font-family: Chillax, 'Josefin Sans', 'Jost', sans-serif;
  color: rgba(255, 255, 255, 0.8);
  font-size: 1.1rem;
  letter-spacing: 0.1em;
  margin-bottom: 2rem;
}

.login-subtitle span {
  color: #00ffcc;
  font-weight: 600;
}

/* Form */
.login-form {
  display: flex;
  flex-direction: column;
  width: 100%;
}

/* Input Fields */
.login-input {
  width: 100%;
  padding: 1rem 1.5rem;
  margin: 0.5rem 0;
  background: rgba(0, 0, 0, 0.3);
  border: 1.5px solid #00ffcc;
  border-radius: 1rem;
  color: var(--palette-white);
  font-family: Chillax, 'Josefin Sans', 'Jost', sans-serif;
  font-size: 1.1rem;
  outline: none;
  box-shadow: 0 0 10px rgba(0, 255, 204, 0.2);
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.login-input::placeholder {
  color: rgba(255, 255, 255, 0.4);
}

.login-input:focus {
  border-color: #ff4da6;
  box-shadow: 0 0 20px rgba(255, 77, 166, 0.4);
}

.login-input:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* Error Message */
.login-error {
  color: var(--palette-danger);
  font-size: 0.9rem;
  margin: 0.5rem 0;
  padding: 0.5rem;
  background: rgba(255, 107, 107, 0.1);
  border-radius: 0.5rem;
  border: 1px solid rgba(255, 107, 107, 0.3);
}

/* Submit Button */
.login-btn {
  width: 100%;
  padding: 1rem;
  background: linear-gradient(45deg, #00ffcc, #ff4da6);
  border: none;
  border-radius: 1rem;
  color: #000;
  font-family: Chillax, 'Josefin Sans', sans-serif;
  font-weight: bold;
  font-size: 1.2rem;
  cursor: pointer;
  margin-top: 1rem;
  transition: all 0.3s ease;
  letter-spacing: 0.1em;
  box-sizing: border-box;
}

.login-btn:hover:not(:disabled) {
  transform: scale(1.02);
  box-shadow: 0 0 30px rgba(0, 255, 204, 0.6);
}

.login-btn:disabled {
  opacity: 0.7;
  cursor: not-allowed;
  transform: none;
}

/* Toggle Link */
.login-toggle {
  margin-top: 1rem;
}

.login-toggle-link {
  color: rgba(255, 255, 255, 0.6);
  font-size: 0.9rem;
  cursor: pointer;
  transition: color 0.2s ease;
}

.login-toggle-link:hover {
  color: #00ffcc;
  text-decoration: underline;
}

/* Info Footer */
.login-info {
  font-family: Chillax, 'Josefin Sans', 'Jost', sans-serif;
  color: rgba(255, 255, 255, 0.5);
  font-size: 0.85rem;
  margin-top: 2rem;
  line-height: 1.6;
}

.login-footer-author {
  color: #00ffcc;
  opacity: 0.7;
}

/* Loading State */
.login-loading {
  color: rgba(255, 255, 255, 0.8);
  font-size: 1.2rem;
  font-family: Chillax, 'Josefin Sans', sans-serif;
}

/* Responsive */
@media (max-width: 600px) {
  .login-container {
    min-width: 320px;
    padding: 2rem;
  }

  .login-logo-text {
    font-size: 2.5rem;
  }

  .login-input {
    padding: 0.8rem 1rem;
    font-size: 1rem;
  }

  .login-btn {
    padding: 0.8rem;
    font-size: 1rem;
  }
}
</file>

<file path="src/styles/original-component-css/PhantomSection.css">
/* ── PhantomSection ────────────────────────────────────────────────
   Phantom control drawer embedded at the bottom of TasksPanel.
   Aesthetic mirrors the Phantom macOS app: dark/black background,
   monospace font, green (var(--palette-neon-green)) record accent, cyan (#00e5ff)
   for running/playback states.
   ─────────────────────────────────────────────────────────────── */

/* ── Container ───────────────────────────────────────────────────── */

.phantom-section {
  flex-shrink: 0;
}

/* ── Toggle button (replaces old Record button) ───────────────────── */

.phantom-toggle {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px;
  background: #0a0a0a;
  border: none;
  border-top: 1px solid #1a1a1a;
  color: var(--palette-text-dim);
  font-family: 'Menlo', 'SF Mono', 'Courier New', monospace;
  font-size: 11px;
  cursor: pointer;
  text-align: left;
  transition: color 0.15s, border-top-color 0.15s;
}

.phantom-toggle:hover {
  color: var(--palette-text-soft);
}

.phantom-toggle.open {
  color: var(--palette-neon-green);
  border-top-color: rgba(0, 255, 136, 0.4);
}

.phantom-toggle-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #2a2a2a;
  flex-shrink: 0;
  transition: background 0.2s, box-shadow 0.2s;
}

.phantom-toggle.open .phantom-toggle-dot {
  background: var(--palette-neon-green);
}

.phantom-toggle.running .phantom-toggle-dot {
  background: var(--palette-neon-green);
  box-shadow: 0 0 6px var(--palette-neon-green);
  animation: ph-pulse 1s infinite;
}

.phantom-toggle-label {
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.phantom-toggle-status {
  margin-left: auto;
  font-size: 10px;
  color: var(--palette-neon-green);
  max-width: 160px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── Drawer ───────────────────────────────────────────────────────── */

.phantom-drawer {
  background: #000;
  border-top: 1px solid #1a1a1a;
  font-family: 'Menlo', 'SF Mono', 'Courier New', monospace;
  font-size: 12px;
  color: var(--palette-text-main);
  display: flex;
  flex-direction: column;
  max-height: 380px;
  overflow: hidden;
}

/* ── Mode tabs ────────────────────────────────────────────────────── */

.phantom-tabs {
  display: flex;
  border-bottom: 1px solid #1a1a1a;
  background: #050505;
  flex-shrink: 0;
}

.phantom-tab {
  flex: 1;
  padding: 8px 0;
  background: none;
  border: none;
  border-bottom: 2px solid transparent;
  color: #444;
  font-family: inherit;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  cursor: pointer;
  transition: color 0.15s, border-color 0.15s;
}

.phantom-tab:hover {
  color: var(--palette-text-subtle);
}

.phantom-tab.active {
  color: var(--palette-neon-green);
  border-bottom-color: var(--palette-neon-green);
}

/* ── Status bar ────────────────────────────────────────────────────── */

.phantom-status {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 5px 12px;
  font-size: 10px;
  background: rgba(0, 255, 136, 0.03);
  border-bottom: 1px solid #111;
  flex-shrink: 0;
}

.phantom-status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  flex-shrink: 0;
  background: #333;
}

.phantom-status.running .phantom-status-dot {
  background: var(--palette-neon-green);
  box-shadow: 0 0 5px var(--palette-neon-green);
  animation: ph-pulse 1s infinite;
}

.phantom-status.waiting .phantom-status-dot {
  background: #facc15;
}

.phantom-status.completed .phantom-status-dot {
  background: #00e5ff;
}

.phantom-status.error .phantom-status-dot {
  background: #f87171;
}

.phantom-status.stopped .phantom-status-dot {
  background: #444;
}

.phantom-status-text {
  flex: 1;
  color: #777;
}

.phantom-status.running .phantom-status-text {
  color: var(--palette-neon-green);
}

.phantom-status.completed .phantom-status-text {
  color: #00e5ff;
}

.phantom-status.error .phantom-status-text {
  color: #f87171;
}

.phantom-progress {
  width: 52px;
  height: 2px;
  background: #1a1a1a;
  border-radius: 1px;
  overflow: hidden;
  flex-shrink: 0;
}

.phantom-progress-fill {
  height: 100%;
  background: var(--palette-neon-green);
  border-radius: 1px;
  transition: width 0.4s ease;
}

.phantom-elapsed {
  font-size: 10px;
  color: #333;
  flex-shrink: 0;
}

@keyframes ph-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

/* ── Workflow list ────────────────────────────────────────────────── */

.phantom-playback {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  min-height: 0;
}

.phantom-wf-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 12px 4px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #333;
  flex-shrink: 0;
}

.phantom-refresh {
  background: none;
  border: none;
  color: #333;
  font-size: 14px;
  cursor: pointer;
  padding: 0 2px;
  line-height: 1;
  transition: color 0.12s;
}

.phantom-refresh:hover {
  color: var(--palette-neon-green);
}

.phantom-refresh:disabled {
  opacity: 0.3;
  cursor: default;
}

.phantom-wf-list {
  flex: 1;
  overflow-y: auto;
  padding-bottom: 4px;
  min-height: 0;
}

.phantom-empty {
  padding: 14px 12px;
  font-size: 10px;
  color: #2a2a2a;
  text-align: center;
}

.phantom-wf-row {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 6px 12px;
  cursor: pointer;
  transition: background 0.1s;
}

.phantom-wf-row:hover {
  background: rgba(255, 255, 255, 0.025);
}

.phantom-wf-row.selected {
  background: rgba(0, 255, 136, 0.05);
}

.phantom-wf-info {
  flex: 1;
  min-width: 0;
}

.phantom-wf-name {
  display: block;
  font-size: 12px;
  color: #bbb;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.phantom-wf-meta {
  display: block;
  font-size: 10px;
  color: #333;
}

.phantom-wf-row.selected .phantom-wf-name {
  color: var(--palette-neon-green);
}

.phantom-wf-row.selected .phantom-wf-meta {
  color: rgba(0, 255, 136, 0.4);
}

/* Row action buttons */

.phantom-wf-inspect,
.phantom-wf-run,
.phantom-wf-del {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 10px;
  padding: 3px 5px;
  border-radius: 3px;
  transition: color 0.1s, background 0.1s;
  flex-shrink: 0;
  line-height: 1;
  font-family: inherit;
}

.phantom-wf-inspect {
  color: #333;
  border: 1px solid transparent;
}

.phantom-wf-inspect:hover {
  color: var(--palette-text-muted);
  background: rgba(255, 255, 255, 0.04);
}

.phantom-wf-run {
  color: #1a4a2e;
  border: 1px solid #132a1e;
}

.phantom-wf-run:hover {
  color: var(--palette-neon-green);
  border-color: rgba(0, 255, 136, 0.4);
  background: rgba(0, 255, 136, 0.06);
}

.phantom-wf-run:disabled {
  opacity: 0.2;
  cursor: default;
}

.phantom-wf-del {
  color: #2a1010;
  border: 1px solid transparent;
}

.phantom-wf-del:hover {
  color: #f87171;
  background: rgba(248, 113, 113, 0.06);
}

.phantom-wf-del:disabled {
  opacity: 0.2;
  cursor: default;
}

/* ── Event inspector ──────────────────────────────────────────────── */

.phantom-events {
  border-top: 1px solid #0f0f0f;
  border-bottom: 1px solid #0f0f0f;
  background: #020202;
  max-height: 130px;
  overflow-y: auto;
  padding: 3px 0;
}

.phantom-event-row {
  padding: 1px 20px;
  font-size: 10px;
  color: #3a3a3a;
  font-family: inherit;
  line-height: 1.7;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.phantom-event-row:hover {
  color: var(--palette-text-muted);
  background: rgba(255, 255, 255, 0.015);
}

/* ── Run options ──────────────────────────────────────────────────── */

.phantom-run-opts {
  display: flex;
  gap: 14px;
  padding: 7px 12px;
  border-top: 1px solid #0f0f0f;
  flex-shrink: 0;
}

.phantom-run-opts label {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 10px;
  color: #333;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.phantom-run-opts input {
  width: 42px;
  background: #0f0f0f;
  border: 1px solid #1e1e1e;
  border-radius: 3px;
  color: var(--palette-text-subtle);
  font-family: inherit;
  font-size: 11px;
  padding: 3px 5px;
  text-align: center;
  outline: none;
}

.phantom-run-opts input:focus {
  border-color: rgba(0, 255, 136, 0.3);
  color: var(--palette-text-faint);
}

/* ── Action buttons ───────────────────────────────────────────────── */

.phantom-actions {
  display: flex;
  gap: 6px;
  padding: 7px 12px;
  flex-shrink: 0;
}

.phantom-btn {
  border-radius: 4px;
  font-family: inherit;
  font-size: 11px;
  font-weight: 600;
  padding: 5px 12px;
  cursor: pointer;
  border: 1px solid transparent;
  transition: opacity 0.12s, background 0.12s;
  letter-spacing: 0.05em;
}

.phantom-btn:disabled {
  opacity: 0.2;
  cursor: default;
}

.phantom-btn.primary {
  flex: 1;
  background: rgba(0, 255, 136, 0.06);
  border-color: rgba(0, 255, 136, 0.2);
  color: var(--palette-neon-green);
}

.phantom-btn.primary:not(:disabled):hover {
  background: rgba(0, 255, 136, 0.12);
}

.phantom-btn.danger {
  background: rgba(248, 113, 113, 0.06);
  border-color: rgba(248, 113, 113, 0.2);
  color: #f87171;
}

.phantom-btn.danger:not(:disabled):hover {
  background: rgba(248, 113, 113, 0.12);
}

/* ── Record tab ───────────────────────────────────────────────────── */

.phantom-record {
  padding: 20px 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.phantom-record-desc {
  font-size: 10px;
  color: #333;
  text-align: center;
  line-height: 1.7;
  max-width: 240px;
}

.phantom-btn.record-launch {
  background: rgba(0, 255, 136, 0.06);
  border-color: rgba(0, 255, 136, 0.25);
  color: var(--palette-neon-green);
  padding: 9px 22px;
  font-size: 12px;
}

.phantom-btn.record-launch:hover {
  background: rgba(0, 255, 136, 0.14);
}

.phantom-record-hint {
  font-size: 10px;
  color: #222;
}

/* ── Error banner ─────────────────────────────────────────────────── */

.phantom-error {
  margin: 0 12px 8px;
  padding: 6px 10px;
  background: rgba(248, 113, 113, 0.06);
  border: 1px solid rgba(248, 113, 113, 0.2);
  border-radius: 4px;
  font-size: 10px;
  color: #f87171;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
  flex-shrink: 0;
}

.phantom-error button {
  background: none;
  border: none;
  color: #f87171;
  cursor: pointer;
  font-size: 13px;
  flex-shrink: 0;
  padding: 0;
  line-height: 1;
}
</file>

