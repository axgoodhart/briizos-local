:root[data-theme='verdigris'] {
    --chat-input-text-color: gold;
    --palette-accent-primary: #3a9f9a;                 /* muted verdigris (patina) */
    --palette-accent-primary-soft: #2f8e89;
    --palette-neon-accent: #4fbf91;                  /* oxidized-copper green */
    --palette-success: #5a9b63;                     /* subdued, matte */
    --palette-warning: #c9a24a;                     /* antique gold */
    --palette-danger: #b45a4f;                      /* oxidized red-brown */
    --palette-text-main: #e6dccf;                   /* warm parchment */
    --palette-text-faint: #d2c6b7;
    --palette-text-soft: #b9ac9d;
    --palette-text-subtle: #9a8d7f;
    --palette-text-muted: #7c7166;
    --palette-text-dim: #60584f;
    --palette-white: #f3eadf;
    --ui-body-bg: white;                          /* matte soot-brown */
    --ui-app-bg: #0b0705;
    --ui-app-border: 3px solid rgba(92, 63, 36, 0.65); /* tarnished bronze edge */
    --ui-app-shadow: inset 0 0 12px rgba(41, 26, 14, 0.85);
    --ui-text-primary: var(--palette-text-main);
    --ui-header-text: var(--palette-white);
    --ui-header-bg: linear-gradient(to bottom, #0b0705 75%, rgba(153, 102, 51, 0.55)); /* burnished bronze falloff */
    --ui-title-icon: #b07a44;                       /* bronze highlight */
    --ui-title-icon-glow: 0 0 8px rgba(176, 122, 68, 0.25); /* matte "glow" */
    --ui-title-gradient: linear-gradient(
        120deg,
        #6d4b2c,   /* engraved bronze */
        #0b0705,   /* soot */
        #8a5a2f,   /* burnished copper */
        rgba(33, 54, 49, 0.65), /* tarnish/patina */
        #a66d3c,   /* warm brass */
        #0b0705,
        #5c3f24
    );
    --ui-title-stroke: 0.1px rgba(243, 234, 223, 0.65);
    --ui-button-ghost-bg: transparent;
    --ui-button-ghost-border: rgba(230, 220, 207, 0.10);
    --ui-button-ghost-border-strong: rgba(230, 220, 207, 0.14);
    --ui-button-ghost-text: var(--palette-text-subtle);
    --ui-button-ghost-text-hover: var(--palette-text-soft);
