function animateTitle() {

  let lineACLength60 = lineACLength * 0.6;
  const tl = gsap.timeline().
  set(["#masterTextPath"], { attr: { fill: "#FFFFFF" } }).
  set(["#masterTextPath2"], { attr: { "stroke-opacity": 0 } }).
  set(["#masterTextPath", "#masterTextPath2"], { textContent: optionValueText.toUpperCase(), attr: { "letter-spacing": 50 } }).
  from(["#masterTextPath", "#masterTextPath2"], 1.5, { attr: { startOffset: lineACLength60 }, ease: "power1" }) /* 60% */.
  to("#masterTextPath", 1.5, { attr: { fill: "#000000" }, ease: "power1" }, "<").
  to("#masterTextPath2", 1.5, { attr: { "stroke-opacity": 0.5 }, ease: "power1" }, "<").
  to(["#masterTextPath", "#masterTextPath2"], 1.5, { attr: { "letter-spacing": 1 }, ease: "back.in(4)" }, "<");

