/**
 * Firebase Configuration for briizOS.2
 * Shares the same Firebase project as briizOS-Dev for data sync
 * Uses email/password authentication (matching briizOS-Dev)
 */
import logger from './logger';
import { initializeApp, getApps, getApp } from 'firebase/app';
import {
  getAuth,
  onAuthStateChanged,
  setPersistence,
  browserLocalPersistence,
  inMemoryPersistence
} from 'firebase/auth';
import { initializeFirestore, getFirestore, persistentLocalCache, persistentMultipleTabManager } from 'firebase/firestore';

const firebaseConfig = {
  apiKey: import.meta.env.VITE_FIREBASE_API_KEY,
  authDomain: import.meta.env.VITE_FIREBASE_AUTH_DOMAIN,
  projectId: import.meta.env.VITE_FIREBASE_PROJECT_ID,
  storageBucket: import.meta.env.VITE_FIREBASE_STORAGE_BUCKET,
  messagingSenderId: import.meta.env.VITE_FIREBASE_MESSAGING_SENDER_ID,
  appId: import.meta.env.VITE_FIREBASE_APP_ID,
};

// Validate Firebase configuration
const requiredConfigKeys = ['apiKey', 'authDomain', 'projectId', 'appId'];
const missingKeys = requiredConfigKeys.filter(key => !firebaseConfig[key]);
if (missingKeys.length > 0) {
  logger.error('auth', 'Firebase config missing required keys', missingKeys);
  logger.error('auth', 'Current config', firebaseConfig);
}

// Initialize Firebase (singleton pattern)
const app = getApps().length ? getApp() : initializeApp(firebaseConfig);
const auth = getAuth(app);

const authPersistenceReady = setPersistence(auth, browserLocalPersistence).catch(async (error) => {
  logger.warn('auth', 'Failed to set browserLocalPersistence, falling back to inMemoryPersistence', error?.code || error?.message);
  try {
    await setPersistence(auth, inMemoryPersistence);
    logger.warn('auth', 'Using inMemoryPersistence fallback');
  } catch (fallbackError) {
    logger.error('auth', 'Failed to set auth persistence fallback', fallbackError?.code || fallbackError?.message);
  }
});

// Initialize Firestore with persistent cache (modern API for Firebase v10+)
let db;
try {
  db = initializeFirestore(app, {
    localCache: persistentLocalCache({
      tabManager: persistentMultipleTabManager()
    })
  });
} catch (e) {
  // Firestore already initialized (happens in dev with HMR)
  db = getFirestore(app);
  logger.info('auth', 'Using existing Firestore instance');
}

// Auth state tracking
let currentUser = null;
let authReady = false;
let authReadyCallbacks = [];

onAuthStateChanged(auth, (user) => {
  currentUser = user;
  authReady = true;
  authReadyCallbacks.forEach(cb => cb(user));
  authReadyCallbacks = [];
});

/**
 * Wait for auth to be ready
 */
export function waitForAuth() {
  return new Promise((resolve) => {
    if (authReady) {
      resolve(currentUser);
    } else {
      authReadyCallbacks.push(resolve);
    }
  });
}

/**
 * Wait until persistence setup completes
 */
export async function waitForAuthPersistence() {
  await authPersistenceReady;
}

/**
 * Get current user (requires email/password login)
 * Returns null if not authenticated - user must log in
 */
export async function ensureAuth() {
  logger.debug('auth', 'ensureAuth called, waiting for auth state...');
  await waitForAuth();
  logger.debug('auth', 'Auth state ready', currentUser?.uid || 'null');

  // No longer auto-sign-in anonymously - user must authenticate
  return currentUser;
}

/**
 * Get current user UID (null if not authenticated)
 */
export function getCurrentUid() {
  return currentUser?.uid || null;
}

/**
 * Get current user email (null if not authenticated)
 */
export function getCurrentUserEmail() {
  return currentUser?.email || null;
}

/**
 * Check if user is authenticated
 */
export function isAuthenticated() {
  return !!currentUser;
}

export { app, auth, db };
</file>

<file path="src/lib/floatingPanelPrefs.js">
export const PANEL_FILTER_LIMITS = Object.freeze({
  hueRotate: { min: 0, max: 360 },
  saturation: { min: 0, max: 200 },
  sepia: { min: 0, max: 100 },
  contrast: { min: 50, max: 200 },
});

export const PANEL_START_AS_OPTIONS = Object.freeze({
  TILE: 'layout-tile',
  FLOATING: 'floating-panel',
  LAST_USE: 'last-use',
});

export const PANEL_VIEW_OPTIONS = Object.freeze({
  TILE: 'layout-tile',
  FLOATING: 'floating-panel',
});

export const DEFAULT_PANEL_FILTERS = Object.freeze({
  hueRotate: 0,
  saturation: 100,
  sepia: 0,
  contrast: 100,
});

export const DEFAULT_ACTIONDECK_PANEL_SETTINGS = Object.freeze({
  filters: DEFAULT_PANEL_FILTERS,
  startAs: PANEL_START_AS_OPTIONS.TILE,
  lastUsedView: PANEL_VIEW_OPTIONS.TILE,
  pinToCurrentLocation: false,
  pinnedPosition: null,
  headerBg: '',
});

export const DEFAULT_CANVAS_PANEL_SETTINGS = Object.freeze({
  filters: DEFAULT_PANEL_FILTERS,
  startAs: PANEL_START_AS_OPTIONS.LAST_USE,
  lastUsedView: PANEL_VIEW_OPTIONS.FLOATING,
  pinToCurrentLocation: false,
  pinnedPosition: null,
  headerBg: '',
});

function clampNumber(value, min, max, fallback) {
  const numeric = Number(value);
  if (!Number.isFinite(numeric)) return fallback;
  return Math.min(Math.max(Math.round(numeric), min), max);
}

function normalizePosition(position) {
  if (!position || typeof position !== 'object') return null;
  const x = Number(position.x);
  const y = Number(position.y);
  if (!Number.isFinite(x) || !Number.isFinite(y)) return null;
  return { x: Math.round(x), y: Math.round(y) };
}

function normalizeFilters(filters = {}, fallback = DEFAULT_PANEL_FILTERS) {
  return {
    hueRotate: clampNumber(
      filters.hueRotate,
      PANEL_FILTER_LIMITS.hueRotate.min,
      PANEL_FILTER_LIMITS.hueRotate.max,
      fallback.hueRotate
    ),
    saturation: clampNumber(
      filters.saturation,
      PANEL_FILTER_LIMITS.saturation.min,
      PANEL_FILTER_LIMITS.saturation.max,
      fallback.saturation
    ),
    sepia: clampNumber(
      filters.sepia,
      PANEL_FILTER_LIMITS.sepia.min,
      PANEL_FILTER_LIMITS.sepia.max,
      fallback.sepia
    ),
    contrast: clampNumber(
      filters.contrast,
      PANEL_FILTER_LIMITS.contrast.min,
      PANEL_FILTER_LIMITS.contrast.max,
      fallback.contrast
    ),
  };
}

export function normalizePanelSettings(raw = {}, fallback = DEFAULT_ACTIONDECK_PANEL_SETTINGS) {
  const startAsValues = Object.values(PANEL_START_AS_OPTIONS);
  const viewValues = Object.values(PANEL_VIEW_OPTIONS);

  return {
    filters: normalizeFilters(raw.filters, fallback.filters || DEFAULT_PANEL_FILTERS),
    startAs: startAsValues.includes(raw.startAs) ? raw.startAs : fallback.startAs,
    lastUsedView: viewValues.includes(raw.lastUsedView) ? raw.lastUsedView : fallback.lastUsedView,
    pinToCurrentLocation: Boolean(raw.pinToCurrentLocation),
    pinnedPosition: normalizePosition(raw.pinnedPosition),
    headerBg: typeof raw.headerBg === 'string' ? raw.headerBg : fallback.headerBg,
  };
}

export function buildPanelFilter(filters = DEFAULT_PANEL_FILTERS) {
  const normalized = normalizeFilters(filters, DEFAULT_PANEL_FILTERS);
  return [
    `hue-rotate(${normalized.hueRotate}deg)`,
    `saturate(${normalized.saturation}%)`,
    `sepia(${normalized.sepia}%)`,
    `contrast(${normalized.contrast}%)`,
  ].join(' ');
}

export function resolvePanelStartView(settings, fallback = PANEL_VIEW_OPTIONS.TILE) {
  const normalized = normalizePanelSettings(settings, {
    ...DEFAULT_ACTIONDECK_PANEL_SETTINGS,
    lastUsedView: fallback,
  });

  if (normalized.startAs === PANEL_START_AS_OPTIONS.LAST_USE) {
    return normalized.lastUsedView || fallback;
  }
  if (normalized.startAs === PANEL_START_AS_OPTIONS.FLOATING) {
    return PANEL_VIEW_OPTIONS.FLOATING;
  }
  return PANEL_VIEW_OPTIONS.TILE;
}

export function loadPanelSettings(storageKey, fallback = DEFAULT_ACTIONDECK_PANEL_SETTINGS) {
  if (typeof window === 'undefined') {
    return normalizePanelSettings({}, fallback);
  }

  try {
    const raw = window.localStorage.getItem(storageKey);
    if (!raw) return normalizePanelSettings({}, fallback);
    return normalizePanelSettings(JSON.parse(raw), fallback);
  } catch {
    return normalizePanelSettings({}, fallback);
  }
}

export function savePanelSettings(storageKey, settings, fallback = DEFAULT_ACTIONDECK_PANEL_SETTINGS) {
  if (typeof window === 'undefined') return;

  try {
    const normalized = normalizePanelSettings(settings, fallback);
    window.localStorage.setItem(storageKey, JSON.stringify(normalized));
  } catch {
    // ignore storage write failures
  }
}
</file>

<file path="src/lib/floatingShell.js">
function smoothstep(t) {
  const c = Math.max(0, Math.min(1, t));
  return c * c * (3 - 2 * c);
}

function smoothWindow(t, center = 0.5, width = 0.25) {
  return smoothstep((t - (center - width)) / (2 * width));
}

function lerp(a, b, t) {
  return a + (b - a) * t;
}

function clamp01(v) {
  return Math.max(0, Math.min(1, v));
}

export function computeFloatingShellChrome(shellRect) {
  if (typeof window === 'undefined') {
    return {
      rotateY: 0,
      rotateX: 0,
      boxShadow: 'inset 0 0 20px rgba(0, 0, 0, 0.35)',
      borderRadius: '28px',
      borderTop: '1px solid rgba(155, 220, 200, 0.24)',
      borderBottom: '1px solid rgba(155, 220, 200, 0.24)',
      borderLeft: '1px solid rgba(155, 220, 200, 0.24)',
      borderRight: '1px solid rgba(155, 220, 200, 0.24)',
      closedRotateY: 0,
      closedTranslateX: 0,
    };
  }

  const vw = window.innerWidth;
  const vh = window.innerHeight;

  const cx = (shellRect.x + shellRect.width / 2) / vw;
  const cy = (shellRect.y + shellRect.height / 2) / vh;

  const rotateY = -30 * (cx * 2 - 1);
  const rotateX = 10 * (cy * 2 - 1);

  const shadowX = Math.round(12 * (cx * 2 - 1));
  const shadowY = Math.round(8 * (cy * 2 - 1));
  const boxShadow = `inset ${shadowX}px ${shadowY}px 20px rgba(0,0,0,0.6)`;

  const leftBias = 1 - cx;
  const rightBias = cx;
  const topBias = 1 - cy;
  const bottomBias = cy;

  const tx = smoothWindow(cx, 0.5, 0.25);
  const ty = smoothWindow(cy, 0.5, 0.25);

  const tlMix = clamp01(tx * leftBias + ty * topBias);
  const trMix = clamp01(tx * rightBias + ty * topBias);
  const brMix = clamp01(tx * rightBias + ty * bottomBias);
  const blMix = clamp01(tx * leftBias + ty * bottomBias);

  const outerR = 80;
  const innerR = 24;
  const borderRadius = [
    lerp(innerR, outerR, tlMix),
    lerp(innerR, outerR, trMix),
    lerp(innerR, outerR, brMix),
    lerp(innerR, outerR, blMix),
  ].map((r) => `${Math.round(r)}px`).join(' ');

  const brightA = 0.45;
  const dimA = 0.12;
  const borderAlphaTop = lerp(dimA, brightA, clamp01(topBias * ty));
  const borderAlphaBottom = lerp(dimA, brightA, clamp01(bottomBias * ty));
  const borderAlphaLeft = lerp(dimA, brightA, clamp01(leftBias * tx));
  const borderAlphaRight = lerp(dimA, brightA, clamp01(rightBias * tx));

  const borderTop = `2px solid rgba(155,220,200,${borderAlphaTop.toFixed(3)})`;
  const borderBottom = `5px solid rgba(155,220,200,${borderAlphaBottom.toFixed(3)})`;
  const borderLeft = `2px solid rgba(155,220,200,${borderAlphaLeft.toFixed(3)})`;
  const borderRight = `2px solid rgba(155,220,200,${borderAlphaRight.toFixed(3)})`;

  const closedRotateY = cx > 0.5 ? 90 : -90;
  const closedTranslateX = cx > 0.5 ? 20 : -20;

  return {
    rotateY,
    rotateX,
    boxShadow,
    borderRadius,
    borderTop,
    borderBottom,
    borderLeft,
    borderRight,
    closedRotateY,
    closedTranslateX,
  };
}
