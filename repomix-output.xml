                       placeholder="https://example.com/your-app" value="${url}">
                <button onclick="externalManager.loadExternalApp('${panel.id}')" 
                        style="margin-top: 8px; padding: 6px 12px; background: #00ffcc; color: #000; border: none; border-radius: 4px; cursor: pointer;">
                  Load App
                </button>
              </div>
              <div class="external-loading">
                <div>Enter URL above to load external application</div>
              </div>
            `;
          }
          return `
            <div class="external-url-config" style="display:${showCfg ? 'block' : 'none'}">
              <label style="color: #00ffcc; font-size: 0.9rem; margin-bottom: 5px; display: block;">External App URL:</label>
              <input type="url" class="external-url-input" id="external-url-${panel.id}" 
                     placeholder="https://example.com/your-app" value="${url}">
              <button onclick="externalManager.loadExternalApp('${panel.id}')" 
