  // ThoughtStream Task Management (like original Thoughtstream)
  class TaskManager {
    constructor() {
      this.tasks = state.tasks;
      this.activeAnimations = new Map();
      this.init();
    }

    init() {
      this.setupTaskInput();
      this.startTaskAnimations();
      this.updateTaskCounts();
    }

    refreshFromState() {
      this.updateTaskCounts();
    }

    setupTaskInput() {
      document.getElementById('thoughtstream-btn').addEventListener('click', () => {
        this.toggleThoughtStream();
      });

      document.getElementById('stream-toggle-btn').addEventListener('click', () => {
        this.toggleThoughtStream();
      });
    }

    createTask(text, priority = 'medium', dueDate = null) {
      const now = Date.now();
      const task = {
        id: `task-${now}`,
        text: text,
        priority: this.determinePriority(text, dueDate),
        created: now,
        createdAt: now,
        updatedAt: now,
        dueDate: dueDate,
        completed: false,
        position: { x: -200, y: Math.random() * (window.innerHeight - 200) + 100 }
      };

      this.tasks.push(task);
      this.saveTasksToStorage();
      
      if (thoughtStreamActive) {
        this.animateTask(task);
      }
      
      this.updateTaskCounts();
      return task;
    }

    determinePriority(text, dueDate) {
      const urgentWords = ['urgent', 'asap', 'emergency', 'critical', 'deadline'];
      const lowWords = ['maybe', 'someday', 'eventually', 'when', 'if'];
      
      const lowerText = text.toLowerCase();
      
      if (urgentWords.some(word => lowerText.includes(word))) {
        return 'high';
      }
      
      if (lowWords.some(word => lowerText.includes(word))) {
        return 'low';
      }
      
      if (dueDate) {
        const daysUntilDue = (new Date(dueDate) - new Date()) / (1000 * 60 * 60 * 24);
        if (daysUntilDue <= 1) return 'high';
        if (daysUntilDue <= 7) return 'medium';
        return 'low';
      }
      
      return 'medium';
    }

    toggleThoughtStream() {
      thoughtStreamActive = !thoughtStreamActive;
      const container = document.getElementById('thoughtstream-container');
      const streamBtn = document.getElementById('stream-toggle-btn');
      
      if (thoughtStreamActive) {
        container.classList.remove('hidden');
        streamBtn.style.background = 'rgba(0, 255, 204, 0.3)';
        streamBtn.querySelector('span:first-child').textContent = 'STREAM';
        streamBtn.querySelector('span:last-child').textContent = 'ACTIVE';
        
        // Start animations for all active tasks
        this.tasks.filter(t => !t.completed).forEach(task => {
          this.animateTask(task);
        });
      } else {
        container.classList.add('hidden');
        streamBtn.style.background = 'transparent';
        streamBtn.querySelector('span:first-child').textContent = 'THOUGHT';
        streamBtn.querySelector('span:last-child').textContent = 'STREAM';
        
        // Stop all animations
        this.activeAnimations.forEach(animation => animation.stop());
        this.activeAnimations.clear();
        container.innerHTML = '';
      }
    }

    animateTask(task) {
      if (!thoughtStreamActive) return;
      
      const container = document.getElementById('thoughtstream-container');
      const taskElement = document.createElement('div');
      
      taskElement.className = `floating-task priority-${task.priority}`;
      taskElement.id = task.id;
      taskElement.textContent = task.text;
      taskElement.style.left = `${task.position.x}px`;
      taskElement.style.top = `${task.position.y}px`;
      taskElement.style.pointerEvents = 'auto';
      
      taskElement.addEventListener('click', () => {
        this.completeTask(task.id);
      });

      container.appendChild(taskElement);

      // Animate across screen
      const animation = new TWEEN.Tween(task.position)
        .to({ x: window.innerWidth + 200 }, 15000 + Math.random() * 10000)
        .easing(TWEEN.Easing.Linear.None)
        .onUpdate(() => {
          taskElement.style.left = `${task.position.x}px`;
        })
        .onComplete(() => {
          if (taskElement.parentNode) {
            // Reset position and start again
            task.position.x = -200;
            task.position.y = Math.random() * (window.innerHeight - 200) + 100;
            setTimeout(() => this.animateTask(task), Math.random() * 5000 + 2000);
          }
        })
        .start();

      this.activeAnimations.set(task.id, animation);
    }

    completeTask(taskId) {
      const taskIndex = this.tasks.findIndex(t => t.id === taskId);
      if (taskIndex > -1) {
        const now = Date.now();
        this.tasks[taskIndex].completed = true;
        this.tasks[taskIndex].completedAt = now;
        this.tasks[taskIndex].updatedAt = now;
        
        const taskElement = document.getElementById(taskId);
        if (taskElement) {
          taskElement.style.background = 'linear-gradient(45deg, #44ff44, #88ffaa)';
          taskElement.style.transform = 'scale(1.2)';
          setTimeout(() => {
            taskElement.style.opacity = '0';
            setTimeout(() => taskElement.remove(), 300);
          }, 1000);
        }

        const animation = this.activeAnimations.get(taskId);
        if (animation) {
          animation.stop();
          this.activeAnimations.delete(taskId);
        }

        this.saveTasksToStorage();
        this.updateTaskCounts();
      }
    }

    clearCompletedTasks() {
      const remaining = this.tasks.filter(t => !t.completed);
      this.tasks.splice(0, this.tasks.length, ...remaining);
      this.saveTasksToStorage();
      this.updateTaskCounts();
    }

    updateTaskCounts() {
      const activeTasks = this.tasks.filter(t => !t.completed).length;
      const today = new Date().toDateString();
      const completedToday = this.tasks.filter(t => 
        t.completed && new Date(t.completedAt).toDateString() === today
      ).length;

      document.getElementById('active-tasks').textContent = activeTasks;
      document.getElementById('completed-today').textContent = completedToday;
      const prevActive = state.stats?.active;
      const prevCompleted = state.stats?.completedToday;
      state.stats = state.stats || { active: 0, completedToday: 0 };
      state.stats.active = activeTasks;
      state.stats.completedToday = completedToday;
      if (prevActive !== activeTasks || prevCompleted !== completedToday) {
        markDirty();
      }
    }

    async saveTasksToStorage() {
      try {
        for (const t of this.tasks) {
          await persistence.saveTask(t);
        }
      } catch {}
      return Promise.resolve();
    }

    async loadTasksFromStorage() {
      this.refreshFromState();
      return Promise.resolve();
    }

    startTaskAnimations() {
      function animate() {
        requestAnimationFrame(animate);
        TWEEN.update();
      }
      animate();
    }
  }

