  function renderOrganizerList() {
    const tbody = document.getElementById('org-tbody');
    tbody.innerHTML = '';
    if (!OrganizerStore.items.length) {
      const tr = document.createElement('tr'); tr.className = 'org-empty';
      tr.innerHTML = `<td colspan="5">No items yet — add one above.</td>`;
      tbody.appendChild(tr); return;
    }
    // Get filtered and sorted rows
    const rows = OrganizerFilterSort.getFilteredAndSortedItems();
    if (!rows.length) {
      const tr = document.createElement('tr'); tr.className = 'org-empty';
      tr.innerHTML = `<td colspan="5">No items match current filter.</td>`;
      tbody.appendChild(tr); return;
    }
    rows.forEach(it => {
      const tr = document.createElement('tr');
      const dateMode = it.dateMode || (it.type === 'event' ? 'event' : 'created');
      const createdStamp = toLocalYMDFromTs(it.createdAt) || '';
      let schedDisplay = '';
      let dueDisplay = '';
      if (it.type === 'event') {
        schedDisplay = it.scheduledDate || it.dateValue || '';
        // Add time to display if available
        if (it.start != null) {
          schedDisplay += ' ' + formatTimeFromMinutes(it.start);
          if (it.duration != null) {
            schedDisplay += ' (' + formatDuration(it.duration) + ')';
          }
        }
        dueDisplay = it.due || it.dateValue || '';
      } else if (dateMode === 'due') {
        schedDisplay = createdStamp || it.scheduledDate || it.dateValue || '';
        dueDisplay = it.due || it.dateValue || '';
      } else {
        schedDisplay = it.scheduledDate || it.dateValue || createdStamp;
        dueDisplay = '';
      }
      const statusClass = it.completedAt ? 'org-status done' : 'org-status';
      // active on screen?
      let isActive = false;
      try {
        if (it.panelId) {
          const el = document.querySelector(`.dynamic-panel[data-panel-id="${it.panelId}"]`);
          isActive = !!el;
        } else if (window.panelManager) {
          isActive = panelManager.hasPanelForItem?.(it.id) || false;
        }
      } catch {}
      const nameStyle = isActive ? 'style="color: yellow;"' : '';
      tr.innerHTML = `
        <td>${it.type}</td>
        <td><span class="org-name" data-id="${it.id}" ${nameStyle} title="Click to toggle on/off">${escapeHtml(it.name)}</span></td>
        <td>${schedDisplay}</td>
        <td>${dueDisplay}</td>
        <td><span class="${statusClass}" data-id="${it.id}">${it.completedAt ? 'done' : 'todo'}</span></td>
        <td style="white-space:nowrap;">
          <button class="org-toggle" data-id="${it.id}" title="Show/Hide panel" style="border:1px solid rgba(255,255,255,.28);background:rgba(0,0,0,.18);color:#e5e7eb;border-radius:8px;padding:2px 8px;margin-right:6px;">
            <i class="fas fa-window-restore"></i>
          </button>
          <button class="org-trash" data-id="${it.id}" title="Archive (trash)" style="border:1px solid rgba(255,255,255,.28);background:rgba(0,0,0,.18);color:#e5e7eb;border-radius:8px;padding:2px 8px;">
            <i class="fas fa-trash"></i>
          </button>
        </td>
      `;
      tbody.appendChild(tr);
    });

    // bind clicks
    tbody.querySelectorAll('.org-status').forEach(el => {
      el.addEventListener('click', () => {
        const id = el.dataset.id;
        OrganizerStore.toggleDone(id);
        // hide from DOM if marked done
        const it = OrganizerStore.items.find(i=>i.id===id);
        if (it?.status === 'done') {
          panelManager?.hidePanelForItem?.(id);
        }
        renderOrganizerList();
      });
    });
    tbody.querySelectorAll('.org-name').forEach(el => {
      el.addEventListener('click', () => {
        const id = el.dataset.id;
        const it = OrganizerStore.items.find(i=>i.id===id);
        if (!it) return;
        if (it.status === 'done') return; // cannot activate directly when done
        // Events open in calendar, not as panels
        if (it.type === 'event' || it.type === 'calendar') {
          try {
            enterCalendarMode();
            const d = it.scheduledDate || it.due;
            if (d) {
              // ensure calendar grid reflects latest organizer items and highlight date
              renderCalendarOverlay();
              updateCalDaily(d);
              const grid = document.getElementById('cal-grid');
              const cell = grid && grid.querySelector(`.cal-cell[data-date="${d}"]`);
              if (cell) {
                grid.querySelectorAll('.cal-cell').forEach(c=>c.classList.remove('selected'));
                cell.classList.add('selected');
              }
            }
          } catch {}
        } else {
          panelManager?.togglePanelFromOrganizer?.(it);
        }
        renderOrganizerList();
      });
    });
    // explicit toggle buttons
    tbody.querySelectorAll('.org-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.id;
        const it = OrganizerStore.items.find(i=>i.id===id);
        if (!it) return;
        if (it.status === 'done') return;
        if (it.type === 'event' || it.type === 'calendar') {
          try {
            enterCalendarMode();
            const d = it.scheduledDate || it.due;
            if (d) {
              renderCalendarOverlay();
              updateCalDaily(d);
              const grid = document.getElementById('cal-grid');
              const cell = grid && grid.querySelector(`.cal-cell[data-date="${d}"]`);
              if (cell) {
                grid.querySelectorAll('.cal-cell').forEach(c=>c.classList.remove('selected'));
                cell.classList.add('selected');
