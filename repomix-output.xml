    color: #003322;
    box-shadow: 0 8px 32px rgba(0, 255, 155, 0.3);}
.result-toast.error {
    background: linear-gradient(135deg, rgba(255, 80, 80, 0.95), rgba(200, 40, 40, 0.95));
    border: 2px solid #ff5050;
    color: #ffcccc;
    box-shadow: 0 8px 32px rgba(255, 80, 80, 0.3);}
.message-tooltip-assistant {
