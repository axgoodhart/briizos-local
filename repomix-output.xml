        // ============================================================
        // ============================================================
        // PANEL STACK MANAGEMENT (for ESC key)
        // ============================================================

        const panelStack = [];

        function pushPanel(panelName) {
            // Remove if already in stack (prevent duplicates)
            const index = panelStack.indexOf(panelName);
            if (index > -1) {
                panelStack.splice(index, 1);
            }
            panelStack.push(panelName);
        }

        function popPanel(panelName) {
            const index = panelStack.indexOf(panelName);
            if (index > -1) {
                panelStack.splice(index, 1);
            }
        }

        function closeTopPanel() {
            if (panelStack.length === 0) return false;

            const topPanel = panelStack[panelStack.length - 1];

            switch(topPanel) {
                case 'presets':
                    closePresetsPanel();
                    break;
                case 'edit-modal':
                    closeEditModal();
                    break;
                case 'creation-modal':
                    closeCreationModal();
                    break;
                case 'search':
                    toggleSearchPanel();
                    break;
                case 'settings':
                    toggleSettings();
                    break;
            }

            return true;
        }

        // Global ESC key handler
        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                const closed = closeTopPanel();
                if (closed) {
                    e.preventDefault();
                    e.stopPropagation();
                }
            }
        });

        // SETTINGS DRAWER FUNCTIONS
        // ============================================================

        let settingsOpen = false;

        window.toggleSettings = function() {
            const drawer = document.getElementById('settings-drawer');
            settingsOpen = !settingsOpen;

            if (settingsOpen) {
                drawer.classList.add('open');
                pushPanel('settings');
            } else {
                drawer.classList.remove('open');
                popPanel('settings');
            }
            NavController.updateMouseLook();
        }

        window.updateFlightSetting = function(setting, value) {
            const numValue = parseFloat(value);

            // Map setting name to NavController property
            if (setting === 'acceleration') {
                NavController.thrustPower = numValue;
                document.getElementById('accel-value').innerText = numValue.toFixed(3);
            } else if (setting === 'deceleration') {
                NavController.deceleration = numValue;
                document.getElementById('damping-value').innerText = numValue.toFixed(2);
            } else if (setting === 'maxSpeed') {
                NavController.maxSpeed = numValue;
                document.getElementById('maxspeed-value').innerText = numValue.toFixed(2);
            }

            saveCurrentFlightSettings();
            setCurrentPresetName('CUSTOM');
        }

        window.updateCameraFOV = function(value) {
            const fov = parseInt(value);
            camera.fov = fov;
            camera.updateProjectionMatrix();
            document.getElementById('fov-value').innerText = fov + '°';
            saveCurrentFlightSettings();
            setCurrentPresetName('CUSTOM');
        }

        window.updateLookSpeed = function(value) {
            NavController.lookSpeed = parseFloat(value);
            document.getElementById('lookspeed-value').innerText = NavController.lookSpeed.toFixed(3);
            saveCurrentFlightSettings();
            setCurrentPresetName('CUSTOM');
        }

        // ============================================================
        // THEME SYSTEM
        // ============================================================

        const THEME_KEY = 'celestia_theme';
        let currentTheme = 'vaporwave';

        window.setTheme = function(themeName) {
            const validThemes = ['vaporwave', 'onyx', 'dusk', 'rose'];
            if (!validThemes.includes(themeName)) return;

            // Remove all theme classes
            document.documentElement.classList.remove('theme-vaporwave', 'theme-onyx', 'theme-dusk', 'theme-rose');
            // Add new theme class
            document.documentElement.classList.add('theme-' + themeName);
            currentTheme = themeName;

            // Save to localStorage
            localStorage.setItem(THEME_KEY, themeName);

            // Update 3D scene colors
            updateSceneTheme(themeName);

            // Update button states
            document.querySelectorAll('.theme-btn').forEach(btn => {
                const isActive = btn.dataset.theme === themeName;
                btn.classList.toggle('bg-cyan-900/50', isActive);
                btn.classList.toggle('ring-1', isActive);
                btn.classList.toggle('ring-cyan-400/50', isActive);
            });

            showToast(`Theme: ${themeName.toUpperCase()}`, 'info');
        };

        function loadSavedTheme() {
            const saved = localStorage.getItem(THEME_KEY);
            if (saved && ['vaporwave', 'onyx', 'dusk', 'rose'].includes(saved)) {
                setTheme(saved);
            } else {
                setTheme('vaporwave');
            }
        }

        // Get theme color palette
        function getThemeColors(themeName) {
            const themes = {
                vaporwave: {
                    fog: 0x001a1a,
                    bg: 0x020205,
                    grid1: 0x00ffff,
                    grid2: 0x112244,
                    ambient: 0x4080a0,
                    camLight: 0xccffff,
                    stars: 0xaaffff
                },
                onyx: {
                    fog: 0x0a0a0a,
                    bg: 0x050505,
                    grid1: 0xaaaaaa,
                    grid2: 0x222222,
                    ambient: 0x666666,
                    camLight: 0xdddddd,
                    stars: 0xcccccc
                },
                dusk: {
                    fog: 0x1a0f0a,
                    bg: 0x0f0805,
                    grid1: 0xffaa64,
                    grid2: 0x442211,
                    ambient: 0xaa6644,
                    camLight: 0xffcc88,
                    stars: 0xffd4aa
                },
                rose: {
                    fog: 0x1a0a14,
                    bg: 0x0f050a,
                    grid1: 0xff6eaa,
                    grid2: 0x331122,
                    ambient: 0xaa5588,
                    camLight: 0xffaacc,
                    stars: 0xffc4dd
                }
            };
            return themes[themeName] || themes.vaporwave;
        }

        // Update 3D scene colors to match theme
        function updateSceneTheme(themeName) {
            if (!scene) return; // Scene not initialized yet

            const colors = getThemeColors(themeName);

            // Update fog
            scene.fog.color.setHex(colors.fog);
            scene.background.setHex(colors.bg);

            // Update grid colors
            if (grid && grid.material) {
                grid.material.color.setHex(colors.grid1);
                grid.material.needsUpdate = true;
            }
            if (grid2 && grid2.material) {
                grid2.material.color.setHex(colors.grid1);
                grid2.material.needsUpdate = true;
            }

            // Update ambient light
            if (ambientLight) {
                ambientLight.color.setHex(colors.ambient);
            }

            // Update camera point light
            if (camLight) {
                camLight.color.setHex(colors.camLight);
            }

            // Update starfield
            if (starField && starField.material) {
                starField.material.color.setHex(colors.stars);
                starField.material.needsUpdate = true;
            }
        }

        // Load theme on startup (deferred)
        setTimeout(loadSavedTheme, 0);

