/* from the picked color, generate palette colors and display */
/* CSS contrast color --selectContrastColor                   */
/* saturated or desaturate color using chroma.js              */
/* complementy color using tinycolor                          */
/* average of all three colors using chroma.js                */

function setupSwatches() {

  var cS0 = namedToHex(customSelect.value);
  var cS1 = colorToHex(dataCard, "color");

  gsap.set("#cS0", { "--color": cS0 });
  gsap.set("#cS1", { "--color": cS1 });
  gsap.set("body", { "--bd1": cS1 });

  var cS2 = chroma(customSelect.value).saturate(5);
  var difference = chroma.deltaE(cS0, cS2);

  if (difference < 10)
  cS2 = chroma(customSelect.value).desaturate(5);
  gsap.set("#cS2", { "--color": cS2 });
  gsap.set("body", { "--bd2": cS2 });

  if (cS0 != "#000000")
  {
    var cS3 = tinycolor2(cS0).complement().toHexString();
    gsap.set("#cS3", { "--color": cS3 });
  } else

  {
    var cS3 = "#FFFFFF";
    gsap.set("#cS3", { "--color": "#FFFFFF" });
  }
  gsap.set("body", { "--bd3": cS3 });

  var cS4 = chroma.average([cS1, cS2, cS3]);
  gsap.set("body", { "--bd4": cS4 });


  /*  update display details */
  select("#cS0").innerHTML = "<span class='code'>" + cS0 + "</span>";
  select("#cS0").innerHTML += "<span>" + chroma(cS0).css('hsl').replace("deg", "") + "</span>";
  select("#cS0").innerHTML += "<span>" + chroma(cS0).css('rgb') + "</span>";

  select("#cS1").innerHTML = "<span class='code'>" + cS1 + "</span>";
  select("#cS1").innerHTML += "<span>" + chroma(cS1).css('hsl').replace("deg", "") + "</span>";
  select("#cS1").innerHTML += "<span>" + chroma(cS1).css('rgb') + "</span>";

  select("#cS2").innerHTML = "<span class='code'>" + cS2 + "</span>";
  select("#cS2").innerHTML += "<span>" + chroma(cS2).css('hsl').replace("deg", "") + "</span>";
  select("#cS2").innerHTML += "<span>" + chroma(cS2).css('rgb') + "</span>";

  select("#cS3").innerHTML = "<span class='code'>" + cS3 + "</span>";
  select("#cS3").innerHTML += "<span>" + chroma(cS3).css('hsl').replace("deg", "") + "</span>";
  select("#cS3").innerHTML += "<span>" + chroma(cS3).css('rgb') + "</span>";

}


/* convert CSS color-mix calculated value to hex */
function colorToHex(el, selector) {

  let style = gsap.getProperty(el, selector);
  let offscreen = new OffscreenCanvas(1, 1).getContext("2d");
  offscreen.fillStyle = style;
  offscreen.fillRect(0, 0, 1, 1);
  const pixel = offscreen.getImageData(0, 0, 1, 1).data;
  return `#${intToHex(pixel[0])}${intToHex(pixel[1])}${intToHex(pixel[2])}`;

  function intToHex(i) {
    return Math.floor(i).toString(16).padStart(2, "0");
  }

}

/* convert named color to Hex */
function namedToHex(name) {
  var offscreen = document.createElement('canvas').getContext('2d');
  offscreen.fillStyle = name;
  return offscreen.fillStyle;
}
// ── Theme Engine Integration ──────────────────────
const _engineReady = import('./themeEngine.js').catch(() => null);

window.addEventListener('load', async () => {
  const engine = await _engineReady;
  const panel = document.querySelector('#enginePanel');
  if (!panel) return;

  // Toggle panel open/close
  panel.querySelector('.ep-toggle').addEventListener('click', () => panel.classList.toggle('open'));

  const status = panel.querySelector('.ep-status');

  if (!engine) {
    status.textContent = 'Serve via HTTP to enable engine';
    return;
  }

  status.textContent = 'Ready';

  let currentDNA = null;
  const $ = s => panel.querySelector(s);
  const cssInput     = $('#cssInput');
  const dnaSection   = $('#dnaSection');
  const genSection   = $('#generateSection');
  const genCSS       = $('#generatedCSS');
  const lInput       = $('#lightnessInput');
  const sInput       = $('#saturationInput');
  const lVal         = $('#lightnessVal');
  const sVal         = $('#saturationVal');
  const invCB        = $('#invertLightness');
  const nameInput    = $('#themeName');

  // File upload
  $('#cssFile').addEventListener('change', e => {
    const f = e.target.files[0];
    if (!f) return;
    new Response(f).text().then(t => { cssInput.value = t; analyze(); });
  });

  // Analyze button
  $('#analyzeBtn').addEventListener('click', analyze);

  function analyze() {
    const css = cssInput.value.trim();
    if (!css) return;
    const dna = engine.extract(css);
    const keys = Object.keys(dna);
    if (!keys.length) { status.textContent = 'No :root blocks found'; return; }
    currentDNA = dna[keys[0]];
    status.textContent = currentDNA.name + ' — ' + currentDNA.variableCount + ' vars';
    renderDNA(currentDNA);
    regenerate();
  }

  function renderDNA(dna) {
    dnaSection.style.display = '';
    $('#dnaSummary').innerHTML =
      '<div class="dna-stat"><div class="stat-value">' + dna.variableCount + '</div>Variables</div>' +
      '<div class="dna-stat"><div class="stat-value">' + dna.colorSlotCount + '</div>Color slots</div>';
    const max = Math.max(...dna.dominantHues.map(d => d.count), 1);
    $('#hueHistogram').innerHTML = dna.dominantHues.slice(0, 10).map(d =>
      '<div class="hist-row">' +
        '<span class="hist-label">' + d.hue + '°</span>' +
        '<div class="hist-bar" style="width:' + (d.count / max * 100).toFixed(0) + '%;background:hsl(' + d.hue + ',80%,55%)"></div>' +
        '<span class="hist-count">' + d.count + '</span>' +
      '</div>'
    ).join('');
  }

  // Control listeners
  lInput.addEventListener('input', () => { lVal.textContent = parseFloat(lInput.value).toFixed(2); regenerate(); });
  sInput.addEventListener('input', () => { sVal.textContent = parseFloat(sInput.value).toFixed(1); regenerate(); });
  invCB.addEventListener('change', regenerate);
  nameInput.addEventListener('input', regenerate);

  function regenerate() {
    if (!currentDNA) return;
    genSection.style.display = '';

    // Use the currently-picked named color as the new accent
    const hex = namedToHex(optionValue);
    const rgba = engine.parseColor(hex);
    if (!rgba) return;
    const [accentH] = engine.rgbToHsl(rgba[0], rgba[1], rgba[2]);

    // Shift hue so the original dominant hue → picked color hue
    const domH = currentDNA.dominantHues[0]?.hue ?? 0;
    const shift = accentH - domH;

    const vars = engine.generate(currentDNA, {
      hueShift: shift,
      lightnessScale: parseFloat(lInput.value),
      saturationScale: parseFloat(sInput.value),
      invertLightness: invCB.checked,
    });

    const name = nameInput.value.trim() || 'my-theme';
    genCSS.value = engine.toCSS(vars, ":root[data-theme='" + name + "']");
  }

  // Regenerate when the color picker changes
  customSelect.addEventListener('change', () => setTimeout(regenerate, 60));

  // Copy button
  $('#copyBtn').addEventListener('click', () => {
    navigator.clipboard.writeText(genCSS.value).then(() => {
      const fb = $('#copyFeedback');
      fb.textContent = 'Copied!';
      setTimeout(() => fb.textContent = '', 2000);
    });
  });

});
  </script>

  
