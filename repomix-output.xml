        background: transparent;

        &:hover {
            cursor: pointer;
        }

        option:not(.selectFrame) {

            --color: attr(value type(<color>));
            --colorText: attr(value);

            --contrast-color: color(from var(--color) xyz clamp(0, (.36 / y - 1) * infinity, 1) clamp(0, (.36 / y - 1) * infinity, 1) clamp(0, (.36 / y - 1) * infinity, 1) / 1 );

            --bgColor: color-mix(in oklch shorter hue, var(--color), transparent 30%);
            --bgColor2c: color-mix(in oklab, var(--color), var(--selectBackgroundColor) 30%);
            --bgColor2b: color-mix(in oklab, var(--bgColor2c), var(--contrast-color) 70%);
            --bgColor2: color-mix(in oklch shorter hue, var(--bgColor2b), transparent 80%);

            --contrast-shadow: color-mix(in oklch shorter hue, var(--contrast-color), transparent 80%);
            --contrast-shadow2: color-mix(in oklch shorter hue, var(--contrast-color), transparent 60%);

         }

    }

    @supports (appearance: base-select) {
      
        select#customSelect {

