       if (form) {

form.style.display = authed ? "none" : "block";}
       if (logoutBtn) { logoutBtn.style.display = authed ? "inline-block" : "none";}});
  const LS_KEY = "glOS.state.v1", SNAP_VER = 1;
  const cloudFirst = true; // prefer server as source of truth
  // Disable local cache for core app state when false
  const USE_LOCAL_CACHE = false;
  function createEmptyState(){
    return {
      __ver: SNAP_VER,
      panels: [],
      panelMinStack: [],
      tasks: [],
      events: [],
      organizer: [],
      thoughtstream: [],
      calendar: {},
      chatThreads: {},
      stats: { active: 0, completedToday: 0 },
      clientTs: 0
    };
  }

  function normalizeStateShape(input){
    if (!input || typeof input !== 'object') return createEmptyState();
    const normalized = createEmptyState();
    normalized.__ver = input.__ver === SNAP_VER ? SNAP_VER : SNAP_VER;
    normalized.panels = Array.isArray(input.panels) ? input.panels : Object.values(input.panels || {});
    normalized.panelMinStack = Array.isArray(input.panelMinStack) ? input.panelMinStack : [];
    normalized.tasks = Array.isArray(input.tasks) ? input.tasks : [];
    normalized.events = Array.isArray(input.events) ? input.events : [];
    if (Array.isArray(input.organizer)) {
      normalized.organizer = [...input.organizer];
    } else if (input.organizer && typeof input.organizer === 'object') {
      normalized.organizer = Object.values(input.organizer);
    }
    normalized.thoughtstream = Array.isArray(input.thoughtstream) ? input.thoughtstream : [];
    normalized.calendar = input.calendar && typeof input.calendar === 'object' ? input.calendar : {};
    normalized.chatThreads = input.chatThreads && typeof input.chatThreads === 'object' ? input.chatThreads : {};
    normalized.stats = input.stats && typeof input.stats === 'object' ? input.stats : { active: 0, completedToday: 0 };
    normalized.clientTs = typeof input.clientTs === 'number' ? input.clientTs : 0;
    return normalized;
  }

  const state = (()=>{
    if (USE_LOCAL_CACHE) {
      try{
        const raw = localStorage.getItem(LS_KEY);
        if(raw){
          const parsed = JSON.parse(raw);
          if(parsed.__ver === SNAP_VER){
            return normalizeStateShape(parsed);
          }
        }
      }catch{}
    }
    return createEmptyState();
  })();
  // Ensure consistent timestamp fields across models
  function ensureModelTimestamps(){
    const nowTs = Date.now();
    try {
      // Tasks
      if (Array.isArray(state.tasks)) {
        state.tasks.forEach(t => {
          if (!t) return;
          if (t.createdAt == null) {
            t.createdAt = (t.created != null) ? t.created : nowTs;
          }
          if (t.created == null) {
            t.created = t.createdAt;
          }
          if (t.updatedAt == null) {
            t.updatedAt = (t.completedAt != null) ? t.completedAt : t.createdAt;
          }
        });
      }
      // Legacy calendar events
      if (Array.isArray(state.events)) {
        state.events.forEach(ev => {
          if (!ev) return;
          if (ev.createdAt == null) {
            ev.createdAt = (ev.created != null) ? ev.created : nowTs;
          }
          if (ev.created == null) {
            ev.created = ev.createdAt;
          }
          if (ev.updatedAt == null) {
            ev.updatedAt = ev.createdAt;
          }
        });
      }
      // Panels
      if (Array.isArray(state.panels)) {
        state.panels.forEach(p => {
          if (!p) return;
          if (p.createdAt == null) {
            p.createdAt = nowTs;
          }
          if (p.updatedAt == null) {
            p.updatedAt = p.createdAt;
          }
          if (typeof p.autoHeight === 'undefined') {
            p.autoHeight = true;
          }
        });
      }
    } catch {}
  }
  ensureModelTimestamps();
  let dirty=false, lastCheckpoint=0, uid=null, subUnsub=null, cpTimer=null;
  let cpBackoffMs = 2000; // checkpoint retry backoff
  const saveLocal=()=>{ if(!USE_LOCAL_CACHE) return; try{ localStorage.setItem(LS_KEY, JSON.stringify(state)); }catch{} };
  const scheduleCheckpoint=()=>{
    if (!cloudFirst) return;
    if (cpTimer) clearTimeout(cpTimer);
    cpTimer = setTimeout(()=>{ checkpoint(true); cpTimer=null; }, 800);
  };
  const markDirty=()=>{ dirty=true; saveLocal(); scheduleCheckpoint(); };

  window.appState = state;

  // Pending local changes (per-panel field patches) buffered in localStorage
  const PENDING_KEY = 'glOS.pending.v1';
  let pendingCommitTimer = null;

  function readPending(){
    try { return JSON.parse(localStorage.getItem(PENDING_KEY)||'null') || { panels:{}, meta:{} }; } catch { return { panels:{}, meta:{} }; }
  }
  function writePending(obj){ try { localStorage.setItem(PENDING_KEY, JSON.stringify(obj)); } catch {} }
  function stagePanelPatch(id, patch){
    const pid = String(id);
    const pend = readPending();
    pend.panels = pend.panels || {};
    const cur = pend.panels[pid]?.patch || {};
    const next = { ...cur };
    Object.keys(patch||{}).forEach(k=>{
      const v = patch[k];
      if (typeof v === 'undefined') return; // skip undefined
      next[k] = v;
    });
    pend.panels[pid] = { patch: next, updatedAt: Date.now() };
    writePending(pend);
    console.log('[stage] panel', { id: pid, fields: Object.keys(next) });
  }
  function scheduleCommit(ms=60_000){
    if (pendingCommitTimer) return;
    pendingCommitTimer = setTimeout(()=>{ pendingCommitTimer=null; commitPendingChanges(); }, ms);
  }
  async function commitPendingChanges(opts={}){
    const onlyId = opts.onlyId ? String(opts.onlyId) : null;
    const pend = readPending();
    const ids = Object.keys(pend.panels||{}).filter(id => !onlyId || id===onlyId);
    if (!ids.length) return;
    console.log('[commit-start]', { count: ids.length });
    const keyToId = new Map();
    for (const id of ids){
      const patch = pend.panels[id]?.patch || {};
      // sanitize partial patch: drop undefined
      const clean = {};
      Object.keys(patch).forEach(k=>{ const v = patch[k]; if (typeof v !== 'undefined') clean[k]=v; });
      if (Object.keys(clean).length === 0) continue;
      persistence.queueFirebaseSave('panels', id, clean);
      keyToId.set(`panels/${id}`, id);
    }
    // Attempt per-key commit and track success
    const results = await Promise.allSettled(Array.from(keyToId.keys()).map(k => persistence.flushSaveQueue(k)));
    const succeeded = new Set();
    results.forEach((r, idx)=>{
      const key = Array.from(keyToId.keys())[idx];
      const id = keyToId.get(key);
      if (r.status === 'fulfilled') { console.log('[commit-ok]', { id }); succeeded.add(id); }
      else { console.error('[commit-error]', { id, error: String(r.reason && r.reason.message || r.reason) }); }
    });
    if (succeeded.size){
      const next = readPending();
      for (const id of succeeded){ delete next.panels[id]; }
      next.meta = next.meta || {}; next.meta.lastCommitTs = Date.now();
      writePending(next);
    }
  }
  function overlayPendingIntoState(){
    try {
      const pend = readPending();
      const panels = state.panels || [];
      Object.entries(pend.panels||{}).forEach(([id, rec])=>{
        const p = panels.find(x=> String(x.id)===String(id)); if (!p) return;
        const patch = rec?.patch || {};
        Object.assign(p, patch);
        // ensure timestamps keep moving forward
        p.updatedAt = Date.now();
      });
      if (Object.keys(pend.panels||{}).length) console.log('[overlay]', { count: Object.keys(pend.panels||{}).length });
    } catch {}
  }

  // New persistence manager using Firestore subcollections
  class PersistenceManager {
    constructor(auth, db, stateRef) {
      this.auth = auth;
      this.db = db;
      this.state = stateRef; // bind to existing app state
      this.uid = null;
      this.listeners = new Map();
      this.saveQueue = new Map();
      this.saveTimers = new Map();
      this.animationWaitMap = new Map();
      this.DEBOUNCE_MS = 1000;
    }

    async waitForAnimation(key, durationMs) {
      return new Promise(resolve => {
        clearTimeout(this.animationWaitMap.get(key));
        const timer = setTimeout(() => {
          this.animationWaitMap.delete(key);
          resolve();
        }, durationMs);
        this.animationWaitMap.set(key, timer);
      });
    }

    saveLocal() {
      if (!USE_LOCAL_CACHE) return; try { localStorage.setItem(LS_KEY, JSON.stringify(this.state)); } catch {}
    }

    // Create a Firestore-safe copy of a panel (plain JSON, supported types only)
    sanitizePanelForSave(panel) {
      const pid = String(panel?.id ?? '');
      const safe = {
        id: pid,
        type: panel?.type || 'note',
        title: panel?.title || '',
        content: typeof panel?.content === 'string' ? panel.content : '',
        tags: Array.isArray(panel?.tags) ? panel.tags.map(x => String(x)) : [],
        orgId: panel?.orgId || null,
        active: panel?.active !== false,
        chat: (panel?.chat && typeof panel.chat === 'object') ? { provider: panel.chat.provider || null, model: panel.chat.model || null } : null,
        externalUrl: panel?.externalUrl || '',
        externalShowUrl: !!panel?.externalShowUrl,
        externalData: null,
        subtype: panel?.subtype || null,
        x: Number(panel?.x) || 0,
        y: Number(panel?.y) || 0,
        autoHeight: panel?.autoHeight !== false,
        createdAt: Number(panel?.createdAt) || Date.now(),
        updatedAt: Number(panel?.updatedAt) || Date.now(),
        customColor: panel?.customColor || null,
        expansionCount: Number(panel?.expansionCount || 0),
        // jobPanel fields
        jobMessage: panel?.jobMessage || null,
        taskId: panel?.taskId || null,
      };
      // Only include width/height if finite numbers
      const wNum = Number(panel?.w);
      if (Number.isFinite(wNum) && wNum > 0) safe.w = wNum;
      const hNum = Number(panel?.h);
      if (Number.isFinite(hNum) && hNum > 0) safe.h = hNum;
      // Try to keep externalData if it is JSON-serializable
      try {
        if (panel && typeof panel.externalData !== 'undefined') {
          JSON.stringify(panel.externalData);
          safe.externalData = panel.externalData;
        }
      } catch { safe.externalData = null; }
      return safe;
    }

    async savePanel(panel, options = {}) {
      if (options.waitForAnimation) {
        await this.waitForAnimation(`panel-${panel.id}`, options.animationDuration || 300);
      }
      // ensure external fields exist
      if (panel.type === 'external') {
        panel.externalUrl = panel.externalUrl || '';
        panel.externalShowUrl = !!panel.externalShowUrl;
        panel.externalData = panel.externalData || null;
      }
      const pid = String(panel.id);
      const idx = (this.state.panels||[]).findIndex(p => String(p.id) === pid);
      const now = Date.now();
      if (idx >= 0) {
        Object.assign(this.state.panels[idx], { ...panel, id: pid, updatedAt: now, createdAt: this.state.panels[idx].createdAt || panel.createdAt || now });
      } else {
        const target = { ...panel, id: pid, createdAt: panel.createdAt || now, updatedAt: now };
        this.state.panels.push(target);
      }
      console.log('[persist] upsert panel', { id: pid, contentLen: (panel?.content||'').length });
      this.saveLocal();
      const safe = this.sanitizePanelForSave(panel);
      this.queueFirebaseSave('panels', pid, safe);
    }

    async deletePanel(panelId) {
      const pid = String(panelId);
      this.state.panels = (this.state.panels||[]).filter(p => String(p.id) !== pid);
      console.log('[persist] delete panel', { id: pid });
      // also remove from min stack if present
      if (Array.isArray(this.state.panelMinStack)) {
        this.state.panelMinStack = this.state.panelMinStack.filter(id => String(id) !== pid);
      }
      this.saveLocal();
      this.queueFirebaseDelete('panels', pid);
      // persist min stack update
      this.queueFirebaseSave('minStack', null, this.state.panelMinStack || []);
    }

    async minimizePanel(panelId, minimized) {
      await this.waitForAnimation(`minimize-${panelId}`, 350);
      if (!Array.isArray(this.state.panelMinStack)) this.state.panelMinStack = [];
      const pid = String(panelId);
      if (minimized) {
        const exists = this.state.panelMinStack.map(String).includes(pid);
        if (!exists) this.state.panelMinStack.push(pid);
      } else {
        this.state.panelMinStack = this.state.panelMinStack.filter(id => String(id) !== pid);
      }
      console.log('[persist] minimize state', { id: pid, minimized: !!minimized });
      this.saveLocal();
      this.queueFirebaseSave('minStack', null, this.state.panelMinStack);
    }

    saveTask(task) {
      const idx = (this.state.tasks||[]).findIndex(t => t.id === task.id);
      if (idx >= 0) this.state.tasks[idx] = { ...task, updatedAt: Date.now() };
      else this.state.tasks.push({ ...task, createdAt: Date.now(), updatedAt: Date.now() });
      this.saveLocal();
      this.queueFirebaseSave('tasks', String(task.id), task);
    }

    saveEvent(event) {
      const idx = (this.state.events||[]).findIndex(ev => ev.id === event.id);
      if (idx >= 0) this.state.events[idx] = { ...event, updatedAt: Date.now() };
      else this.state.events.push({ ...event, createdAt: Date.now(), updatedAt: Date.now() });
      this.saveLocal();
      this.queueFirebaseSave('events', String(event.id), event);
    }

    saveOrganizerItem(item) {
      const idx = (this.state.organizer||[]).findIndex(i => i.id === item.id);
      if (idx >= 0) this.state.organizer[idx] = { ...item, updatedAt: Date.now() };
      else this.state.organizer.push({ ...item, createdAt: Date.now(), updatedAt: Date.now() });
      this.saveLocal();
      this.queueFirebaseSave('organizer', String(item.id), item);
    }

    deleteOrganizerItem(itemId) {
      this.state.organizer = (this.state.organizer||[]).filter(i => i.id !== itemId);
      this.saveLocal();
      this.queueFirebaseDelete('organizer', String(itemId));
    }

    queueFirebaseSave(collectionName, docId, data) {
      const key = docId ? `${collectionName}/${docId}` : collectionName;
      clearTimeout(this.saveTimers.get(key));
      this.saveQueue.set(key, { collectionName, docId, data, timestamp: Date.now() });
      const timer = setTimeout(() => this.flushSaveQueue(key), this.DEBOUNCE_MS);
      this.saveTimers.set(key, timer);
      console.log('[queue] save', { key, collectionName, docId, fields: data ? Object.keys(data).slice(0, 8) : [] });
    }

    queueFirebaseDelete(collectionName, docId) {
      const key = `${collectionName}/${docId}`;
      clearTimeout(this.saveTimers.get(key));
      this.saveQueue.set(key, { collectionName, docId, delete: true, timestamp: Date.now() });
      const timer = setTimeout(() => this.flushSaveQueue(key), this.DEBOUNCE_MS);
      this.saveTimers.set(key, timer);
      console.log('[queue] delete', { key, collectionName, docId });
    }

    async flushSaveQueue(key) {
      const item = this.saveQueue.get(key);
      if (!item) return;
      if (!this.uid) {
        console.warn('[flush] deferred (no uid yet)', { key });
        // Re-arm a timer to try again shortly without dropping the queued item
        clearTimeout(this.saveTimers.get(key));
        const t = setTimeout(() => this.flushSaveQueue(key), Math.min(2000, this.DEBOUNCE_MS * 2));
        this.saveTimers.set(key, t);
        return;
      }
      this.saveQueue.delete(key);
      this.saveTimers.delete(key);
      try {
        if (item.delete) {
          const ref = doc(this.db, `users/${this.uid}/${item.collectionName}/${item.docId}`);
          await deleteDoc(ref);
          console.log('[flush] delete ok', { key, collectionName: item.collectionName, docId: item.docId });
        } else if (item.docId) {
          const ref = doc(this.db, `users/${this.uid}/${item.collectionName}/${item.docId}`);
          await setDoc(ref, { ...item.data, updatedAt: serverTimestamp() }, { merge: true });
          console.log('[flush] write ok', { key, collectionName: item.collectionName, docId: item.docId });
        } else {
          // singleton under app/
          const ref = doc(this.db, `users/${this.uid}/app/${item.collectionName}`);
          await setDoc(ref, { value: item.data, updatedAt: serverTimestamp() }, { merge: true });
          console.log('[flush] write ok (singleton)', { key, collectionName: `app/${item.collectionName}` });
        }
      } catch (e) {
        // retry with simple backoff
        setTimeout(() => {
          this.saveQueue.set(key, item);
          this.flushSaveQueue(key);
        }, Math.min(30000, this.DEBOUNCE_MS * 2));
        console.error('[flush] error', { key, error: String(e && e.message || e) });
      }
    }

    async setupRealtimeSync(uid) {
      this.uid = uid;
      // clear old listeners
      this.listeners.forEach(unsub => { try { unsub(); } catch {} });
      this.listeners.clear();

      const bindCollection = (name, idField = 'id') => {
        const collRef = collection(this.db, `users/${uid}/${name}`);
        const unsub = onSnapshot(collRef, (snapshot) => {
          const items = [];
          snapshot.forEach(d => items.push({ ...d.data(), [idField]: d.id }));
          // update state in place (preserve object identity)
          this.mergeArrayByIdInPlace(name, items);
          this.saveLocal();
          this.notifyUIUpdate(name);
          console.log('[snapshot]', { name, count: items.length });
        });
        this.listeners.set(name, unsub);
      };

      bindCollection('panels');
      bindCollection('tasks');
      bindCollection('events');
      bindCollection('organizer');

      // singleton: min stack
      const minRef = doc(this.db, `users/${uid}/app/minStack`);
      const unsubMin = onSnapshot(minRef, (snapshot) => {
        if (snapshot.exists()) {
          const data = snapshot.data();
          const arr = Array.isArray(data.value) ? data.value.map(v => String(v)) : [];
          if (!Array.isArray(this.state.panelMinStack)) this.state.panelMinStack = [];
          this.state.panelMinStack.splice(0, this.state.panelMinStack.length, ...arr);
          this.saveLocal();
          this.notifyUIUpdate('minStack');
          console.log('[snapshot]', { name: 'minStack', count: arr.length });
        }
      });
      this.listeners.set('minStack', unsubMin);

      // Flush queued saves when page unloads
      window.addEventListener('beforeunload', async (e) => {
        try { await this.flushAll(1500); } catch {}
      });

      // After establishing uid and listeners, flush any queued writes from pre-auth
      try { await this.flushAll(3000); } catch {}
    }

    // Merge incoming array of items into state[name] in place by id, preserving object identities
    mergeArrayByIdInPlace(name, incoming) {
      const target = Array.isArray(this.state[name]) ? this.state[name] : (this.state[name] = []);
      const byId = new Map(target.map(obj => [String(obj.id), obj]));
      const nextIds = new Set();
      // upsert
      for (const it of incoming) {
        const id = String(it.id);
        nextIds.add(id);
        if (byId.has(id)) {
          Object.assign(byId.get(id), it, { id });
        } else {
          target.push({ ...it, id });
        }
      }
      // remove stale
      for (let i = target.length - 1; i >= 0; i--) {
        const tid = String(target[i]?.id);
        if (!nextIds.has(tid)) target.splice(i, 1);
      }
    }

    async migrateFromV1() {
      if (!this.uid) return;
      try {
        const oldDoc = await getDoc(doc(this.db, `users/${this.uid}/snapshots/app`));
        if (!oldDoc.exists()) return;
        const old = oldDoc.data();
        // migrate panels
        if (Array.isArray(old.panels)) {
          for (const p of old.panels) {
            if (p?.type === 'external') {
              p.externalUrl = p.externalUrl || '';
              p.externalShowUrl = !!p.externalShowUrl;
              p.externalData = p.externalData || null;
            }
            await setDoc(doc(this.db, `users/${this.uid}/panels/${String(p.id)}`), { ...p, updatedAt: serverTimestamp() }, { merge: true });
          }
        }
        if (Array.isArray(old.tasks)) {
          for (const t of old.tasks) {
            await setDoc(doc(this.db, `users/${this.uid}/tasks/${String(t.id)}`), { ...t, updatedAt: serverTimestamp() }, { merge: true });
          }
        }
        if (Array.isArray(old.events)) {
          for (const ev of old.events) {
            await setDoc(doc(this.db, `users/${this.uid}/events/${String(ev.id)}`), { ...ev, updatedAt: serverTimestamp() }, { merge: true });
          }
        }
        // organizer items
        if (Array.isArray(old.organizer)) {
          for (const it of old.organizer) {
            await setDoc(doc(this.db, `users/${this.uid}/organizer/${String(it.id)}`), { ...it, updatedAt: serverTimestamp() }, { merge: true });
          }
        }
        // min stack singleton
        if (Array.isArray(old.panelMinStack)) {
          await setDoc(doc(this.db, `users/${this.uid}/app/minStack`), { value: old.panelMinStack, updatedAt: serverTimestamp() }, { merge: true });
        }
        await setDoc(doc(this.db, `users/${this.uid}/app/migration`), { v1_migrated: true, migrated_at: serverTimestamp(), old_client_ts: old.clientTs || null }, { merge: true });
      } catch (e) {
        // best-effort
      }
    }

    notifyUIUpdate(collection) {
      const evt = new CustomEvent('briizos-state-update', { detail: { collection, data: collection==='minStack' ? this.state.panelMinStack : this.state[collection] } });
      window.dispatchEvent(evt);
    }
    
    async flushAll(timeoutMs = 2000) {
      const keys = Array.from(this.saveQueue.keys());
      const ops = keys.map(k => this.flushSaveQueue(k));
      if (!ops.length) return;
      await Promise.race([
        Promise.allSettled(ops),
        new Promise(resolve => setTimeout(resolve, timeoutMs))
      ]);
    }
  }

  // Initialize persistence manager instance
  const persistence = new PersistenceManager(auth, db, state);
  window.briizPersistence = persistence;

  // React to realtime updates
  window.addEventListener('briizos-state-update', (event) => {
    const { collection, data } = event.detail || {};
    if (!collection) return;
    switch (collection) {
      case 'panels':
        if (window.panelManager) {
          overlayPendingIntoState();
          // Preserve array/object identity set on construction; just refresh UI
          window.panelManager.refreshFromState?.();
        }
        break;
      case 'tasks':
        if (window.taskManager) {
          window.taskManager.refreshFromState?.();
        }
        break;
      case 'minStack':
        if (window.panelManager) window.panelManager.minStack = Array.isArray(data) ? data.map(String) : [];
        break;
      case 'organizer':
        // Organizer UI refresh is driven by explicit actions; state is updated already.
        break;
    }
  });

  async function checkpoint(force=false){
    const now=Date.now(); if(!uid) return;
    if (!deprecSync || DEV_SAFE_MODE) return;
    if(!force && (!dirty || now-lastCheckpoint<60_000)) return;
    dirty=false; lastCheckpoint=now;
    try{
      const snap={ __ver:state.__ver,
        panels:state.panels,
        panelMinStack:state.panelMinStack,
        tasks:state.tasks,
        events:state.events,
        organizer:state.organizer,
        thoughtstream:state.thoughtstream,
        calendar:state.calendar,
        chatThreads:Object.fromEntries(Object.entries(state.chatThreads).map(([k,v])=>[k,{lastTs:v.messages?.at(-1)?.ts||0,count:v.messages?.length||0}])),
        stats:state.stats,
        updatedAt:serverTimestamp(),
        clientTs:now };
      await setDoc(doc(db,`users/${uid}/snapshots/app`), snap, { merge:true });
      // also write a history pointer (lightweight) to support remote archive browsing
      try { await setDoc(doc(db, `users/${uid}/snapshots/history/${now}`), { clientTs: now, __ver: state.__ver, updatedAt: serverTimestamp() }, { merge: true }); } catch {}
      state.clientTs = now;
      saveLocal();
      if(DEBUG) console.debug("checkpoint ok");
      cpBackoffMs = 2000; // reset backoff on success
    }catch(e){ if(DEBUG) console.debug("checkpoint error",e); dirty=true; }
    if (dirty) {
      try { setTimeout(()=>checkpoint(true), Math.min(cpBackoffMs, 60_000)); } catch {}
      cpBackoffMs = Math.min(cpBackoffMs * 2, 60_000);
    }
  }

  function startRealtime(uid){
    try{ if (subUnsub) { subUnsub(); subUnsub=null; } }catch{}
    const ref = doc(db,`users/${uid}/snapshots/app`);
    subUnsub = onSnapshot(ref, (snap)=>{
      if (!snap.exists()) return;
      const remote = snap.data();
      const remoteClientTs = remote.clientTs||0;
      const localClientTs = state.clientTs||0;
      const remoteIsNewer = remoteClientTs > localClientTs;
      const shouldApply = cloudFirst ? remoteIsNewer : (remoteClientTs >= localClientTs);
      if (shouldApply) {
        if (cloudFirst) {
          // Remote wins: assign structures directly
          state.panels = Array.isArray(remote.panels) ? remote.panels : Object.values(remote.panels||{});
          state.panelMinStack = Array.isArray(remote.panelMinStack) ? [...remote.panelMinStack] : [];
          state.tasks = Array.isArray(remote.tasks) ? remote.tasks : [];
          state.events = Array.isArray(remote.events) ? remote.events : [];
          state.organizer = Array.isArray(remote.organizer) ? remote.organizer : Object.values(remote.organizer||{});
        } else {
          const remoteOrganizer = Array.isArray(remote.organizer) ? remote.organizer : Object.values(remote.organizer || {});
          const mergedOrganizer = mergeById(state.organizer || [], remoteOrganizer);
          const mergedTasks = mergeById(state.tasks || [], Array.isArray(remote.tasks)?remote.tasks:[]);
          const mergedEvents = mergeById(state.events || [], Array.isArray(remote.events)?remote.events:[]);
          const mergedPanels = mergeById(state.panels || [], Array.isArray(remote.panels)?remote.panels:[]);
          state.panels.splice(0, state.panels.length, ...mergedPanels);
          state.panelMinStack.splice(0, state.panelMinStack.length, ...(remote.panelMinStack||[]));
          state.tasks.splice(0, state.tasks.length, ...mergedTasks);
          state.events.splice(0, state.events.length, ...mergedEvents);
          state.organizer.splice(0, state.organizer.length, ...mergedOrganizer);
        }
        state.thoughtstream = Array.isArray(remote.thoughtstream) ? remote.thoughtstream : [];
        state.calendar = remote.calendar || {};
        state.chatThreads = remote.chatThreads || {};
        state.stats = remote.stats || state.stats;
        state.clientTs = remoteClientTs;
        ensureModelTimestamps();
        saveLocal();
        if (panelManager) panelManager.refreshFromState?.();
        if (taskManager) taskManager.refreshFromState?.();
        if (calendarManager) calendarManager.refreshFromState?.();
      }
    }, (err)=>{ if(DEBUG) console.debug('realtime error', err); });
  }

onAuthStateChanged(auth, async user=>{
  uid = user?.uid || null;
  if (!uid) {
    // user logged out: cleanup listeners
    try { persistence.listeners.forEach(unsub => unsub()); } catch {}
    persistence.listeners.clear();
    persistence.uid = null;
    return;
  }

  // Best-effort: migrate old single-doc structure if needed
  try {
    const migRef = doc(db, `users/${uid}/app/migration`);
    const migSnap = await getDoc(migRef);
    if (!migSnap.exists() || !migSnap.data()?.v1_migrated) {
      await persistence.setupRealtimeSync(uid); // start listeners so UI doesn't stall
      await persistence.migrateFromV1();
    }
  } catch {}

  // Initialize managers if they don't exist
  if (!window.panelManager && window._initManagers) {
    window._initManagers();
  }

  // Start new realtime sync (subcollections)
  await persistence.setupRealtimeSync(uid);

  // Seed initial state into managers and render (preserve identity)
  if (window.panelManager) {
    window.panelManager.refreshFromState?.();
    window.taskManager?.refreshFromState?.();
    window.calendarManager?.refreshFromState?.();
  }
});

  function backupLocalState(){
    try {
      const key = `glOS.state.backup.${Date.now()}`;
      localStorage.setItem(key, JSON.stringify(state));
      localStorage.setItem('glOS.state.backup.last', key);
      // LRU prune: keep last 10 backups
      try {
        const keys = Object.keys(localStorage).filter(k => k.startsWith('glOS.state.backup.'));
        const sorted = keys
          .map(k => ({ k, ts: Number(k.split('.').pop()) || 0 }))
          .sort((a,b)=> b.ts - a.ts);
        const MAX = 10;
        if (sorted.length > MAX) {
          sorted.slice(MAX).forEach(({k})=>{ try { localStorage.removeItem(k); } catch {} });
        }
      } catch {}
    } catch {}
  }

  function bestTimestamp(obj){
    const keys = ['updatedAt','updated','completedAt','createdAt','created','timestamp'];
    for (const k of keys){ if (obj && obj[k] != null) return Number(obj[k]) || 0; }
    return 0;
  }
  function mergeById(localArr, remoteArr){
    const out = new Map();
    const add = (it, origin)=>{
      if(!it) return;
      const id = it.id || (`noid_${origin}_${Math.random().toString(36).slice(2,7)}`);
      const prev = out.get(id);
      if (!prev) { out.set(id, it); return; }
      const lu = bestTimestamp(prev);
      const ru = bestTimestamp(it);
      // Prefer the item with the more recent timestamp; on tie, keep existing (favor local insertion order)
      out.set(id, ru > lu ? it : prev);
    };
    (Array.isArray(localArr)?localArr:[]).forEach(it=>add(it,'local'));
    (Array.isArray(remoteArr)?remoteArr:[]).forEach(it=>add(it,'remote'));
    return Array.from(out.values());
  }

  async function initialHydrate(){
    try{
      const ref=doc(db,`users/${auth.currentUser.uid}/snapshots/app`), snap=await getDoc(ref);
      if(snap.exists()){
        const remote=snap.data();
        const remoteClientTs = remote.clientTs||0;
        const localClientTs = state.clientTs||0;
        if(!localClientTs || remoteClientTs > localClientTs){
          // Backup current local state before applying remote
          backupLocalState();

          // Merge critical arrays to avoid losing local-only items
          const remoteOrganizer = Array.isArray(remote.organizer) ? remote.organizer : Object.values(remote.organizer || {});
          const remoteTasks = Array.isArray(remote.tasks) ? remote.tasks : [];
          const remoteEvents = Array.isArray(remote.events) ? remote.events : [];
          const remotePanels = Array.isArray(remote.panels) ? remote.panels : [];
          if (cloudFirst) {
            state.panels = remotePanels;
            state.panelMinStack = Array.isArray(remote.panelMinStack) ? [...remote.panelMinStack] : [];
            state.tasks = remoteTasks;
            state.events = remoteEvents;
            state.organizer = remoteOrganizer;
          } else {
            const mergedOrganizer = mergeById(state.organizer || [], remoteOrganizer);
            const mergedTasks = mergeById(state.tasks || [], remoteTasks);
            const mergedEvents = mergeById(state.events || [], remoteEvents);
            const mergedPanels = mergeById(state.panels || [], remotePanels);
            state.panels.splice(0, state.panels.length, ...mergedPanels);
            state.panelMinStack.splice(0, state.panelMinStack.length, ...(remote.panelMinStack||[]));
            state.tasks.splice(0, state.tasks.length, ...mergedTasks);
            state.events.splice(0, state.events.length, ...mergedEvents);
            state.organizer.splice(0, state.organizer.length, ...mergedOrganizer);
          }
          state.thoughtstream = Array.isArray(remote.thoughtstream) ? remote.thoughtstream : [];
          state.calendar = remote.calendar || {};
          state.chatThreads = remote.chatThreads || {};
          state.stats = remote.stats || state.stats;
          state.clientTs = remoteClientTs || state.clientTs;
          // Backfill any missing timestamps after merge
          ensureModelTimestamps();
          saveLocal();
          if (panelManager) panelManager.refreshFromState?.();
          if (taskManager) taskManager.refreshFromState?.();
          if (calendarManager) calendarManager.refreshFromState?.();
        }
      }
    }catch(e){ if(DEBUG) console.debug("hydrate failed",e); }
  }

  setInterval(()=>checkpoint(false), 15_000);
  document.addEventListener("visibilitychange", ()=>{ if(document.visibilityState==="hidden") checkpoint(true); });
  window.addEventListener("beforeunload", ()=>{ checkpoint(true); });

  window.glosCheckpointNow=()=>checkpoint(true);
  window.glosDebug={ get state(){ return state; } };

  // === SAFE SANDBOX SWITCHES ===
  const DEV_SAFE_MODE = false;   // true = no Firebase reads/writes, no external API calls
  const deprecSync  = false;   // disable legacy single-doc sync; using subcollections
  const archiveEnabled = true; // feature flag for Archive overlay

  // Global State

  let currentUser = null;
  let thoughtStreamActive = false;
  let autoSyncInterval = null;

  // Enhanced Panel Management System (keeping original glOS functionality)
  class PanelManager {
    constructor() {
      this.panels = state.panels;
      this.panelIdCounter = this.panels.reduce((max, panel) => Math.max(max, Number(panel?.id) || 0), 0);
      // Restore base color background if custom color exists
      try {
        const id = String(this.editingPanel.dataset.panelId);
        const panel = this.panels.find(p => String(p.id) === id);
        if (panel && panel.customColor) {
          this.applyPanelColor(this.editingPanel, panel);
        }
      } catch {}

      this.editingPanel = null;
      this.currentWorld = 'all';
      this.minStack = Array.isArray(state.panelMinStack) ? state.panelMinStack.map(v => String(v)) : (state.panelMinStack = []);
      // Ensure state panelMinStack is string-normalized
      if (Array.isArray(state.panelMinStack)) {
        state.panelMinStack.splice(0, state.panelMinStack.length, ...this.minStack);
      }
      this._isDraggingAny = false;
      this.init();
    }

    init() {
      this.renderPanels();
      this.setupEventListeners();
    }

    // Wrapper for tools/SDK: create a panel and return it
    async createPanel(type, title = '', options = { source: 'api' }) {
      // Delegate to existing implementation
      const created = await this.createNewPanel(type, title, options);
      // createNewPanel mutates state; ensure we can return the panel object
      try {
        const panel = this.panels.find(p => (p.title || '') === (title || '') && p.type === type) || null;
        return panel || null;
      } catch {
        return null;
      }
    }

    refreshFromState() {
      if (this._isDraggingAny) return;
      this.panelIdCounter = this.panels.reduce((max, panel) => Math.max(max, panel?.id || 0), 0);
      this.renderPanels();       
    }

    setupEventListeners() {
      document.getElementById('addPanelBtn').addEventListener('click', (e) => {
        e.preventDefault();
        openOrganizer();
      });

      document.getElementById('quick-notes-btn').addEventListener('click', () => {
        this.createNewPanel('note');
      });

      document.getElementById('timer-btn').addEventListener('click', () => {
        try { window.timerApp?.show?.(); } catch {}
      });

      // AI chat button now handled by fixed chat initialization
      // document.getElementById('ai-chat-btn').addEventListener('click', () => {
      //   this.createNewPanel('chat');
      // });

      // Click outside to exit edit mode
      document.addEventListener('click', (e) => {
        if (this.editingPanel && !e.target.closest('.dynamic-panel') && !e.target.closest('.title-input')) {
          this.exitEditMode();
        }
      });

const container = document.getElementById('planetContainer');
const modes = ['all', 'school', 'music', 'life'];
let currentIndex = 0;

container.addEventListener('click', () => {
