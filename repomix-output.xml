  <script>
    // ------------------------------------------------------------
    // Theme DNA Architect Pro+ - semantic inference + live retheme
    // ------------------------------------------------------------

    const DEFAULT_SELECTORS = {
      text: 'body, p, li, h1, h2, h3, h4, h5, h6, label, .text, .copy',
      panel: '.card, .panel, .surface, .modal, .dialog',
      button: 'button, .btn, .button, [type="button"], [type="submit"]',
      input: 'input, textarea, select',
      frame: 'iframe, .frame, .embed'
    };

    const DEFAULTS = {
      bg: '#0f1118',
      surface: '#171a24',
      text: '#e3e9ff',
      muted: '#8a94b5',
      border: '#374159',
      accent: '#7aa2f7',
      inputBg: '#121621',
      frameBg: '#0d1017'
    };

    const TOKEN_DEFS = [
      { key: 'bg',          label: 'App background' },
      { key: 'surface',     label: 'Panel / surface' },
      { key: 'text',        label: 'Primary text' },
      { key: 'muted',       label: 'Muted text' },
      { key: 'border',      label: 'Border / divider' },
      { key: 'accent',      label: 'Accent / primary' },
      { key: 'btnBg',       label: 'Button background' },
      { key: 'btnText',     label: 'Button text' },
      { key: 'inputBg',     label: 'Input background' },
      { key: 'inputBorder', label: 'Input border' },
      { key: 'frameBg',     label: 'Frame / iframe bg' },
      { key: 'frameBorder', label: 'Frame / iframe border' }
    ];

    const TOKEN_RULES = {
      bg: {
        exact: ['--bg', '--background', '--app-bg', '--root-bg'],
        prefer: ['bg', 'background', 'app', 'root', 'canvas', 'base'],
        avoid: ['panel', 'surface', 'card', 'modal', 'btn', 'button', 'input', 'field', 'frame', 'iframe', 'text', 'accent', 'primary', 'border'],
        modality: ['panel'],
        role: ['bg']
      },
      surface: {
        exact: ['--surface', '--surface-bg', '--panel-bg', '--card-bg'],
        prefer: ['surface', 'panel', 'card', 'modal', 'sheet', 'layer', 'bg'],
        avoid: ['btn', 'button', 'input', 'field', 'frame', 'iframe', 'text', 'accent'],
        modality: ['panel'],
        role: ['bg']
      },
      text: {
        exact: ['--text', '--fg', '--foreground'],
        prefer: ['text', 'fg', 'foreground', 'copy', 'content', 'heading', 'title', 'label'],
        avoid: ['muted', 'secondary', 'subtle', 'dim', 'button', 'btn', 'primary', 'accent'],
        modality: ['text'],
        role: ['text']
      },
      muted: {
        exact: ['--muted', '--text-muted', '--text-secondary'],
        prefer: ['muted', 'secondary', 'subtle', 'dim', 'weak', 'quiet', 'disabled'],
        avoid: ['button', 'btn', 'border', 'bg', 'accent'],
        modality: ['text'],
        role: ['muted']
      },
      border: {
        exact: ['--border', '--divider'],
        prefer: ['border', 'divider', 'stroke', 'outline', 'line'],
        avoid: ['btn', 'button', 'input', 'field', 'frame', 'iframe', 'accent'],
        modality: ['panel'],
        role: ['border']
      },
      accent: {
        exact: ['--accent', '--primary', '--brand'],
        prefer: ['accent', 'primary', 'brand', 'link', 'interactive', 'focus', 'selected', 'highlight'],
        avoid: ['text', 'fg', 'foreground', 'border', 'muted'],
        modality: ['accent', 'button'],
        role: ['accent']
      },
      btnBg: {
        exact: ['--btn-bg', '--button-bg', '--primary-bg'],
        prefer: ['btn', 'button', 'cta', 'action', 'primary', 'accent'],
        avoid: ['text', 'fg', 'foreground', 'border', 'input', 'field', 'frame'],
        modality: ['button', 'accent'],
        role: ['bg', 'accent']
      },
      btnText: {
        exact: ['--btn-text', '--button-text', '--on-primary', '--on-accent', '--primary-foreground'],
        prefer: ['btn-text', 'button-text', 'on-primary', 'on-accent', 'foreground', 'contrast'],
        avoid: ['bg', 'background', 'border', 'input', 'field'],
        modality: ['button', 'text'],
        role: ['text']
      },
      inputBg: {
        exact: ['--input-bg', '--field-bg', '--control-bg'],
        prefer: ['input', 'field', 'control', 'form', 'select', 'textarea', 'surface', 'bg'],
        avoid: ['text', 'fg', 'foreground', 'button', 'btn', 'frame'],
        modality: ['input', 'panel'],
        role: ['bg']
      },
      inputBorder: {
        exact: ['--input-border', '--field-border', '--control-border'],
        prefer: ['input', 'field', 'control', 'form', 'border', 'stroke', 'outline'],
        avoid: ['button', 'btn', 'frame', 'text'],
        modality: ['input', 'panel'],
        role: ['border']
      },
      frameBg: {
        exact: ['--frame-bg', '--iframe-bg', '--embed-bg'],
        prefer: ['frame', 'iframe', 'embed', 'media', 'panel', 'surface', 'bg'],
        avoid: ['text', 'fg', 'foreground', 'button', 'btn'],
        modality: ['frame', 'panel'],
        role: ['bg']
      },
      frameBorder: {
        exact: ['--frame-border', '--iframe-border', '--embed-border'],
        prefer: ['frame', 'iframe', 'embed', 'media', 'border', 'stroke', 'outline'],
        avoid: ['button', 'btn', 'text'],
        modality: ['frame', 'panel'],
        role: ['border']
      }
    };

    const dom = {
      input: document.getElementById('rawInput'),
      mappingGrid: document.getElementById('mappingGrid'),
      varSummary: document.getElementById('varSummary'),
      fontInput: document.getElementById('fontInput'),
      fontAutoLoad: document.getElementById('fontAutoLoad'),
      inspector: document.getElementById('inspector'),
      outputCSS: document.getElementById('outputCSS'),
      copyCSS: document.getElementById('copyCSS'),
      resetControls: document.getElementById('resetControls'),
      view: document.getElementById('view'),
      previewStage: document.getElementById('previewStage'),
      themeFrame: document.getElementById('themeFrame'),
      selectors: {
        text: document.getElementById('selText'),
        panel: document.getElementById('selPanel'),
        button: document.getElementById('selButton'),
        input: document.getElementById('selInput'),
        frame: document.getElementById('selFrame')
      },
      ranges: () => document.querySelectorAll('input[type="range"]')
    };

    const colorProbe = document.createElement('div');
    colorProbe.style.position = 'absolute';
    colorProbe.style.left = '-9999px';
    colorProbe.style.top = '-9999px';
    colorProbe.style.pointerEvents = 'none';
    colorProbe.style.opacity = '0';
    document.body.appendChild(colorProbe);

    const state = {
      model: emptyModel(),
      mappingOverrides: {},
      loadedFonts: new Set(),
      lastFrameDoc: '',
      frameRAF: 0
    };

    function emptyModel() {
      return {
        list: [],
        byName: {},
        autoMappings: {},
        count: { total: 0, color: 0, radius: 0, borderWidth: 0 }
      };
    }

    function clamp(n, min, max) {
      return Math.min(max, Math.max(min, n));
    }

    function includesAny(str, arr) {
      return arr.some(part => str.includes(part));
    }

    function hasNonZeroMod(mod) {
      return !!mod && (mod.h || mod.s || mod.l);
    }

    function scaleMod(mod, factor) {
      return {
        h: Math.round((mod?.h || 0) * factor),
        s: Math.round((mod?.s || 0) * factor),
        l: Math.round((mod?.l || 0) * factor)
      };
    }

    function formatColor(r, g, b, a = 1) {
      const rr = Math.round(r);
      const gg = Math.round(g);
      const bb = Math.round(b);
      if (a < 1) {
        const alpha = Math.round(a * 1000) / 1000;
        return `rgba(${rr}, ${gg}, ${bb}, ${alpha})`;
      }
      return `rgb(${rr}, ${gg}, ${bb})`;
    }

    function extractVariables(cssText) {
      const regex = /(--[\w-]+)\s*:\s*([^;]+);/g;
      const vars = {};
      let match;
      while ((match = regex.exec(cssText)) !== null) {
        vars[match[1]] = match[2].trim();
      }
      return vars;
    }

    function resolveVarValue(value, vars, stack = []) {
      let out = String(value || '').trim();
      let safety = 0;

      while (out.includes('var(') && safety < 20) {
        out = out.replace(/var\(\s*(--[\w-]+)\s*(?:,\s*([^)]+))?\)/g, (_, name, fallback) => {
          if (stack.includes(name)) {
            return fallback ? fallback.trim() : `var(${name})`;
          }
          const replacement = vars[name] != null ? vars[name] : fallback;
          if (replacement == null) return `var(${name})`;
          return resolveVarValue(String(replacement).trim(), vars, [...stack, name]);
        });
        safety++;
      }

      return out.trim();
    }

    function parseColor(value) {
      if (!value || typeof value !== 'string') return null;
      const trimmed = value.trim();
      colorProbe.style.color = '';
      colorProbe.style.color = trimmed;
      if (!colorProbe.style.color) return null;

      const computed = getComputedStyle(colorProbe).color;
      const match = computed.match(/rgba?\(([^)]+)\)/i);
      if (!match) return null;

      const parts = match[1].split(',').map(p => p.trim());
      const r = parseFloat(parts[0]);
      const g = parseFloat(parts[1]);
      const b = parseFloat(parts[2]);
      const a = parts[3] != null ? parseFloat(parts[3]) : 1;

      if ([r, g, b].some(Number.isNaN)) return null;

      return { r, g, b, a, css: formatColor(r, g, b, a) };
    }

    function rgbToHsl(r, g, b) {
      r /= 255;
      g /= 255;
      b /= 255;

      const max = Math.max(r, g, b);
      const min = Math.min(r, g, b);
      let h = 0, s = 0;
      const l = (max + min) / 2;

      if (max !== min) {
        const d = max - min;
        s = l > 0.5 ? d / (2 - max - min) : d / (max + min);

        switch (max) {
          case r: h = (g - b) / d + (g < b ? 6 : 0); break;
          case g: h = (b - r) / d + 2; break;
          case b: h = (r - g) / d + 4; break;
        }

        h *= 60;
      }

      return [h, s * 100, l * 100];
    }

    function hslToRgb(h, s, l) {
      h = ((h % 360) + 360) % 360;
      s = clamp(s, 0, 100) / 100;
      l = clamp(l, 0, 100) / 100;

      const c = (1 - Math.abs(2 * l - 1)) * s;
      const x = c * (1 - Math.abs((h / 60) % 2 - 1));
      const m = l - c / 2;

      let r1 = 0, g1 = 0, b1 = 0;

      if (h < 60)      [r1, g1, b1] = [c, x, 0];
      else if (h < 120)[r1, g1, b1] = [x, c, 0];
      else if (h < 180)[r1, g1, b1] = [0, c, x];
      else if (h < 240)[r1, g1, b1] = [0, x, c];
      else if (h < 300)[r1, g1, b1] = [x, 0, c];
      else             [r1, g1, b1] = [c, 0, x];

      return [
        Math.round((r1 + m) * 255),
        Math.round((g1 + m) * 255),
        Math.round((b1 + m) * 255)
      ];
    }

    function adjustColor(value, mod = { h: 0, s: 0, l: 0 }) {
      const color = parseColor(value);
      if (!color) return value;

      let [h, s, l] = rgbToHsl(color.r, color.g, color.b);
      h = ((h + (mod.h || 0)) % 360 + 360) % 360;
      s = clamp(s + (mod.s || 0), 0, 100);
      l = clamp(l + (mod.l || 0), 0, 100);

      const [r, g, b] = hslToRgb(h, s, l);
      return formatColor(r, g, b, color.a);
    }

    function withAlpha(value, alpha) {
      const color = parseColor(value);
      if (!color) return value;
      return formatColor(color.r, color.g, color.b, clamp(alpha, 0, 1));
    }

    function relativeLuminance(value) {
      const color = parseColor(value);
      if (!color) return 0;

      const channel = (c) => {
        const v = c / 255;
        return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
      };

      return (
        0.2126 * channel(color.r) +
        0.7152 * channel(color.g) +
        0.0722 * channel(color.b)
      );
    }

    function isDarkColor(value) {
      return relativeLuminance(value) < 0.5;
    }

    function getContrastColor(value, dark = 'rgb(10, 12, 16)', light = 'rgb(248, 250, 255)') {
      return relativeLuminance(value) > 0.55 ? dark : light;
    }

    function deriveSurface(value) {
      return parseColor(value)
        ? adjustColor(value, { l: isDarkColor(value) ? 4 : -4, s: 0, h: 0 })
        : DEFAULTS.surface;
    }

    function deriveInputBg(value) {
      return parseColor(value)
        ? adjustColor(value, { l: isDarkColor(value) ? -4 : 4, s: 0, h: 0 })
        : DEFAULTS.inputBg;
    }

    function deriveFrameBg(value) {
      return parseColor(value)
        ? adjustColor(value, { l: isDarkColor(value) ? -2 : 2, s: 0, h: 0 })
        : DEFAULTS.frameBg;
    }

    function deriveMuted(value) {
      if (!parseColor(value)) return DEFAULTS.muted;
      return adjustColor(value, { s: -18, l: isDarkColor(value) ? -24 : 24 });
    }

    function deriveBorder(value) {
      if (!parseColor(value)) return DEFAULTS.border;
      return adjustColor(value, { s: -8, l: isDarkColor(value) ? 10 : -10 });
    }

    function isFontFamilyToken(lower) {
      if (/(font-size|font-weight|font-style|line-height|letter-spacing|tracking|leading)/.test(lower)) {
        return false;
      }
      return (
        /font-family|typeface|font-stack/.test(lower) ||
        /^--font$/.test(lower) ||
        /^--font-(sans|serif|mono|body|display)$/.test(lower)
      );
    }

    function computeImportance(lower) {
      let score = 0;
      if (/(primary|main|default|base|root)/.test(lower)) score += 4;
      if (/^--(bg|text|accent|border|surface)$/.test(lower)) score += 6;
      if (/^--[a-z-]{2,14}$/.test(lower)) score += 2;
      return score;
    }

    function inferVarMeta(name, resolved) {
      const lower = name.toLowerCase();
      const color = parseColor(resolved);

      let kind = 'other';
      if (color) {
        kind = 'color';
      } else if (/(^|[-_])(radius|rounded)([-_]|$)/.test(lower)) {
        kind = 'radius';
      } else if (/border.*width|stroke.*width|outline.*width|ring.*width/.test(lower)) {
        kind = 'borderWidth';
      } else if (isFontFamilyToken(lower)) {
        kind = 'font';
      }

      let modality = 'other';

      if (includesAny(lower, ['btn', 'button', 'cta'])) {
        modality = 'button';
      } else if (includesAny(lower, ['input', 'field', 'control', 'select', 'textarea', 'form'])) {
        modality = 'input';
      } else if (includesAny(lower, ['iframe', 'frame', 'embed', 'media'])) {
        modality = 'frame';
      } else if (includesAny(lower, ['accent', 'primary', 'brand', 'interactive', 'link', 'focus', 'selected', 'highlight'])) {
        modality = 'accent';
      } else if (includesAny(lower, ['text', 'fg', 'foreground', 'copy', 'content', 'heading', 'title', 'label'])) {
        modality = 'text';
      } else if (includesAny(lower, ['surface', 'panel', 'card', 'modal', 'sheet', 'layer', 'canvas', 'bg', 'background', 'border', 'divider', 'stroke', 'outline'])) {
        modality = 'panel';
      }

      let role = 'other';
      if (includesAny(lower, ['muted', 'secondary', 'subtle', 'dim', 'weak', 'quiet', 'disabled'])) {
        role = 'muted';
      } else if (includesAny(lower, ['border', 'divider', 'stroke', 'outline', 'line'])) {
        role = 'border';
      } else if (includesAny(lower, ['bg', 'background', 'surface', 'panel', 'card', 'canvas'])) {
        role = 'bg';
      } else if (includesAny(lower, ['text', 'fg', 'foreground', 'copy', 'content', 'heading', 'title', 'label'])) {
        role = 'text';
      } else if (includesAny(lower, ['accent', 'primary', 'brand', 'link', 'focus', 'highlight'])) {
        role = 'accent';
      }

      if (kind === 'font') modality = 'text';
      if (role === 'muted' && modality === 'other') modality = 'text';
      if (kind === 'radius' && modality === 'other' && (/-radius$/.test(lower) || /^--radius$/.test(lower))) modality = 'panel';
      if (kind === 'borderWidth' && modality === 'other') modality = 'panel';

      return {
        kind,
        modality,
        role,
        importance: computeImportance(lower),
        color
      };
    }

    function mapItemToSemanticToken(item) {
      if (item.kind !== 'color') return null;

      const lower = item.name.toLowerCase();
      const isButton = includesAny(lower, ['btn', 'button', 'cta']);
      const isInput  = includesAny(lower, ['input', 'field', 'control', 'select', 'textarea', 'form']);
      const isFrame  = includesAny(lower, ['iframe', 'frame', 'embed', 'media']);
      const isTextish = includesAny(lower, ['text', 'fg', 'foreground', 'copy', 'content', 'heading', 'title', 'label']);
      const isBorderish = includesAny(lower, ['border', 'divider', 'stroke', 'outline', 'line']);
      const isBgish = includesAny(lower, ['bg', 'background', 'surface', 'panel', 'card', 'modal', 'sheet', 'layer', 'canvas']);
      const isMuted = includesAny(lower, ['muted', 'secondary', 'subtle', 'dim', 'weak', 'quiet', 'disabled']);
      const isAccent = includesAny(lower, ['accent', 'primary', 'brand', 'interactive', 'link', 'focus', 'selected', 'highlight']);

      if (/on-primary|on-accent|primary-foreground|accent-foreground/.test(lower)) return 'btnText';
      if (isButton && isTextish) return 'btnText';
      if (isButton && (isBgish || isAccent)) return 'btnBg';

      if (isInput && isBorderish) return 'inputBorder';
      if (isInput && isBgish) return 'inputBg';

      if (isFrame && isBorderish) return 'frameBorder';
      if (isFrame && isBgish) return 'frameBg';

      if (isMuted && !isBgish && !isBorderish) return 'muted';
      if (isBorderish && !isButton && !isInput && !isFrame) return 'border';

      if (isAccent && isTextish) return 'btnText';
      if (isAccent && !isTextish && !isBorderish) return 'accent';

      if (isTextish && !isMuted && !isButton && !isAccent) return 'text';

      if (includesAny(lower, ['surface', 'panel', 'card', 'modal', 'sheet', 'layer']) && !isBorderish) return 'surface';
      if (/^--(bg|background)$/.test(lower)) return 'bg';
      if ((/bg|background|canvas/.test(lower)) && !isButton && !isInput && !isFrame && !isTextish && !isAccent) return 'bg';
      if (isBgish && item.modality === 'panel' && !isBorderish) return 'surface';

      return null;
    }

    function analyzeVariables(rawVars) {
      const list = [];
      const byName = {};

      for (const [name, raw] of Object.entries(rawVars)) {
        const resolved = resolveVarValue(raw, rawVars);
        const meta = inferVarMeta(name, resolved);
        const item = {
          name,
          raw,
          resolved,
          ...meta
        };
        item.semanticToken = mapItemToSemanticToken(item);
        list.push(item);
        byName[name] = item;
      }

      const freq = {};
      list.forEach(item => {
        const key = item.color ? item.color.css : item.resolved;
        freq[key] = (freq[key] || 0) + 1;
      });

      list.forEach(item => {
        const key = item.color ? item.color.css : item.resolved;
        item.frequency = freq[key] || 1;
      });

      const autoMappings = buildAutoMappings(list);

      return {
        list,
        byName,
        autoMappings,
        count: {
          total: list.length,
          color: list.filter(v => v.kind === 'color').length,
          radius: list.filter(v => v.kind === 'radius').length,
          borderWidth: list.filter(v => v.kind === 'borderWidth').length
        }
      };
    }

    function scoreCandidate(item, tokenKey) {
      if (item.kind !== 'color') return -Infinity;

      const lower = item.name.toLowerCase();
      const rule = TOKEN_RULES[tokenKey];
      if (!rule) return -Infinity;

      let score = 0;

      if (item.semanticToken === tokenKey) score += 40;

      (rule.exact || []).forEach(ex => {
        if (lower === ex || lower.endsWith(ex)) score += 55;
      });

      (rule.prefer || []).forEach(word => {
        if (lower.includes(word)) score += word.includes('-') ? 18 : 8;
      });

      (rule.avoid || []).forEach(word => {
        if (lower.includes(word)) score -= word.includes('-') ? 16 : 10;
      });

      if ((rule.modality || []).includes(item.modality)) score += 12;
      if ((rule.role || []).includes(item.role)) score += 10;

      score += item.importance || 0;
      if (item.frequency > 1) score += Math.min((item.frequency - 1) * 3, 9);

      return score;
    }

    function rankCandidates(list, tokenKey, excludeNames = []) {
      return list
        .map(item => ({ item, score: scoreCandidate(item, tokenKey) }))
        .filter(entry => entry.score > 0 && !excludeNames.includes(entry.item.name))
        .sort((a, b) => b.score - a.score);
    }

    function buildAutoMappings(list) {
      const mapping = {};

      const pick = (token, exclude = []) => {
        const ranked = rankCandidates(list, token, exclude);
        return ranked.length ? ranked[0].item.name : null;
      };

      mapping.bg = pick('bg');
      mapping.surface = pick('surface');
      mapping.text = pick('text');
      mapping.muted = pick('muted', [mapping.text].filter(Boolean));
      mapping.border = pick('border', [mapping.surface].filter(Boolean));
      mapping.accent = pick('accent');
      mapping.btnBg = pick('btnBg');
      mapping.btnText = pick('btnText', [mapping.btnBg].filter(Boolean));
      mapping.inputBg = pick('inputBg');
      mapping.inputBorder = pick('inputBorder', [mapping.inputBg].filter(Boolean));
      mapping.frameBg = pick('frameBg');
      mapping.frameBorder = pick('frameBorder', [mapping.frameBg].filter(Boolean));

      return mapping;
    }

    function cleanupOverrides() {
      for (const key of Object.keys(state.mappingOverrides)) {
        const varName = state.mappingOverrides[key];
        if (varName && !state.model.byName[varName]) {
          delete state.mappingOverrides[key];
        }
      }
    }

    function createBadge(text, className = 'tone-other') {
      const span = document.createElement('span');
      span.className = `badge ${className}`;
      span.textContent = text;
      return span;
    }

    function rebuildMappingGrid() {
      const vars = state.model.list
        .filter(item => item.kind === 'color')
        .sort((a, b) => a.name.localeCompare(b.name));

      dom.mappingGrid.innerHTML = '';

      TOKEN_DEFS.forEach(def => {
        const row = document.createElement('div');
        row.className = 'mapping-row';

        const left = document.createElement('div');

        const label = document.createElement('div');
        label.className = 'mapping-label';
        label.textContent = def.label;

        const select = document.createElement('select');
        select.dataset.token = def.key;

        const autoOption = document.createElement('option');
        autoOption.value = 'auto';
        autoOption.textContent = state.model.autoMappings[def.key]
          ? `Auto — ${state.model.autoMappings[def.key]}`
          : 'Auto — fallback chain';
        select.appendChild(autoOption);

        vars.forEach(item => {
          const opt = document.createElement('option');
          opt.value = item.name;
          opt.textContent = `${item.name} · ${item.modality}`;
          select.appendChild(opt);
        });

        const current = state.mappingOverrides[def.key] && state.model.byName[state.mappingOverrides[def.key]]
          ? state.mappingOverrides[def.key]
          : 'auto';
        select.value = current;

        select.addEventListener('change', () => {
          if (select.value === 'auto') delete state.mappingOverrides[def.key];
          else state.mappingOverrides[def.key] = select.value;
          recomputeTheme();
        });

        const source = document.createElement('div');
        source.className = 'mapping-source';
        source.dataset.sourceFor = def.key;

        left.append(label, select, source);

        const swatch = document.createElement('div');
        swatch.className = 'swatch';
        swatch.dataset.token = def.key;

        row.append(left, swatch);
        dom.mappingGrid.appendChild(row);
      });
    }

    function rebuildInspector() {
      const modalityOrder = {
        panel: 0,
        text: 1,
        accent: 2,
        button: 3,
        input: 4,
        frame: 5,
        other: 6
      };

      const items = [...state.model.list].sort((a, b) => {
        return (modalityOrder[a.modality] ?? 99) - (modalityOrder[b.modality] ?? 99)
          || a.name.localeCompare(b.name);
      });

      dom.inspector.innerHTML = '';

      if (!items.length) {
        const empty = document.createElement('div');
        empty.className = 'empty-note';
        empty.textContent = 'No CSS variables detected in the source block.';
        dom.inspector.appendChild(empty);
        return;
      }

      items.forEach(item => {
        const row = document.createElement('div');
        row.className = 'inspector-item';

        const chip = document.createElement('div');
        chip.className = 'inspector-chip';
        chip.style.background = item.color ? item.color.css : '#0f1116';

        const main = document.createElement('div');
        main.className = 'inspector-main';

        const top = document.createElement('div');
        top.className = 'inspector-top';

        const name = document.createElement('span');
        name.className = 'inspector-name';
        name.textContent = item.name;
        top.appendChild(name);

        top.appendChild(createBadge(item.modality, `tone-${item.modality || 'other'}`));
        top.appendChild(createBadge(item.kind, 'tone-kind'));
        top.appendChild(createBadge(item.semanticToken || item.role || 'other', 'tone-sem'));

        if (item.frequency > 1) {
          top.appendChild(createBadge(`x${item.frequency}`, 'tone-other'));
        }

        const value = document.createElement('div');
        value.className = 'inspector-value';
        value.textContent = item.raw === item.resolved ? item.raw : `${item.raw} → ${item.resolved}`;

        main.append(top, value);
        row.append(chip, main);
        dom.inspector.appendChild(row);
      });
    }

    function updateSummary() {
      const c = state.model.count;
      dom.varSummary.textContent = `${c.total} vars · ${c.color} colors · ${c.radius} radius · ${c.borderWidth} widths`;
    }

    function updateRangeDisplays() {
      dom.ranges().forEach(range => {
        const unit = range.dataset.unit || '';
        const span = range.nextElementSibling;
        if (span && span.classList.contains('val')) {
          span.textContent = `${range.value}${unit}`;
        }
      });
    }

    function collectControls() {
      updateRangeDisplays();

      const mods = {
        text:   { h: 0, s: 0, l: 0 },
        accent: { h: 0, s: 0, l: 0 },
        panel:  { h: 0, s: 0, l: 0 },
        button: { h: 0, s: 0, l: 0 },
        input:  { h: 0, s: 0, l: 0 },
        frame:  { h: 0, s: 0, l: 0 }
      };

      const struct = {
        panelRadius: 16,
        panelBorderWidth: 1,
        buttonRadius: 9,
        buttonBorderWidth: 1,
        inputRadius: 10,
        inputBorderWidth: 1,
        frameRadius: 14,
        frameBorderWidth: 2
      };

      dom.ranges().forEach(range => {
        const v = parseInt(range.value, 10) || 0;

        if (range.dataset.group) {
          mods[range.dataset.group][range.dataset.prop] = v;
        }

        if (range.dataset.struct) {
          struct[range.dataset.struct] = v;
        }
      });

      return {
        mods,
        struct,
        fontFamily: dom.fontInput.value.trim() || 'system-ui',
        autoLoadFont: dom.fontAutoLoad.checked,
        selectors: {
          text: dom.selectors.text.value.trim(),
          panel: dom.selectors.panel.value.trim(),
          button: dom.selectors.button.value.trim(),
          input: dom.selectors.input.value.trim(),
          frame: dom.selectors.frame.value.trim()
        }
      };
    }

    function isManualMapping(tokenKey) {
      return !!(state.mappingOverrides[tokenKey] && state.model.byName[state.mappingOverrides[tokenKey]]);
    }

    function pickFirstColor(predicate) {
      const found = state.model.list.find(item => item.kind === 'color' && predicate(item));
      return found ? found.resolved : null;
    }

    function getResolvedMapping() {
      const mapping = {};
      TOKEN_DEFS.forEach(def => {
        const override = state.mappingOverrides[def.key];
        mapping[def.key] = override && state.model.byName[override]
          ? override
          : (state.model.autoMappings[def.key] || null);
      });
      return mapping;
    }

    function getBaseTokenValue(tokenKey, mapping, cache = {}) {
      if (cache[tokenKey] != null) return cache[tokenKey];

      const chosen = mapping[tokenKey];
      if (chosen && state.model.byName[chosen]) {
        cache[tokenKey] = state.model.byName[chosen].resolved;
        return cache[tokenKey];
      }

      let value = null;

      switch (tokenKey) {
        case 'bg':
          value =
            pickFirstColor(item => item.semanticToken === 'bg') ||
            pickFirstColor(item => item.modality === 'panel' && item.role === 'bg') ||
            pickFirstColor(item => item.modality === 'panel') ||
            DEFAULTS.bg;
          break;

        case 'surface':
          value =
            pickFirstColor(item => item.semanticToken === 'surface') ||
            deriveSurface(getBaseTokenValue('bg', mapping, cache));
          break;

        case 'text':
          value =
            pickFirstColor(item => item.semanticToken === 'text') ||
            pickFirstColor(item => item.modality === 'text' && item.role === 'text') ||
            getContrastColor(getBaseTokenValue('bg', mapping, cache));
          break;

        case 'muted':
          value =
            pickFirstColor(item => item.semanticToken === 'muted') ||
            pickFirstColor(item => item.modality === 'text' && item.role === 'muted') ||
            deriveMuted(getBaseTokenValue('text', mapping, cache));
          break;

        case 'border':
          value =
            pickFirstColor(item => item.semanticToken === 'border') ||
            pickFirstColor(item => item.modality === 'panel' && item.role === 'border') ||
            deriveBorder(getBaseTokenValue('surface', mapping, cache));
          break;

        case 'accent':
          value =
            pickFirstColor(item => item.semanticToken === 'accent') ||
            pickFirstColor(item => item.modality === 'accent') ||
            pickFirstColor(item => item.modality === 'button') ||
            DEFAULTS.accent;
          break;

        case 'btnBg':
          value =
            pickFirstColor(item => item.semanticToken === 'btnBg') ||
            pickFirstColor(item => item.modality === 'button' && item.role !== 'text') ||
            getBaseTokenValue('accent', mapping, cache);
          break;

        case 'btnText':
          value =
            pickFirstColor(item => item.semanticToken === 'btnText') ||
            pickFirstColor(item => item.modality === 'button' && item.role === 'text') ||
            getContrastColor(getBaseTokenValue('btnBg', mapping, cache));
          break;

        case 'inputBg':
          value =
            pickFirstColor(item => item.semanticToken === 'inputBg') ||
            pickFirstColor(item => item.modality === 'input' && item.role === 'bg') ||
            deriveInputBg(getBaseTokenValue('surface', mapping, cache));
          break;

        case 'inputBorder':
          value =
            pickFirstColor(item => item.semanticToken === 'inputBorder') ||
            pickFirstColor(item => item.modality === 'input' && item.role === 'border') ||
            getBaseTokenValue('border', mapping, cache);
          break;

        case 'frameBg':
          value =
            pickFirstColor(item => item.semanticToken === 'frameBg') ||
            pickFirstColor(item => item.modality === 'frame' && item.role === 'bg') ||
            deriveFrameBg(getBaseTokenValue('surface', mapping, cache));
          break;

        case 'frameBorder':
          value =
            pickFirstColor(item => item.semanticToken === 'frameBorder') ||
            pickFirstColor(item => item.modality === 'frame' && item.role === 'border') ||
            getBaseTokenValue('border', mapping, cache);
          break;

        default:
          value = null;
      }

      cache[tokenKey] = value;
      return value;
    }

    function buildTheme(controls) {
      const mapping = getResolvedMapping();
      const cache = {};
      const base = {};

      TOKEN_DEFS.forEach(def => {
        base[def.key] = getBaseTokenValue(def.key, mapping, cache);
      });

      const tokens = {};

      tokens.bg = parseColor(base.bg)
        ? adjustColor(base.bg, scaleMod(controls.mods.panel, 0.45))
        : base.bg;

      const useExplicitSurface =
        mapping.surface &&
        (isManualMapping('surface') || mapping.surface !== mapping.bg);

      const surfaceSeed = useExplicitSurface
        ? base.surface
        : deriveSurface(base.bg);

      tokens.surface = parseColor(surfaceSeed)
        ? adjustColor(surfaceSeed, controls.mods.panel)
        : surfaceSeed;

      tokens.text = parseColor(base.text)
        ? adjustColor(base.text, controls.mods.text)
        : base.text;

      const mutedSeed = (mapping.muted && (isManualMapping('muted') || mapping.muted !== mapping.text))
        ? base.muted
        : deriveMuted(tokens.text);

      tokens.muted = parseColor(mutedSeed)
        ? adjustColor(mutedSeed, {
            h: controls.mods.text.h,
            s: Math.round(controls.mods.text.s * 0.8),
            l: controls.mods.text.l - 6
          })
        : deriveMuted(tokens.text);

      const borderSeed = (mapping.border && (isManualMapping('border') || mapping.border !== mapping.surface))
        ? base.border
        : deriveBorder(tokens.surface);

      tokens.border = parseColor(borderSeed)
        ? adjustColor(borderSeed, {
            h: Math.round(controls.mods.panel.h * 0.25),
            s: Math.round(controls.mods.panel.s * 0.3),
            l: Math.round(controls.mods.panel.l * 0.5)
          })
        : deriveBorder(tokens.surface);

      tokens.accent = parseColor(base.accent)
        ? adjustColor(base.accent, controls.mods.accent)
        : base.accent;

      const btnSeed = mapping.btnBg ? base.btnBg : tokens.accent;
      tokens.btnBg = parseColor(btnSeed)
        ? adjustColor(btnSeed, controls.mods.button)
        : btnSeed;

      tokens.btnBorder = deriveBorder(tokens.btnBg);

      const btnTextSeed = mapping.btnText ? base.btnText : getContrastColor(tokens.btnBg);
      tokens.btnText = parseColor(btnTextSeed)
        ? adjustColor(btnTextSeed, controls.mods.text)
        : getContrastColor(tokens.btnBg);

      const useExplicitInputBg =
        mapping.inputBg &&
        (isManualMapping('inputBg') || mapping.inputBg !== mapping.surface);

      const inputBgSeed = useExplicitInputBg
        ? base.inputBg
        : deriveInputBg(tokens.surface);

      tokens.inputBg = parseColor(inputBgSeed)
        ? adjustColor(inputBgSeed, controls.mods.input)
        : inputBgSeed;

      const inputBorderSeed =
        mapping.inputBorder &&
        (isManualMapping('inputBorder') || mapping.inputBorder !== mapping.border)
          ? base.inputBorder
          : tokens.border;

      tokens.inputBorder = parseColor(inputBorderSeed)
        ? adjustColor(inputBorderSeed, controls.mods.input)
        : inputBorderSeed;

      const useExplicitFrameBg =
        mapping.frameBg &&
        (isManualMapping('frameBg') || mapping.frameBg !== mapping.surface);

      const frameBgSeed = useExplicitFrameBg
        ? base.frameBg
        : deriveFrameBg(tokens.surface);

      tokens.frameBg = parseColor(frameBgSeed)
        ? adjustColor(frameBgSeed, controls.mods.frame)
        : frameBgSeed;

      const frameBorderSeed =
        mapping.frameBorder &&
        (isManualMapping('frameBorder') || mapping.frameBorder !== mapping.border)
          ? base.frameBorder
          : tokens.border;

      tokens.frameBorder = parseColor(frameBorderSeed)
        ? adjustColor(frameBorderSeed, controls.mods.frame)
        : frameBorderSeed;

      tokens.accentSoft = withAlpha(tokens.accent, 0.16);
      tokens.link = tokens.accent;

      return { mapping, base, tokens };
    }

    function modifierForItem(item, mods) {
      const lower = item.name.toLowerCase();

      if (/(text|fg|foreground|copy|content|heading|title|label)/.test(lower)
        && !/(btn|button|on-primary|on-accent|primary-foreground|accent-foreground)/.test(lower)) {
        return mods.text;
      }

      if (item.modality === 'accent') return mods.accent;

      if (item.modality === 'button') {
        return /(text|fg|foreground|label)/.test(lower) ? mods.text : mods.button;
      }

      if (item.modality === 'input') {
        return /(text|fg|foreground|label)/.test(lower) ? mods.text : mods.input;
      }

      if (item.modality === 'frame') {
        return /(text|fg|foreground|label)/.test(lower) ? mods.text : mods.frame;
      }

      if (item.modality === 'panel') {
        if (item.role === 'border') {
          return {
            h: Math.round(mods.panel.h * 0.25),
            s: Math.round(mods.panel.s * 0.3),
            l: Math.round(mods.panel.l * 0.5)
          };
        }
        return mods.panel;
      }

      return null;
    }

    function structuralRadiusForItem(item, struct) {
      const lower = item.name.toLowerCase();
      if (item.kind !== 'radius') return null;

      if (/(btn|button|cta)/.test(lower)) return `${struct.buttonRadius}px`;
      if (/(input|field|control|select|textarea|form)/.test(lower)) return `${struct.inputRadius}px`;
      if (/(iframe|frame|embed|media)/.test(lower)) return `${struct.frameRadius}px`;

      if (
        /(panel|card|surface|modal|sheet|dialog|container)/.test(lower) ||
        /^--radius$/.test(lower) ||
        /-radius$/.test(lower)
      ) {
        return `${struct.panelRadius}px`;
      }

      return null;
    }

    function structuralBorderWidthForItem(item, struct) {
      const lower = item.name.toLowerCase();
      if (item.kind !== 'borderWidth') return null;

      if (/(btn|button|cta)/.test(lower)) return `${struct.buttonBorderWidth}px`;
      if (/(input|field|control|select|textarea|form)/.test(lower)) return `${struct.inputBorderWidth}px`;
      if (/(iframe|frame|embed|media)/.test(lower)) return `${struct.frameBorderWidth}px`;

      if (
        /^--(border-width|stroke-width|outline-width)$/.test(lower) ||
        /(panel|card|surface|modal|sheet|dialog)/.test(lower)
      ) {
        return `${struct.panelBorderWidth}px`;
      }

      return null;
    }

    function deriveRootVars(theme, controls) {
      const out = {};

      for (const item of state.model.list) {
        const semanticToken = mapItemToSemanticToken(item);

        if (semanticToken && theme.tokens[semanticToken] != null) {
          out[item.name] = theme.tokens[semanticToken];
          continue;
        }

        if (item.kind === 'font') {
          out[item.name] = controls.fontFamily;
          continue;
        }

        if (item.kind === 'radius') {
          out[item.name] = structuralRadiusForItem(item, controls.struct) || item.raw;
          continue;
        }

        if (item.kind === 'borderWidth') {
          out[item.name] = structuralBorderWidthForItem(item, controls.struct) || item.raw;
          continue;
        }

        if (item.kind === 'color') {
          const mod = modifierForItem(item, controls.mods);
          if (mod && hasNonZeroMod(mod)) {
            out[item.name] = adjustColor(item.resolved, mod);
          } else {
            out[item.name] = item.raw.includes('var(') ? item.raw : item.resolved;
          }
          continue;
        }

        out[item.name] = item.raw;
      }

      return out;
    }

    function emitRule(selector, lines) {
      const clean = (selector || '').trim();
      if (!clean) return '';
      return `${clean} {\n${lines.map(line => `  ${line}`).join('\n')}\n}`;
    }

    function generateOutputCSS(theme, controls, derivedVars) {
      const lines = [];

      lines.push(':root {');

      if (state.model.list.length) {
        lines.push('  /* Original variable set, rethemed heuristically */');
        state.model.list.forEach(item => {
          lines.push(`  ${item.name}: ${derivedVars[item.name]};`);
        });
        lines.push('');
      }

      lines.push('  /* Semantic DNA aliases used by the modality patch below */');
      lines.push(`  --dna-font-family: ${controls.fontFamily};`);
      lines.push(`  --dna-bg: ${theme.tokens.bg};`);
      lines.push(`  --dna-surface: ${theme.tokens.surface};`);
      lines.push(`  --dna-text: ${theme.tokens.text};`);
      lines.push(`  --dna-muted: ${theme.tokens.muted};`);
      lines.push(`  --dna-border: ${theme.tokens.border};`);
      lines.push(`  --dna-accent: ${theme.tokens.accent};`);
      lines.push(`  --dna-accent-soft: ${theme.tokens.accentSoft};`);
      lines.push(`  --dna-btn-bg: ${theme.tokens.btnBg};`);
      lines.push(`  --dna-btn-text: ${theme.tokens.btnText};`);
      lines.push(`  --dna-btn-border: ${theme.tokens.btnBorder};`);
      lines.push(`  --dna-input-bg: ${theme.tokens.inputBg};`);
      lines.push(`  --dna-input-border: ${theme.tokens.inputBorder};`);
      lines.push(`  --dna-frame-bg: ${theme.tokens.frameBg};`);
      lines.push(`  --dna-frame-border: ${theme.tokens.frameBorder};`);
      lines.push(`  --dna-panel-radius: ${controls.struct.panelRadius}px;`);
      lines.push(`  --dna-panel-border-width: ${controls.struct.panelBorderWidth}px;`);
      lines.push(`  --dna-button-radius: ${controls.struct.buttonRadius}px;`);
      lines.push(`  --dna-button-border-width: ${controls.struct.buttonBorderWidth}px;`);
      lines.push(`  --dna-input-radius: ${controls.struct.inputRadius}px;`);
      lines.push(`  --dna-input-border-width: ${controls.struct.inputBorderWidth}px;`);
      lines.push(`  --dna-frame-radius: ${controls.struct.frameRadius}px;`);
      lines.push(`  --dna-frame-border-width: ${controls.struct.frameBorderWidth}px;`);
      lines.push('}');
      lines.push('');

      lines.push('/* Smart mapping used for preview + semantic aliases */');
      TOKEN_DEFS.forEach(def => {
        lines.push(`/* ${def.label}: ${theme.mapping[def.key] || 'fallback'} */`);
      });
      lines.push('');

      lines.push(emitRule('html, body', [
        'background: var(--dna-bg);',
        'color: var(--dna-text);',
        'font-family: var(--dna-font-family);'
      ]));
      lines.push('');

      lines.push(emitRule(controls.selectors.text, [
        'color: var(--dna-text);',
        'font-family: var(--dna-font-family);'
      ]));
      lines.push('');

      lines.push(emitRule('a, .link', [
        'color: var(--dna-accent);'
      ]));
      lines.push('');

      lines.push(emitRule(controls.selectors.panel, [
        'background: var(--dna-surface);',
        'color: var(--dna-text);',
        'border: var(--dna-panel-border-width) solid var(--dna-border);',
        'border-radius: var(--dna-panel-radius);'
      ]));
      lines.push('');

      lines.push(emitRule(controls.selectors.button, [
        'background: var(--dna-btn-bg);',
        'color: var(--dna-btn-text);',
        'border: var(--dna-button-border-width) solid var(--dna-btn-border);',
        'border-radius: var(--dna-button-radius);',
        'font-family: var(--dna-font-family);'
      ]));
      lines.push('');

      lines.push(emitRule(controls.selectors.input, [
        'background: var(--dna-input-bg);',
        'color: var(--dna-text);',
        'border: var(--dna-input-border-width) solid var(--dna-input-border);',
        'border-radius: var(--dna-input-radius);',
        'font-family: var(--dna-font-family);'
      ]));
      lines.push('');

      lines.push(emitRule(controls.selectors.frame, [
        'background: var(--dna-frame-bg);',
        'border: var(--dna-frame-border-width) solid var(--dna-frame-border);',
        'border-radius: var(--dna-frame-radius);',
        'overflow: hidden;'
      ]));

      return lines.filter(Boolean).join('\n');
    }

    function primaryFamilyFromInput(fontValue) {
      const first = String(fontValue || '')
        .split(',')[0]
        .trim()
        .replace(/^['"]|['"]$/g, '');

      if (!first) return null;

      if (/^(system-ui|serif|sans-serif|monospace|cursive|fantasy|emoji|math|fangsong|ui-sans-serif|ui-serif|ui-monospace)$/i.test(first)) {
        return null;
      }

      if (/[()]/.test(first)) return null;
      return first;
    }

    function googleFontHref(fontValue) {
      const family = primaryFamilyFromInput(fontValue);
      if (!family) return '';
      return `https://fonts.googleapis.com/css2?family=${encodeURIComponent(family).replace(/%20/g, '+')}:wght@400;500;600;700&display=swap`;
    }

    function tryLoadWebFont(fontValue) {
      const href = googleFontHref(fontValue);
      if (!href || state.loadedFonts.has(href)) return;

      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = href;
      document.head.appendChild(link);

      state.loadedFonts.add(href);
    }

    function buildIframeDoc(theme, controls) {
      const fontHref = controls.autoLoadFont ? googleFontHref(controls.fontFamily) : '';

      return `<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
${fontHref ? `<link rel="stylesheet" href="${fontHref}">` : ''}
<style>
  :root {
    --bg: ${theme.tokens.bg};
    --surface: ${theme.tokens.surface};
    --text: ${theme.tokens.text};
    --muted: ${theme.tokens.muted};
    --border: ${theme.tokens.border};
    --accent: ${theme.tokens.accent};
    --accent-soft: ${theme.tokens.accentSoft};
    --btn-bg: ${theme.tokens.btnBg};
    --btn-text: ${theme.tokens.btnText};
    --btn-border: ${theme.tokens.btnBorder};
    --input-bg: ${theme.tokens.inputBg};
    --input-border: ${theme.tokens.inputBorder};
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    height: 100vh;
    padding: 14px;
    font-family: ${controls.fontFamily};
    background: var(--bg);
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .panel {
    width: 100%;
    background: var(--surface);
    color: var(--text);
    border: ${controls.struct.panelBorderWidth}px solid var(--border);
    border-radius: ${controls.struct.panelRadius}px;
    padding: 16px;
  }

  .tag {
    display: inline-flex;
    padding: 5px 8px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 700;
    background: var(--accent-soft);
    color: var(--accent);
    margin-bottom: 10px;
  }

  h4 {
    margin: 0 0 8px 0;
    font-size: 16px;
    line-height: 1.2;
  }

  p {
    margin: 0 0 12px 0;
    font-size: 12px;
    line-height: 1.55;
    color: var(--muted);
  }

  input {
    width: 100%;
    padding: 10px 12px;
    margin-bottom: 10px;
    border: ${controls.struct.inputBorderWidth}px solid var(--input-border);
    border-radius: ${controls.struct.inputRadius}px;
    background: var(--input-bg);
    color: var(--text);
    font-family: inherit;
    font-size: 12px;
  }

  button {
    padding: 10px 12px;
    border: ${controls.struct.buttonBorderWidth}px solid var(--btn-border);
    border-radius: ${controls.struct.buttonRadius}px;
    background: var(--btn-bg);
    color: var(--btn-text);
    font-family: inherit;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
  }
</style>
</head>
<body>
  <div class="panel">
    <div class="tag">iframe content</div>
    <h4>Embedded UI preview</h4>
    <p>
      The outer shell follows the frame/iframe controls,
      while the UI inside still follows panel, input, and button modalities.
    </p>
    <input placeholder="Field inside the iframe" />
    <button>Run Embedded Action</button>
  </div>
</body>
</html>`;
    }

    function updateIframePreview(theme, controls) {
      const doc = buildIframeDoc(theme, controls);
      if (doc === state.lastFrameDoc) return;

      state.lastFrameDoc = doc;
      cancelAnimationFrame(state.frameRAF);
      state.frameRAF = requestAnimationFrame(() => {
        dom.themeFrame.srcdoc = doc;
      });
    }

    function applyPreview(theme, controls) {
      const vars = {
        '--dna-font-family': controls.fontFamily,
        '--dna-bg': theme.tokens.bg,
        '--dna-surface': theme.tokens.surface,
        '--dna-text': theme.tokens.text,
        '--dna-muted': theme.tokens.muted,
        '--dna-border': theme.tokens.border,
        '--dna-accent': theme.tokens.accent,
        '--dna-accent-soft': theme.tokens.accentSoft,
        '--dna-btn-bg': theme.tokens.btnBg,
        '--dna-btn-text': theme.tokens.btnText,
        '--dna-btn-border': theme.tokens.btnBorder,
        '--dna-input-bg': theme.tokens.inputBg,
        '--dna-input-border': theme.tokens.inputBorder,
        '--dna-frame-bg': theme.tokens.frameBg,
        '--dna-frame-border': theme.tokens.frameBorder,
        '--dna-panel-radius': `${controls.struct.panelRadius}px`,
        '--dna-panel-border-width': `${controls.struct.panelBorderWidth}px`,
        '--dna-button-radius': `${controls.struct.buttonRadius}px`,
        '--dna-button-border-width': `${controls.struct.buttonBorderWidth}px`,
        '--dna-input-radius': `${controls.struct.inputRadius}px`,
        '--dna-input-border-width': `${controls.struct.inputBorderWidth}px`,
        '--dna-frame-radius': `${controls.struct.frameRadius}px`,
        '--dna-frame-border-width': `${controls.struct.frameBorderWidth}px`
      };

      Object.entries(vars).forEach(([name, value]) => {
        dom.previewStage.style.setProperty(name, value);
      });

      const bgTop = parseColor(theme.tokens.bg) ? adjustColor(theme.tokens.bg, { l: 4 }) : theme.tokens.bg;
      const dot = withAlpha(theme.tokens.accent, 0.12);
      dom.view.style.background =
        `radial-gradient(circle, ${dot} 1px, transparent 1px), linear-gradient(180deg, ${bgTop} 0%, ${theme.tokens.bg} 100%)`;
      dom.view.style.backgroundSize = '28px 28px, auto';

      updateIframePreview(theme, controls);
      updateMappingDisplay(theme);
    }

    function updateMappingDisplay(theme) {
      TOKEN_DEFS.forEach(def => {
        const source = dom.mappingGrid.querySelector(`[data-source-for="${def.key}"]`);
        const swatch = dom.mappingGrid.querySelector(`[data-token="${def.key}"]`);
        const manual = isManualMapping(def.key);

        if (source) {
          source.textContent = `${manual ? 'Manual' : 'Auto'} → ${theme.mapping[def.key] || 'fallback chain'}`;
        }

        if (swatch) {
          const value = theme.tokens[def.key];
          swatch.style.background = parseColor(value) ? value : '#111';
          swatch.title = `${def.label}: ${value}`;
        }
      });
    }

    async function copyText(text) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch (err) {
        try {
          dom.outputCSS.focus();
          dom.outputCSS.select();
          document.execCommand('copy');
          return true;
        } catch (fallbackErr) {
          return false;
        }
      }
    }

    function flashButton(button, label, ms = 1600) {
      const prev = button.textContent;
      button.textContent = label;
      setTimeout(() => {
        button.textContent = prev;
      }, ms);
    }

    function recomputeTheme() {
      const controls = collectControls();

      if (controls.autoLoadFont) {
        tryLoadWebFont(controls.fontFamily);
      }

      const theme = buildTheme(controls);
      const derivedVars = deriveRootVars(theme, controls);
      const css = generateOutputCSS(theme, controls, derivedVars);

      applyPreview(theme, controls);

      dom.outputCSS.value = css;
      window.currentGeneratedCSS = css;
      window.currentThemeModel = {
        controls,
        theme,
        derivedVars,
        model: state.model
      };
    }

    function parseSource() {
      const rawVars = extractVariables(dom.input.value);
      state.model = analyzeVariables(rawVars);
      cleanupOverrides();
      updateSummary();
      rebuildMappingGrid();
      rebuildInspector();
      recomputeTheme();
    }

    function resetControls() {
      dom.ranges().forEach(range => {
        range.value = range.defaultValue;
      });

      dom.fontInput.value = dom.fontInput.defaultValue;
      dom.fontAutoLoad.checked = dom.fontAutoLoad.defaultChecked;

      dom.selectors.text.value = DEFAULT_SELECTORS.text;
      dom.selectors.panel.value = DEFAULT_SELECTORS.panel;
      dom.selectors.button.value = DEFAULT_SELECTORS.button;
      dom.selectors.input.value = DEFAULT_SELECTORS.input;
      dom.selectors.frame.value = DEFAULT_SELECTORS.frame;

      state.mappingOverrides = {};
      rebuildMappingGrid();
      recomputeTheme();
    }

    // ------------------------
    // Event wiring
    // ------------------------

    let parseTimer = 0;

    dom.input.addEventListener('input', () => {
      clearTimeout(parseTimer);
      parseTimer = setTimeout(parseSource, 80);
    });

    dom.fontInput.addEventListener('input', recomputeTheme);
    dom.fontAutoLoad.addEventListener('change', recomputeTheme);

    dom.ranges().forEach(range => {
      range.addEventListener('input', recomputeTheme);
    });

    Object.values(dom.selectors).forEach(input => {
      input.addEventListener('input', recomputeTheme);
    });

    dom.copyCSS.addEventListener('click', async () => {
      const ok = await copyText(dom.outputCSS.value);
      flashButton(dom.copyCSS, ok ? 'Copied!' : 'Copy Failed');
    });

    dom.resetControls.addEventListener('click', () => {
      resetControls();
      flashButton(dom.resetControls, 'Reset');
    });

    // ------------------------
    // Init
    // ------------------------
    parseSource();
  </script>
</body>
</html>
</file>

<file path="src/lib/useTaskAutomation.js">
/**
 * useTaskAutomation Hook
 *
 * Listens for automated tasks and bridges them to LangGraph.
 * Follows the same pattern as useChat's remote chat listener.
 */

import { useEffect, useRef, useCallback } from 'react';
import { subscribeAutomatedTasks, getTask } from '../lib/firestore';
import { getCurrentUid } from '../lib/firebase';
import {
  evaluateTask,
  logBreakdownStart,
  saveBreakdownResult,
  logStepStart,
  logStepDone,
  completeStep,
  logVerificationStart,
  finalizeTask,
  flagVerificationIssue,
  logAutomationError,
  appendTaskLog,
} from '../lib/taskAutomation';
import logger from '../lib/logger';

const api = typeof window !== 'undefined' && window.api ? window.api : {};
const hasApi = typeof window !== 'undefined' && window.api;

export function useTaskAutomation() {
  const uid = getCurrentUid();
  const processingRef = useRef(new Set());
  // Keep one LangGraph thread per task so the agent retains context across steps
  const threadMapRef = useRef(new Map());

  // Get or create a LangGraph thread for a given task
  const getThreadForTask = useCallback(async (taskId) => {
    if (!hasApi) throw new Error('Electron API not available');

    const existing = threadMapRef.current.get(taskId);
    if (existing) return existing;

    const threadResult = await api.langgraphCreateThread();
    const threadId = threadResult?.thread_id || threadResult?.threadId || threadResult;
    if (!threadId) throw new Error('Failed to create LangGraph thread');

    threadMapRef.current.set(taskId, threadId);
    logger.debug('task-automation', 'Created thread ' + threadId + ' for task ' + taskId);
    return threadId;
  }, []);

  // Send a message to LangGraph and get a synchronous response
  const sendToAgent = useCallback(async (taskId, message) => {
    const threadId = await getThreadForTask(taskId);

    // Use the globally selected model from the InteractionPanel picker
    const model = localStorage.getItem('briizos-selected-model') || undefined;

    const result = await api.langgraphSendMessage(threadId, message, {
      // Automation runs headlessly — agent must not wait for user confirmation
      tool_confirmation_mode: 'no-asking',
      model,
    });
    return result;
  }, [getThreadForTask]);

  // Process an automated task through the decision tree.
  // Loops internally so that step→step→verify chains complete in a single
  // invocation rather than relying on Firestore re-fires between steps.
  const processTask = useCallback(async (task) => {
    if (processingRef.current.has(task.id)) return;
    processingRef.current.add(task.id);

    try {
      let decision = await evaluateTask(task);

      // Loop: each iteration handles one action, then gets the next from
      // completeStep/evaluateTask. Exits on completion, error, or waiting.
      while (decision) {
        switch (decision.action) {
          case 'breakdown': {
            await logBreakdownStart(task.id);

            const prompt = buildBreakdownPrompt(task.title, null);
            const aiResponse = await sendToAgent(task.id, prompt);
            const parsed = parseBreakdownResponse(aiResponse);

            const breakdownResult = await saveBreakdownResult(task.id, parsed);
            if (breakdownResult.action === 'waiting' || breakdownResult.action === 'error') {
              decision = null; // Stop — waiting for user or hit an error
            } else {
              // Breakdown created steps; re-evaluate to start resuming
              const freshTask = await getTask(task.id);
              decision = freshTask ? await evaluateTask(freshTask) : null;
            }
            break;
          }

          case 'resume': {
            await logStepStart(task.id, decision.step.title, decision.stepIndex, decision.totalSteps);

            const prompt = buildStepPrompt(
              task.title,
              decision.step.title,
              decision.stepIndex,
              decision.totalSteps,
              task.taskLog
            );
            const aiResponse = await sendToAgent(task.id, prompt);
            const summary = extractText(aiResponse);

            // completeStep marks the action done and returns the next decision
            decision = await completeStep(task.id, decision.step.id, summary);
            break;
          }

          case 'verify': {
            await logVerificationStart(task.id);

            const freshTask = await getTask(task.id);
            const prompt = buildVerifyPrompt(task.title, freshTask?.taskLog || task.taskLog);
            const aiResponse = await sendToAgent(task.id, prompt);
            const result = parseVerifyResponse(aiResponse);

            if (result.complete) {
              threadMapRef.current.delete(task.id);
              await finalizeTask(task.id);
            } else {
              await flagVerificationIssue(task.id, result.reason);
            }
            decision = null; // Done — either completed or flagged
            break;
          }

          case 'error':
            await logAutomationError(task.id, decision.message);
            decision = null;
            break;

          default:
            decision = null;
            break;
        }
      }
    } catch (error) {
      logger.error('task-automation', 'Failed to process task ' + task.id, error?.message);
      await logAutomationError(task.id, error).catch(() => {});
    } finally {
      processingRef.current.delete(task.id);
      // threadMapRef cleanup for errored tasks
      if (!processingRef.current.has(task.id)) {
        // Keep thread for potential retry — it will be GC'd on next successful completion
      }
    }
  }, [sendToAgent]);

  // Subscribe to automated tasks
  useEffect(() => {
    if (!uid) return;

    const unsubscribe = subscribeAutomatedTasks((task) => {
      logger.info('task-automation', 'Automated task detected: ' + task.id);
      processTask(task);
    });

    return () => unsubscribe();
  }, [uid, processTask]);
}

// ── Prompt builders ──────────────────────────────────────────

function buildBreakdownPrompt(title, context) {
  const lines = [
    'You are an expert project manager and personal assistant working inside briizOS, a desktop workspace app. A user will provide a high-level goal. Your job is to break that goal down into a list of small, actionable steps.',
    '',
    'Evaluate the user\'s goal carefully.',
    '- If the goal is straightforward and you have enough information (e.g., "organize my garage", "email the PDF to John", "plan a birthday party"), break it down into a list of concrete, actionable steps and set isDone to true. Each step should be something that can be checked off — specific, not vague.',
    '- If the goal is ambiguous, emotionally complex, or requires details you don\'t have (e.g., "reconcile with mom", "fix that thing from yesterday"), you MUST ask one single clarifying question to get the necessary information. Do not generate steps yet. Set isDone to false and populate the clarifyingQuestion field.',
    '- Keep steps practical. Prefer 3-7 steps. Don\'t over-decompose simple goals or under-decompose complex ones.',
    '- You have access to the user\'s filesystem, terminal, browser, GitHub, and other desktop tools. Factor this into your steps — if a step can be automated, phrase it as an action you will take, not something the user has to do manually.',
  ];

  if (context) {
    lines.push('');
    lines.push('The user has provided the following context to your previous question:');
    lines.push('"' + context + '"');
    lines.push('Use this information to generate the steps.');
  }

  lines.push('');
  lines.push('Respond with ONLY a JSON object, no markdown wrapping, no explanation:');
  lines.push('{ "isDone": true, "tasks": ["step 1", "step 2", ...] }');
  lines.push('or');
  lines.push('{ "isDone": false, "clarifyingQuestion": "your question" }');
  lines.push('');
  lines.push('User Goal: "' + title + '"');

  return lines.join('\n');
}

function buildStepPrompt(taskTitle, stepTitle, stepIndex, totalSteps, taskLog) {
  const recentLog = (taskLog || [])
    .slice(-10)
    .map(function(e) { return '[' + e.type + '] ' + e.message; })
    .join('\n');

  const lines = [
    'You are a personal assistant working inside briizOS, a desktop workspace app with access to the filesystem, terminal, browser, GitHub, and other tools.',
    '',
    'You are executing a multi-step task for the user.',
    '',
    'Overall task: "' + taskTitle + '"',
    'Current step: ' + (stepIndex + 1) + ' of ' + totalSteps + ' — "' + stepTitle + '"',
  ];

  if (recentLog) {
    lines.push('');
    lines.push('Recent activity log:');
    lines.push(recentLog);
  }

  lines.push('');
  lines.push('Execute this step using whatever tools are appropriate. When finished, provide a brief summary (1-3 sentences) of what you accomplished and any relevant details the user should know.');
  lines.push('');
  lines.push('If this step cannot be completed because something is missing or blocked, explain what\'s wrong so the user can help.');

  return lines.join('\n');
}

function buildVerifyPrompt(taskTitle, taskLog) {
  const logSummary = (taskLog || [])
    .filter(function(e) { return e.type === 'status'; })
    .map(function(e) { return e.message; })
    .join('\n');

  const lines = [
    'You are a personal assistant working inside briizOS. You have been executing a multi-step task for the user.',
    '',
    'Task: "' + taskTitle + '"',
    '',
    'Work completed:',
    logSummary || '(no log entries)',
    '',
    'All individual steps have been marked as complete. Review the work that was done and determine whether the overall task goal has been achieved.',
    '',
    'Consider:',
    '- Were all steps actually completed, or were some skipped or partially done?',
    '- Does the work as a whole satisfy the user\'s original goal?',
    '- Is there anything obvious that was missed?',
    '',
    'Respond with ONLY a JSON object, no markdown wrapping:',
    '{ "complete": true }',
    'or',
    '{ "complete": false, "reason": "what\'s missing or incomplete" }',
  ];

  return lines.join('\n');
}

// ── Response parsers & helpers ───────────────────────────────

function extractText(response) {
  if (typeof response === 'string') return response;

  // LangGraph /runs/wait returns { messages: [{ role, content }, ...] }
  // Find the last assistant message for the actual response
  if (response?.messages && response.messages.length > 0) {
    for (let i = response.messages.length - 1; i >= 0; i--) {
      const msg = response.messages[i];
      if (msg.role === 'assistant' || msg.type === 'ai') {
        const content = msg.content;
        // Content can be a string or an array of content blocks
        if (typeof content === 'string') return content;
        if (Array.isArray(content)) {
          const textParts = content
            .filter(c => c.type === 'text')
            .map(c => c.text);
          if (textParts.length > 0) return textParts.join('\n');
        }
        return JSON.stringify(content);
      }
    }
  }

  if (response?.content) return response.content;
  if (response?.text) return response.text;
  return JSON.stringify(response);
}

function parseBreakdownResponse(response) {
  try {
    const text = extractText(response);
    var jsonMatch = text.match(/\{[\s\S]*\}/);
    if (jsonMatch) {
      return JSON.parse(jsonMatch[0]);
    }
  } catch (e) {
    // Fall through
  }
  return { isDone: false, clarifyingQuestion: 'I had trouble understanding the task. Could you rephrase it?' };
}

function parseVerifyResponse(response) {
  try {
    const text = extractText(response);
    var jsonMatch = text.match(/\{[\s\S]*\}/);
    if (jsonMatch) {
      const parsed = JSON.parse(jsonMatch[0]);
      return { complete: parsed.complete === true, reason: parsed.reason || null };
    }
  } catch (e) {
    // Fall through
  }
  return { complete: false, reason: 'Could not parse verification response' };
}

export default useTaskAutomation;
</file>

