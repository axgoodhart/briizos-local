      font-size: 12px;
      line-height: 1.55;
    }

    .preview-input {
      width: 100%;
      margin-top: 18px;
      padding: 12px 14px;
      font-family: inherit;
      font-size: 13px;
      color: var(--dna-text, #fff);
      background: var(--dna-input-bg, #12151d);
      border: var(--dna-input-border-width, 1px) solid var(--dna-input-border, #434b66);
      border-radius: var(--dna-input-radius, 10px);
      outline: none;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
