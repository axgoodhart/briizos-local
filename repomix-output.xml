      // State
      const st = {
        mode: 'timer', running: false, paused: false, startTime: 0, endTime: 0,
        defaultTimer: 25*60*1000, remaining: 25*60*1000, elapsed: 0, compact: false,
        tickId: 0,
        needsAck: false
      };

      // El refs
      const el = {
        big: document.getElementById('ftBig'), small: document.getElementById('ftCompact'),
        time: document.getElementById('ftTime'), status: document.getElementById('ftStatus'),
        start: document.getElementById('ftStart'), pause: document.getElementById('ftPause'),
        plus: document.getElementById('ftPlus'), minus: document.getElementById('ftMinus'),
        tabTimer: document.getElementById('ftTabTimer'), tabStop: document.getElementById('ftTabStop'),
        tabLine: document.getElementById('ftTabLine'), progress: document.getElementById('ftProgress'),
        cTime: document.getElementById('ftCTime'), cPause: document.getElementById('ftCPause'),
        cStop: document.getElementById('ftCStop'), cExpand: document.getElementById('ftCExpand')
      };

      // Alarm sound management
      const SOUND_BASE = 'assets/sounds/alarm/';
      const soundFiles = {
        start: SOUND_BASE + 'alarmStart.mp3',
        end1: SOUND_BASE + 'alarmEnd1.mp3',
        end2: SOUND_BASE + 'alarmEnd2.mp3',
        end3: SOUND_BASE + 'alarmEnd3.mp3',
        end4: SOUND_BASE + 'alarmEnd4.mp3'
      };
      let alarmSeqCancel = false;
      let alarmLoopAudio = null;
      let alarmSeqActive = false;

      function playAlarmStart(){
        try {
          const a = new Audio(soundFiles.start);
          a.volume = 0.25; // 35%
          a.play().catch(()=>{});
        } catch {}
      }

      function playAudioOnce(src, volume){
        return new Promise(resolve => {
          try {
            const a = new Audio(src);
            a.volume = Math.max(0, Math.min(1, volume ?? 1));
            a.addEventListener('ended', () => resolve());
            a.addEventListener('error', () => resolve());
            const p = a.play();
            if (p && typeof p.then === 'function') {
              p.catch(() => setTimeout(resolve, 300));
            } else {
              // If play() isn't promise-based, fallback timeout
              setTimeout(resolve, 500);
            }
          } catch {
            setTimeout(resolve, 300);
          }
        });
      }

      async function playSeries(src, count, volStart, volEnd){
        const steps = Math.max(1, count);
        for (let i = 0; i < steps; i++) {
          if (alarmSeqCancel) return;
          const v = steps === 1 ? volStart : (volStart + (volEnd - volStart) * (i / (steps - 1)));
          await playAudioOnce(src, v);
        }
      }

      function stopAlarmLoop(){
        try {
          if (alarmLoopAudio) {
            alarmLoopAudio.pause();
            alarmLoopAudio.currentTime = 0;
          }
        } catch {}
        alarmLoopAudio = null;
      }

      function startAlarmLoop(src, volume){
        stopAlarmLoop();
        try {
          const a = new Audio(src);
          a.volume = Math.max(0, Math.min(1, volume ?? 1));
          a.loop = true;
          alarmLoopAudio = a;
          a.play().catch(()=>{});
        } catch {}
      }

      async function startAlarmEndSequence(){
        if (alarmSeqActive) return;
        alarmSeqActive = true;
        alarmSeqCancel = false;
        try {
          await playSeries(soundFiles.end1, 5, 0.35, 0.40);
          if (alarmSeqCancel) return;
          await playSeries(soundFiles.end2, 5, 0.40, 0.50);
          if (alarmSeqCancel) return;
          await playSeries(soundFiles.end3, 10, 0.50, 0.60);
          if (alarmSeqCancel) return;
          startAlarmLoop(soundFiles.end4, 0.65);
        } finally {
          // Keep active flag true while looping; set false only when acknowledged
        }
      }

      function acknowledgeAlarm(){
        alarmSeqCancel = true;
        stopAlarmLoop();
        alarmSeqActive = false;
        if (st.needsAck) {
          st.needsAck = false;
          save();
        }
      }

      const fmt = (ms, compact=false)=>{ ms=Math.max(0,Math.floor(ms)); const h=Math.floor((ms%1000)/10); const ts=Math.floor(ms/1000); const m=Math.floor(ts/60); const s=ts%60; const mm=compact?String(m):String(m).padStart(2,'0'); return `${mm}:${String(s).padStart(2,'0')}.${String(h).padStart(2,'0')}`; };

      function setMode(mode){ if(st.running) return; st.mode=mode; el.tabTimer.classList.toggle('active',mode==='timer'); el.tabStop.classList.toggle('active',mode==='stopwatch'); el.tabLine.style.left = (mode==='timer') ? '0%' : '52%'; el.tabLine.style.width='46%'; if(mode==='timer'){ st.remaining = st.defaultTimer; el.time.textContent = fmt(st.remaining); el.progress.style.transform='scaleX(0)'; el.plus.disabled=false; el.minus.disabled=false; } else { st.elapsed=0; el.time.textContent = fmt(0); el.progress.style.transform='scaleX(0)'; el.plus.disabled=true; el.minus.disabled=true; } setStatus('idle'); save(); }
      function setStatus(k){ if(k==='running'){ el.status.textContent='active'; el.status.classList.add('active'); el.pause.textContent='pause'; el.pause.classList.add('running'); } else if(k==='paused'){ el.status.textContent='paused'; el.status.classList.remove('active'); el.pause.textContent='resume'; el.pause.classList.remove('running'); } else { el.status.textContent='idle'; el.status.classList.remove('active'); el.pause.textContent='pause'; el.pause.classList.remove('running'); } }
      const toSmall=()=>{ el.big.classList.add('ft-hidden'); el.small.classList.remove('ft-hidden'); st.compact=true; save(); };
      const toBig=()=>{ el.small.classList.add('ft-hidden'); el.big.classList.remove('ft-hidden'); st.compact=false; save(); };
      const showRoot=()=>{ root.classList.remove('ft-hidden'); };
      const hideRoot=()=>{ root.classList.add('ft-hidden'); };

      function start(){ if(st.running) return; if(st.mode==='timer'){ if(st.remaining<=0) st.remaining=st.defaultTimer; st.startTime=Date.now(); st.endTime=st.startTime+st.remaining; } else { st.startTime=Date.now()-st.elapsed; } acknowledgeAlarm(); if(st.mode==='timer'){ playAlarmStart(); } st.running=true; st.paused=false; tick(); setStatus('running'); toSmall(); save(); }
      function pauseToggle(){ if(!st.running) return; if(!st.paused){ cancelAnimationFrame(st.tickId); st.tickId=0; if(st.mode==='timer'){ st.remaining=Math.max(0, st.endTime-Date.now()); } else { st.elapsed=Date.now()-st.startTime; } st.paused=true; setStatus('paused'); } else { if(st.mode==='timer'){ st.startTime=Date.now(); st.endTime=st.startTime+st.remaining; } else { st.startTime=Date.now()-st.elapsed; } st.paused=false; setStatus('running'); tick(); } refresh(); save(); }
      function stopReset(){ acknowledgeAlarm(); cancelAnimationFrame(st.tickId); st.tickId=0; st.running=false; st.paused=false; if(st.mode==='timer'){ st.remaining=st.defaultTimer; el.progress.style.transform='scaleX(0)'; el.time.textContent=fmt(st.remaining); } else { st.elapsed=0; el.time.textContent=fmt(0); } setStatus('idle'); toBig(); refresh(); save(); }
      function addTime(ms){ if(st.mode!=='timer') return; if(st.running && !st.paused){ st.endTime += ms; if(st.endTime < Date.now()) st.endTime = Date.now(); } else { st.remaining = Math.max(0, (st.remaining||st.defaultTimer) + ms); el.time.textContent = fmt(st.remaining); } st.defaultTimer = st.remaining || st.defaultTimer; refresh(); save(); }
      function tick(){ st.tickId = requestAnimationFrame(function raf(){ if(!st.running || st.paused) return; if(st.mode==='timer'){ const left=st.endTime-Date.now(); if(left<=0){ done(); return; } el.time.textContent=fmt(left); el.cTime.textContent=fmt(left,true); const total=st.defaultTimer; const donep=1-Math.max(0,Math.min(1,left/Math.max(1,total))); el.progress.style.transform=`scaleX(${donep})`; } else { const elapsed=Date.now()-st.startTime; st.elapsed=elapsed; el.time.textContent=fmt(elapsed); el.cTime.textContent=fmt(elapsed,true); el.progress.style.transform='scaleX(0)'; } st.tickId=requestAnimationFrame(raf); }); }
      function refresh(){ if(st.mode==='timer'){ const ms = st.running&&!st.paused? Math.max(0,st.endTime-Date.now()) : (st.remaining||st.defaultTimer); el.time.textContent=fmt(ms); el.cTime.textContent=fmt(ms,true); } else { const ms = st.running&&!st.paused? (Date.now()-st.startTime) : st.elapsed; el.time.textContent=fmt(ms); el.cTime.textContent=fmt(ms,true); } }
      function done(){ cancelAnimationFrame(st.tickId); st.tickId=0; st.running=false; st.paused=false; el.time.textContent='00:00.00'; el.cTime.textContent='0:00.00'; setStatus('idle'); el.progress.style.transform='scaleX(1)'; setTimeout(()=>{ el.progress.style.transform='scaleX(0)'; }, 1200); st.needsAck = true; save(); startAlarmEndSequence(); }

      // Persistence helpers
      const TIMER_KEY = 'glOS.timer.v1';
      const save = (()=>{ let t=null; return ()=>{ clearTimeout(t); t=setTimeout(()=>{ const payload={ mode:st.mode, running:st.running, paused:st.paused, startTime:st.startTime, endTime:st.endTime, defaultTimer:st.defaultTimer, remaining:st.remaining, elapsed:st.elapsed, compact:st.compact, needsAck: !!st.needsAck, ts:Date.now() }; try{ localStorage.setItem(TIMER_KEY, JSON.stringify(payload)); }catch{} try{ if(window.persistence){ persistence.queueFirebaseSave('app','timer', payload); } }catch{} }, 300); }; })();
      async function load(){ let data=null; try{ if(window.persistence?.uid){ const ref = doc(db, `users/${persistence.uid}/app/timer`); const snap = await getDoc(ref); if(snap.exists()) data = snap.data()?.value || snap.data(); } }catch{} if(!data){ try{ data = JSON.parse(localStorage.getItem(TIMER_KEY)||'null'); }catch{} }
        if(!data) { setMode('timer'); refresh(); return; }
        try{
          setMode(data.mode==='stopwatch'?'stopwatch':'timer');
          st.defaultTimer = Number(data.defaultTimer)||st.defaultTimer;
          st.remaining = Number(data.remaining)||st.defaultTimer;
          st.elapsed = Number(data.elapsed)||0;
          st.compact = !!data.compact; if(st.compact) { toSmall(); } else { toBig(); }
          st.needsAck = !!data.needsAck;
          if(data.running){ if(st.mode==='timer'){ const left = (Number(data.endTime)||0) - Date.now(); if(left>0){ st.startTime=Date.now(); st.endTime=st.startTime+left; st.running=true; tick(); setStatus('running'); } else { done(); } } else { st.startTime = Date.now() - (Number(data.elapsed)||0); st.running=true; tick(); setStatus('running'); } }
          else if(data.paused){ st.paused=true; setStatus('paused'); refresh(); }
          else { setStatus('idle'); refresh(); if(st.needsAck){ startAlarmEndSequence(); } }
        }catch{ setMode('timer'); refresh(); }
      }

      // Wire UI
      el.start.addEventListener('click', start);
      el.pause.addEventListener('click', pauseToggle);
      el.plus.addEventListener('click', ()=>addTime(15_000));
      el.minus.addEventListener('click', ()=>addTime(-15_000));
      el.cPause.addEventListener('click', pauseToggle);
      el.cStop.addEventListener('click', stopReset);
      el.cExpand.addEventListener('click', toBig);
      el.tabTimer.addEventListener('click', ()=>setMode('timer'));
      el.tabStop.addEventListener('click', ()=>setMode('stopwatch'));

      // Init
      setMode('timer');
      refresh();
      load();

      return {
        show: showRoot, hide: hideRoot, expand: toBig, collapse: toSmall, toggle: ()=>{ if(root.classList.contains('ft-hidden')) showRoot(); else (st.compact?toBig():hideRoot()); }, setMode
      };
    })();
  } catch (e) { console.error('Timer init failed', e); }

  // Shortcut menu chat removed
});
