  // Day popup helpers
  function openDayPopup(dateStr, items){
    const wrap = document.getElementById('org-daypopup-wrap');
    const list = document.getElementById('org-daypopup-list');
    const title = document.getElementById('org-daypopup-title');
    if (!wrap || !list) return;
    title.textContent = parseYMDLocal(dateStr).toLocaleDateString('en-US', { weekday:'long', month:'long', day:'numeric' });
    list.innerHTML = '';
    items.forEach(it=>{
      const r = document.createElement('div'); r.className='row';
      const left = document.createElement('div');
      const tags = (it.tags && it.tags.length) ? it.tags.join(', ') : '—';
      const time = it.time || it.start || '—';
      const dur = it.duration || '—';
      left.innerHTML = `<div>${escapeHtml(it.name)}</div><div class='meta'>${it.type || 'item'} · ${it.source?.mode || 'manual'} · ${time} · ${dur} · ${escapeHtml(tags)}</div>`;
      const btn = document.createElement('button'); btn.textContent = it.completedAt ? 'Undo' : 'Done';
      btn.addEventListener('click', ()=>{ OrganizerStore.toggleDone(it.id); renderOrganizerCalendar(); renderOrganizerList(); openDayDetail(dateStr); });
      r.appendChild(left); r.appendChild(btn); list.appendChild(r);
    });
    wrap.classList.add('show'); wrap.setAttribute('aria-hidden','false');
