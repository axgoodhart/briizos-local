        // ============================================================
        // FLIGHT SETTINGS PERSISTENCE & PRESETS
        // ============================================================

        const FLIGHT_SETTINGS_KEY = 'celestia_flight_settings';
        const FLIGHT_PRESETS_KEY = 'celestia_flight_presets';
        let currentPresetName = 'CUSTOM';

        // Default presets
        const defaultPresets = [
            { name: 'SMOOTH SATELLITE', settings: { acceleration: 0.005, deceleration: 0.96, maxSpeed: 0.4, fov: 55, lookSpeed: 0.002 }},
            { name: 'RECKLESS INVADERZ', settings: { acceleration: 0.025, deceleration: 0.88, maxSpeed: 1.5, fov: 90, lookSpeed: 0.005 }},
            { name: 'METEOR FRIGHT', settings: { acceleration: 0.015, deceleration: 0.92, maxSpeed: 0.8, fov: 70, lookSpeed: 0.004 }},
            { name: 'BABY LDN1235', settings: { acceleration: 0.003, deceleration: 0.98, maxSpeed: 0.25, fov: 50, lookSpeed: 0.0015 }}
        ];

        function getCurrentFlightSettings() {
            return {
                acceleration: NavController.thrustPower,
                deceleration: NavController.deceleration,
                maxSpeed: NavController.maxSpeed,
                fov: camera.fov,
                lookSpeed: NavController.lookSpeed
            };
        }

        function applyFlightSettings(settings) {
            NavController.thrustPower = settings.acceleration;
            NavController.deceleration = settings.deceleration;
            NavController.maxSpeed = settings.maxSpeed;
            NavController.lookSpeed = settings.lookSpeed;
            camera.fov = settings.fov;
            camera.updateProjectionMatrix();

            // Update sliders
            document.getElementById('accel-slider').value = settings.acceleration;
            document.getElementById('damping-slider').value = settings.deceleration;
            document.getElementById('maxspeed-slider').value = settings.maxSpeed;
            document.getElementById('fov-slider').value = settings.fov;
            document.getElementById('lookspeed-slider').value = settings.lookSpeed;

            // Update displays
            document.getElementById('accel-value').innerText = settings.acceleration.toFixed(3);
            document.getElementById('damping-value').innerText = settings.deceleration.toFixed(2);
            document.getElementById('maxspeed-value').innerText = settings.maxSpeed.toFixed(2);
            document.getElementById('fov-value').innerText = settings.fov + '°';
            document.getElementById('lookspeed-value').innerText = settings.lookSpeed.toFixed(3);
        }

        function saveCurrentFlightSettings() {
            const settings = getCurrentFlightSettings();
            localStorage.setItem(FLIGHT_SETTINGS_KEY, JSON.stringify(settings));
        }

        function loadSavedFlightSettings() {
            const saved = localStorage.getItem(FLIGHT_SETTINGS_KEY);
            if (saved) {
                try {
                    const settings = JSON.parse(saved);
                    applyFlightSettings(settings);
                } catch(e) {
                    console.warn('Failed to load flight settings:', e);
                }
            }
        }

        function setCurrentPresetName(name) {
            currentPresetName = name;
            const el = document.getElementById('current-preset-name');
            if (el) el.innerText = name;
        }

        function getPresets() {
            const saved = localStorage.getItem(FLIGHT_PRESETS_KEY);
            if (saved) {
                try {
                    return JSON.parse(saved);
                } catch(e) {
                    return [...defaultPresets];
                }
            }
            return [...defaultPresets];
        }

        function savePresets(presets) {
            localStorage.setItem(FLIGHT_PRESETS_KEY, JSON.stringify(presets));
        }

        function renderPresetsList() {
            const list = document.getElementById('presets-list');
            const presets = getPresets();

            list.innerHTML = presets.map((preset, index) => `
                <div class="flex items-center justify-between px-2 py-1.5 hover:bg-cyan-900/30 cursor-pointer group" onclick="loadPreset(${index})">
                    <span class="text-xs font-mono text-cyan-300">[${index + 1}] ${preset.name}</span>
                    <button onclick="event.stopPropagation(); deletePreset(${index})" class="text-red-400 hover:text-red-300 opacity-0 group-hover:opacity-100 transition-opacity text-sm">✕</button>
                </div>
            `).join('');
        }

        window.openPresetsPanel = function() {
            const panel = document.getElementById('presets-panel');
            panel.classList.remove('translate-x-full');
            panel.classList.add('translate-x-0');
            pushPanel('presets');
            renderPresetsList();
        }

        window.closePresetsPanel = function() {
            const panel = document.getElementById('presets-panel');
            panel.classList.add('translate-x-full');
            panel.classList.remove('translate-x-0');
            popPanel('presets');
            cancelSavePreset();
        }

        window.startSavePreset = function() {
            document.getElementById('save-preset-btn').classList.add('hidden');
            document.getElementById('new-preset-input').classList.remove('hidden');
            document.getElementById('new-preset-name').value = '';
            document.getElementById('new-preset-name').focus();
        }

        window.cancelSavePreset = function() {
            document.getElementById('save-preset-btn').classList.remove('hidden');
            document.getElementById('new-preset-input').classList.add('hidden');
        }

        window.confirmSavePreset = function() {
            const nameInput = document.getElementById('new-preset-name');
            const name = nameInput.value.trim().toUpperCase() || 'UNNAMED';

            const presets = getPresets();
            presets.push({
                name: name,
                settings: getCurrentFlightSettings()
            });
            savePresets(presets);

            setCurrentPresetName(name);
            cancelSavePreset();
            renderPresetsList();
            showToast(`Preset "${name}" saved`, 'success');
        }

        window.loadPreset = function(index) {
            const presets = getPresets();
            if (presets[index]) {
                applyFlightSettings(presets[index].settings);
                saveCurrentFlightSettings();
                setCurrentPresetName(presets[index].name);
                showToast(`Loaded "${presets[index].name}"`, 'info');
            }
        }

        window.deletePreset = function(index) {
            const presets = getPresets();
            if (presets[index]) {
                const name = presets[index].name;
                presets.splice(index, 1);
                savePresets(presets);
                renderPresetsList();
                showToast(`Deleted "${name}"`, 'info');
            }
        }

        // ============================================================
        // SEARCH & FILTER FUNCTIONS
        // ============================================================

        let searchPanelOpen = false;

        window.toggleSearchPanel = function() {
            const panel = document.getElementById('search-panel');
            searchPanelOpen = !searchPanelOpen;

            if (searchPanelOpen) {
                panel.classList.remove('-translate-x-full');
                panel.classList.add('translate-x-0', 'open');
                performSearch(); // Populate results
                document.getElementById('search-input').focus();
                pushPanel('search');
            } else {
                panel.classList.add('-translate-x-full');
                panel.classList.remove('translate-x-0', 'open');
                popPanel('search');
            }
            NavController.updateMouseLook();
        }

        window.performSearch = function() {
            const query = document.getElementById('search-input').value.toLowerCase();
            const categoryFilter = document.getElementById('search-category').value;
            const priorityFilter = document.getElementById('search-priority').value;
            const sortBy = document.getElementById('search-sort').value;

            // Filter projects
            let results = projects.filter(p => {
                const data = p.userData;

                // Text search (name, description, tags)
                const matchesQuery = !query ||
                    data.name.toLowerCase().includes(query) ||
                    (data.description || '').toLowerCase().includes(query) ||
                    (data.tags || []).some(t => t.toLowerCase().includes(query));

                // Category filter
                const matchesCategory = !categoryFilter || data.category === categoryFilter;

                // Priority filter
                const matchesPriority = !priorityFilter || data.priority === priorityFilter;

                return matchesQuery && matchesCategory && matchesPriority;
            });

            // Sort results
            const priorityOrder = { CRITICAL: 4, HIGH: 3, MEDIUM: 2, LOW: 1 };
            results.sort((a, b) => {
                const da = a.userData, db = b.userData;
                switch(sortBy) {
                    case 'name':
                        return da.name.localeCompare(db.name);
                    case 'updated':
                        return (db.updatedAt || 0) - (da.updatedAt || 0);
                    case 'created':
                        return (db.createdAt || 0) - (da.createdAt || 0);
                    case 'priority':
                        return (priorityOrder[db.priority] || 0) - (priorityOrder[da.priority] || 0);
                    case 'shards':
                        return (db.shardsCount || 0) - (da.shardsCount || 0);
                    default:
                        return 0;
                }
            });

            // Render results
            renderSearchResults(results);
        }

        function renderSearchResults(results) {
            const container = document.getElementById('search-results');
            document.getElementById('search-count').innerText = results.length;

            if (results.length === 0) {
                container.innerHTML = '<div class="text-center text-cyan-700 text-xs py-8">No projects found</div>';
                return;
            }

            container.innerHTML = results.map(p => {
                const data = p.userData;
                const priority = PRIORITY_LEVELS[data.priority] || PRIORITY_LEVELS.MEDIUM;
                const colorHex = '#' + (data.baseColor || 0x00ffff).toString(16).padStart(6, '0');

                return `
                    <div onclick="navigateToProject('${data.id}')"
                        class="p-3 bg-black/30 border border-cyan-500/20 hover:border-cyan-500/50 hover:bg-cyan-900/20 cursor-pointer transition-all rounded">
                        <div class="flex items-start justify-between gap-2">
                            <div class="flex items-center gap-2">
                                <div class="w-3 h-3 rounded-full" style="background:${colorHex};box-shadow:0 0 8px ${colorHex}"></div>
                                <span class="text-sm text-cyan-100 font-medium">${data.name}</span>
                            </div>
                            <span class="text-[9px] px-1.5 py-0.5 rounded" style="background:${priority.color};color:#000">${data.priority}</span>
                        </div>
                        <div class="text-[10px] text-cyan-500 mt-1">${data.category}</div>
                        ${data.tags && data.tags.length > 0 ?
                            `<div class="flex flex-wrap gap-1 mt-2">${data.tags.slice(0, 3).map(t =>
                                `<span class="text-[9px] px-1.5 py-0.5 bg-cyan-900/50 text-cyan-400 rounded">#${t}</span>`
                            ).join('')}</div>` : ''
                        }
                    </div>
                `;
            }).join('');
        }

        window.navigateToProject = function(projectId) {
            const project = projects.find(p => p.userData.id === projectId);
            if (project) {
                toggleSearchPanel(); // Close search
                NavController.navigateTo(project, () => {
                    currentlySelectedProject = project;
                    openHUD(project.userData);
                });
            }
        }

        window.clearSearch = function() {
            document.getElementById('search-input').value = '';
            document.getElementById('search-category').value = '';
            document.getElementById('search-priority').value = '';
            document.getElementById('search-sort').value = 'name';
            performSearch();
        }

        window.resetFlightSettings = function() {
            const defaults = {
                acceleration: 0.008,
                deceleration: 0.92,
                maxSpeed: 0.8,
                fov: 60,
                lookSpeed: 0.003
            };

            applyFlightSettings(defaults);
            saveCurrentFlightSettings();
            setCurrentPresetName('DEFAULT');
            showToast('Settings reset to defaults', 'info');
        }

        window.navigateToSelected = function() {
            if (currentlySelectedProject) {
                closeHUD();
                NavController.navigateTo(currentlySelectedProject, () => {
                    openHUD(currentlySelectedProject.userData);
                });
            }
        }

        window.selectColor = function(color) {
            selectedColor = color;
            // Visual feedback could be added here
        }

        window.openHUD = function(data) {
            const hud = document.getElementById('project-hud');

            // Basic info
            document.getElementById('hud-title').innerText = data.name;
            document.getElementById('hud-subtitle').innerText = data.category;
            document.getElementById('hud-shards').innerText = (data.shardsCount || 0) + " SHARDS";

            // Format date
            let dateDisplay = data.date || "UNKNOWN";
            if (data.updatedAt && typeof data.updatedAt === 'number') {
                const diff = Date.now() - data.updatedAt;
                const mins = Math.floor(diff / 60000);
                const hours = Math.floor(diff / 3600000);
                const days = Math.floor(diff / 86400000);
                if (mins < 1) dateDisplay = "JUST NOW";
                else if (mins < 60) dateDisplay = `${mins}m AGO`;
                else if (hours < 24) dateDisplay = `${hours}h AGO`;
                else dateDisplay = `${days}d AGO`;
            }
            document.getElementById('hud-date').innerText = dateDisplay;

            // Priority badge
            const priorityEl = document.getElementById('hud-priority');
            const priority = PRIORITY_LEVELS[data.priority] || PRIORITY_LEVELS.MEDIUM;
            priorityEl.innerText = priority.label;
            priorityEl.style.background = priority.color;
            priorityEl.style.color = data.priority === 'LOW' ? '#fff' : '#000';

            // Description
            const descSection = document.getElementById('hud-description-section');
            const descEl = document.getElementById('hud-description');
            if (data.description) {
                descEl.innerText = data.description;
                descSection.classList.remove('hidden');
            } else {
                descSection.classList.add('hidden');
            }

            // Tags
            const tagsSection = document.getElementById('hud-tags-section');
            const tagsEl = document.getElementById('hud-tags');
            if (data.tags && data.tags.length > 0) {
                tagsEl.innerHTML = data.tags.map(tag =>
                    `<span class="text-[10px] px-2 py-0.5 bg-cyan-900/50 border border-cyan-500/30 rounded text-cyan-300">#${tag}</span>`
                ).join('');
                tagsSection.classList.remove('hidden');
            } else {
                tagsSection.classList.add('hidden');
            }

            // Stats
            const statsContainer = document.getElementById('hud-stats-container');
            statsContainer.innerHTML = '';
            if (data.stats && data.stats.length > 0) {
                data.stats.forEach(stat => {
                    const percentage = (stat.val / stat.max) * 100;
                    statsContainer.innerHTML += `
                        <div>
                            <div class="flex justify-between text-xs font-bold tracking-wider mb-1">
                                <span class="text-cyan-100">${stat.label.toUpperCase()}</span>
                                <span class="text-cyan-400">${stat.val}/${stat.max}</span>
                            </div>
                            <div class="stat-bar-bg">
                                <div class="stat-bar-fill" style="width: ${percentage}%"></div>
                            </div>
                        </div>
                    `;
                });
            } else {
                statsContainer.innerHTML = '<div class="text-xs text-gray-500 italic">NO METRICS AVAILABLE</div>';
            }

            // Notes
            const notesSection = document.getElementById('hud-notes-section');
            const notesEl = document.getElementById('hud-notes');
            if (data.notes) {
                notesEl.innerText = data.notes;
                notesSection.classList.remove('hidden');
            } else {
                notesSection.classList.add('hidden');
            }

            // Links
            const linksSection = document.getElementById('hud-links-section');
            const linksEl = document.getElementById('hud-links');
            if (data.links && data.links.length > 0) {
                linksEl.innerHTML = data.links.map(link =>
                    `<a href="${link.url}" target="_blank" class="text-xs text-cyan-400 hover:text-cyan-200 underline">→ ${link.label}</a>`
                ).join('');
                linksSection.classList.remove('hidden');
            } else {
                linksSection.classList.add('hidden');
            }

            hud.classList.remove('hidden');
            NavController.updateMouseLook();
        }

        window.closeHUD = function() {
            document.getElementById('project-hud').classList.add('hidden');
            currentlySelectedProject = null;
            NavController.updateMouseLook();
        }

        // Confirm deletion with modal
        window.confirmDeleteProject = function() {
            if (!currentlySelectedProject) return;

            const projectName = currentlySelectedProject.userData?.name || 'this chrysalis';

            const modal = document.createElement('div');
            modal.id = 'delete-confirm-modal';
            modal.innerHTML = `
                <div class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center">
                    <div class="hologram-panel w-full max-w-sm p-6 rounded-lg border-2 border-red-500/50 transform-none">
                        <h2 class="text-xl neon-text text-center mb-4 text-red-400">SHATTER CHRYSALIS?</h2>
                        <p class="text-sm text-center text-cyan-200/70 mb-6">
                            "${projectName}" will shatter forever.<br>This cannot be undone.
                        </p>
                        <div class="flex gap-4">
                            <button id="cancel-delete" class="flex-1 py-3 border border-cyan-500/30 text-cyan-400 hover:bg-cyan-900/20 transition-colors tracking-widest text-xs">CANCEL</button>
                            <button id="confirm-delete" class="flex-1 py-3 bg-red-900/40 border border-red-500 text-red-300 hover:bg-red-500 hover:text-white transition-colors tracking-widest text-xs font-bold">SHATTER</button>
                        </div>
                    </div>
                </div>
            `;
            document.body.appendChild(modal);
            NavController.updateMouseLook();

            document.getElementById('cancel-delete').onclick = () => {
                modal.remove();
                NavController.updateMouseLook();
            };
            document.getElementById('confirm-delete').onclick = () => {
                deleteProject(currentlySelectedProject);
                closeHUD();
                modal.remove();
                NavController.updateMouseLook();
            };
        }

        // ============================================================
        // PHASE 1.3: EDIT MODAL FUNCTIONS
        // ============================================================

        let editState = {
            priority: 'MEDIUM',
            color: '#00ffff',
            stats: []
        };

        window.openEditModal = function() {
            if (!currentlySelectedProject) return;

            const data = currentlySelectedProject.userData;
            const modal = document.getElementById('edit-modal');

            // Populate form fields
            document.getElementById('edit-name').value = data.name || '';
            document.getElementById('edit-category').value = data.category || 'Other';
            document.getElementById('edit-description').value = data.description || '';
            document.getElementById('edit-tags').value = (data.tags || []).join(', ');
            document.getElementById('edit-notes').value = data.notes || '';

            // Set priority
            editState.priority = data.priority || 'MEDIUM';
            updatePriorityButtons();

            // Set color
            const colorHex = '#' + (data.baseColor || 0x00ffff).toString(16).padStart(6, '0');
            editState.color = colorHex;
            updateColorButtons();

            // Populate stats
            editState.stats = JSON.parse(JSON.stringify(data.stats || []));
            renderEditStats();

            // Show modal
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            moveSpeed = 0;
            pushPanel('edit-modal');
            NavController.updateMouseLook();
        }

        window.closeEditModal = function() {
            const modal = document.getElementById('edit-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            popPanel('edit-modal');
            NavController.updateMouseLook();
        }

        window.setEditPriority = function(priority) {
            editState.priority = priority;
            updatePriorityButtons();
        }

        function updatePriorityButtons() {
            document.querySelectorAll('.edit-priority-btn').forEach(btn => {
                const p = btn.dataset.priority;
                if (p === editState.priority) {
                    btn.classList.add('ring-2', 'ring-white');
                } else {
                    btn.classList.remove('ring-2', 'ring-white');
                }
            });
        }

        window.setEditColor = function(color) {
            editState.color = color;
            updateColorButtons();
        }

        function updateColorButtons() {
            document.querySelectorAll('.edit-color-btn').forEach(btn => {
                if (btn.dataset.color === editState.color) {
                    btn.classList.add('ring-2', 'ring-white', 'scale-110');
                } else {
                    btn.classList.remove('ring-2', 'ring-white', 'scale-110');
                }
            });
        }

        function renderEditStats() {
            const container = document.getElementById('edit-stats-container');
            container.innerHTML = editState.stats.map((stat, i) => `
                <div class="flex gap-2 items-center">
                    <input type="text" value="${stat.label}" onchange="updateEditStat(${i}, 'label', this.value)" class="flex-1 p-2 glass-input text-xs" placeholder="Metric name">
                    <input type="number" value="${stat.val}" min="0" max="${stat.max}" onchange="updateEditStat(${i}, 'val', parseInt(this.value))" class="w-16 p-2 glass-input text-xs text-center">
                    <span class="text-cyan-500 text-xs">/</span>
                    <input type="number" value="${stat.max}" min="1" onchange="updateEditStat(${i}, 'max', parseInt(this.value))" class="w-16 p-2 glass-input text-xs text-center">
                    <button onclick="removeEditStat(${i})" class="text-red-400 hover:text-red-200 text-xs px-2">✕</button>
                </div>
            `).join('');
        }

        window.updateEditStat = function(index, field, value) {
            if (editState.stats[index]) {
                editState.stats[index][field] = value;
            }
        }

        window.addEditStat = function() {
            editState.stats.push({ label: 'New Metric', val: 0, max: 10 });
            renderEditStats();
        }

        window.removeEditStat = function(index) {
            editState.stats.splice(index, 1);
            renderEditStats();
        }

        window.saveProjectEdits = function() {
            if (!currentlySelectedProject) return;

            const data = currentlySelectedProject.userData;
            const oldName = data.name;

            // Update userData
            data.name = document.getElementById('edit-name').value || 'UNTITLED';
            data.category = document.getElementById('edit-category').value;
            data.description = document.getElementById('edit-description').value;
            data.priority = editState.priority;
            data.tags = document.getElementById('edit-tags').value
                .split(',')
                .map(t => t.trim().toLowerCase())
                .filter(t => t.length > 0);
            data.notes = document.getElementById('edit-notes').value;
            data.baseColor = parseInt(editState.color.replace('#', '0x'));
            data.stats = editState.stats;
            data.updatedAt = Date.now();

            // Update 3D visuals if name or color changed
            updateProjectVisuals(currentlySelectedProject, oldName);

            // Trigger save
            AppState._notify('projects', projects, null);

            // Close modal and refresh HUD
            closeEditModal();
            openHUD(data);

            showToast('Project updated', 'success');
        }

        // Update 3D object visuals after edit
        function updateProjectVisuals(projectGroup, oldName) {
            const data = projectGroup.userData;

            // Update crystal color
            const crystal = projectGroup.children[0];
            if (crystal && crystal.material) {
                crystal.material.color.setHex(data.baseColor);
                crystal.material.emissive.setHex(data.baseColor);
            }

            // Update shard colors
            projectGroup.children.forEach(child => {
                if (child.userData?.orbit && child.material) {
                    child.material.color.setHex(data.baseColor);
                }
            });

            // Update label if name changed
            if (oldName !== data.name) {
                // Remove old label texture from cache
                if (labelTextureCache.has(oldName)) {
                    labelTextureCache.get(oldName).dispose();
                    labelTextureCache.delete(oldName);
                }

                // Find and update label sprite
                const labelSprite = projectGroup.children.find(c => c.isSprite);
                if (labelSprite) {
                    const newTexture = getLabelTexture(data.name);
                    labelSprite.material.map = newTexture;
                    labelSprite.material.needsUpdate = true;
                }
            }
        }

        window.openCreationModal = function() {
            document.getElementById('creation-modal').classList.remove('hidden');
            document.getElementById('creation-modal').classList.add('flex');
            moveSpeed = 0; // Pause movement
            pushPanel('creation-modal');
            NavController.updateMouseLook();
        }

        window.closeCreationModal = function() {
            document.getElementById('creation-modal').classList.add('hidden');
            document.getElementById('creation-modal').classList.remove('flex');
            moveSpeed = 0.2; // Resume
            popPanel('creation-modal');
            NavController.updateMouseLook();
        }

        window.submitNewProject = function() {
            const name = document.getElementById('new-project-name').value || "UNTITLED PROJECT";
            const cat = document.getElementById('new-project-cat').value;
            
            // Create new data object
            const newProj = {
                name: name,
                category: cat,
                color: parseInt(selectedColor.replace('#', '0x')),
                stats: [
                    { label: "Concept", val: 1, max: 10 },
                    { label: "Execution", val: 0, max: 10 }
                ],
                // Spawn it just in front of the camera so we see it fly by
                pos: { 
                    x: (Math.random() - 0.5) * 10 + camera.position.x, 
                    y: 2, 
                    z: camera.position.z - 30 
                },
                shards: 1
            };

            createChrysalis(newProj);
            closeCreationModal();
        }
    </script>
</body>
</html>
