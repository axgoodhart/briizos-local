      font-weight: 600;
    }

    .preview-link:hover {
      text-decoration: underline;
    }

    .preview-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 18px 0 14px;
    }

    .preview-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 10px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      background: var(--dna-accent-soft, rgba(122,162,247,0.16));
      color: var(--dna-accent, #7aa2f7);
      border: 1px solid rgba(255,255,255,0.08);
    }

    .preview-inline-panel {
      margin-top: 18px;
      padding: 14px;
      border-radius: 12px;
      background: rgba(255,255,255,0.03);
      border: 1px dashed rgba(255,255,255,0.08);
