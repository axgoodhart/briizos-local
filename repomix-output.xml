  /* === SEPARATE CALENDAR OVERLAY (not the organizer) === */
  .cal-overlay {
    position: fixed;
 inset: 0;
 z-index: 200000;
 display: none;
 place-items: center;
    background: transparent; 
 pointer-events: none;
 opacity: 0;
    -webkit-backdrop-filter: none;
 backdrop-filter: none;
    transition: opacity .45s cubic-bezier(0.16, 1, 0.3, 1);
    perspective: 9100px;
  }
  .cal-overlay.show { display: contents;
 opacity: 1;
 }
  /* "Layable" calendar styles inspired by Untitled-1: perspective + tilt that flattens on hover */
  .cal-overlay .cal-lay-wrap { perspective: 900px;
 width: 100%;
 display: flex;
 justify-content: center;
 align-items: center;
 }
  /* Drag wrapper holds the panel and handle; moving this avoids transform jump */
  .cal-drag-wrap { position: fixed; z-index: 200001; perspective: 900px; pointer-events: none;height:50px;width:50px; }
  .cal-drag-wrap.dragging { cursor: grabbing; }
  /* Top-right drag handle appears only when in lay mode + hover */
  .cal-drag-handle {
    position: absolute;
    right: -20px;
    bottom:-20px;
    height: 100%;
    border:1.5px solid rgb(31, 0, 51);
    width: 40px;
    border-radius: 600px;
    background: linear-gradient(135deg, rgba(0,255,204,.9), rgba(255,77,166,.9));
    box-shadow: 0 0 6px rgba(0,0,0,.45), inset 0 0 6px rgba(0,0,0,.35);
    cursor: grab;
    opacity: 0;
    pointer-events: none;
    z-index: 5;
    transition: opacity .2s ease;
    animation: handthrob 2.2s infinite linear;
  }

  @keyframes handthrob {
    0% {
      filter:hue-rotate(0deg)
    }
    100%{filter:hue-rotate(360deg);}
  }
  .cal-drag-wrap.lay:hover .cal-drag-handle { opacity: .85; pointer-events: auto; }
