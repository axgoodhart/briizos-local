    }

    textarea[readonly] {
      min-height: 240px;
      color: #9cdcfe;
    }

    select {
      cursor: pointer;
    }

    .control-group {
      border-left: 2px solid #2d2d33;
      padding-left: 12px;
      margin-top: 8px;
    }

    .control {
      display: grid;
      grid-template-columns: 60px 1fr 48px;
      gap: 10px;
      align-items: center;
      margin-bottom: 8px;
    }

    .control.compact {
      grid-template-columns: 1fr auto;
    }

    .control.single {
      grid-template-columns: 1fr;
    }

    label {
      font-size: 11px;
      color: #a8b0c2;
      font-weight: 600;
    }

    input[type="range"] {
      width: 100%;
