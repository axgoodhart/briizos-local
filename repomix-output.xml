/**
 * Studio Tool Launchers
 *
 * Handles launching external applications and URLs for studio tools.
 * Uses Electron's shell module for secure external launching.
 */

const { shell } = require('electron');
const path = require('path');
const os = require('os');

// Tool configuration with URLs and local paths
const studioTools = {
  video: {
    type: 'app',
    // On macOS, attempt to open iMovie or default video editor
    macApp: '/Applications/iMovie.app',
    fallbackUrl: null // No web fallback for video editing
  },
  website: {
    type: 'url',
    url: 'https://webflow.com' // Popular website builder
  },
  replicate: {
    type: 'url',
    url: 'https://replicate.com'
  },
  suno: {
    type: 'url',
    url: 'https://suno.ai'
  },
  dalle: {
    type: 'url',
    url: 'https://labs.openai.com'
  },
  ideogram: {
    type: 'url',
    url: 'https://ideogram.ai'
  },
  myaudio: {
    type: 'path',
    // Opens the user's Music folder
    getPath: () => path.join(os.homedir(), 'Music')
  },
  briizclerk: {
    type: 'placeholder',
    message: 'Briiz-Clerk workflow coming soon'
  }
};

/**
 * Launch a studio tool by its ID
 * @param {string} toolId - The tool identifier (e.g., 'video', 'suno')
 * @returns {Promise<{success: boolean, message: string}>}
 */
async function launchTool(toolId) {
  const tool = studioTools[toolId];

  if (!tool) {
    return {
      success: false,
      message: `Unknown tool: ${toolId}`
    };
  }

  try {
    switch (tool.type) {
      case 'url':
        // Open URL in default browser
        await shell.openExternal(tool.url);
        return {
          success: true,
          message: `Opened ${tool.url}`
        };

      case 'path':
        // Open a local folder/file
        const localPath = tool.getPath();
        const result = await shell.openPath(localPath);
        if (result) {
          // openPath returns empty string on success, error message on failure
          return {
            success: false,
            message: `Failed to open path: ${result}`
          };
        }
        return {
          success: true,
          message: `Opened ${localPath}`
        };

      case 'app':
        // Try to open a local application
        if (process.platform === 'darwin' && tool.macApp) {
          const appResult = await shell.openPath(tool.macApp);
          if (appResult) {
            // App not found, try fallback URL if available
            if (tool.fallbackUrl) {
              await shell.openExternal(tool.fallbackUrl);
              return {
                success: true,
                message: `App not found, opened ${tool.fallbackUrl}`
              };
            }
            return {
              success: false,
              message: `Application not found: ${tool.macApp}`
            };
          }
          return {
            success: true,
            message: `Opened ${tool.macApp}`
          };
        }
        // For non-Mac or no macApp defined
        if (tool.fallbackUrl) {
          await shell.openExternal(tool.fallbackUrl);
          return {
            success: true,
            message: `Opened ${tool.fallbackUrl}`
          };
        }
        return {
          success: false,
          message: 'No application configured for this platform'
        };

      case 'placeholder':
        return {
          success: false,
          message: tool.message
        };

      default:
        return {
          success: false,
          message: `Unknown tool type: ${tool.type}`
        };
    }
  } catch (error) {
    return {
      success: false,
      message: `Error launching tool: ${error.message}`
    };
  }
}

/**
 * Get information about all available studio tools
 * @returns {Object} Tool configurations (without functions)
 */
function getToolsInfo() {
  const info = {};
  for (const [id, tool] of Object.entries(studioTools)) {
    info[id] = {
      type: tool.type,
      url: tool.url || null,
      message: tool.message || null
    };
  }
  return info;
}

module.exports = {
  launchTool,
  getToolsInfo
};
</file>

<file path="electron/tool-bridge.js">
/**
 * briizOS Tool Bridge Server
 *
 * Lightweight HTTP server running in the Electron main process that exposes
 * briizOS tool operations to the LangGraph Python process. Tool requests
 * arrive via HTTP POST, get relayed to the renderer via IPC (where the
 * existing tool registry lives), and results are returned to Python.
 *
 * Flow: Python -> HTTP POST /tools/{toolName} -> IPC to renderer ->
 *       renderer executes tool -> IPC result back -> HTTP response to Python
 */

const http = require('http');
const { ipcMain } = require('electron');
const { logger } = require('./logger');

const TOOL_BRIDGE_PORT = 2025;

let mainWindow = null;
let server = null;
let pendingRequests = new Map();
let requestCounter = 0;

/**
 * Set the main BrowserWindow reference so IPC messages can be sent to the renderer.
 */
function setMainWindow(win) {
  mainWindow = win;
}

/**
 * Start the HTTP tool bridge server on port 2025 (localhost only).
 */
function start() {
  if (server) {
    logger.warn('tool-bridge', 'Server already running');
    return server;
  }

  // Register IPC handler for renderer to return tool execution results
  ipcMain.on('tool-bridge-result', (_event, { requestId, result, error }) => {
    const pending = pendingRequests.get(requestId);
    if (!pending) {
      logger.warn('tool-bridge', 'Received result for unknown request', { requestId });
      return;
    }

    clearTimeout(pending.timeout);
    pendingRequests.delete(requestId);

    if (error) {
      pending.reject(new Error(error));
    } else {
      pending.resolve(result);
    }
  });

  server = http.createServer(async (req, res) => {
    // Only allow POST requests
    if (req.method !== 'POST') {
      res.writeHead(405, { 'Content-Type': 'application/json' });
      res.end(JSON.stringify({ error: 'Method not allowed' }));
      return;
    }

    // Parse /tools/{toolName}
    const match = req.url.match(/^\/tools\/(.+)$/);
    if (!match) {
      res.writeHead(404, { 'Content-Type': 'application/json' });
      res.end(JSON.stringify({ error: 'Not found. Use POST /tools/{toolName}' }));
      return;
    }
    const toolName = decodeURIComponent(match[1]);

    // Check that the renderer window is available
    if (!mainWindow || mainWindow.isDestroyed()) {
      res.writeHead(503, { 'Content-Type': 'application/json' });
      res.end(JSON.stringify({ error: 'briizOS renderer not available' }));
      return;
    }

    // Read JSON body
    let body = '';
    req.on('data', chunk => { body += chunk; });
    req.on('end', async () => {
      try {
        const params = JSON.parse(body || '{}');
        const requestId = ++requestCounter;

        logger.info('tool-bridge', `Tool request: ${toolName}`, { requestId, params });

        // Send to renderer and wait for response via IPC
        const result = await new Promise((resolve, reject) => {
          const timeoutHandle = setTimeout(() => {
            pendingRequests.delete(requestId);
            reject(new Error(`Tool execution timed out after 30s: ${toolName}`));
          }, 30000);

          pendingRequests.set(requestId, { resolve, reject, timeout: timeoutHandle });
          mainWindow.webContents.send('tool-bridge-execute', { requestId, toolName, params });
        });

        logger.info('tool-bridge', `Tool result: ${toolName}`, { requestId, success: result?.success });

        res.writeHead(200, { 'Content-Type': 'application/json' });
        res.end(JSON.stringify(result));
      } catch (err) {
        logger.error('tool-bridge', `Tool error: ${toolName}`, err?.message);
        res.writeHead(500, { 'Content-Type': 'application/json' });
        res.end(JSON.stringify({ error: err.message }));
      }
    });
  });

  server.listen(TOOL_BRIDGE_PORT, '127.0.0.1', () => {
    logger.info('tool-bridge', `Tool bridge server listening on 127.0.0.1:${TOOL_BRIDGE_PORT}`);
  });

  server.on('error', (err) => {
    logger.error('tool-bridge', 'Server error', err?.message);
  });

  return server;
}

/**
 * Stop the HTTP tool bridge server and clean up pending requests.
 */
function stop() {
  if (server) {
    // Reject all pending requests
    for (const [id, pending] of pendingRequests) {
      clearTimeout(pending.timeout);
      pending.reject(new Error('Tool bridge shutting down'));
    }
    pendingRequests.clear();

    server.close(() => {
      logger.info('tool-bridge', 'Tool bridge server stopped');
    });
    server = null;
  }
}

module.exports = { start, stop, setMainWindow, TOOL_BRIDGE_PORT };
</file>

