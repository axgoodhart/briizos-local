<file path="src/styles/original-component-css/overlays/OrganizerModal.css">
/* =====================
   Organizer Modal Styles
   ===================== */

.organizer-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
backdrop-filter:blur(18px); 
background:rgba(0,255,255,.1);
 display: flex;
  align-items: center;
  justify-content: center;
  z-index: 500;
  perspective:500px;
  animation: fadeIn .4s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.organizer-modal {
  transform-style: preserve-3d;
  transform:rotateY(0deg);;
  width: 90%;
  max-width: 680px;
  height: 80vh;
    background: linear-gradient(135deg, #80d2972d 0%, #0115343a 100%);

filter:brightness(2);  border: 3.65px solid rgba(0, 100, 100, 0.6);
  border-radius: 12px;
  display: flex;
  border:1px solid rgba(0, 200, 200, 0.7);
  flex-direction: column;
  animation: flipUp .751s cubic-bezier(0.65, 0.35, 0.65, 1.2) forwards;
}
@keyframes flipUp {
  from {
    opacity: 0;
filter:blur(30px);
    box-shadow:0 0 40px yellow;
    transform: translateY(-120px) scale(0.0098)rotate(0deg)rotateX(50deg);
  }
  to {
    opacity: 1;
    filter:blur(0px);
    background-color:transparent;
    box-shadow:0 0 40px rgba(0,0,0,0.2);
    transform: translateY(0) scale(1)rotate(0deg)rotateX(0deg);
  }
}

/* Header */
.organizer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 20px;
  border-bottom: 1px solid rgba(0, 200, 200, 0.15);
}

.organizer-title {
  font-size: 18px;
  font-weight: 500;
  color: var(--palette-accent-cyan);
  margin: 0;
}

.organizer-close-btn {
  background: none;
  border: none;
  color: var(--palette-text-muted);
  font-size: 28px;
  cursor: pointer;
  padding: 0;
  line-height: 1;
  transition: color 0.2s ease;
}

.organizer-close-btn:hover {
  color: var(--palette-danger);
}

/* Tabs */
.organizer-tabs {
  display: flex;
  border-bottom: 1px solid rgba(0, 200, 200, 0.1);
  background: rgba(0, 30, 50, 0.3);
}

.organizer-tab {
  flex: 1;
  padding: 12px 16px;
  background: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  color: white;
  font-size: 12px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.organizer-tab:hover {
  color: skyblue;
  background: rgba(0, 200, 200, 0.05);
}

.organizer-tab.active {
  color: lime;
  border-bottom-color: var(--palette-accent-cyan);
  background: rgba(0, 200, 200, 0.08);
}

.tab-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
