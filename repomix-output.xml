import { useEffect, useRef } from 'react';
import logger from '../lib/logger';
import { addChatMessage, addLog, addRemoteChatMessage } from '../lib/firestore';
import { getCurrentUid } from '../lib/firebase';
import { startAgentWorkers, stopAgentWorkers } from '../lib/agentJobsFirestore';

const AGENT_WORKER_COUNT = 3;

export function useAgentWorkers(executeTool, appContext) {
  const uid = getCurrentUid();
  const executeToolRef = useRef(executeTool);
  const appContextRef = useRef(appContext);

  useEffect(() => {
    executeToolRef.current = executeTool;
  }, [executeTool]);

  useEffect(() => {
    appContextRef.current = appContext;
  }, [appContext]);

  useEffect(() => {
    if (!uid) return;

    let cancelled = false;

    const startWorkers = async () => {
      try {
        await startAgentWorkers({
          uid,
          workerCount: AGENT_WORKER_COUNT,
          executeTool: async (toolName, params) =>
            executeToolRef.current(toolName, params, appContextRef.current),
          onJobResult: async ({ job, result }) => {
            if (cancelled) return;
            if (job?.source?.kind !== 'chat-tool-call') return;

            const resultText = result?.summary || result?.message || JSON.stringify(result);
            await addChatMessage('assistant', `[${job.tool}] ${resultText}`);

            addLog('tool_result', `${job.tool}: ${String(resultText)}`.slice(0, 1200))
              .catch(err => logger.debug('agent-jobs', 'Failed to write tool_result log', err?.message));

            if (job?.source?.remoteReply) {
              try {
                await addRemoteChatMessage('assistant', `[${job.tool}] ${resultText}`);
              } catch (e) {
                logger.debug('agent-jobs', 'Failed to write remote tool result', e?.message);
              }
            }
          },
          onJobError: async ({ job, error, terminal }) => {
            if (cancelled) return;
            if (!terminal) return;
            if (job?.source?.kind !== 'chat-tool-call') return;

            const msg = error?.message || String(error);
            await addChatMessage('assistant', `[Error: ${job?.tool || 'job'}] ${msg}`, true);

            addLog('tool_error', `${job?.tool || 'job'}: ${msg}`.slice(0, 1200))
              .catch(err => logger.debug('agent-jobs', 'Failed to write tool_error log', err?.message));
          },
        });
      } catch (error) {
        logger.error('agent-jobs', 'Failed to start autonomous workers', error?.message);
      }
    };

    startWorkers();

    return () => {
      cancelled = true;
      stopAgentWorkers(uid).catch((error) => {
        logger.debug('agent-jobs', 'Failed to stop autonomous workers', error?.message);
      });
    };
  }, [uid]);
}

export default useAgentWorkers;
</file>

<file path="src/hooks/useAppContext.js">
import { useState, useEffect, useMemo } from 'react';
import { subscribeNotes, subscribeTasks, subscribeProjects, subscribeAllSchedule } from '../lib/firestore';
import { getCurrentUid } from '../lib/firebase';

/**
 * Subscribes to notes, tasks, events, projects from Firestore.
 * Returns state snapshot for system prompt builder.
 */
export function useAppContext() {
  const [notes, setNotes] = useState([]);
  const [tasks, setTasks] = useState([]);
  const [events, setEvents] = useState([]);
  const [projects, setProjects] = useState([]);

  // Re-check uid each render so effect re-runs when auth becomes ready
  const uid = getCurrentUid();

  useEffect(() => {
    if (!uid) return;

    const unsubs = [];

    unsubs.push(subscribeNotes((data) => setNotes(data)));

    unsubs.push(subscribeTasks((data) => {
      // Flatten tasks + subtasks into a single list for context
      const flat = [];
      for (const task of data) {
        flat.push(task);
        if (task.subtasks) {
          flat.push(...task.subtasks);
        }
      }
      setTasks(flat);
    }));

    unsubs.push(subscribeAllSchedule((data) => setEvents(data)));

    unsubs.push(subscribeProjects((data) => setProjects(data)));

    return () => {
      unsubs.forEach(fn => fn());
    };
  }, [uid]);

  return useMemo(() => ({ notes, tasks, events, projects }), [notes, tasks, events, projects]);
}

export default useAppContext;
</file>

<file path="src/hooks/useCanvases.js">
import { useState, useEffect, useCallback, useRef } from 'react';
import logger from '../lib/logger';
import { CANVAS_RENDER_ENGINES } from '../lib/canvasUtils';

// The canvas library is backed by the Electron IPC canvas store
// (flat HTML files at {appData}/briizOS/canvas/). Metadata — form
// factor, display name, source — is persisted per-canvas in sidecar
// ".meta.json" files alongside the HTML. The hook owns the list state
// and exposes CRUD helpers that all ultimately call through
// window.api.canvas*.

const api = typeof window !== 'undefined' && window.api ? window.api : null;
const hasCanvasApi = !!(api && api.canvasList);

const DEFAULT_META = Object.freeze({
  formFactor: 'float',
  source: 'ai',
  renderEngine: CANVAS_RENDER_ENGINES.IFRAME,
  url: '',
});

function normalizeEntry(entry) {
  if (!entry) return null;
  return {
    id: entry.filename,
    filename: entry.filename,
    title: entry.title || entry.filename,
    size: entry.size || 0,
    formFactor: entry.formFactor || DEFAULT_META.formFactor,
    source: entry.source || DEFAULT_META.source,
    renderEngine: entry.renderEngine || DEFAULT_META.renderEngine,
    url: entry.url || DEFAULT_META.url,
    createdAt: entry.createdAt || null,
    updatedAt: entry.updatedAt || null,
  };
}

export function useCanvases() {
  const [canvases, setCanvases] = useState([]);
  const [isLoading, setIsLoading] = useState(true);
  const mountedRef = useRef(true);

  const refresh = useCallback(async () => {
    if (!hasCanvasApi) {
      setCanvases([]);
      setIsLoading(false);
      return [];
    }
    try {
      const raw = await api.canvasList();
      const list = Array.isArray(raw) ? raw.map(normalizeEntry).filter(Boolean) : [];
      if (mountedRef.current) {
        setCanvases(list);
        setIsLoading(false);
      }
      return list;
    } catch (err) {
      logger.error('canvases', 'Failed to list canvases', { error: String(err) });
      if (mountedRef.current) {
        setCanvases([]);
        setIsLoading(false);
      }
      return [];
    }
  }, []);

  useEffect(() => {
    mountedRef.current = true;
    refresh();
    return () => { mountedRef.current = false; };
  }, [refresh]);

  const loadHtml = useCallback(async (filename) => {
    if (!hasCanvasApi) return '';
    try {
      const html = await api.canvasLoad(filename);
      return html || '';
    } catch (err) {
      logger.error('canvases', 'Failed to load canvas HTML', { filename, error: String(err) });
      return '';
    }
  }, []);

  const loadMeta = useCallback(async (filename) => {
    if (!hasCanvasApi) return { ...DEFAULT_META };
    try {
      const meta = await api.canvasLoadMeta(filename);
      return { ...DEFAULT_META, ...(meta || {}) };
    } catch (err) {
      logger.error('canvases', 'Failed to load canvas meta', { filename, error: String(err) });
      return { ...DEFAULT_META };
    }
  }, []);

  const saveMeta = useCallback(async (filename, meta) => {
    if (!hasCanvasApi) return { success: false };
    try {
      const res = await api.canvasSaveMeta(filename, meta);
      if (res?.success) {
        logger.info('canvases', 'Canvas meta saved', { filename, meta });
      }
      await refresh();
      return res || { success: false };
    } catch (err) {
      logger.error('canvases', 'Failed to save canvas meta', { filename, error: String(err) });
      return { success: false, error: String(err) };
    }
  }, [refresh]);

  // Create a new canvas from raw HTML + initial meta. Returns the
  // saved entry (with filename) or null on failure.
  const createCanvas = useCallback(async ({
    title,
    html,
    formFactor = 'float',
    source = 'ai',
    meta = {},
  }) => {
    if (!hasCanvasApi) return null;
    const safeTitle = (title || 'Untitled Canvas').trim() || 'Untitled Canvas';
    try {
      const saveRes = await api.canvasSave(safeTitle, html || '<!doctype html><html><body></body></html>');
      if (!saveRes?.success || !saveRes.filename) {
        logger.error('canvases', 'Canvas save failed', { title: safeTitle, saveRes });
        return null;
      }
      const metaRes = await api.canvasSaveMeta(saveRes.filename, {
        displayName: safeTitle,
        formFactor,
        source,
        renderEngine: meta.renderEngine || (source === 'url' ? CANVAS_RENDER_ENGINES.BROWSER : CANVAS_RENDER_ENGINES.IFRAME),
        url: meta.url || '',
      });
      logger.info('canvases', 'Canvas created', {
        filename: saveRes.filename,
        title: safeTitle,
        formFactor,
        source,
      });
      await refresh();
      return {
        id: saveRes.filename,
        filename: saveRes.filename,
        title: safeTitle,
        formFactor,
        source,
        renderEngine: metaRes?.meta?.renderEngine || meta.renderEngine || DEFAULT_META.renderEngine,
        url: metaRes?.meta?.url || meta.url || '',
        meta: metaRes?.meta || {},
      };
    } catch (err) {
      logger.error('canvases', 'Failed to create canvas', { title: safeTitle, error: String(err) });
      return null;
    }
  }, [refresh]);

  const deleteCanvas = useCallback(async (filename) => {
    if (!hasCanvasApi) return { success: false };
    try {
      const res = await api.canvasDelete(filename);
      if (res?.success) {
        logger.info('canvases', 'Canvas deleted', { filename });
      } else {
        logger.error('canvases', 'Canvas delete failed', { filename, res });
      }
      await refresh();
      return res || { success: false };
    } catch (err) {
      logger.error('canvases', 'Failed to delete canvas', { filename, error: String(err) });
      return { success: false, error: String(err) };
    }
  }, [refresh]);

  const renameCanvas = useCallback(async (filename, newTitle) => {
    if (!hasCanvasApi) return { success: false };
    const safeTitle = String(newTitle || '').trim();
    if (!safeTitle) return { success: false, error: 'Empty title' };
    try {
      const res = await api.canvasRename(filename, safeTitle);
      if (res?.success) {
        logger.info('canvases', 'Canvas renamed', {
          oldFilename: filename,
          newFilename: res.filename,
          newTitle: safeTitle,
        });
      } else {
        logger.error('canvases', 'Canvas rename failed', { filename, res });
      }
      await refresh();
      return res || { success: false };
    } catch (err) {
      logger.error('canvases', 'Failed to rename canvas', { filename, error: String(err) });
      return { success: false, error: String(err) };
    }
  }, [refresh]);

  const setFormFactor = useCallback(async (filename, formFactor) => {
    if (!hasCanvasApi) return { success: false };
    try {
      const existing = await api.canvasLoadMeta(filename);
      const next = { ...(existing || {}), formFactor };
      const res = await api.canvasSaveMeta(filename, next);
      if (res?.success) {
        logger.info('canvases', 'Canvas form factor changed', { filename, formFactor });
      }
      await refresh();
      return res || { success: false };
    } catch (err) {
      logger.error('canvases', 'Failed to set canvas form factor', { filename, error: String(err) });
      return { success: false, error: String(err) };
    }
  }, [refresh]);

  const setRenderEngine = useCallback(async (filename, renderEngine) => {
    if (!hasCanvasApi) return { success: false };
    try {
      const existing = await api.canvasLoadMeta(filename);
      const next = { ...(existing || {}), renderEngine };
      const res = await api.canvasSaveMeta(filename, next);
      if (res?.success) {
        logger.info('canvases', 'Canvas render engine changed', { filename, renderEngine });
      }
      await refresh();
      return res || { success: false };
    } catch (err) {
      logger.error('canvases', 'Failed to set canvas render engine', { filename, error: String(err) });
      return { success: false, error: String(err) };
    }
  }, [refresh]);

  return {
    canvases,
    isLoading,
    refresh,
    loadHtml,
    loadMeta,
    saveMeta,
    createCanvas,
    deleteCanvas,
    renameCanvas,
    setFormFactor,
    setRenderEngine,
  };
}

export default useCanvases;
</file>

<file path="src/hooks/useDraggable.js">
import { useState, useEffect, useRef, useCallback } from 'react';

/**
 * useDraggable - Reusable hook for drag + resize behavior.
 *
 * @param {Object} options
 * @param {(id: string, pos: {x: number, y: number}) => void} options.onDragEnd
 * @param {(id: string, size: {width: number, height: number}) => void} options.onResizeEnd
 */
export default function useDraggable({ onDragEnd, onResizeEnd } = {}) {
  const [draggingId, setDraggingId] = useState(null);
  const [resizingId, setResizingId] = useState(null);

  // Live position/size stored in refs to avoid re-rendering everything
  const dragRef = useRef(null);   // { id, offsetX, offsetY, x, y }
  const resizeRef = useRef(null); // { id, startMouseX, startMouseY, startWidth, startHeight, width, height }

  // Force-update counter so the dragged/resized element can re-render
  const [, setTick] = useState(0);

  const handleDragStart = useCallback((id, e, { x, y }) => {
    dragRef.current = {
      id,
      offsetX: e.clientX - x,
      offsetY: e.clientY - y,
      x,
      y,
    };
    setDraggingId(id);
  }, []);

  const handleResizeStart = useCallback((id, e, { width, height }) => {
    e.stopPropagation();
    e.preventDefault();
    resizeRef.current = {
      id,
      startMouseX: e.clientX,
      startMouseY: e.clientY,
      startWidth: width,
      startHeight: height,
      width,
      height,
    };
    setResizingId(id);
  }, []);

  const getPosition = useCallback((id) => {
    if (dragRef.current && dragRef.current.id === id) {
      return { x: dragRef.current.x, y: dragRef.current.y };
    }
    return null;
  }, []);

  const getSize = useCallback((id) => {
    if (resizeRef.current && resizeRef.current.id === id) {
      return { width: resizeRef.current.width, height: resizeRef.current.height };
    }
    return null;
  }, []);

  useEffect(() => {
    if (!draggingId && !resizingId) return;

    const onMouseMove = (e) => {
      if (dragRef.current) {
        dragRef.current.x = e.clientX - dragRef.current.offsetX;
        dragRef.current.y = e.clientY - dragRef.current.offsetY;
        setTick((t) => t + 1);
      }

      if (resizeRef.current) {
        const dx = e.clientX - resizeRef.current.startMouseX;
        const dy = e.clientY - resizeRef.current.startMouseY;
        resizeRef.current.width = Math.max(180, resizeRef.current.startWidth + dx);
        resizeRef.current.height = Math.max(120, resizeRef.current.startHeight + dy);
        setTick((t) => t + 1);
      }
    };

    const onMouseUp = () => {
      if (dragRef.current) {
        const { id, x, y } = dragRef.current;
        dragRef.current = null;
        setDraggingId(null);
        onDragEnd?.(id, { x, y });
      }

      if (resizeRef.current) {
        const { id, width, height } = resizeRef.current;
        resizeRef.current = null;
        setResizingId(null);
        onResizeEnd?.(id, { width, height });
      }
    };

    window.addEventListener('mousemove', onMouseMove);
    window.addEventListener('mouseup', onMouseUp);
    return () => {
      window.removeEventListener('mousemove', onMouseMove);
      window.removeEventListener('mouseup', onMouseUp);
    };
  }, [draggingId, resizingId, onDragEnd, onResizeEnd]);

  return {
    draggingId,
    resizingId,
    handleDragStart,
    handleResizeStart,
    getPosition,
    getSize,
  };
}
</file>

<file path="src/hooks/useModelSelection.js">
// useModelSelection.js
import { useState, useEffect, useCallback } from 'react';

const STORAGE_KEY = 'briizos-selected-model';

export function useModelSelection() {
  const [models, setModels] = useState([]);
  const [apiKeyStatus, setApiKeyStatus] = useState({ anthropic: false, openai: false, google: false });
  const [selectedModel, setSelectedModel] = useState(() => localStorage.getItem(STORAGE_KEY) || null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);

  // Fetch models and API key status on mount
  useEffect(() => {
    async function load() {
      try {
        const [modelList, keyStatus] = await Promise.all([
          window.api.getModels(),
          window.api.checkApiKeys(),
        ]);
        setModels(modelList || []);
        setApiKeyStatus(keyStatus || {});
        // If no model selected yet, or selected model no longer exists, pick first available
        if (modelList?.length > 0) {
          const stored = localStorage.getItem(STORAGE_KEY);
          const stillExists = modelList.some(m => m.name === stored);
          if (!stored || !stillExists) {
            const firstAvailable = modelList[0]?.name;
            setSelectedModel(firstAvailable);
            localStorage.setItem(STORAGE_KEY, firstAvailable);
          }
        }
      } catch (err) {
        setError(err.message);
      } finally {
        setLoading(false);
      }
    }
    load();
  }, []);

  // Select a model — persist to localStorage
  const selectModel = useCallback((modelName) => {
    setSelectedModel(modelName);
    localStorage.setItem(STORAGE_KEY, modelName);
  }, []);

  // Group models by provider for display
  const modelsByProvider = models.reduce((acc, model) => {
    const provider = model.provider || 'other';
    if (!acc[provider]) acc[provider] = [];
    acc[provider].push(model);
    return acc;
  }, {});

  // Check if a specific model's provider has API key configured
  const isModelAvailable = useCallback((model) => {
    const provider = model.provider || 'other';
    return apiKeyStatus[provider] === true;
  }, [apiKeyStatus]);

  return {
    models,
    modelsByProvider,
    selectedModel,
    selectModel,
    apiKeyStatus,
    isModelAvailable,
    loading,
    error,
  };
}
</file>

<file path="src/hooks/useRecorder.js">
import { useState, useEffect, useCallback } from 'react';
import logger from '../lib/logger';
import {
  subscribeSessions,
  createSession,
  endSession,
  addSessionEvent,
  getSession as getSessionFirestore,
  deleteSession as deleteSessionFirestore,
  renameSession as renameSessionFirestore,
  exportSession as exportSessionFirestore,
} from '../lib/firestore';
import { getCurrentUid } from '../lib/firebase';

export function useRecorder() {
  const [isRecording, setIsRecording] = useState(false);
  const [activeSession, setActiveSession] = useState(null);
  const [sessions, setSessions] = useState([]);
  const [isLoading, setIsLoading] = useState(true);

  // Subscribe to sessions from Firestore
  useEffect(() => {
    const uid = getCurrentUid();
    if (!uid) {
      setIsLoading(false);
      return;
    }

    const unsubscribe = subscribeSessions((firestoreSessions) => {
      setSessions(firestoreSessions);
      setIsLoading(false);
    });

    return () => unsubscribe();
  }, []);

  // Start recording a new session
  const startRecording = useCallback(async (name) => {
    try {
      const timestamp = new Date().toISOString().slice(0, 19).replace('T', ' ');
      const sessionName = name || `Session ${timestamp}`;
      const session = await createSession(sessionName);
      setActiveSession(session);
      setIsRecording(true);
      return session;
    } catch (error) {
      logger.error('ui', 'Failed to start recording', error?.message);
      throw error;
    }
  }, []);

  // Stop the current recording
  const stopRecording = useCallback(async () => {
    if (!activeSession) return null;

    try {
      await endSession(activeSession.id);
      const endedSession = { ...activeSession };
      setActiveSession(null);
      setIsRecording(false);
      return endedSession;
    } catch (error) {
      logger.error('ui', 'Failed to stop recording', error?.message);
      throw error;
    }
  }, [activeSession]);

  // Toggle recording on/off
  const toggleRecording = useCallback(async (name) => {
    if (isRecording) {
      return await stopRecording();
    } else {
      return await startRecording(name);
    }
  }, [isRecording, startRecording, stopRecording]);

  // Record an event to the current session
  const recordEvent = useCallback(async (eventType, eventData) => {
    if (!isRecording || !activeSession) return;
    try {
      await addSessionEvent(activeSession.id, eventType, eventData);
    } catch (error) {
      logger.error('ui', 'Failed to record event', error?.message);
    }
  }, [isRecording, activeSession]);

  // Get a specific session with full data
  const getSession = useCallback(async (sessionId) => {
    try {
      return await getSessionFirestore(sessionId);
    } catch (error) {
      logger.error('ui', 'Failed to get session', error?.message);
      throw error;
    }
  }, []);

  // Delete a session
  const deleteSession = useCallback(async (sessionId) => {
    try {
      await deleteSessionFirestore(sessionId);
    } catch (error) {
      logger.error('ui', 'Failed to delete session', error?.message);
      throw error;
    }
  }, []);

  // Rename a session
  const renameSession = useCallback(async (sessionId, newName) => {
    try {
      await renameSessionFirestore(sessionId, newName);
    } catch (error) {
      logger.error('ui', 'Failed to rename session', error?.message);
      throw error;
    }
  }, []);

  // Export a session as JSON
  const exportSession = useCallback(async (sessionId) => {
    try {
      return await exportSessionFirestore(sessionId);
    } catch (error) {
      logger.error('ui', 'Failed to export session', error?.message);
      throw error;
    }
  }, []);

  return {
    isRecording,
    activeSession,
    sessions,
    isLoading,
    startRecording,
    stopRecording,
    toggleRecording,
    recordEvent,
    getSession,
    deleteSession,
    renameSession,
    exportSession,
    fetchSessions: () => {}, // No-op; real-time subscription handles this
  };
}

export default useRecorder;
</file>

<file path="src/hooks/useToolBridge.js">
/**
 * useToolBridge - React hook that handles tool execution requests from the
 * Electron main process tool bridge.
 *
 * When the LangGraph Python agent calls a briizOS tool, the request flows:
 *   Python -> HTTP POST -> tool-bridge.js (main) -> IPC -> renderer
 *
 * This hook listens for those IPC messages, looks up the tool in the existing
 * tools registry (src/lib/tools.js), executes it, and sends the result back
 * via IPC so the HTTP response can complete.
 *
 * Mount this hook once in AppContent (App.jsx).
 */

import { useEffect } from 'react';
import { getToolRegistry } from '../lib/tools';
import logger from '../lib/logger';

/**
 * @param {Function} executeTool - The executeTool function from ToolContext
 *   that handles confirmation gates. For bridge calls we bypass confirmation
 *   by passing __agentAuto: true.
 * @param {Object} appContext - The app context object (tasks, notes, events)
 *   passed to tool handlers for data lookups.
 */
export function useToolBridge(executeTool, appContext) {
  useEffect(() => {
    if (!window.api?.onToolBridgeExecute) {
      logger.debug('tool-bridge', 'Preload bindings not available, skipping tool bridge setup');
      return;
    }

    const cleanup = window.api.onToolBridgeExecute(async ({ requestId, toolName, params }) => {
      logger.info('tool-bridge', `Renderer received tool request: ${toolName}`, { requestId });

      try {
        const registry = getToolRegistry();
        const tool = registry[toolName];

        if (!tool) {
          const error = `Unknown tool: ${toolName}`;
          logger.warn('tool-bridge', error);
          window.api.toolBridgeResult(requestId, null, error);
          return;
        }

        // Execute the tool handler directly, bypassing confirmation gates.
        // The __agentAuto flag is the existing pattern in ToolContext.jsx for
        // agent-initiated tool calls that should not prompt the user.
        const result = await tool.handler(
          { ...params, __agentAuto: true },
          appContext,
        );

        logger.info('tool-bridge', `Tool executed: ${toolName}`, { requestId, success: result?.success });
        window.api.toolBridgeResult(requestId, result, null);
      } catch (err) {
        logger.error('tool-bridge', `Tool execution failed: ${toolName}`, err?.message);
        window.api.toolBridgeResult(requestId, null, err?.message || 'Tool execution failed');
      }
    });

    return cleanup;
  }, [executeTool, appContext]);
}

export default useToolBridge;
</file>

<file path="src/lib/bfast-format.js">
/**
 * bfast-format — prose helpers for the BfastBundle.
 *
 * Margerins show a pre-hoc intent label ("Add event 'Lunch' on Apr 10?").
 * Toasts show a post-hoc receipt ("Added 'Lunch' on Apr 10."). This file
 * owns the switch statements that map (toolName, params) → human text
 * for both forms so the UI components stay dumb and the executor in
 * briizos-tools.js has a single place to call for either framing.
 *
 * Guiding principle: action-oriented, present-tense or imperative for
 * margerins ("Add X?", "Move X to Y?"), past-tense or plain-verb for
 * toasts ("Added X.", "Moved X to Y."). Keep labels short — under ~60
 * chars — since they live inside a pill.
 *
 * When a tool name isn't covered, we fall back to a readable default
 * generated from the tool name's camelCase words and the first few
 * params so new tools show something reasonable without needing a
 * bespoke case first.
 */

// ---------- utilities ----------

function camelToWords(s) {
  return String(s)
    .replace(/([a-z])([A-Z])/g, '$1 $2')
    .replace(/^./, (c) => c.toUpperCase());
}

function quote(v) {
  if (v == null) return '';
  const s = String(v).trim();
  if (!s) return '';
  return `'${s.length > 32 ? s.slice(0, 29) + '…' : s}'`;
}

function shortDate(d) {
  if (!d) return '';
  // Accept 'YYYY-MM-DD' or a Date-like string.
  const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(d));
  if (!m) return String(d);
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const mi = parseInt(m[2], 10) - 1;
  const day = parseInt(m[3], 10);
  if (mi < 0 || mi > 11) return String(d);
  return `${months[mi]} ${day}`;
}

function shortTime(t) {
  if (!t) return '';
  return String(t).trim();
}

// ---------- margerin labels (pre-hoc, question form) ----------

const MARGERIN_FORMATTERS = {
  // Calendar
  createSingleCalendarEvent: (p) => {
    const when = [shortDate(p.date), shortTime(p.time)].filter(Boolean).join(' ');
    return `Add event ${quote(p.title)}${when ? ' on ' + when : ''}?`;
  },
  createRecurringCalendarEvent: (p) => {
    const cadence = p.recurrence_type ? ` (${p.recurrence_type})` : '';
    return `Add recurring event ${quote(p.title)}${cadence}?`;
  },
  updateCalendarEvent: (p) => {
    const to = p.new_date ? ' to ' + shortDate(p.new_date) : '';
    return `Move ${quote(p.event_title)}${to}?`;
  },

  // Tasks
  completeTask: (p) => `Complete task ${quote(p.task_id)}?`,
  createThoughtStream: (p) => `Jot ${quote(p.text)}?`,
  createPrioritizedTaskList: (p) => `Build task list for ${quote(p.criteria)}?`,

  // Notes
  createNotePanel: (p) => `Create note ${quote(p.title)}?`,
  updateNoteContent: (p) => {
    const mode = p.mode === 'replace' ? 'Replace' : 'Append to';
    return `${mode} note ${quote(p.panel_id)}?`;
  },

  // Panels
  openPanel: (p) => `Open ${quote(p.panel_title)}?`,
  setPanelColor: (p) => `Recolor ${quote(p.panel_id)}?`,
  movePanel: (p) => `Move ${quote(p.panel_id)}?`,
  resizePanel: (p) => `Resize ${quote(p.panel_id)}?`,
  duplicatePanel: (p) => `Duplicate ${quote(p.panel_id)}?`,
  deletePanel: (p) => `Delete ${quote(p.panel_id)}?`,
  minimizePanel: (p) => `Minimize ${quote(p.panel_id)}?`,
  restorePanel: (p) => `Restore ${quote(p.panel_id)}?`,
  setPanelTitle: (p) => `Rename to ${quote(p.new_title)}?`,

  // Workspace
  tilePanels: () => 'Tile all panels?',
  groupPanelsByType: () => 'Group panels by type?',
  stackPanelsVertically: () => 'Stack panels vertically?',
  focusMode: (p) => `Focus on ${quote(p.panel_id)}?`,
  minimizeAllPanels: () => 'Minimize all panels?',
  closeAllPanels: () => 'Close all panels?',

  // Misc
  startTimer: (p) => {
    const t = quote(p.title) || 'timer';
    return `Start ${t} for ${p.duration_minutes ?? '?'} min?`;
  },
};

// ---------- toast messages (post-hoc, past-tense) ----------

const TOAST_FORMATTERS = {
  createSingleCalendarEvent: (p) => {
    const when = [shortDate(p.date), shortTime(p.time)].filter(Boolean).join(' ');
    return `Added ${quote(p.title)}${when ? ' on ' + when : ''}.`;
  },
  createRecurringCalendarEvent: (p) => `Added recurring ${quote(p.title)}.`,
  updateCalendarEvent: (p) => {
    const to = p.new_date ? ' to ' + shortDate(p.new_date) : '';
    return `Moved ${quote(p.event_title)}${to}.`;
  },
  completeTask: (p) => `Completed ${quote(p.task_id)}.`,
  createThoughtStream: (p) => `Jotted ${quote(p.text)}.`,
  createPrioritizedTaskList: (p) => `Built list for ${quote(p.criteria)}.`,
  createNotePanel: (p) => `Note ${quote(p.title)} created.`,
  updateNoteContent: (p) => `Note ${quote(p.panel_id)} updated.`,
  openPanel: (p) => `Opened ${quote(p.panel_title)}.`,
  setPanelColor: (p) => `Recolored ${quote(p.panel_id)}.`,
  movePanel: (p) => `Moved ${quote(p.panel_id)}.`,
  resizePanel: (p) => `Resized ${quote(p.panel_id)}.`,
  duplicatePanel: (p) => `Duplicated ${quote(p.panel_id)}.`,
  deletePanel: (p) => `Deleted ${quote(p.panel_id)}.`,
  minimizePanel: (p) => `Minimized ${quote(p.panel_id)}.`,
  restorePanel: (p) => `Restored ${quote(p.panel_id)}.`,
  setPanelTitle: (p) => `Renamed to ${quote(p.new_title)}.`,
  tilePanels: () => 'Panels tiled.',
  groupPanelsByType: () => 'Panels grouped.',
  stackPanelsVertically: () => 'Panels stacked.',
  focusMode: (p) => `Focused on ${quote(p.panel_id)}.`,
  minimizeAllPanels: () => 'All panels minimized.',
  closeAllPanels: () => 'All panels closed.',
  startTimer: (p) => {
    const t = quote(p.title) || 'Timer';
    return `${t} started for ${p.duration_minutes ?? '?'} min.`;
  },
};

// ---------- public API ----------

/**
 * Format a pre-hoc margerin label from a tool name + params.
 * Falls back to "Run Tool Name?" if no bespoke formatter is registered.
 */
export function formatMargerinLabel(toolName, params = {}) {
  const fn = MARGERIN_FORMATTERS[toolName];
  if (fn) {
    try {
      return fn(params);
    } catch {
      /* fall through to default */
    }
  }
  return `${camelToWords(toolName)}?`;
}

/**
 * Format a post-hoc success toast message from a tool name + params.
 * Falls back to "Tool name ran." if no bespoke formatter is registered.
 */
export function formatToastMessage(toolName, params = {}) {
  const fn = TOAST_FORMATTERS[toolName];
  if (fn) {
    try {
      return fn(params);
    } catch {
      /* fall through to default */
    }
  }
  return `${camelToWords(toolName)} ran.`;
}
</file>

<file path="src/lib/bfast-queue.js">
/**
 * bfast-queue — the module-level state + pub/sub for the BfastBundle
 * (Toast, Snackbar, Margerin) UI family.
 *
 * This file is the non-React brain of the bundle. React components in
 * src/components/bfast subscribe to it via `subscribe()`, and callers
 * anywhere in the renderer (useChat → BriizTools.executeToolInternal
 * for the chat path, imperative `toast()`/`snackbar()` calls from
 * anywhere) push into it via the API below.
 *
 * Conceptual model: one ordered queue of pending "actions" where each
 * action is one of three kinds:
 *
 *   - 'margerin'  — pre-hoc intent hold. Has a pending Promise that
 *                   stays unresolved until the user taps ✓ / ✕ / 💬.
 *                   Defaults to ✓ (approve). Supports scroll-wheel
 *                   rotation between the three icons while the pointer
 *                   is over the pill.
 *
 *   - 'toast'     — post-hoc fire-and-forget receipt. Auto-dismisses
 *                   after `durationMs` (default 2500).
 *
 *   - 'snackbar'  — post-hoc receipt with one optional action. Auto-
 *                   dismisses after `durationMs` (default 5000) unless
 *                   the user taps the action.
 *
 * Margerins are gating: the caller awaits enqueueMargerin() and blocks
 * on the user's decision. Toasts and snackbars are non-gating: the
 * caller returns immediately and the bundle handles their lifecycle.
 *
 * This file has NO React imports. It can be used from any module and
 * is tree-shakeable.
 */

// ---------- internal state ----------

let _state = {
  /** Queue of actions awaiting presentation / dismissal. */
  actions: [],
};

const _listeners = new Set();

/** Listeners specifically for the 💬-chat-return event. */
const _chatReturnListeners = new Set();

function _nextId() {
  return `bfast-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
}

function _notify() {
  for (const fn of _listeners) fn(_state);
}

function _update(producer) {
  _state = producer(_state);
  _notify();
}

// ---------- subscription API (consumed by React) ----------

/**
 * Subscribe to state changes. Returns an unsubscribe function.
 * The listener is called immediately with the current state so that
 * useSyncExternalStore can snapshot correctly.
 */
export function subscribe(listener) {
  _listeners.add(listener);
  listener(_state);
  return () => _listeners.delete(listener);
}

/** Snapshot of the current state. */
export function getState() {
  return _state;
}

/**
 * Subscribe to chat-return events. Fired when the user taps 💬 on a
 * margerin. The listener receives `{ toolName, params, label }`.
 * InteractionPanel uses this to focus the textarea and prepend a
 * "re:" quote.
 */
export function onChatReturn(listener) {
  _chatReturnListeners.add(listener);
  return () => _chatReturnListeners.delete(listener);
}

function _emitChatReturn(payload) {
  for (const fn of _chatReturnListeners) {
    try { fn(payload); } catch (err) { console.warn('[bfast] chat-return listener threw', err); }
  }
}

// ---------- margerin API ----------

/**
 * Enqueue a margerin and return a Promise that resolves/rejects based
 * on the user's decision.
 *
 * Resolution shape:
 *   - ✓  →  resolve({ __approved: true })
 *   - ✕  →  reject(Error('Action cancelled by user'))
 *   - 💬 →  reject(Error with .__returnedToChat = true)
 *
 * Callers in briizos-tools.js interpret these three outcomes:
 *   - __approved: run the real handler
 *   - cancelled: propagate the error so the tool card shows "failed"
 *   - __returnedToChat: propagate a special error so useChat suppresses
 *     the tool-failed card and the InteractionPanel handler takes over
 *     to refocus the input and prepend the "re:" quote.
 */
export function enqueueMargerin({ toolName, params, label }) {
  return new Promise((resolve, reject) => {
    const id = _nextId();
    _update((s) => ({
      ...s,
      actions: [
        ...s.actions,
        {
          id,
          kind: 'margerin',
          toolName,
          params,
          label,
          selectedIcon: 'check',
          createdAt: Date.now(),
          _resolve: resolve,
          _reject: reject,
        },
      ],
    }));
  });
}

/**
 * Rotate the currently-selected icon on a margerin. Called by the
 * Margerin component in response to wheel events. Cycles through
 * ['check', 'x', 'chat'] in the direction indicated.
 */
export function rotateSelectedIcon(id, direction) {
  const order = ['check', 'x', 'chat'];
  _update((s) => ({
    ...s,
    actions: s.actions.map((a) => {
      if (a.id !== id || a.kind !== 'margerin') return a;
      const i = order.indexOf(a.selectedIcon);
      const next = direction > 0
        ? order[(i + 1) % order.length]
        : order[(i - 1 + order.length) % order.length];
      return { ...a, selectedIcon: next };
    }),
  }));
}

/**
 * Explicitly set the selected icon on a margerin. Called when the user
 * directly clicks one of the three icons rather than scrolling.
 */
export function setSelectedIcon(id, icon) {
  if (!['check', 'x', 'chat'].includes(icon)) return;
  _update((s) => ({
    ...s,
    actions: s.actions.map((a) =>
      a.id === id && a.kind === 'margerin' ? { ...a, selectedIcon: icon } : a,
    ),
  }));
}

/**
 * Commit a margerin: run the action corresponding to `icon` (or the
 * currently-selected icon if `icon` is omitted). Removes the action
 * from the queue and resolves/rejects its Promise.
 */
export function commitMargerin(id, icon = null) {
  const action = _state.actions.find((a) => a.id === id && a.kind === 'margerin');
  if (!action) return;
  const chosen = icon || action.selectedIcon || 'check';
  _update((s) => ({
    ...s,
    actions: s.actions.filter((a) => a.id !== id),
  }));

  if (chosen === 'check') {
    action._resolve({ __approved: true });
  } else if (chosen === 'x') {
    action._reject(new Error('Action cancelled by user'));
  } else if (chosen === 'chat') {
    const err = new Error('Returned to chat for refinement');
    err.__returnedToChat = true;
    err.__toolName = action.toolName;
    err.__params = action.params;
    err.__label = action.label;
    action._reject(err);
    _emitChatReturn({
      toolName: action.toolName,
      params: action.params,
      label: action.label,
    });
  }
}

// ---------- toast API ----------

/**
 * Enqueue a toast. Returns the action id so callers can dismiss early
 * if needed.
 *
 * @param {string} message
 * @param {object} opts
 * @param {'info'|'success'|'error'} [opts.tone='info']
 * @param {number} [opts.durationMs=2500]
 */
export function toast(message, opts = {}) {
  const id = _nextId();
  const durationMs = opts.durationMs ?? 2500;
  _update((s) => ({
    ...s,
    actions: [
      ...s.actions,
      {
        id,
        kind: 'toast',
        message,
        tone: opts.tone || 'info',
        createdAt: Date.now(),
        durationMs,
      },
    ],
  }));
  if (durationMs > 0) {
    setTimeout(() => dismiss(id), durationMs);
  }
  return id;
}

// ---------- snackbar API ----------

/**
 * Enqueue a snackbar with one optional action.
 *
 * @param {string} message
 * @param {object} [action] { label, onPress }
 * @param {object} [opts]
 * @param {number} [opts.durationMs=5000]
 */
export function snackbar(message, action = null, opts = {}) {
  const id = _nextId();
  const durationMs = opts.durationMs ?? 5000;
  _update((s) => ({
    ...s,
    actions: [
      ...s.actions,
      {
        id,
        kind: 'snackbar',
        message,
        action,
        createdAt: Date.now(),
        durationMs,
      },
    ],
  }));
  if (durationMs > 0) {
    setTimeout(() => dismiss(id), durationMs);
  }
  return id;
}

/**
 * Dismiss any queued action by id. Used by auto-timers for
 * toasts/snackbars and by direct user dismissal.
 */
export function dismiss(id) {
  _update((s) => ({
    ...s,
    actions: s.actions.filter((a) => a.id !== id),
  }));
}

/**
 * Clear the entire queue, rejecting any pending margerins with a
 * "cleared" error. Intended for test teardown or route changes.
 */
export function clearAll() {
  for (const a of _state.actions) {
    if (a.kind === 'margerin') {
      a._reject(new Error('Bfast queue cleared'));
    }
  }
  _update((s) => ({ ...s, actions: [] }));
}

// ---------- selectors ----------

/** Return the current margerin if any (only one is active at a time). */
export function selectCurrentMargerin(state = _state) {
  return state.actions.find((a) => a.kind === 'margerin') || null;
}

/** Return all toasts currently queued. Multiple can coexist. */
export function selectToasts(state = _state) {
  return state.actions.filter((a) => a.kind === 'toast');
}

/** Return all snackbars currently queued. Multiple can coexist. */
export function selectSnackbars(state = _state) {
  return state.actions.filter((a) => a.kind === 'snackbar');
}
