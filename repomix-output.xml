      if (sidebar && sidebar.parentNode !== (orgModal || document.body)) {
        (orgModal || document.body).appendChild(sidebar);
      }
    } catch {}

    // Activate calendar UI without overlay
    const wrap = document.getElementById('cal-drag-wrap');
    const panel = document.getElementById('cal-panel');
    if (panel) panel.classList.add('active');
    if (wrap) {
      wrap.style.position = 'fixed';
      // center panel similarly to prior overlay behavior
      requestAnimationFrame(()=>{
        const rect = panel ? panel.getBoundingClientRect() : { width: 680, height: 520 };
        const left = Math.max(8, (window.innerWidth - rect.width) / 2);
        const top = Math.max(8, (window.innerHeight - rect.height) / 2);
        wrap.style.left = left + 'px';
        wrap.style.top = top + 'px';
        wrap.style.right = 'auto';
        wrap.style.bottom = 'auto';
      });
    }
    // Render and bind interactions
    try {
    
      renderCalendarOverlay();
      const todayStr = yyyyMMdd(new Date());
      updateCalDaily(todayStr);
      initCalDailyDrag();
