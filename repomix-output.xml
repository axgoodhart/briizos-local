    initColorPicker(el, panel, container) {
      const sliders = container.querySelectorAll('.hsl-slider');
      const preview = container.querySelector(`#color-preview-${panel.id}`);

      // Initialize color object if not exists
      if (!panel.customColor) {
        panel.customColor = { h: 180, s: 70, l: 50 };
      }

      const updateColor = () => {
        const h = panel.customColor.h;
        const s = panel.customColor.s;
        const l = panel.customColor.l;

        // Update preview
        preview.style.background = `hsl(${h}, ${s}%, ${l}%)`;

        // Update value displays
        container.querySelector(`#hue-val-${panel.id}`).textContent = h;
        container.querySelector(`#sat-val-${panel.id}`).textContent = s;
        container.querySelector(`#light-val-${panel.id}`).textContent = l;

      // Apply hue rotation to panel (no gradient overrides)
      this.applyPanelColor(el, panel);

        // Persist
        this.touchPanel(panel);
        this.savePanelsToStorage();
      };

      sliders.forEach(slider => {
        slider.addEventListener('input', (e) => {
          const prop = e.target.dataset.prop;
          panel.customColor[prop] = parseInt(e.target.value);
          updateColor();
        });
      });

      // Reset button
      const resetBtn = container.querySelector('.color-reset-btn');
      resetBtn.addEventListener('click', () => {
        panel.customColor = { h: 0, s: 70, l: 50 };
        sliders.forEach(s => {
          s.value = panel.customColor[s.dataset.prop];
        });
        updateColor();
      });
    }

    applyPanelColor(el, panel) {
      // Clear styles when no custom color
      if (!panel?.customColor) {
        try {
          // Remove any color filters/backgrounds applied previously
          const body = el.querySelector('.panel-body');
          if (body) {
            body.style.removeProperty('filter');
            body.style.removeProperty('background');
            body.style.removeProperty('box-shadow');
            body.style.removeProperty('border-color');
          }
          el.style.removeProperty('background');
          el.style.removeProperty('box-shadow');
          el.style.removeProperty('border-color');
          // Keep buttons untouched
          const btns = el.querySelector('.panel-buttons-container');
          if (btns) btns.style.removeProperty('filter');
          const title = el.querySelector('.panel-title');
          if (title) {
            title.style.removeProperty('background');
            title.style.removeProperty('-webkit-background-clip');
            title.style.removeProperty('-webkit-text-fill-color');
          }
        } catch {}
        return;
      }

      const { h, s, l } = panel.customColor;
      // Map saturation and lightness to CSS filter multipliers
      const sat = Math.max(0, Number(s) || 0); // 0..100
      const lig = Math.max(0, Number(l) || 0); // 0..100
      const sFactor = Math.max(0, (sat / 50));      // 50 -> 1, 100 -> 2, 0 -> 0
      const bFactor = Math.max(0.2, (lig / 50));    // 50 -> 1, clamp min 0.2

      // Apply color treatment to the entire panel element for clear effect
      el.style.filter = `hue-rotate(${Number(h)||0}deg) saturate(${sFactor}) brightness(${bFactor})`;

      // Inverse treatment for the button strip to ensure readability (optional boost)
      try {
        const btns = el.querySelector('.panel-buttons-container');
        if (btns) {
          const invH = (Number(h) + 180) % 360;
          const invS = sat > 0 ? (1 / sFactor) : 1; // avoid div by zero
          const invB = 1 / bFactor;
          btns.style.filter = `hue-rotate(${invH}deg) saturate(${invS}) brightness(${invB})`;
        }
      } catch {}
    }

    attachColorHoverHandlers(el, panel) {
      if (el._colorHoverBound) return;
      el._colorHoverBound = true;
      const onEnter = () => {
        if (!panel.customColor) return;
        const { h, s, l } = panel.customColor;
        const color = `hsl(${h}, ${s}%, ${l}%)`;
        el.style.setProperty('background', `linear-gradient(135deg, ${color}33, ${color}66)`, 'important');
        const body = el.querySelector('.panel-body');
        if (body) body.style.setProperty('background', `linear-gradient(135deg, ${color}22, ${color}44)`, 'important');
      };
      const onLeave = () => {
        if (!panel.customColor) return;
        this.applyPanelColor(el, panel);
      };
      el.addEventListener('mouseenter', onEnter);
      el.addEventListener('mouseleave', onLeave);
    }

    applyWorldFilter() {
      const mode = this.currentWorld || 'all';
      const filter = (mode === 'all') ? null : (mode === 'music' ? 'music' : (mode === 'school' ? 'school' : (mode === 'life' ? 'home' : mode)));
      document.querySelectorAll('.dynamic-panel').forEach(el => {
        const id = String(el.dataset.panelId);
        const p = this.panels.find(x => String(x.id) === id);
        const tags = p?.tags || [];
        const matches = !filter || tags.includes(filter);
        if (matches) el.classList.remove('panel-filtered');
        else el.classList.add('panel-filtered');
      });
    }


makeDraggable(el) {
  if (window.innerWidth <= 640) return; 

  let startMouseX = 0, startMouseY = 0;
  let startLeft = 0, startTop = 0;
  let lastPersistTs = 0;

  const onMouseDown = (e) => {
    if (el.classList.contains('panel-minimized')) return;
        if (el.classList.contains('panel-flipped')) return; 

    if (e.target.closest('.panel-edit-btn') || e.target.closest('.panel-del-btn') || e.target.closest('.panel-min-btn')) return;

    // For cw panels, don't start dragging when interacting with chat UI/input
    if (el.classList.contains('cw-panel')) {
      if (
        e.target.closest('.cw-root') ||
        e.target.closest('.cw-input') ||
        e.target.closest('.cw-textarea') ||
        e.target.closest('textarea') ||
        e.target.closest('input') ||
        e.target.isContentEditable
      ) {
        return;
      }
    }

    e.preventDefault();
    el.style.cursor = 'grabbing';
    el.style.userSelect = 'none';
    startMouseX = e.clientX;
    startMouseY = e.clientY;
    startLeft = parseFloat(el.style.left || '0');
    startTop = parseFloat(el.style.top || '0');

    document.addEventListener('mousemove', onMouseMove);
    document.addEventListener('mouseup', onMouseUp);
    if (window.panelManager) window.panelManager._isDraggingAny = true;
  };

  const onMouseMove = (e) => {
    e.preventDefault();
    const dx = e.clientX - startMouseX;
    const dy = e.clientY - startMouseY;
    let newLeft = startLeft + dx;
    let newTop = startTop + dy;

    const parentRect = el.offsetParent ? el.offsetParent.getBoundingClientRect() : { left: 0, top: 0, width: window.innerWidth, height: window.innerHeight };
    const maxLeft = (parentRect.width || window.innerWidth) - el.offsetWidth;
    const maxTop = (parentRect.height || window.innerHeight) - el.offsetHeight;
    newLeft = Math.max(0, Math.min(newLeft, maxLeft));
    newTop = Math.max(0, Math.min(newTop, maxTop));

    el.style.left = `${newLeft}px`;
    el.style.top = `${newTop}px`;
    // Throttle-persist position to avoid snap-back on refresh
    const now = Date.now();
    if (now - lastPersistTs > 100) {
      const panelId = String(el.dataset.panelId);
      const panel = this.panels.find(p => String(p.id) === panelId);
      if (panel) {
        panel.x = newLeft;
        panel.y = newTop;
        this.touchPanel(panel);
        saveLocal();
      }
      lastPersistTs = now;
    }
  };

  const onMouseUp = () => {
    el.style.cursor = 'grab';
    el.style.removeProperty('user-select');

    const panelId = String(el.dataset.panelId);
    const panel = this.panels.find(p => String(p.id) === panelId);
    if (panel) {
      panel.x = parseFloat(el.style.left) || 0;
      panel.y = parseFloat(el.style.top) || 0;
      panel.w = el.offsetWidth;
      panel.h = el.offsetHeight;
      this.touchPanel(panel);
      stagePanelPatch(panelId, { x: panel.x, y: panel.y, w: panel.w, h: panel.h });
      scheduleCommit(60_000);
    }

    document.removeEventListener('mousemove', onMouseMove);
    document.removeEventListener('mouseup', onMouseUp);
    if (window.panelManager) window.panelManager._isDraggingAny = false;
  };

  el.addEventListener('mousedown', onMouseDown);
}
    
    MakePoopable(el) {
      if (window.innerWidth <= 640) return;

      let startMouseX = 0, startMouseY = 0;
      let startLeft = 0, startTop = 0;

      const onMouseDown = (e) => {
        if (el.classList.contains('panel-minimized')) return;
        if (e.target.closest('.panel-edit-btn') || e.target.closest('.panel-del-btn') || e.target.closest('.panel-min-btn')) return;

        const rect = el.getBoundingClientRect();
        const isNearResizeHandle = e.clientX > rect.right - 20 && e.clientY > rect.bottom - 20;
        if (isNearResizeHandle) return;

        e.preventDefault();
        el.style.cursor = 'grabbing';
        el.style.userSelect = 'none';

        startMouseX = e.clientX;
        startMouseY = e.clientY;

        const parentRect = el.offsetParent ? el.offsetParent.getBoundingClientRect() : { left: 0, top: 0 };
        startLeft = parseFloat(el.style.left || (rect.left - parentRect.left)) || 0;
        startTop  = parseFloat(el.style.top  || (rect.top  - parentRect.top)) || 0;

        document.addEventListener('mousemove', onMouseMove);
        document.addEventListener('mouseup', onMouseUp);
      };

      const onMouseMove = (e) => {
        e.preventDefault();
        const dx = e.clientX - startMouseX;
        const dy = e.clientY - startMouseY;
        let newLeft = startLeft + dx;
        let newTop  = startTop  + dy;

        const parentRect = el.offsetParent ? el.offsetParent.getBoundingClientRect() : { left: 0, top: 0, width: window.innerWidth, height: window.innerHeight };
        const maxLeft = (parentRect.width || window.innerWidth) - el.offsetWidth;
        const maxTop  = (parentRect.height || window.innerHeight) - el.offsetHeight;
        newLeft = Math.max(0, Math.min(newLeft, maxLeft));
        newTop  = Math.max(0, Math.min(newTop,  maxTop));

        el.style.left = `${newLeft}px`;
        el.style.top  = `${newTop}px`;
      };

      const onMouseUp = async () => {
        el.style.cursor = 'grab';
        el.style.removeProperty('user-select');

        const panelId = String(el.dataset.panelId);
        const panel = panelManager.panels.find(p => String(p.id) === panelId);
        if (panel) {
          panel.x = parseFloat(el.style.left) || 0;
          panel.y = parseFloat(el.style.top)  || 0;
          panel.w = el.offsetWidth;
          panel.h = el.offsetHeight;
          try { await persistence.savePanel(panel); } catch {}
        }

        document.removeEventListener('mousemove', onMouseMove);
        document.removeEventListener('mouseup', onMouseUp);
      };

      el.addEventListener('mousedown', onMouseDown);
    }

    async minimizePanel(panelElement, opts = { persist: true }) {
      if (!panelElement) {
        console.warn('minimizePanel called with undefined panelElement');
        return;
      }

      if (!panelElement.dataset.prevLeft) {
        panelElement.dataset.prevLeft = panelElement.style.left || '0';
        panelElement.dataset.prevTop = panelElement.style.top || '0';
        panelElement.dataset.prevW = String(panelElement.offsetWidth);
        panelElement.dataset.prevH = String(panelElement.offsetHeight);
      }

      const id = String(panelElement.dataset.panelId);
      const alreadyMin = this.minStack.includes(id);
      if (!alreadyMin && opts?.persist !== false) {
        this.minStack.push(id);
      }
      const index = this.minStack.indexOf(id);

      panelElement.classList.add('panel-minimized');
      panelElement.style.left = '';
      panelElement.style.top = '';
      panelElement.style.width = '100px';
      panelElement.style.height = '56px';
      panelElement.style.left = '-80px';
      panelElement.style.top = (8 + index * 64) + 'px';
      panelElement.addEventListener('click', (e) => {
        e.stopPropagation();
        this.restoreFromMin(panelElement);  
      })
      if (opts?.persist !== false) {
      try { await persistence.minimizePanel(id, true); } catch {}
      }
    }


    async restoreFromMin(panelElement) {
      const id = String(panelElement.dataset.panelId);
      const idx = this.minStack.indexOf(id);
      if (idx !== -1) {
        this.minStack.splice(idx, 1);
      }
      
      this.minStack.forEach((pid, i) => {
        const el = document.querySelector(`.dynamic-panel[data-panel-id="${pid}"]`);
        if (el && el.classList.contains('panel-minimized')) {
          el.style.top = (8 + i * 64) + 'px';
        }
      });

      panelElement.classList.remove('panel-minimized');
      if (panelElement.dataset.prevLeft) {
        panelElement.style.left = panelElement.dataset.prevLeft;
        panelElement.style.top = panelElement.dataset.prevTop || '0px';
        panelElement.style.width = panelElement.dataset.prevW + 'px';
        panelElement.style.height = panelElement.dataset.prevH + 'px';
        delete panelElement.dataset.prevLeft;
        delete panelElement.dataset.prevTop;
        delete panelElement.dataset.prevW;
        delete panelElement.dataset.prevH;
      }
      try { await persistence.minimizePanel(id, false); } catch {}
    }

renderPanels() {
  const container = document.getElementById('panelsContainer');
  const existing = new Map(
    Array.from(container.children).map(el => [String(el.dataset.panelId), el])
  );
  const keep = new Set();

  this.panels.forEach(panel => {
    if (panel.active === false) return;
    const key = String(panel.id);
    keep.add(key);
    const el = existing.get(key);

    // ─── CREATE NEW PANEL ──────────────────────────────────────────────
    if (!el) {
      const newEl = this.createPanelElement(panel);
      this.initializePanelContent(newEl, panel);

      // Type-specific setup BEFORE appending
      if (panel.type === 'external') {
        newEl.className = 'dynamic-panel panel-external';
        Object.assign(newEl.style, {
          border: '.3px solid rgba(255,255,255,.2)',
          borderBottom: 'none',
