    display: flex;
    gap: 8px;}
.confirmation-btn {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;}
.confirmation-btn.confirm {
    background: rgba(0, 255, 155, 0.2);
    border: 1px solid #00ff9b;
    color: #00ff9b;}
.confirmation-btn.confirm:hover {
    background: rgba(0, 255, 155, 0.4);
    box-shadow: 0 0 12px rgba(0, 255, 155, 0.5);}
.confirmation-btn.cancel {
    background: rgba(255, 80, 80, 0.2);
    border: 1px solid #ff5050;
    color: #ff5050;}
.confirmation-btn.cancel:hover {
    background: rgba(255, 80, 80, 0.4);
    box-shadow: 0 0 12px rgba(255, 80, 80, 0.5);}
.result-toast {
    position: fixed;
    top: 20px;
    left: 20px;
    z-index: 10000;
    border-radius: 12px;
    padding: 12px 16px;
    font-size: 14px;
    font-weight: 500;
    animation: slideInFromLeft 0.3s ease-out;
    backdrop-filter: blur(10px);}
.model-picker-dropdown {background:rgba(0, 0, 0, 0.84) !important}
.result-toast.success {
    background: linear-gradient(135deg, rgba(0, 255, 155, 0.95), rgba(0, 200, 120, 0.95));
