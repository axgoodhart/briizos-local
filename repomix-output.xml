/**
 * Firestore Persistence Layer for briizOS.2
 * Syncs with briizOS-Dev's Firebase collections
 *
 * Collection Structure (matches web app):
 * - users/{uid}/panels          (notes, type='note')
 * - users/{uid}/tasks           (tasks)
 * - users/{uid}/events          (schedule events)
 * - users/{uid}/organizer       (projects, type='project')
 *
 * Desktop-only collections:
 * - users/{uid}/desktopChatMessages/{id}
 * - users/{uid}/desktopSessions/{id}
 * - users/{uid}/desktopSelectedFiles/{id}
 * - users/{uid}/desktopSettings/config   (single doc)
 * - users/{uid}/desktopSettings/layout   (single doc)
 * - users/{uid}/desktopLogs/{id}
 */
import {
  collection,
  doc,
  getDoc,
  getDocs,
  setDoc,
  deleteDoc,
  onSnapshot,
  query,
  orderBy,
  where,
  limit,
  runTransaction,
  writeBatch,
  serverTimestamp,
} from 'firebase/firestore';
import { db, ensureAuth, getCurrentUid } from './firebase';
import logger from './logger';
import { taskAdapter, organizerAdapter, calendarAdapter, noteAdapter } from './syncAdapters';

// =====================
// HELPER FUNCTIONS
// =====================

function removeUndefined(obj) {
  const cleaned = {};
  for (const [key, value] of Object.entries(obj)) {
    if (value !== undefined) {
      cleaned[key] = value;
    }
  }
  return cleaned;
}

function generateId() {
  return `${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
}

function generateTaskId() {
  return `tasks-${Date.now()}`;
}

function generateOrgItemId() {
  return `itm_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`;
}

function generateAgentJobId() {
  return `job_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
}

function sanitizeNested(value) {
  if (value === undefined) return null;
  if (value === null) return null;
  if (Array.isArray(value)) return value.map(sanitizeNested);
  if (typeof value === 'object') {
    const out = {};
    for (const [k, v] of Object.entries(value)) {
      if (v !== undefined) out[k] = sanitizeNested(v);
    }
    return out;
  }
  return value;
}

function buildTaskLogEntry(type, message, extra = {}) {
  return removeUndefined({
    timestamp: Date.now(),
    type,
    message,
    ...sanitizeNested(extra),
  });
}

/**
 * Safely convert any timestamp format to ISO string.
 * The web app stores timestamps as Date.now() numbers, but Firestore
 * serverTimestamp() merge-writes may overwrite them with Timestamp objects.
 * This handles both.
 */
function toISO(value) {
  if (!value) return new Date().toISOString();
  if (typeof value.toDate === 'function') return value.toDate().toISOString();
  if (typeof value === 'number') return new Date(value).toISOString();
  if (typeof value === 'string') return value;
  if (value instanceof Date) return value.toISOString();
  return new Date().toISOString();
}

function normalizeTaskDoc(id, data) {
  const t = taskAdapter.normalizeOnRead(id, data);
  const actions = Array.isArray(t.actions) ? [...t.actions] : [];

  actions.sort((a, b) => (a.created || 0) - (b.created || 0));

  return {
    id: t.id,
    title: t.title,
    status: t.status,
    priority: t.priority,
    due_date: t.dueDate,
    parent_id: t.parentId,
    created: toISO(t.createdAt),
    type: t.type,
    position: t.position,
    automated: data.automated || false,
    ignored: data.ignored || false,
    source: data.source || null,
    automation: data.automation || null,
    taskLog: data.taskLog || [],
    subtasks: actions.map(a => ({
      id: a.id,
      title: a.title || '',
      status: a.completed ? 'completed' : 'pending',
      priority: a.priority || 'medium',
      parent_id: t.id,
      created: toISO(a.created),
    })),
  };
}

function isTerminalAutomationStatus(status) {
  return ['completed', 'failed', 'cancelled'].includes(status);
}

function getAutomationCandidateState(data) {
  if (data?.automation?.state) return data.automation.state;
  if (data?.status === 'active' && data?.automated) return 'queued';
  return data?.status || 'queued';
}

function isClaimableAutomatedTask(data, now = Date.now()) {
  if (!data?.automated) return false;
  if (data.ignored) return false;
  if (data.completed || data.completedAt) return false;
  if (isTerminalAutomationStatus(data.status)) return false;

  const automation = data.automation || {};
  const state = getAutomationCandidateState(data);
  const leaseUntil = automation.leaseUntil || 0;
  const awaitingUser = automation.awaitingUser === true;
  const nextRunAt = automation.nextRunAt || 0;

  if (awaitingUser) return false;
  if (nextRunAt > now) return false;
  if (state === 'waiting_for_user' || state === 'blocked') return false;
  if (state === 'running' || state === 'claimed') {
    return leaseUntil <= now;
  }
  return state === 'queued' || state === 'needs_retry' || state === 'active';
}

function getAutomationClaimScore(data) {
  const automation = data.automation || {};
  return automation.nextRunAt || automation.claimedAt || data.createdAt || 0;
}

/**
 * Get user-scoped collection references (web-compatible paths)
 */
function getUserCollections(uid) {
  const userDoc = doc(db, 'users', uid);
  return {
    panelsCol: collection(userDoc, 'panels'),
    tasksCol: collection(userDoc, 'tasks'),
    eventsCol: collection(userDoc, 'events'),
    organizerCol: collection(userDoc, 'organizer'),
    // Desktop-only (flattened to valid Firestore segment counts)
    chatMessagesCol: collection(userDoc, 'desktopChatMessages'),
    sessionsCol: collection(userDoc, 'desktopSessions'),
    selectedFilesCol: collection(userDoc, 'desktopSelectedFiles'),
    settingsDoc: doc(userDoc, 'desktopSettings', 'config'),
    layoutDoc: doc(userDoc, 'desktopSettings', 'layout'),
    logsCol: collection(userDoc, 'desktopLogs'),
    remoteChatCol: collection(userDoc, 'desktopRemoteChat'),
    agentJobsCol: collection(userDoc, 'desktopAgentJobs'),
    agentWorkersCol: collection(userDoc, 'desktopAgentWorkers'),
    agentToolOpsCol: collection(userDoc, 'desktopAgentToolOps'),
    agentEventsCol: collection(userDoc, 'desktopAgentEvents'),
    // App singletons
    minStackDoc: doc(userDoc, 'app', 'minStack'),
  };
}

/**
 * Subscribe to app/minStack in real-time (SyncContract §5)
 */
export function subscribeMinStack(callback) {
  const uid = getCurrentUid();
  if (!uid) return () => {};

  const { minStackDoc } = getUserCollections(uid);
  return onSnapshot(minStackDoc, (snapshot) => {
    if (snapshot.exists()) {
      const data = snapshot.data();
      const arr = Array.isArray(data.value) ? data.value.map(String) : [];
      callback(arr);
    } else {
      callback([]);
    }
  }, (error) => {
    logger.error('firestore', 'minStack subscription error', error?.message);
  });
}

// =====================
// COLOR TRANSFORM HELPERS
// =====================

/**
 * Convert hex color to HSL object for web compatibility
 */
function hexToHsl(hex) {
  if (!hex || typeof hex !== 'string') return { h: 60, s: 97, l: 78 };
  hex = hex.replace('#', '');
  if (hex.length !== 6) return { h: 60, s: 97, l: 78 };

  const r = parseInt(hex.substring(0, 2), 16) / 255;
  const g = parseInt(hex.substring(2, 4), 16) / 255;
  const b = parseInt(hex.substring(4, 6), 16) / 255;

  const max = Math.max(r, g, b);
  const min = Math.min(r, g, b);
  let h, s;
  const l = (max + min) / 2;

  if (max === min) {
    h = s = 0;
  } else {
    const d = max - min;
    s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
    switch (max) {
      case r: h = ((g - b) / d + (g < b ? 6 : 0)) / 6; break;
      case g: h = ((b - r) / d + 2) / 6; break;
      case b: h = ((r - g) / d + 4) / 6; break;
    }
  }

  return {
    h: Math.round(h * 360),
    s: Math.round(s * 100),
    l: Math.round(l * 100),
  };
}

/**
 * Read customColor from Firestore — handles both legacy HSL objects and web hex strings
 */
function readCustomColor(value, fallback = '#fef08a') {
  if (!value) return fallback;
  // Web writes hex strings directly
  if (typeof value === 'string') return value;
  // Legacy local writes HSL objects {h, s, l}
  if (typeof value === 'object' && 'h' in value) return hslToHex(value);
  return fallback;
}

/**
 * Convert HSL object to hex color for desktop
 */
function hslToHex(hsl) {
  if (!hsl || typeof hsl !== 'object') return '#fef08a';
  const { h = 60, s = 97, l = 78 } = hsl;

  const sNorm = s / 100;
  const lNorm = l / 100;
  const c = (1 - Math.abs(2 * lNorm - 1)) * sNorm;
  const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
  const m = lNorm - c / 2;

  let r = 0, g = 0, b = 0;
  if (h < 60)      { r = c; g = x; b = 0; }
  else if (h < 120) { r = x; g = c; b = 0; }
  else if (h < 180) { r = 0; g = c; b = x; }
  else if (h < 240) { r = 0; g = x; b = c; }
  else if (h < 300) { r = x; g = 0; b = c; }
  else              { r = c; g = 0; b = x; }

  const toHex = (v) => Math.round((v + m) * 255).toString(16).padStart(2, '0');
  return `#${toHex(r)}${toHex(g)}${toHex(b)}`;
}

// =====================
// NOTES FUNCTIONS (panels collection, type='note')
// =====================

/**
 * Subscribe to notes in real-time
 * Reads from panels collection where type === 'note'
 */
export function subscribeNotes(callback) {
  const uid = getCurrentUid();
  if (!uid) {
    logger.warn('firestore', 'No user authenticated for notes subscription');
    return () => {};
  }

  const { panelsCol } = getUserCollections(uid);

  // Subscribe to full panels collection (matches web app — no where/orderBy)
  // Filter to notes client-side
  return onSnapshot(panelsCol, (snapshot) => {
    const notes = [];
    snapshot.forEach((docSnap) => {
      const data = docSnap.data();
      if (data.type !== 'note') return; // client-side filter
      const n = noteAdapter.normalizeOnRead(docSnap.id, data);
      notes.push({
        id: n.id,
        title: n.title,
        content: n.body,
        color: readCustomColor(n.customColor, data.color || '#fef08a'),
        position_x: n.position_x,
        position_y: n.position_y,
        width: n.width,
        height: n.height,
        is_pinned: n.active ? 1 : 0,
        is_docked: n.isDocked ? 1 : 0,
        created: toISO(n.createdAt),
        updated: toISO(n.updatedAt),
      });
    });
    // Sort client-side by updatedAt descending
    notes.sort((a, b) => (b.updated || '').localeCompare(a.updated || ''));
    callback(notes);
  }, (error) => {
    logger.error('firestore', 'Notes subscription error', error?.message);
  });
}

/**
 * Get all notes (one-time fetch)
 */
export async function getNotes() {
  const user = await ensureAuth();
  if (!user) return [];

  const { panelsCol } = getUserCollections(user.uid);
  const snapshot = await getDocs(panelsCol);

  const notes = [];
  snapshot.forEach((docSnap) => {
    const data = docSnap.data();
    if (data.type !== 'note') return; // client-side filter
    const n = noteAdapter.normalizeOnRead(docSnap.id, data);
    notes.push({
      id: n.id,
      title: n.title,
      content: n.body,
      color: readCustomColor(n.customColor, data.color || '#fef08a'),
      position_x: n.position_x,
      position_y: n.position_y,
      width: n.width,
      height: n.height,
      is_pinned: n.active ? 1 : 0,
      is_docked: n.isDocked ? 1 : 0,
      created: toISO(n.createdAt),
      updated: toISO(n.updatedAt),
    });
  });

  notes.sort((a, b) => (b.updated || '').localeCompare(a.updated || ''));
  return notes;
}

/**
 * Add or update a note.
 *
 * On create, also mints a linked organizer item so the note shows up in the
 * Organizer on briizOS.Web (which expects every panel to be backed by an
 * organizer entry, via bidirectional orgId ↔ panelId). Without this link,
 * local-created notes show up on web as "uncategorized" panels.
 */
export async function upsertNote(noteData) {
  const user = await ensureAuth();
  if (!user) return null;

  const { panelsCol, organizerCol } = getUserCollections(user.uid);
  const noteId = noteData.id || generateId();

  const isNew = !noteData.id;
  const now = Date.now();

  // Create a paired organizer item for new notes (matches web createNewPanel flow).
  // Done before the panel write so we can stamp orgId onto the panel doc in one go.
  let orgId = noteData.orgId;
  if (isNew && !orgId) {
    try {
      orgId = await addOrganizerItem({
        type: 'note',
        name: noteData.title || 'New Note',
        tags: [],
        source: { mode: 'panel' },
        dateMode: 'created',
        panelType: 'note',
        panelId: noteId,
      });
    } catch (e) {
      logger.warn('firestore', 'Failed to create paired organizer item for note', e?.message);
    }
  }

  const firestoreData = noteAdapter.prepareForWrite(removeUndefined({
    id: noteId,
    type: 'note',
    title: noteData.title,
    body: noteData.content,
    // Only write these fields when they are explicitly provided so partial
    // updates don't clobber existing values on merge.
    customColor: noteData.color !== undefined ? hexToHsl(noteData.color) : undefined,
    position_x: noteData.position_x,
    position_y: noteData.position_y,
    width: noteData.width,
    height: noteData.height,
    isDocked: noteData.is_docked !== undefined ? (noteData.is_docked === 1) : undefined,
    // Web-compat scaffolding — only stamped on first create so merges don't wipe.
    orgId: isNew ? (orgId || null) : undefined,
    active: isNew
      ? true
      : (noteData.is_pinned !== undefined ? (noteData.is_pinned === 1) : undefined),
    tags: isNew ? [] : undefined,
    chat: isNew ? null : undefined,
    externalUrl: isNew ? '' : undefined,
    externalShowUrl: isNew ? false : undefined,
    externalData: isNew ? null : undefined,
    autoHeight: isNew ? true : undefined,
    expansionCount: isNew ? 0 : undefined,
    createdAt: isNew ? now : undefined,
  }), isNew);

  await setDoc(doc(panelsCol, noteId), firestoreData, { merge: true });
  return noteId;
}

/**
 * Delete a note — and its paired organizer item, if any.
 *
 * Reads the panel doc first to grab `orgId`, then deletes both. Without this,
 * orphaned organizer items left behind can cause web to resurrect the panel
 * on reload with null values (because web reconciles organizer ↔ panels and
 * writes back stubs for dangling panelId references).
 */
export async function deleteNote(noteId) {
  const user = await ensureAuth();
  if (!user) return false;

  const { panelsCol, organizerCol } = getUserCollections(user.uid);
  const panelRef = doc(panelsCol, noteId);

  // Grab orgId before the delete so we can clean up the paired item.
  let orgId = null;
  try {
    const snap = await getDoc(panelRef);
    if (snap.exists()) {
      orgId = snap.data()?.orgId || null;
    }
  } catch (e) {
    logger.warn('firestore', 'deleteNote: failed to read panel before delete', e?.message);
  }

  await deleteDoc(panelRef);

  if (orgId) {
    try {
      await deleteDoc(doc(organizerCol, orgId));
    } catch (e) {
      logger.warn('firestore', 'deleteNote: failed to delete paired organizer item', e?.message);
    }
  }

  return true;
}

// =====================
// TASKS FUNCTIONS (tasks collection)
// =====================

/**
 * Subscribe to tasks in real-time
 */
export function subscribeTasks(callback) {
  const uid = getCurrentUid();
  if (!uid) {
    logger.warn('firestore', 'No user authenticated for tasks subscription');
    return () => {};
  }

  const { tasksCol } = getUserCollections(uid);

  return onSnapshot(tasksCol, (snapshot) => {
    const tasks = [];
    snapshot.forEach((docSnap) => {
      tasks.push(normalizeTaskDoc(docSnap.id, docSnap.data()));
    });

    // Sort top-level: priority then newest first
    const priorityOrder = { high: 1, medium: 2, low: 3 };
    tasks.sort((a, b) => {
      const pa = priorityOrder[a.priority] || 4;
      const pb = priorityOrder[b.priority] || 4;
      if (pa !== pb) return pa - pb;
      return (b.created || '').localeCompare(a.created || '');
    });

    callback(tasks);
  }, (error) => {
    logger.error('firestore', 'Tasks subscription error', error?.message);
  });
}

/**
 * Subscribe to automated tasks that need processing.
 * Fires onNewAutomated(task) when a task with automated:true
 * transitions to status:'active' (new or changed).
 *
 * Uses a per-task cooldown to avoid re-firing from our own writes
 * (appendTaskLog, updateTask, etc. all mutate the doc and trigger onSnapshot).
 */
export function subscribeAutomatedTasks(onNewAutomated) {
  const uid = getCurrentUid();
  if (!uid) return () => {};

  const { tasksCol } = getUserCollections(uid);
  // Single-field query to avoid composite index requirement; filter status in JS
  const q = query(tasksCol, where('automated', '==', true));
  let initialIds = null;
  // Track last-fired time per task to suppress re-fires from our own writes
  const lastFiredAt = new Map();
  const COOLDOWN_MS = 5000;

  return onSnapshot(q, (snapshot) => {
    if (initialIds === null) {
      // First snapshot — record existing active automated tasks, don't fire
      initialIds = new Set();
      snapshot.forEach(d => initialIds.add(d.id));
      return;
    }

    snapshot.docChanges().forEach((change) => {
      if (change.type === 'added' || change.type === 'modified') {
        const id = change.doc.id;
        const data = change.doc.data();
        // Filter for active status in JS
        if (data.status !== 'active') return;

        // Suppress re-fires within the cooldown window (our own writes echo back)
        const now = Date.now();
        const lastTime = lastFiredAt.get(id) || 0;
        if (now - lastTime < COOLDOWN_MS) return;

        if (!initialIds.has(id) || change.type === 'modified') {
          initialIds.add(id);
          lastFiredAt.set(id, now);
          const actions = Array.isArray(data.actions) ? data.actions : [];
          onNewAutomated({
            ...normalizeTaskDoc(id, data),
            automated: data.automated,
            taskLog: data.taskLog || [],
            source: data.source || null,
            automation: data.automation || null,
            subtasks: actions.map(a => ({
              id: a.id,
              title: a.title || '',
              status: a.completed ? 'completed' : 'pending',
            })),
          });
        }
      }
    });
  }, (error) => {
    logger.error('firestore', 'Automated tasks subscription error', error?.message);
  });
}

/**
 * Add a new task
 */
export async function addTask(title, options = {}) {
  const user = await ensureAuth();
  if (!user) return null;

  const { tasksCol } = getUserCollections(user.uid);
  const taskId = generateTaskId();
  const now = Date.now();

  const firestoreData = taskAdapter.prepareForWrite(removeUndefined({
    id: taskId,
    type: 'jobPanel',
    title: title,
    completed: false,
    completedAt: null,
    status: 'running',
    priority: options.priority || 'medium',
    dueDate: options.dueDate || null,
    parentId: options.parentId || null,
    position: options.position || { x: 0, y: 0 },
    createdAt: now,
  }), true);

  await setDoc(doc(tasksCol, taskId), firestoreData);
  return taskId;
}

/**
 * Add multiple subtasks (actions) to a parent task document
 * Stored as an embedded actions array on the parent doc
 */
export async function addSubtasks(parentId, subtasks) {
  const user = await ensureAuth();
  if (!user) return [];

  const { tasksCol } = getUserCollections(user.uid);
  const parentRef = doc(tasksCol, parentId);
  const parentSnap = await getDoc(parentRef);
  if (!parentSnap.exists()) return [];

  const parentData = parentSnap.data();
  const existingActions = Array.isArray(parentData.actions) ? [...parentData.actions] : [];
  const ids = [];

  for (const subtask of subtasks) {
    const actionId = generateTaskId();
    ids.push(actionId);
    const title = typeof subtask === 'string' ? subtask : subtask.title;
    const priority = typeof subtask === 'string' ? 'medium' : (subtask.priority || 'medium');

    existingActions.push({
      id: actionId,
      title: title,
      completed: false,
      completedAt: null,
      priority: priority,
      created: Date.now(),
    });
  }

  await setDoc(parentRef, {
    actions: existingActions,
    updatedAt: serverTimestamp(),
  }, { merge: true });

  return ids;
}

/**
 * Update a task or an action within a parent task
 * If parentId is provided in updates, it updates an action inside the parent's actions array
 */
export async function updateTask(id, updates) {
  const user = await ensureAuth();
  if (!user) return false;

  const { tasksCol } = getUserCollections(user.uid);

  // If this is a subtask/action update, modify the parent's actions array
  if (updates._parentId) {
    const parentRef = doc(tasksCol, updates._parentId);
    const parentSnap = await getDoc(parentRef);
    if (!parentSnap.exists()) return false;

    const parentData = parentSnap.data();
    const actions = Array.isArray(parentData.actions) ? [...parentData.actions] : [];
    const actionIdx = actions.findIndex(a => a.id === id);
    if (actionIdx === -1) return false;

    if (updates.status !== undefined) {
      const isCompleted = updates.status === 'completed';
      actions[actionIdx].completed = isCompleted;
      actions[actionIdx].completedAt = isCompleted ? Date.now() : null;
    }
    if (updates.title !== undefined) {
      actions[actionIdx].title = updates.title;
    }
    if (updates.priority !== undefined) {
      actions[actionIdx].priority = updates.priority;
    }

    await setDoc(parentRef, { actions, updatedAt: serverTimestamp() }, { merge: true });
    return true;
  }

  // Top-level task update
  const firestoreUpdates = { updatedAt: serverTimestamp() };

  if (updates.status !== undefined) {
    const isCompleted = updates.status === 'completed';
    firestoreUpdates.completed = isCompleted;
    firestoreUpdates.completedAt = isCompleted ? Date.now() : null;
    // Preserve the actual status value — callers may pass 'active', 'waiting', etc.
    firestoreUpdates.status = updates.status;
  }
  if (updates.title !== undefined) {
    firestoreUpdates.title = updates.title;
  }
  if (updates.priority !== undefined) {
    firestoreUpdates.priority = updates.priority;
  }
  if (updates.dueDate !== undefined) {
    firestoreUpdates.dueDate = updates.dueDate;
  }
  if (updates.position !== undefined) {
    firestoreUpdates.position = updates.position;
  }
  if (updates.automated !== undefined) {
    firestoreUpdates.automated = updates.automated;
  }
  if (updates.ignored !== undefined) {
    firestoreUpdates.ignored = updates.ignored;
  }
  if (updates.taskLog !== undefined) {
    firestoreUpdates.taskLog = updates.taskLog;
  }
  if (updates.source !== undefined) {
    firestoreUpdates.source = sanitizeNested(updates.source);
  }
  if (updates.automation !== undefined) {
    firestoreUpdates.automation = sanitizeNested(updates.automation);
  }
  if (updates.completed !== undefined) {
    firestoreUpdates.completed = updates.completed;
  }
  if (updates.completedAt !== undefined) {
    firestoreUpdates.completedAt = updates.completedAt;
  }

  await setDoc(doc(tasksCol, id), firestoreUpdates, { merge: true });
  return true;
}

/**
 * Delete a task (actions are embedded, so they go with it)
 * If _parentId is provided, deletes an action from the parent's actions array
 */
export async function deleteTask(id, options = {}) {
  const user = await ensureAuth();
  if (!user) return false;

  const { tasksCol } = getUserCollections(user.uid);

  // If deleting an action within a parent
  if (options._parentId) {
    const parentRef = doc(tasksCol, options._parentId);
    const parentSnap = await getDoc(parentRef);
    if (!parentSnap.exists()) return false;

    const parentData = parentSnap.data();
    const actions = Array.isArray(parentData.actions) ? parentData.actions.filter(a => a.id !== id) : [];
    await setDoc(parentRef, { actions, updatedAt: serverTimestamp() }, { merge: true });
    return true;
  }

  // Delete the whole task doc (actions embedded, go with it)
  await deleteDoc(doc(tasksCol, id));
  return true;
}

/**
 * Get a single task with its embedded actions (subtasks)
 */
export async function getTask(id) {
  const user = await ensureAuth();
  if (!user) return null;

  const { tasksCol } = getUserCollections(user.uid);
  const taskDoc = await getDoc(doc(tasksCol, id));
  if (!taskDoc.exists()) return null;

  return normalizeTaskDoc(taskDoc.id, taskDoc.data());
}

/**
 * Create a message-first automated job in the canonical tasks bucket.
 * One task doc owns the request, visible log, and automation state.
 */
export async function createAutomatedJobTask(title, options = {}) {
  const user = await ensureAuth();
  if (!user) return null;

  const { tasksCol } = getUserCollections(user.uid);
  const taskId = options.taskId || generateTaskId();
  const now = Date.now();
  const source = sanitizeNested(options.source || { kind: 'remote-web' });
  const automation = removeUndefined({
    mode: 'message-first',
    state: options.state || 'queued',
    runnerId: null,
    workerId: null,
    threadId: options.threadId || null,
    leaseUntil: 0,
    claimedAt: null,
    lastHeartbeatAt: null,
    nextRunAt: options.nextRunAt ?? now,
    currentAction: null,
    currentTool: null,
    awaitingUser: false,
    blockedReason: null,
    lastError: null,
    createdBy: options.createdBy || source?.kind || 'manual',
  });
  const taskLog = Array.isArray(options.taskLog) && options.taskLog.length > 0
    ? options.taskLog
    : [buildTaskLogEntry('status', options.initialLogMessage || 'Remote job queued')];

  const firestoreData = taskAdapter.prepareForWrite(removeUndefined({
    id: taskId,
    type: 'jobPanel',
    title,
    completed: false,
    completedAt: null,
    status: options.status || 'queued',
    priority: options.priority || 'medium',
    dueDate: options.dueDate || null,
    parentId: options.parentId || null,
    position: options.position || { x: 0, y: 0 },
    createdAt: now,
    automated: true,
    ignored: false,
    taskLog,
    automation,
    source,
  }), true);

  await setDoc(doc(tasksCol, taskId), firestoreData);
  return { taskId };
}

/**
 * Append a user-visible log entry to an automated job task.
 */
export async function appendTaskLogEntry(taskId, entry) {
  const task = await getTask(taskId);
  if (!task) return false;

  const nextLog = [...(task.taskLog || [])];
  nextLog.push(buildTaskLogEntry(
    entry?.type || 'status',
    entry?.message || '',
    entry || {},
  ));

  return updateTask(taskId, { taskLog: nextLog });
}

/**
 * Merge task-level and automation-level updates for an automated job.
 */
export async function updateAutomatedJobTask(taskId, updates = {}) {
  const task = await getTask(taskId);
  if (!task) return false;

  const nextAutomation = updates.automation !== undefined
    ? removeUndefined({
        ...(task.automation || {}),
        ...sanitizeNested(updates.automation || {}),
      })
    : undefined;

  return updateTask(taskId, removeUndefined({
    status: updates.status,
    completed: updates.completed,
    completedAt: updates.completedAt,
    automated: updates.automated,
    ignored: updates.ignored,
    title: updates.title,
    priority: updates.priority,
    dueDate: updates.dueDate,
    position: updates.position,
    source: updates.source,
    taskLog: updates.taskLog,
    automation: nextAutomation,
  }));
}

/**
 * Claim the next queued automated task from the tasks bucket.
 * This is the message-first equivalent of desktopAgentJobs polling.
 */
export async function claimNextAutomatedTask(options = {}) {
  const user = await ensureAuth();
  if (!user) return null;

  const runnerId = options.runnerId || `runner_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`;
  const leaseMs = Math.max(5000, options.leaseMs || 45000);
  const maxItems = Math.max(1, Math.min(options.maxItems || 25, 100));
  const { tasksCol } = getUserCollections(user.uid);
  const snapshot = await getDocs(query(tasksCol, where('automated', '==', true), limit(maxItems)));
  const now = Date.now();
  const candidates = [];

  snapshot.forEach((docSnap) => {
    const data = docSnap.data() || {};
    if (isClaimableAutomatedTask(data, now)) {
      candidates.push({
        id: docSnap.id,
        score: getAutomationClaimScore(data),
      });
    }
  });

  candidates.sort((a, b) => a.score - b.score);

  for (const candidate of candidates) {
    try {
      const claimed = await runTransaction(db, async (tx) => {
        const taskRef = doc(tasksCol, candidate.id);
        const taskSnap = await tx.get(taskRef);
        if (!taskSnap.exists()) return null;

        const data = taskSnap.data() || {};
        const t = Date.now();
        if (!isClaimableAutomatedTask(data, t)) return null;

        const currentAutomation = data.automation && typeof data.automation === 'object'
          ? data.automation
          : {};
        const nextAutomation = removeUndefined({
          ...currentAutomation,
          mode: currentAutomation.mode || 'message-first',
          state: 'running',
          runnerId,
          workerId: options.workerId || currentAutomation.workerId || null,
          threadId: options.threadId || currentAutomation.threadId || null,
          leaseUntil: t + leaseMs,
          claimedAt: currentAutomation.claimedAt || t,
          lastHeartbeatAt: t,
          currentAction: options.currentAction || currentAutomation.currentAction || 'processing_request',
          blockedReason: null,
          lastError: null,
          awaitingUser: false,
        });

        tx.update(taskRef, {
          status: 'active',
          automated: true,
          ignored: false,
          automation: nextAutomation,
          updatedAt: serverTimestamp(),
        });

        return {
          id: taskSnap.id,
          ...data,
          status: 'active',
          automated: true,
          ignored: false,
          automation: nextAutomation,
        };
      });

      if (claimed) {
        return normalizeTaskDoc(claimed.id, claimed);
      }
    } catch (error) {
      logger.debug('firestore', 'Automated task claim race lost', error?.message);
    }
  }

  return null;
}

/**
 * Refresh the lease/heartbeat for a claimed automated task.
 */
export async function heartbeatAutomatedTask(taskId, options = {}) {
  const task = await getTask(taskId);
  if (!task) return false;

  const runnerId = options.runnerId;
  if (!runnerId) throw new Error('heartbeatAutomatedTask requires runnerId');

  const automation = task.automation && typeof task.automation === 'object'
    ? task.automation
    : {};
  if (automation.runnerId && automation.runnerId !== runnerId) return false;

  return updateTask(taskId, {
    automation: removeUndefined({
      ...automation,
      mode: automation.mode || 'message-first',
      state: automation.state || 'running',
      runnerId,
      leaseUntil: Date.now() + Math.max(5000, options.leaseMs || 45000),
      lastHeartbeatAt: Date.now(),
    }),
  });
}

