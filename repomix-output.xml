<file path="src/styles/original-component-css/overlays/CalendarModal.css">
/* =====================
   Calendar Modal Styles
   ===================== */

.calendar-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.25);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 500;
  animation: cal-fadeIn 0.2s ease;
}

@keyframes cal-fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.calendar-modal {
  width: 92%;
  max-width: 820px;
  max-height: 88vh;
  background: linear-gradient(135deg, #80d2972d 0%, #0115343a 100%);
  border: 1px solid rgba(0, 200, 200, 0.3);
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: cal-slideUp 0.3s ease;
  filter: brightness(2);
  backdrop-filter: blur(20px);
}

@keyframes cal-slideUp {
  from {
    opacity: 0;
    transform: translateY(20px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* Header */
.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 20px;
  border-bottom: 1px solid rgba(0, 200, 200, 0.15);
  background: rgba(0, 50, 80, 0.2);
}

.calendar-title {
  font-size: 18px;
  font-weight: 500;
  color: var(--palette-accent-cyan);
  margin: 0;
}

.calendar-close-btn {
  background: none;
  border: none;
  color: var(--palette-text-muted);
  font-size: 28px;
  cursor: pointer;
  padding: 0;
  line-height: 1;
  transition: color 0.2s ease;
}

.calendar-close-btn:hover {
  color: var(--palette-danger);
}

/* Navigation */
.calendar-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  padding: 10px 20px;
  border-bottom: 1px solid rgba(0, 200, 200, 0.1);
  background: rgba(0, 30, 50, 0.3);
}

.nav-btn {
  padding: 6px 14px;
  background: rgba(0, 80, 100, 0.3);
  border: 1px solid rgba(0, 200, 200, 0.2);
  border-radius: 6px;
  color: var(--palette-accent-cyan);
  font-size: 13px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.nav-btn:hover {
  background: rgba(0, 100, 120, 0.4);
  border-color: rgba(0, 200, 200, 0.4);
}

.nav-btn.today {
  background: rgba(0, 150, 180, 0.4);
}

.current-date {
  font-size: 16px;
  font-weight: 500;
  color: var(--palette-text-main);
  min-width: 180px;
  text-align: center;
}

/* Content */
.calendar-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 14px 16px;
  overflow: hidden;
}

/* =====================
   Split Layout: Grid + Daily
   ===================== */

.cal-split-layout {
  display: flex;
  gap: 14px;
  flex: 1;
  overflow: hidden;
}

.cal-grid-container {
  flex: 1;
  min-width: 0;
}

/* =====================
   Monthly Grid
   ===================== */

.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 2px;
}

.cal-dayheader {
  text-align: center;
  font-size: 10px;
  font-weight: 600;
  color: var(--palette-text-muted);
  text-transform: uppercase;
  padding: 4px 0 6px;
  letter-spacing: 0.5px;
}

.cal-cell {
  aspect-ratio: 1;
  padding: 3px;
  border-radius: 6px;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  transition: all 0.15s ease;
  background: rgba(0, 0, 0, 0.12);
  border: 1px solid transparent;
}

.cal-cell:hover {
  background: rgba(0, 100, 120, 0.25);
  border-color: rgba(0, 200, 200, 0.15);
}

.cal-cell.selected {
  border-color: var(--palette-accent-cyan);
  background: rgba(0, 229, 229, 0.1);
  box-shadow: 0 0 8px rgba(0, 229, 229, 0.15);
}

.cal-cell.today .cal-daynum {
  color: var(--palette-accent-cyan);
  font-weight: 700;
}

.cal-cell.pad {
  opacity: 0.25;
}

.cal-cell.pad:hover {
  opacity: 0.5;
}

.cal-daynum {
  font-size: 11px;
  color: #d0d0d0;
  line-height: 1;
}

.cal-dots {
  display: flex;
  gap: 2px;
  justify-content: center;
  min-height: 5px;
}

.cal-dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  flex-shrink: 0;
}

/* =====================
   Daily Detail Panel
   ===================== */

.cal-daily-panel {
  width: 220px;
  flex-shrink: 0;
  border-left: 1px solid rgba(0, 200, 200, 0.1);
  padding-left: 14px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
}

.cal-daily-title {
  font-size: 13px;
  font-weight: 500;
  color: var(--palette-accent-cyan);
  margin: 0 0 10px 0;
  display: flex;
  align-items: center;
  gap: 6px;
}

.cal-daily-today-badge {
  font-size: 9px;
  font-weight: 700;
  color: #000;
  background: var(--palette-accent-cyan);
  padding: 1px 5px;
  border-radius: 3px;
  text-transform: uppercase;
}

.cal-daily-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
  flex: 1;
}

.cal-daily-empty {
  font-size: 12px;
  color: var(--palette-text-muted);
  padding: 16px 0;
  text-align: center;
}

.cal-daily-item {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 8px 8px;
  background: rgba(30, 50, 70, 0.3);
  border: 1px solid rgba(0, 200, 200, 0.08);
  border-radius: 6px;
  transition: all 0.15s ease;
}

.cal-daily-item:hover {
  background: rgba(0, 100, 120, 0.2);
  border-color: rgba(0, 200, 200, 0.15);
}

.cal-daily-item.done {
  opacity: 0.5;
}

.cal-daily-item.done .cal-daily-item-name {
  text-decoration: line-through;
}

.cal-daily-item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.cal-daily-item-name {
  font-size: 12px;
  font-weight: 500;
  color: var(--palette-text-main);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cal-daily-item-time {
  font-size: 10px;
  color: var(--palette-text-subtle);
}

.cal-daily-item-rec {
  font-size: 9px;
  color: #a855f7;
}

.cal-daily-done-btn {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: 1.5px solid rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  color: var(--palette-text-subtle);
  font-size: 11px;
  cursor: pointer;
  transition: all 0.15s ease;
  margin-top: 1px;
}

.cal-daily-done-btn:hover {
  border-color: var(--palette-accent-cyan);
  color: var(--palette-accent-cyan);
}

.cal-daily-done-btn.checked {
  border-color: var(--palette-success);
  color: var(--palette-success);
  background: rgba(76, 175, 80, 0.1);
}

/* =====================
   Quick Add
   ===================== */

.quick-add {
  display: flex;
  gap: 8px;
  margin-top: 12px;
  flex-shrink: 0;
}

.quick-add-input {
  flex: 1;
  padding: 10px 14px;
  background: rgba(20, 40, 60, 0.6);
  border: 1px solid rgba(0, 200, 200, 0.2);
  border-radius: 8px;
  color: var(--palette-text-main);
  font-size: 13px;
}

.quick-add-input:focus {
  outline: none;
  border-color: rgba(0, 200, 200, 0.5);
}

.quick-add-input::placeholder {
  color: var(--palette-text-dim);
}

.quick-add-btn {
  padding: 10px 18px;
  background: rgba(0, 150, 180, 0.5);
  border: 1px solid rgba(0, 200, 200, 0.4);
  border-radius: 8px;
  color: var(--palette-accent-cyan);
  font-size: 18px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.quick-add-btn:hover {
  background: rgba(0, 180, 200, 0.6);
}

/* =====================
   Footer
   ===================== */

.calendar-footer {
  display: flex;
  justify-content: space-between;
  padding: 12px 20px;
  border-top: 1px solid rgba(0, 200, 200, 0.1);
  background: rgba(0, 30, 50, 0.3);
}

.calendar-btn {
  padding: 8px 16px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
}

.calendar-btn.close {
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: var(--palette-text-subtle);
}

.calendar-btn.close:hover {
  background: rgba(255, 255, 255, 0.05);
  color: var(--palette-text-soft);
}

.items-count {
  font-size: 12px;
  color: var(--palette-text-muted);
  display: flex;
  align-items: center;
}

/* Loading */
.calendar-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  color: var(--palette-text-muted);
  font-size: 14px;
}
</file>

