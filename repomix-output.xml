<file path="src/components/bfast/bfast.css">
/*
 * bfast.css — styles for the BfastBundle (Toast, Snackbar, Margerin).
 *
 * Visual language: soft, floating pills on a dark background.
 * Positioning: the bundle is a fixed-position stack at the bottom of
 * the screen, centered horizontally, with the margerin at the very
 * bottom (nearest the user's attention) and toasts/snackbars stacked
 * above it.
 *
 * Colors are intentionally muted purples and blues — the bundle is a
 * background/ambient surface, not a hero element.
 */

/* ---------- layout ---------- */

.bfast-bundle {
  position: fixed;
  left: 50%;
  bottom: 24px;
  transform: translateX(-50%);
  z-index: 9000;
  pointer-events: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  max-width: min(560px, calc(100vw - 32px));
  width: max-content;
}

.bfast-bundle > * {
  pointer-events: auto;
}

.bfast-bundle-snackbars,
.bfast-bundle-toasts,
.bfast-bundle-margerin-slot {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  width: 100%;
}

.bfast-bundle-margerin-slot:empty,
.bfast-bundle-toasts:empty,
.bfast-bundle-snackbars:empty {
  display: none;
}

/* ---------- keyframes ---------- */

@keyframes bfast-fade-in-up {
  from {
    opacity: 0;
    transform: translateY(8px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes bfast-bead-pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
    box-shadow: 0 0 0 0 rgba(92, 156, 255, 0.6);
  }
  50% {
    transform: scale(1.15);
    opacity: 0.9;
    box-shadow: 0 0 0 6px rgba(92, 156, 255, 0);
  }
}

/* ---------- Toast ---------- */

.bfast-toast {
  display: inline-flex;
  align-items: center;
  padding: 10px 18px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 500;
  color: #ebe8ff;
  backdrop-filter: blur(10px);
  cursor: default;
  user-select: none;
  animation: bfast-fade-in-up 180ms ease-out;
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.35);
}

.bfast-toast--success {
  background: linear-gradient(135deg, #7a6bdc 0%, #5b4fb8 100%);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.bfast-toast--info {
  background: linear-gradient(135deg, #4a4a6b 0%, #343450 100%);
  border: 1px solid rgba(255, 255, 255, 0.06);
}

.bfast-toast--error {
  background: linear-gradient(135deg, #a85c68 0%, #823e4a 100%);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.bfast-toast-message {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 420px;
}

/* ---------- Snackbar ---------- */

.bfast-snackbar {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 10px 16px;
  border-radius: 999px;
  background: rgba(20, 20, 32, 0.88);
  border: 1.5px solid #e6c74d; /* yellow stroke */
  color: #f3efe4;
  font-size: 13px;
  font-weight: 500;
  backdrop-filter: blur(10px);
  cursor: default;
  user-select: none;
  animation: bfast-fade-in-up 180ms ease-out;
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.4);
}

.bfast-snackbar-bead {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #5c9cff;
  animation: bfast-bead-pulse 1.6s ease-in-out infinite;
  flex: 0 0 auto;
}

.bfast-snackbar-message {
  text-decoration: underline;
  text-decoration-color: rgba(243, 239, 228, 0.45);
  text-underline-offset: 3px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 360px;
}

.bfast-snackbar-action {
  background: transparent;
  border: 1px solid rgba(230, 199, 77, 0.55);
  color: #e6c74d;
  border-radius: 999px;
  padding: 4px 12px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: background 120ms ease, color 120ms ease;
}

.bfast-snackbar-action:hover {
  background: rgba(230, 199, 77, 0.12);
  color: #f5dc6a;
}

/* ---------- Margerin ---------- */

.bfast-margerin-root {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  animation: bfast-fade-in-up 200ms ease-out;
}

.bfast-margerin-pill {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px 12px 22px;
  border-radius: 999px;
  background: linear-gradient(135deg, #2b2448 0%, #1c1830 100%);
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: #f0ecff;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  user-select: none;
  box-shadow: 0 10px 32px rgba(0, 0, 0, 0.55),
              0 0 0 1px rgba(124, 108, 220, 0.25);
  transition: transform 120ms ease, box-shadow 160ms ease, border-color 160ms ease;
}

.bfast-margerin-pill:hover {
  transform: translateY(-1px);
  box-shadow: 0 14px 36px rgba(0, 0, 0, 0.6),
              0 0 0 1px rgba(148, 130, 246, 0.45);
  border-color: rgba(148, 130, 246, 0.35);
}

.bfast-margerin-pill:active {
  transform: translateY(0);
}

.bfast-margerin-pill--check {
  box-shadow: 0 10px 32px rgba(0, 0, 0, 0.55),
              0 0 0 1px rgba(120, 210, 150, 0.35);
}

.bfast-margerin-pill--x {
  box-shadow: 0 10px 32px rgba(0, 0, 0, 0.55),
              0 0 0 1px rgba(220, 120, 120, 0.35);
}

.bfast-margerin-pill--chat {
  box-shadow: 0 10px 32px rgba(0, 0, 0, 0.55),
              0 0 0 1px rgba(120, 170, 230, 0.35);
}

.bfast-margerin-label {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 380px;
}

.bfast-margerin-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  font-size: 14px;
  line-height: 1;
  flex: 0 0 auto;
}

.bfast-margerin-icon--primary {
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.18);
}

.bfast-margerin-icon--primary.bfast-margerin-icon--check {
  background: rgba(120, 210, 150, 0.18);
  color: #b6f0c9;
  border-color: rgba(120, 210, 150, 0.45);
}

.bfast-margerin-icon--primary.bfast-margerin-icon--x {
  background: rgba(220, 120, 120, 0.18);
  color: #f3bcbc;
  border-color: rgba(220, 120, 120, 0.45);
}

.bfast-margerin-icon--primary.bfast-margerin-icon--chat {
  background: rgba(120, 170, 230, 0.18);
  color: #c9defc;
  border-color: rgba(120, 170, 230, 0.45);
}

.bfast-margerin-secondary-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.bfast-margerin-icon--secondary {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: rgba(240, 236, 255, 0.55);
  cursor: pointer;
  opacity: 0.65;
  transition: opacity 120ms ease, transform 120ms ease,
              background 120ms ease, border-color 120ms ease;
}

.bfast-margerin-icon--secondary:hover {
  opacity: 1;
  transform: translateY(-1px);
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.22);
  color: #ffffff;
}

.bfast-margerin-icon--secondary.bfast-margerin-icon--x:hover {
  background: rgba(220, 120, 120, 0.18);
  border-color: rgba(220, 120, 120, 0.55);
  color: #f3bcbc;
}

.bfast-margerin-icon--secondary.bfast-margerin-icon--chat:hover {
  background: rgba(120, 170, 230, 0.18);
  border-color: rgba(120, 170, 230, 0.55);
  color: #c9defc;
}

/* ---------- reduced motion ---------- */

@media (prefers-reduced-motion: reduce) {
  .bfast-toast,
  .bfast-snackbar,
  .bfast-margerin-root {
    animation: none;
  }
  .bfast-snackbar-bead {
    animation: none;
  }
  .bfast-margerin-pill,
  .bfast-margerin-icon--secondary {
    transition: none;
  }
}
</file>

<file path="src/components/bfast/BfastBundle.jsx">
/**
 * BfastBundle — the single mount point for the three fast-feedback
 * UI elements: Toast, Snackbar, and Margerin.
 *
 * Subscribes to bfast-queue via useSyncExternalStore and renders:
 *   - at most ONE Margerin (head-of-queue) at the "hold" slot
 *   - all queued Toasts (stacked, vertical)
 *   - all queued Snackbars (stacked, vertical)
 *
 * Rationale: margerins gate the caller's Promise, so only one should
 * be presentable at a time to avoid ambiguous user intent. Toasts and
 * snackbars are non-gating and can pile up; the queue handles their
 * lifetimes.
 *
 * This file owns NO state of its own; it is pure view over
 * bfast-queue.
 */

import { useSyncExternalStore } from 'react';
import {
  subscribe,
  getState,
  selectCurrentMargerin,
  selectToasts,
  selectSnackbars,
} from '../../lib/bfast-queue';
import Margerin from './Margerin';
import Toast from './Toast';
import Snackbar from './Snackbar';

import './bfast.css';

function BfastBundle() {
  const state = useSyncExternalStore(subscribe, getState, getState);

  const margerin = selectCurrentMargerin(state);
  const toasts = selectToasts(state);
  const snackbars = selectSnackbars(state);

  return (
    <div className="bfast-bundle" aria-live="polite">
      <div className="bfast-bundle-snackbars">
        {snackbars.map((s) => (
          <Snackbar key={s.id} action={s} />
        ))}
      </div>
      <div className="bfast-bundle-toasts">
        {toasts.map((t) => (
          <Toast key={t.id} action={t} />
        ))}
      </div>
      <div className="bfast-bundle-margerin-slot">
        {margerin && <Margerin key={margerin.id} action={margerin} />}
      </div>
    </div>
  );
}

export default BfastBundle;
</file>

<file path="src/components/bfast/Margerin.jsx">
/**
 * Margerin — the pre-hoc intent-hold pill.
 *
 * One instance of this renders at a time (BfastBundle only passes in
 * the current head-of-queue margerin). The component is stateless
 * aside from hover tracking; all authoritative state lives in
 * bfast-queue.
 *
 * Interaction surface:
 *   - Click anywhere on the pill          → commit currently-selected icon
 *   - Click directly on one of the three
 *     icons (primary inside the pill or
 *     either secondary icon beneath)      → commit THAT icon
 *   - Scroll wheel while pointer is
 *     over the pill                       → rotate selected icon
 *
 * Visual rules:
 *   - The currently-selected icon renders inside the pill on the right.
 *   - The two unselected icons render beneath the pill as secondary
 *     affordances at reduced opacity.
 *   - The pill label is the action preview (e.g. "Add event 'Lunch'
 *     on Apr 10").
 */

import { useCallback, useRef } from 'react';
import {
  rotateSelectedIcon,
  setSelectedIcon,
  commitMargerin,
} from '../../lib/bfast-queue';

const ICON_ORDER = ['check', 'x', 'chat'];

const ICON_GLYPH = {
  check: '\u2713',  // ✓
  x:     '\u2715',  // ✕
  chat:  '\u{1F4AC}', // 💬
};

const ICON_TITLE = {
  check: 'Approve and run',
  x:     'Cancel',
  chat:  'Return to chat for refinement',
};

function Margerin({ action }) {
  const { id, label, selectedIcon } = action;
  const wheelAccumRef = useRef(0);

  const handleWheel = useCallback(
    (e) => {
      e.preventDefault();
      e.stopPropagation();
      // Accumulate deltaY so a single gentle flick (small delta) still
      // rotates exactly one step, and big scrolls don't over-rotate.
      wheelAccumRef.current += e.deltaY;
      const threshold = 20;
      if (Math.abs(wheelAccumRef.current) >= threshold) {
        const direction = wheelAccumRef.current > 0 ? 1 : -1;
        rotateSelectedIcon(id, direction);
        wheelAccumRef.current = 0;
      }
    },
    [id],
  );

  const handlePillClick = useCallback(() => {
    commitMargerin(id);
  }, [id]);

  const handleIconClick = useCallback(
    (e, icon) => {
      e.stopPropagation();
      setSelectedIcon(id, icon);
      commitMargerin(id, icon);
    },
    [id],
  );

  const secondaryIcons = ICON_ORDER.filter((i) => i !== selectedIcon);

  return (
    <div className="bfast-margerin-root">
      <button
        type="button"
        className={`bfast-margerin-pill bfast-margerin-pill--${selectedIcon}`}
        onClick={handlePillClick}
        onWheel={handleWheel}
        aria-label={`${label}. ${ICON_TITLE[selectedIcon]}. Scroll to change action.`}
      >
        <span className="bfast-margerin-label">{label}</span>
        <span
          className={`bfast-margerin-icon bfast-margerin-icon--primary bfast-margerin-icon--${selectedIcon}`}
          aria-hidden="true"
        >
          {ICON_GLYPH[selectedIcon]}
        </span>
      </button>
      <div className="bfast-margerin-secondary-row" aria-hidden="false">
        {secondaryIcons.map((icon) => (
          <button
            type="button"
            key={icon}
            className={`bfast-margerin-icon bfast-margerin-icon--secondary bfast-margerin-icon--${icon}`}
            onClick={(e) => handleIconClick(e, icon)}
            title={ICON_TITLE[icon]}
            aria-label={ICON_TITLE[icon]}
          >
            {ICON_GLYPH[icon]}
          </button>
        ))}
      </div>
    </div>
  );
}

export default Margerin;
</file>

<file path="src/components/bfast/Snackbar.jsx">
/**
 * Snackbar — post-hoc receipt with one optional action.
 *
 * Visual: yellow-stroke pill with a pulsing blue bead and underlined
 * message. Used for "something just happened and you might want to
 * undo/open/view it" moments. Auto-dismisses after durationMs
 * (default 5000), but the action button stays tappable until then.
 *
 * Unlike a Margerin, the primary effect has ALREADY happened by the
 * time a Snackbar shows. The action, if present, is a compensatory
 * follow-up ("Undo", "Open", "View", etc).
 *
 * The Snackbar is stateless. All lifecycle (enqueue, auto-dismiss,
 * removal) is owned by bfast-queue.
 */

import { dismiss } from '../../lib/bfast-queue';

function Snackbar({ action }) {
  const { id, message, action: innerAction } = action;

  const handleActionClick = (e) => {
    e.stopPropagation();
    try {
      if (innerAction && typeof innerAction.onPress === 'function') {
        innerAction.onPress();
      }
    } finally {
      dismiss(id);
    }
  };

  const handleRootClick = () => {
    // Tapping the body dismisses early without invoking the action.
    dismiss(id);
  };

  return (
    <div
      className="bfast-snackbar"
      role="status"
      aria-live="polite"
      onClick={handleRootClick}
    >
      <span className="bfast-snackbar-bead" aria-hidden="true" />
      <span className="bfast-snackbar-message">{message}</span>
      {innerAction && (
        <button
          type="button"
          className="bfast-snackbar-action"
          onClick={handleActionClick}
          aria-label={innerAction.label}
        >
          {innerAction.label}
        </button>
      )}
    </div>
  );
}

export default Snackbar;
</file>

<file path="src/components/bfast/Toast.jsx">
/**
 * Toast — post-hoc, fire-and-forget receipt.
 *
 * Visual: soft gradient pill, no buttons. Appears briefly after an
 * action has already been committed to confirm success (or failure).
 * Auto-dismisses; the user cannot interact with it beyond hovering
 * (which pauses the timer — handled by BfastBundle, not here).
 *
 * Tone variants:
 *   - 'success' (default) — soft purple gradient
 *   - 'info'              — neutral slate
 *   - 'error'             — muted red
 *
 * The Toast is stateless. All lifecycle (enqueue, auto-dismiss,
 * removal) is owned by bfast-queue.
 */

import { dismiss } from '../../lib/bfast-queue';

function Toast({ action }) {
  const { id, message, tone = 'info' } = action;

  const handleClick = () => {
    // Tapping a toast dismisses it early — this is a no-op convenience
    // gesture, not a confirmation.
    dismiss(id);
  };

  return (
    <div
      className={`bfast-toast bfast-toast--${tone}`}
      role="status"
      aria-live="polite"
      onClick={handleClick}
    >
      <span className="bfast-toast-message">{message}</span>
    </div>
  );
}

export default Toast;
</file>

<file path="src/components/canvases/CanvasCard.jsx">
import { useState, useRef, useEffect } from 'react';
import { CANVAS_RENDER_ENGINES } from '../../lib/canvasUtils';

const FORM_FACTOR_BADGES = {
  float: { label: 'Float', className: 'canvas-badge canvas-badge-float' },
  tile: { label: 'Tile', className: 'canvas-badge canvas-badge-tile' },
  hybrid: { label: 'Hybrid', className: 'canvas-badge canvas-badge-hybrid' },
  widget: { label: 'Widget', className: 'canvas-badge canvas-badge-widget' },
};

const FORM_FACTOR_ORDER = ['float', 'tile', 'hybrid', 'widget'];

function formatWhen(ts) {
  if (!ts) return '';
  try {
    const d = new Date(ts);
    return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
  } catch { return ''; }
}

function CanvasCard({
  canvas,
  onOpen,
  onDelete,
  onRename,
  onSetFormFactor,
  onSetRenderEngine,
}) {
  const [menuOpen, setMenuOpen] = useState(false);
  const [renaming, setRenaming] = useState(false);
  const [renameValue, setRenameValue] = useState(canvas.title || '');
  const menuRef = useRef(null);
  const cardRef = useRef(null);

  useEffect(() => {
    if (!menuOpen) return;
    const handleDocClick = (e) => {
      if (menuRef.current && !menuRef.current.contains(e.target)) {
        setMenuOpen(false);
      }
    };
    document.addEventListener('mousedown', handleDocClick);
    return () => document.removeEventListener('mousedown', handleDocClick);
  }, [menuOpen]);

  const badge = FORM_FACTOR_BADGES[canvas.formFactor] || FORM_FACTOR_BADGES.float;
  const isWebCapable = canvas.source === 'url' || !!canvas.url;
  const showWebBadge = isWebCapable
    && (canvas.renderEngine || CANVAS_RENDER_ENGINES.IFRAME) !== CANVAS_RENDER_ENGINES.IFRAME;
  const webBadgeLabel = showWebBadge ? 'WEB+' : '';

  const handleCardClick = () => {
    if (renaming || menuOpen) return;
    onOpen?.(canvas);
  };

  const handleContextMenu = (e) => {
    e.preventDefault();
    setMenuOpen(true);
  };

  const handleRenameSubmit = () => {
    const value = renameValue.trim();
    if (value && value !== canvas.title) {
      onRename?.(canvas, value);
    }
    setRenaming(false);
  };

  const handleRenameCancel = () => {
    setRenameValue(canvas.title || '');
    setRenaming(false);
  };

  const startRename = () => {
    setMenuOpen(false);
    setRenameValue(canvas.title || '');
    setRenaming(true);
  };

  const handleDelete = () => {
    setMenuOpen(false);
    onDelete?.(canvas);
  };

  const handleFormFactorPick = (factor) => {
    setMenuOpen(false);
    onSetFormFactor?.(canvas, factor);
  };

  const handleRenderEnginePick = (renderEngine) => {
    setMenuOpen(false);
    onSetRenderEngine?.(canvas, renderEngine);
  };

  return (
    <div
      ref={cardRef}
      className={menuOpen ? 'canvas-card menu-open' : 'canvas-card'}
      onClick={handleCardClick}
      onContextMenu={handleContextMenu}
      title={canvas.title}
    >
      <div className="canvas-card-icon">
        <span className="cb-icon">􀈷</span>
      </div>
      <div className="canvas-card-main">
        {renaming ? (
          <input
            type="text"
            className="canvas-card-rename"
            value={renameValue}
            autoFocus
            onClick={(e) => e.stopPropagation()}
            onChange={(e) => setRenameValue(e.target.value)}
            onBlur={handleRenameSubmit}
            onKeyDown={(e) => {
              if (e.key === 'Enter') handleRenameSubmit();
              if (e.key === 'Escape') handleRenameCancel();
            }}
          />
        ) : (
          <div className="canvas-card-title">{canvas.title || canvas.filename}</div>
        )}
        <div className="canvas-card-meta">
          <span className={badge.className}>{badge.label}</span>
          {webBadgeLabel ? (
            <span className="canvas-badge canvas-badge-webplus">{webBadgeLabel}</span>
          ) : null}
          {canvas.updatedAt ? (
            <span className="canvas-card-when">{formatWhen(canvas.updatedAt)}</span>
          ) : null}
        </div>
      </div>
      <button
        type="button"
        className="canvas-card-more"
        aria-label="Open menu"
        onClick={(e) => {
          e.stopPropagation();
          setMenuOpen((v) => !v);
        }}
      >
        ⋯
      </button>
      {menuOpen ? (
        <div ref={menuRef} className="canvas-card-menu" onClick={(e) => e.stopPropagation()}>
          <button type="button" onClick={() => { setMenuOpen(false); onOpen?.(canvas); }}>Open</button>
          <button type="button" onClick={startRename}>Rename</button>
          <div className="canvas-card-menu-section">
            <div className="canvas-card-menu-label">Form factor</div>
            {FORM_FACTOR_ORDER.map((factor) => (
              <button
                key={factor}
                type="button"
                className={factor === canvas.formFactor ? 'is-active' : ''}
                onClick={() => handleFormFactorPick(factor)}
              >
                {FORM_FACTOR_BADGES[factor].label}
              </button>
            ))}
          </div>
          {isWebCapable ? (
            <div className="canvas-card-menu-section">
              <div className="canvas-card-menu-label">Render engine</div>
              {[
                { key: CANVAS_RENDER_ENGINES.AUTO, label: 'Auto' },
                { key: CANVAS_RENDER_ENGINES.IFRAME, label: 'Iframe' },
                { key: CANVAS_RENDER_ENGINES.BROWSER, label: 'Browser' },
              ].map((engine) => (
                <button
                  key={engine.key}
                  type="button"
                  className={engine.key === (canvas.renderEngine || CANVAS_RENDER_ENGINES.IFRAME) ? 'is-active' : ''}
                  onClick={() => handleRenderEnginePick(engine.key)}
                >
                  {engine.label}
                </button>
              ))}
            </div>
          ) : null}
          <button type="button" className="canvas-card-menu-danger" onClick={handleDelete}>Delete</button>
        </div>
      ) : null}
    </div>
  );
}

export default CanvasCard;
</file>

