  const OrganizerFilterSort = {
    state: {
      activeFilter: 'all',
      activeSort: 'name',
      sortDirection: 'asc',
      sortAscending: true
    },

    init() {
      // Load persisted state
      const saved = localStorage.getItem('orgFilterSort');
      if (saved) {
        try {
          const parsed = JSON.parse(saved);
          this.state = { ...this.state, ...parsed };
        } catch {}
      }
      this.setupEventListeners();
      this.applyActiveStates();
    },

    setupEventListeners() {
      // Filter buttons
      document.querySelectorAll('.org-filter').forEach(btn => {
        btn.addEventListener('click', () => {
          this.state.activeFilter = btn.dataset.mode;
          this.save();
          this.applyActiveStates();
          renderOrganizerList();
        });
      });

      // Sort buttons
      document.querySelectorAll('.org-sort-toggle').forEach(btn => {
        btn.addEventListener('click', () => {
          const mode = btn.dataset.sort;
          // Toggle sort direction if clicking same button
          if (this.state.activeSort === mode) {
            this.state.sortAscending = !this.state.sortAscending;
          } else {
            this.state.activeSort = mode;
            this.state.sortAscending = true;
          }
          this.save();
          this.applyActiveStates();
          renderOrganizerList();
        });
      });
    },

    applyActiveStates() {
      // Update filter buttons
      document.querySelectorAll('.org-filter').forEach(btn => {
        const isActive = btn.dataset.mode === this.state.activeFilter;
        if (isActive) {
          btn.classList.add('active');
          btn.setAttribute('aria-pressed', 'true');
        } else {
          btn.classList.remove('active');
          btn.setAttribute('aria-pressed', 'false');
        }
      });

      // Update sort buttons with directional indicator
      document.querySelectorAll('.org-sort-toggle').forEach(btn => {
        const isActive = btn.dataset.sort === this.state.activeSort;
        if (isActive) {
          btn.classList.add('active');
          btn.setAttribute('aria-pressed', 'true');
          btn.title = `Sort by ${btn.dataset.sort} (${this.state.sortAscending ? '↑ ascending' : '↓ descending'})`;
        } else {
          btn.classList.remove('active');
          btn.setAttribute('aria-pressed', 'false');
          btn.title = `Sort by ${btn.dataset.sort} (click to toggle direction)`;
        }
      });
    },

    save() {
      localStorage.setItem('orgFilterSort', JSON.stringify(this.state));
      // Also queue Firestore save for cloud sync
      if (window.persistence && typeof persistence.queueFirebaseSave === 'function') {
        try {
          persistence.queueFirebaseSave('app', 'orgFilterSort', this.state);
        } catch (e) { /* Firestore not available */ }
      }
    },

    getFilteredAndSortedItems() {
      let items = [...OrganizerStore.items];

      // Apply filter
      if (this.state.activeFilter !== 'all') {
        const filterMap = {
          'notes': ['note'],
          'events': ['event'],
          'timers': ['timer'],
          'externals': ['external', 'custom-panel']
        };
        const allowedTypes = filterMap[this.state.activeFilter] || [];
        items = items.filter(i => allowedTypes.includes(i.type));
      }

      // Apply sort
      const sortKey = this.state.activeSort;
      items.sort((a, b) => {
        let aVal, bVal;

        switch(sortKey) {
          case 'name':
            aVal = (a.name || '').toLowerCase();
            bVal = (b.name || '').toLowerCase();
            break;
          case 'created':
            aVal = a.createdAt || 0;
            bVal = b.createdAt || 0;
            break;
          case 'due':
            aVal = a.due || a.scheduledDate || '';
            bVal = b.due || b.scheduledDate || '';
            break;
          case 'status':
            aVal = (a.status || 'todo');
            bVal = (b.status || 'todo');
            break;
          case 'type':
            aVal = a.type || '';
            bVal = b.type || '';
            break;
          default:
            return 0;
        }

        // Handle numeric comparisons
        if (typeof aVal === 'number' && typeof bVal === 'number') {
          return this.state.sortAscending ? aVal - bVal : bVal - aVal;
        }

        // Handle string comparisons
        const comparison = String(aVal).localeCompare(String(bVal));
        return this.state.sortAscending ? comparison : -comparison;
      });

      return items;
    }
  };

