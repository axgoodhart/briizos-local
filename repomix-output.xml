import { useLayout } from './hooks/useLayout';
import './components/layout/layout.css';

// Auth context
import { AuthProvider, useAuth } from './context/AuthContext';
import { OrganizerProvider } from './context/OrganizerContext';
import { ChatSettingsProvider } from './context/ChatSettingsContext';
import { ToolProvider, useTools } from './context/ToolContext';
import { useAppContext } from './hooks/useAppContext';
import { useAgentWorkers } from './hooks/useAgentWorkers';
import { useToolBridge } from './hooks/useToolBridge';
import { useTaskAutomation } from './hooks/useTaskAutomation';
import { setBriizToolsContext } from './lib/briizos-tools';

// New overlay imports
import { ControlBar } from './components/controlbar';
import { BriiztormOverlay, ActionDeckColumn, OrganizerModal, CalendarModal, LiveCanvas, DashboardOverlay } from './components/overlays';
import { NotesWidget } from './components/notes';
import { CanvasesPopover, CanvasTile } from './components/canvases';
import { useCanvases } from './hooks/useCanvases';
import BfastBundle from './components/bfast/BfastBundle';
import { toast as bfastToast } from './lib/bfast-queue';
import logger from './lib/logger';
import { CANVAS_RENDER_ENGINES } from './lib/canvasUtils';
import {
  DEFAULT_ACTIONDECK_PANEL_SETTINGS,
  DEFAULT_CANVAS_PANEL_SETTINGS,
  PANEL_VIEW_OPTIONS,
  loadPanelSettings,
  normalizePanelSettings,
  resolvePanelStartView,
  savePanelSettings,
} from './lib/floatingPanelPrefs';

const UI_THEME_STORAGE_KEY = 'briizos.ui_theme';
const ACTIONDECK_SETTINGS_KEY = 'briizos.actiondeck.panel-settings';

function applyUiTheme(theme) {
  if (typeof document === 'undefined') return;
  const root = document.documentElement;

  // Trigger transition animation
  root.classList.remove('theme-transitioning');
  // Force reflow so the animation restarts
  void root.offsetWidth;
  root.classList.add('theme-transitioning');

  if (!theme || theme === 'default') {
    root.removeAttribute('data-theme');
    return;
  }
  root.setAttribute('data-theme', theme);

  // Clean up animation class after animation completes
  setTimeout(() => {
    root.classList.remove('theme-transitioning');
  }, 500);
}

// Debug counter to track renders
let appRenderCount = 0;

// WMO weather code to glyph
function wmoGlyph(code) {
  if (code === 0) return '☀';
  if (code <= 3) return '⛅';
  if (code <= 48) return '☁';
  if (code <= 57) return '🌧';
  if (code <= 67) return '🌧';
  if (code <= 77) return '❄';
  if (code <= 82) return '🌧';
  if (code <= 86) return '❄';
  if (code <= 99) return '⛈';
  return '☁';
}

const WEATHER_FALLBACK_COORDS_BY_TZ = {
  'America/New_York': { latitude: 40.7128, longitude: -74.0060 }, // NYC
  'America/Chicago': { latitude: 41.8781, longitude: -87.6298 }, // Chicago
  'America/Denver': { latitude: 39.7392, longitude: -104.9903 }, // Denver
  'America/Los_Angeles': { latitude: 34.0522, longitude: -118.2437 }, // Los Angeles
  default: { latitude: 40.7128, longitude: -74.0060 }
};

function getFallbackWeatherCoords() {
  const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
  return WEATHER_FALLBACK_COORDS_BY_TZ[tz] || WEATHER_FALLBACK_COORDS_BY_TZ.default;
}

async function getWeatherCoords() {
  if (typeof navigator !== 'undefined' && navigator.geolocation) {
    try {
      const pos = await new Promise((resolve, reject) =>
        navigator.geolocation.getCurrentPosition(resolve, reject, {
          enableHighAccuracy: false,
          timeout: 8000,
          maximumAge: 10 * 60 * 1000
        })
      );
      return { latitude: pos.coords.latitude, longitude: pos.coords.longitude };
    } catch (error) {
      logger.warn('ui', 'Geolocation unavailable for weather, using timezone fallback', error?.message);
    }
  }
  return getFallbackWeatherCoords();
}

function normalizeWeatherPayload(data) {
  const tempRaw = data?.current?.temperature_2m;
  const codeRaw = data?.current?.weather_code;
  if (typeof tempRaw !== 'number' || typeof codeRaw !== 'number') {
    throw new Error('Weather response missing current temperature/code');
  }
  return { temp: Math.round(tempRaw), code: codeRaw };
}

async function fetchWeatherDirect(lat, lon) {
  const resp = await fetch(
    `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,weather_code&temperature_unit=fahrenheit`,
    { cache: 'no-store' }
  );
  if (!resp.ok) throw new Error(`Weather request failed (${resp.status})`);
  const data = await resp.json();
  return normalizeWeatherPayload(data);
}

async function fetchWeatherForCoords(lat, lon) {
  if (typeof window !== 'undefined' && typeof window.api?.weatherGetCurrent === 'function') {
    try {
      const result = await window.api.weatherGetCurrent(lat, lon);
      if (!result?.ok) {
        throw new Error(result?.error || 'Weather IPC request failed');
      }
      if (typeof result.temperature !== 'number' || typeof result.weatherCode !== 'number') {
        throw new Error('Weather IPC response missing temperature/code');
      }
      return { temp: Math.round(result.temperature), code: result.weatherCode };
    } catch (error) {
      logger.warn('ui', 'Weather IPC path failed, trying renderer fetch fallback', error?.message);
    }
  }
  return fetchWeatherDirect(lat, lon);
}

function HeaderDateTimeWeather() {
  const [time, setTime] = useState('');
  const [date, setDate] = useState('');
  const [weather, setWeather] = useState('--°');

  useEffect(() => {
    const tick = () => {
      const now = new Date();
      setTime(now.toLocaleTimeString('en-US', { hour12: false, hour: '2-digit', minute: '2-digit' }));
      const day = now.getDate();
      const ord = day % 10 === 1 && day !== 11 ? 'ST' :
                  day % 10 === 2 && day !== 12 ? 'ND' :
                  day % 10 === 3 && day !== 13 ? 'RD' : 'TH';
      setDate(`${now.toLocaleDateString('en-US', { weekday: 'short' }).toUpperCase()}.${now.toLocaleDateString('en-US', { month: 'short' }).toUpperCase()}.${day}${ord}`);
    };
    tick();
    const id = setInterval(tick, 1000);
    return () => clearInterval(id);
  }, []);

  useEffect(() => {
    let cancelled = false;
    let coordsPromise = null;

    const resolveCoords = () => {
      if (!coordsPromise) coordsPromise = getWeatherCoords();
      return coordsPromise;
    };

    const fetchWeather = async () => {
      try {
        const { latitude: lat, longitude: lon } = await resolveCoords();
        const { temp, code } = await fetchWeatherForCoords(lat, lon);
        if (!cancelled) {
          setWeather(`${wmoGlyph(code)} ${temp}°`);
        }
      } catch (error) {
        logger.warn('ui', 'Failed to refresh header weather', error?.message);
        if (!cancelled) setWeather('--°');
      }
    };
    fetchWeather();
    const id = setInterval(fetchWeather, 600000);
    return () => { cancelled = true; clearInterval(id); };
  }, []);

  return (
    <div className="header-datetime-weather" style={{ WebkitAppRegion: 'no-drag' }}>
      <span className="header-time">{time}</span>
      <span className="header-date">{date}</span>
      <span className="header-weather">{weather}</span>
    </div>
  );
}

// Inner app component that uses auth context
function AppContent({ layout }) {
  const { isAuthenticated, loading: authLoading } = useAuth();
  const { executeTool } = useTools();
  const appContext = useAppContext();
  useAgentWorkers(executeTool, appContext);
  useToolBridge(executeTool, appContext);
  useTaskAutomation();

  // Feed the BriizTools chat pipeline the same appContext + layoutHook
  // that ToolContext/useToolBridge already use. This is how chat-originated
  // tool calls (useChat → BriizTools.execute) reach the real handlers in
  // src/lib/tools.js instead of the fake-success stub in electron/main.js.
  useEffect(() => {
    setBriizToolsContext({ appContext, layoutHook: layout });
  }, [appContext, layout]);
  appRenderCount++;
  logger.debug('ui', `App render #${appRenderCount}`);

  // Existing state
  const [showSettings, setShowSettings] = useState(false);
  const {
    getVisiblePanels,
    getPanelByType,
    addPanel,
    removePanel,
    togglePanelVisibility,
    updateColumnSizes,
    updateStackSizes,
    movePanel,
    getLayoutRow,
    updateWorkspace,
    layoutRow,
    isLoading: layoutLoading
  } = layout;

  // Workspace-persisted overlay states
  const workspace = layoutRow.workspace || {};
  const [briiztormOpen, setBriiztormOpen] = useState(false);
  const [actionDeckFloating, setActionDeckFloating] = useState(false);
  const [organizerOpen, setOrganizerOpen] = useState(false);
  const [calendarOpen, setCalendarOpen] = useState(false);
  const [mediaOpen, setMediaOpen] = useState(false);
  const [notesOpen, setNotesOpen] = useState(false);
  const [canvasOpen, setCanvasOpen] = useState(false);
  const [canvasData, setCanvasData] = useState(null);
  const [canvasTitle, setCanvasTitle] = useState('Canvas');
  // Canvases library (the Control Bar folder feature)
  const [canvasesPopoverOpen, setCanvasesPopoverOpen] = useState(false);
  // openCanvases tracks which saved canvases are currently mounted
  // { [filename]: { formFactor: 'float' | 'tile' | 'hybrid' | 'widget' } }
  const [openCanvases, setOpenCanvases] = useState({});
  // The single floating canvas currently in LiveCanvas from the popover
  // (separate from the AI-driven canvasData path). Shape:
  // { filename, title, rawHtml }
  const [floatingCanvas, setFloatingCanvas] = useState(null);
  const canvasesHook = useCanvases();

  useEffect(() => {
    const savedTheme = localStorage.getItem(UI_THEME_STORAGE_KEY) || 'default';
    applyUiTheme(savedTheme);
  }, []);

  // Restore workspace state once layout loads from Firestore
  const workspaceRestoredRef = useRef(false);
  useEffect(() => {
    if (!layoutLoading && !workspaceRestoredRef.current) {
      workspaceRestoredRef.current = true;
      const ws = layoutRow.workspace;
      if (ws) {
        if (ws.notesOpen) setNotesOpen(true);
        if (ws.actionDeckFloating) setActionDeckFloating(true);
        if (ws.mediaOpen) setMediaOpen(true);
        if (ws.openCanvases && typeof ws.openCanvases === 'object') {
          setOpenCanvases(ws.openCanvases);
        }
      }
    }
  }, [layoutLoading, layoutRow.workspace]);

  // Persist overlay states to workspace (debounced via useLayout)
  useEffect(() => {
    if (!workspaceRestoredRef.current) return;
    updateWorkspace({ notesOpen, actionDeckFloating, mediaOpen, openCanvases });
  }, [notesOpen, actionDeckFloating, mediaOpen, openCanvases, updateWorkspace]);

  // Get the panels from the layout hook
  const panels = getVisiblePanels();
  logger.debug('ui', 'App panels', panels.map(p => p.id));
  const actionDeckPanel = getPanelByType('actiondeck');
  const actionDeckOpen = actionDeckFloating || actionDeckPanel?.visible === true;

  const getActionDeckPanelSettings = useCallback(() => (
    loadPanelSettings(ACTIONDECK_SETTINGS_KEY, DEFAULT_ACTIONDECK_PANEL_SETTINGS)
  ), []);

  const saveActionDeckPanelSettings = useCallback((updater) => {
    const current = getActionDeckPanelSettings();
    const next = normalizePanelSettings(
      typeof updater === 'function' ? updater(current) : { ...current, ...updater },
      DEFAULT_ACTIONDECK_PANEL_SETTINGS
    );
    savePanelSettings(ACTIONDECK_SETTINGS_KEY, next, DEFAULT_ACTIONDECK_PANEL_SETTINGS);
    return next;
  }, [getActionDeckPanelSettings]);

  const openActionDeckColumn = useCallback(() => {
    saveActionDeckPanelSettings({ lastUsedView: PANEL_VIEW_OPTIONS.TILE });
    if (actionDeckPanel?.visible) return;
    if (actionDeckPanel) {
      togglePanelVisibility(actionDeckPanel.id);
      return;
    }
    addPanel({
      id: 'actiondeck',
      type: 'actiondeck',
      size: 25,
      visible: true
    });
  }, [actionDeckPanel, togglePanelVisibility, addPanel, saveActionDeckPanelSettings]);

  const hideActionDeckColumn = useCallback(() => {
    if (actionDeckPanel?.visible) {
      togglePanelVisibility(actionDeckPanel.id);
    }
  }, [actionDeckPanel, togglePanelVisibility]);

  const toggleActionDeck = useCallback(() => {
    if (actionDeckFloating) {
      setActionDeckFloating(false);
      return;
    }
    if (actionDeckPanel?.visible) {
      hideActionDeckColumn();
      return;
    }
    const preferredView = resolvePanelStartView(
      getActionDeckPanelSettings(),
      PANEL_VIEW_OPTIONS.TILE
    );
    if (preferredView === PANEL_VIEW_OPTIONS.FLOATING) {
      setActionDeckFloating(true);
      saveActionDeckPanelSettings({ lastUsedView: PANEL_VIEW_OPTIONS.FLOATING });
      return;
    }
    openActionDeckColumn();
  }, [
    actionDeckFloating,
    actionDeckPanel,
    getActionDeckPanelSettings,
    hideActionDeckColumn,
    openActionDeckColumn,
    saveActionDeckPanelSettings,
  ]);

  const popOutActionDeck = useCallback(() => {
    hideActionDeckColumn();
    saveActionDeckPanelSettings({ lastUsedView: PANEL_VIEW_OPTIONS.FLOATING });
    setActionDeckFloating(true);
  }, [hideActionDeckColumn, saveActionDeckPanelSettings]);

  const dockActionDeck = useCallback(() => {
    setActionDeckFloating(false);
    openActionDeckColumn();
  }, [openActionDeckColumn]);

  const closeActionDeck = useCallback(() => {
    if (actionDeckFloating) {
      setActionDeckFloating(false);
      return;
    }
    hideActionDeckColumn();
  }, [actionDeckFloating, hideActionDeckColumn]);

  // ----- Canvases (folder library of saved mini-apps) -----

  const openCanvasTile = useCallback((filename) => {
    const panelId = `canvas:${filename}`;
    // addPanel is idempotent: if a panel with this id already exists
    // (via findPanelLocation check inside useLayout) it is a no-op.
    addPanel({
      id: panelId,
      type: 'canvas',
      size: 25,
      visible: true,
    });
    logger.info('canvases', 'Canvas tile opened', { filename });
  }, [addPanel]);

  const openCanvasFloating = useCallback(async (canvas) => {
    if (!canvas?.filename) return;
    const api = typeof window !== 'undefined' ? window.api : null;
    if (!api?.canvasLoad) {
      logger.warn('canvases', 'Canvas IPC unavailable — cannot open floating canvas');
      return;
    }
    try {
      const raw = await api.canvasLoad(canvas.filename);
      const meta = api.canvasLoadMeta ? await api.canvasLoadMeta(canvas.filename) : {};
      setFloatingCanvas({
        filename: canvas.filename,
        title: canvas.title || canvas.filename,
        rawHtml: raw || '',
        meta: { ...(meta || {}), source: canvas.source || meta?.source },
      });
      setCanvasData({
        filename: canvas.filename,
        rawHtml: raw || '',
        html: '',
        css: '',
        js: '',
        meta: { ...(meta || {}), source: canvas.source || meta?.source },
      });
      setCanvasTitle(canvas.title || canvas.filename);
      setCanvasOpen(true);
      logger.info('canvases', 'Canvas float opened', { filename: canvas.filename });
    } catch (err) {
      logger.error('canvases', 'Failed to open canvas float', { filename: canvas.filename, error: String(err) });
    }
  }, []);

  const persistCanvasPanelSettings = useCallback(async (filename, updater) => {
    if (!filename) return DEFAULT_CANVAS_PANEL_SETTINGS;
    const existing = await canvasesHook.loadMeta(filename);
    const currentSettings = normalizePanelSettings(
      existing?.panelSettings || {},
      DEFAULT_CANVAS_PANEL_SETTINGS
    );
    const nextSettings = normalizePanelSettings(
      typeof updater === 'function' ? updater(currentSettings) : { ...currentSettings, ...updater },
      DEFAULT_CANVAS_PANEL_SETTINGS
    );
    await canvasesHook.saveMeta(filename, {
      ...(existing || {}),
      panelSettings: nextSettings,
    });
    if (floatingCanvas?.filename === filename) {
      setFloatingCanvas((prev) => prev ? {
        ...prev,
        meta: { ...(prev.meta || {}), panelSettings: nextSettings },
      } : null);
      setCanvasData((prev) => prev ? {
        ...prev,
        meta: { ...(prev.meta || {}), panelSettings: nextSettings },
      } : null);
    }
    return nextSettings;
  }, [canvasesHook, floatingCanvas]);

  const handleOpenCanvas = useCallback(async (canvas) => {
    if (!canvas) return;
    const meta = await canvasesHook.loadMeta(canvas.filename);
    const preferredView = resolvePanelStartView(
      meta?.panelSettings || DEFAULT_CANVAS_PANEL_SETTINGS,
      PANEL_VIEW_OPTIONS.FLOATING
    );
    const factor = preferredView === PANEL_VIEW_OPTIONS.TILE ? 'tile' : 'float';
    setOpenCanvases((prev) => ({ ...prev, [canvas.filename]: { formFactor: factor } }));
    await persistCanvasPanelSettings(canvas.filename, { lastUsedView: preferredView });
    if (factor === 'tile') {
      openCanvasTile(canvas.filename);
    }
    if (factor === 'float') {
      await openCanvasFloating(canvas);
    }
  }, [canvasesHook, openCanvasTile, openCanvasFloating, persistCanvasPanelSettings]);

  const handleCreateCanvas = useCallback(async ({ source, name, html, meta }) => {
    const created = await canvasesHook.createCanvas({
      title: name,
      html,
      formFactor: 'float',
      source,
      meta,
    });
    if (created) {
      await canvasesHook.refresh();
      // Auto-open the new canvas in its default (float) form factor
      await handleOpenCanvas({
        filename: created.filename,
        title: created.title,
        formFactor: 'float',
      });
    }
    return created;
  }, [canvasesHook, handleOpenCanvas]);

  const handleDeleteCanvas = useCallback(async (canvas) => {
    if (!canvas?.filename) return;
    await canvasesHook.deleteCanvas(canvas.filename);
    // Remove tile panel from layout (not just hide — fully remove)
    const panelId = `canvas:${canvas.filename}`;
    removePanel(panelId);
    setOpenCanvases((prev) => {
      if (!prev[canvas.filename]) return prev;
      const next = { ...prev };
      delete next[canvas.filename];
      return next;
    });
    if (floatingCanvas?.filename === canvas.filename) {
      setFloatingCanvas(null);
      setCanvasOpen(false);
      setCanvasData(null);
    }
  }, [canvasesHook, floatingCanvas, removePanel]);

  const handleRenameCanvas = useCallback(async (canvas, newTitle) => {
    if (!canvas?.filename) return;
    const res = await canvasesHook.renameCanvas(canvas.filename, newTitle);
    if (res?.success && res.filename && res.filename !== canvas.filename) {
      const oldPanelId = `canvas:${canvas.filename}`;
      const newPanelId = `canvas:${res.filename}`;
      // Swap tile panel: remove old, add new with same form factor
      setOpenCanvases((prev) => {
        if (!prev[canvas.filename]) return prev;
        const entry = prev[canvas.filename];
        // If this canvas had a tile panel, replace it in the layout
        if (entry.formFactor === 'tile' || entry.formFactor === 'hybrid') {
          removePanel(oldPanelId);
          addPanel({ id: newPanelId, type: 'canvas', size: 25, visible: true });
        }
        const next = { ...prev };
        next[res.filename] = entry;
        delete next[canvas.filename];
        return next;
      });
      // Update floating canvas reference if open
      if (floatingCanvas?.filename === canvas.filename) {
        setFloatingCanvas((prev) => prev ? { ...prev, filename: res.filename, title: newTitle } : null);
      }
    }
  }, [canvasesHook, removePanel, addPanel, floatingCanvas]);

  const handleSetCanvasFormFactor = useCallback(async (canvas, factor) => {
    if (!canvas?.filename) return;
    if (factor === 'widget') {
      try { bfastToast('Widget mode — coming soon'); } catch { /* ignore */ }
      return;
    }
    const prev = openCanvases[canvas.filename];
    const hadTile = prev && (prev.formFactor === 'tile' || prev.formFactor === 'hybrid');
    const hadFloat = prev && (prev.formFactor === 'float' || prev.formFactor === 'hybrid');
    const wantsTile = factor === 'tile' || factor === 'hybrid';
    const wantsFloat = factor === 'float' || factor === 'hybrid';

    await canvasesHook.setFormFactor(canvas.filename, factor);
    // If this canvas is currently open, update its mount shape live
    if (prev) {
      setOpenCanvases((oc) => ({ ...oc, [canvas.filename]: { formFactor: factor } }));
      // Remove tile panel if no longer needed
      if (hadTile && !wantsTile) {
        removePanel(`canvas:${canvas.filename}`);
      }
      // Add tile panel if now needed
      if (wantsTile && !hadTile) {
        openCanvasTile(canvas.filename);
      }
      // Close float if no longer needed
      if (hadFloat && !wantsFloat && floatingCanvas?.filename === canvas.filename) {
        setFloatingCanvas(null);
        setCanvasOpen(false);
        setCanvasData(null);
      }
      // Open float if now needed
      if (wantsFloat && !hadFloat) {
        await openCanvasFloating({ filename: canvas.filename, title: canvas.title, formFactor: factor });
      }
    }
  }, [canvasesHook, openCanvases, openCanvasTile, openCanvasFloating, removePanel, floatingCanvas]);

  const handleSetCanvasRenderEngine = useCallback(async (canvas, renderEngine) => {
    if (!canvas?.filename) return;
    await canvasesHook.setRenderEngine(canvas.filename, renderEngine);
    if (floatingCanvas?.filename === canvas.filename) {
      setFloatingCanvas((prev) => prev ? {
        ...prev,
        meta: { ...(prev.meta || {}), renderEngine },
      } : null);
      setCanvasData((prev) => prev ? {
        ...prev,
        meta: { ...(prev.meta || {}), renderEngine },
      } : null);
    }
  }, [canvasesHook, floatingCanvas]);

  const handleToggleCanvasMount = useCallback(async (filename, mountType) => {
    if (!filename || (mountType !== 'tile' && mountType !== 'float')) return;
    const canvas = canvasesHook.canvases.find((entry) => entry.filename === filename)
      || (floatingCanvas?.filename === filename ? {
        filename,
        title: floatingCanvas.title,
        formFactor: openCanvases[filename]?.formFactor || 'float',
      } : null);
    if (!canvas) return;

    const currentFactor = openCanvases[filename]?.formFactor || canvas.formFactor || 'float';
    const hasTile = currentFactor === 'tile' || currentFactor === 'hybrid';
    const hasFloat = currentFactor === 'float' || currentFactor === 'hybrid';
    const nextHasTile = mountType === 'tile' ? !hasTile : hasTile;
    const nextHasFloat = mountType === 'float' ? !hasFloat : hasFloat;

    if (!nextHasTile && !nextHasFloat) {
      return;
    }

    const nextFactor = nextHasTile && nextHasFloat
      ? 'hybrid'
      : nextHasTile
        ? 'tile'
        : 'float';

    await persistCanvasPanelSettings(filename, {
      lastUsedView: mountType === 'tile' ? PANEL_VIEW_OPTIONS.TILE : PANEL_VIEW_OPTIONS.FLOATING,
    });
    await handleSetCanvasFormFactor(canvas, nextFactor);
  }, [
    canvasesHook.canvases,
    floatingCanvas,
    handleSetCanvasFormFactor,
    openCanvases,
    persistCanvasPanelSettings,
  ]);

  const handlePromoteCanvasToBrowser = useCallback(async (filename) => {
    if (!filename) return;
    const canvas = canvasesHook.canvases.find((entry) => entry.filename === filename);
    if (!canvas) return;
    if (canvas.renderEngine === CANVAS_RENDER_ENGINES.BROWSER) return;
    await handleSetCanvasRenderEngine(canvas, CANVAS_RENDER_ENGINES.BROWSER);
  }, [canvasesHook.canvases, handleSetCanvasRenderEngine]);

  const handleSaveFloatingCanvas = useCallback(async (srcdoc) => {
    if (!floatingCanvas) return;
    const api = typeof window !== 'undefined' ? window.api : null;
    if (!api?.canvasSave) return;
    try {
      await api.canvasSave(floatingCanvas.title || 'Canvas', srcdoc);
      await canvasesHook.refresh();
      logger.info('canvases', 'Floating canvas saved', { title: floatingCanvas.title });
    } catch (err) {
      logger.error('canvases', 'Failed to save floating canvas', { error: String(err) });
    }
  }, [floatingCanvas, canvasesHook]);

  const closeCanvasPanel = useCallback((panelId) => {
    const prefix = 'canvas:';
    if (typeof panelId !== 'string' || !panelId.startsWith(prefix)) return;
    const filename = panelId.slice(prefix.length);
    togglePanelVisibility(panelId);
    setOpenCanvases((prev) => {
      if (!prev[filename]) return prev;
      const current = prev[filename];
      // For hybrid, keep float open; remove tile dimension only
      if (current.formFactor === 'hybrid') {
        return { ...prev, [filename]: { formFactor: 'float' } };
      }
      const next = { ...prev };
      delete next[filename];
      return next;
    });
    logger.info('canvases', 'Canvas tile closed', { filename });
  }, [togglePanelVisibility]);

  useEffect(() => {
    const api = typeof window !== 'undefined' ? window.api : null;
    if (!api?.canvasList || layoutLoading || canvasesHook.isLoading) return;

    const liveFilenames = new Set(
      canvasesHook.canvases
        .map(canvas => canvas?.filename)
        .filter(Boolean)
    );
    const canvasPanelIds = new Set();

    (layoutRow.columns || []).forEach((column) => {
      (column.panels || []).forEach((panel) => {
        if (typeof panel.panelId === 'string' && panel.panelId.startsWith('canvas:')) {
          canvasPanelIds.add(panel.panelId);
        }
      });
    });
    (layoutRow.hiddenPanels || []).forEach((panel) => {
      if (typeof panel.panelId === 'string' && panel.panelId.startsWith('canvas:')) {
        canvasPanelIds.add(panel.panelId);
      }
    });

    const orphanPanelIds = [...canvasPanelIds].filter((panelId) => {
      const filename = panelId.slice('canvas:'.length);
      return !liveFilenames.has(filename);
    });

    if (orphanPanelIds.length === 0) return;

    orphanPanelIds.forEach(removePanel);
    setOpenCanvases((prev) => {
      let changed = false;
      const next = {};
      Object.entries(prev).forEach(([filename, entry]) => {
        if (liveFilenames.has(filename)) {
          next[filename] = entry;
        } else {
          changed = true;
        }
      });
      return changed ? next : prev;
    });
    if (floatingCanvas?.filename && !liveFilenames.has(floatingCanvas.filename)) {
      setFloatingCanvas(null);
      setCanvasOpen(false);
      setCanvasData(null);
    }
    logger.info('canvases', 'Removed orphaned canvas panels from layout', { orphanPanelIds });
  }, [
    canvasesHook.canvases,
    canvasesHook.isLoading,
    floatingCanvas,
    layoutLoading,
    layoutRow.columns,
    layoutRow.hiddenPanels,
    removePanel,
  ]);

  // Track mount/unmount
  useEffect(() => {
    logger.debug('ui', `App MOUNTED (render #${appRenderCount})`);
    return () => {
      logger.debug('ui', `App UNMOUNTED (render #${appRenderCount})`);
    };
  }, []);

  // Keyboard shortcuts
  useEffect(() => {
    const handleKeyDown = (e) => {
      // Check for Cmd/Ctrl + Shift combinations
      if ((e.metaKey || e.ctrlKey) && e.shiftKey) {
        switch (e.key.toLowerCase()) {
          case 'b': // Cmd+Shift+B - Toggle briiZtorm
            e.preventDefault();
            setBriiztormOpen(prev => !prev);
            break;
          case 'a': // Cmd+Shift+A - Toggle ActionDeck
            e.preventDefault();
            toggleActionDeck();
            break;
          case 'o': // Cmd+Shift+O - Open Organizer
            e.preventDefault();
            setOrganizerOpen(true);
            break;
          case 'c': // Cmd+Shift+C - Open Calendar
            e.preventDefault();
            setCalendarOpen(true);
            break;
          case 'm': // Cmd+Shift+M - Toggle Media
            e.preventDefault();
            setMediaOpen(prev => !prev);
            break;
          case 'n': // Cmd+Shift+N - Toggle Notes
            e.preventDefault();
            setNotesOpen(prev => !prev);
            break;
          case 'v': // Cmd+Shift+V - Toggle Canvas
            e.preventDefault();
            setCanvasOpen(prev => !prev);
            break;
          case 'k': // Cmd+Shift+K - Toggle Canvases library
            e.preventDefault();
            setCanvasesPopoverOpen(prev => !prev);
            break;
        }
      }

      // Escape closes topmost overlay
      if (e.key === 'Escape') {
        if (canvasesPopoverOpen) {
          setCanvasesPopoverOpen(false);
        } else if (canvasOpen) {
          setCanvasOpen(false);
        } else if (mediaOpen) {
          setMediaOpen(false);
        } else if (organizerOpen) {
          setOrganizerOpen(false);
        } else if (calendarOpen) {
          setCalendarOpen(false);
        } else if (briiztormOpen) {
          setBriiztormOpen(false);
        } else if (actionDeckOpen) {
          closeActionDeck();
        } else if (notesOpen) {
          setNotesOpen(false);
        } else if (showSettings) {
          setShowSettings(false);
        }
      }
    };

    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [organizerOpen, calendarOpen, briiztormOpen, actionDeckOpen, closeActionDeck, mediaOpen, notesOpen, showSettings, canvasOpen, canvasesPopoverOpen, toggleActionDeck]);

  // Listen for canvas events from tool system
  useEffect(() => {
    const handleCanvasEvent = (e) => {
      const { action, title, data } = e.detail;
      logger.debug('canvas', 'Canvas event received', { action, title, dataKeys: data ? Object.keys(data) : null, htmlLen: data?.html?.length, cssLen: data?.css?.length });
      if (action === 'open') {
        setCanvasData(data);
        setCanvasTitle(title || 'Canvas');
        setCanvasOpen(true);
      } else if (action === 'update') {
        setCanvasData(prev => prev ? {
          html: data.html ?? prev.html,
          css: data.css ?? prev.css,
          js: data.js ?? prev.js,
        } : null);
      }
    };
    window.addEventListener('briizos-canvas', handleCanvasEvent);
    return () => window.removeEventListener('briizos-canvas', handleCanvasEvent);
  }, []);

  // Render the appropriate component based on panel type
  const renderPanel = useCallback((panel) => {
    switch (panel.type) {
      case 'sources':
        return <SourcesPanel />;
      case 'interaction':
        return <InteractionPanel />;
      case 'tasks':
        return <TasksPanel />;
      case 'media':
        return <MediaPanel />;
      case 'actiondeck':
        return <ActionDeckColumn embedded onClose={closeActionDeck} onPopOut={popOutActionDeck} />;
      case 'canvas': {
        const canvasFilename = String(panel.panelId || panel.id || '').replace(/^canvas:/, '');
        const canvasEntry = canvasesHook.canvases.find((entry) => entry.filename === canvasFilename);
        return (
          <CanvasTile
            panel={panel}
            metaOverride={canvasEntry ? {
              displayName: canvasEntry.title,
              source: canvasEntry.source,
              renderEngine: canvasEntry.renderEngine,
              url: canvasEntry.url,
            } : null}
            onClose={() => closeCanvasPanel(panel.panelId || panel.id)}
            isTileActive
            isFloatActive={(() => {
              const factor = openCanvases[canvasFilename]?.formFactor || 'tile';
              return factor === 'float' || factor === 'hybrid';
            })()}
            onPromoteBrowser={() => handlePromoteCanvasToBrowser(canvasFilename)}
            onToggleTile={() => handleToggleCanvasMount(canvasFilename, 'tile')}
            onToggleFloat={() => handleToggleCanvasMount(canvasFilename, 'float')}
          />
        );
      }
      default:
        return (
          <div className="panel">
            <div className="panel-header">
              <span>{panel.type || 'Unknown'}</span>
            </div>
            <div className="panel-content">
              Unknown panel type: {panel.type}
            </div>
          </div>
        );
    }
  }, [canvasesHook.canvases, closeActionDeck, popOutActionDeck, closeCanvasPanel, handlePromoteCanvasToBrowser, handleToggleCanvasMount, openCanvases]);

  return (
    <div className="app">
      <header className="app-header">
        <div className="header-title">
          <span className="title-icon:before"></span>
          <span className="title-icon"></span>
          <span className="title-text">briizOS</span>
        </div>

        <div className="header-dock-slot">
          <ControlBar
            variant="dock"
            briiztormOpen={briiztormOpen}
            actionDeckOpen={actionDeckOpen}
            organizerOpen={organizerOpen}
            calendarOpen={calendarOpen}
            mediaOpen={mediaOpen}
            notesOpen={notesOpen}
            canvasesOpen={canvasesPopoverOpen}
            onToggleBriiztorm={() => setBriiztormOpen(!briiztormOpen)}
            onToggleActionDeck={toggleActionDeck}
            onOpenOrganizer={() => setOrganizerOpen((prev) => !prev)}
            onOpenCalendar={() => setCalendarOpen((prev) => !prev)}
            onToggleMedia={() => setMediaOpen((prev) => !prev)}
            onToggleNotes={() => setNotesOpen(!notesOpen)}
            onToggleCanvases={() => setCanvasesPopoverOpen((prev) => !prev)}
            canvasesPopoverSlot={(
              <CanvasesPopover
                isOpen={canvasesPopoverOpen}
                onClose={() => setCanvasesPopoverOpen(false)}
                canvases={canvasesHook.canvases}
                isLoading={canvasesHook.isLoading}
                onOpenCanvas={handleOpenCanvas}
                onCreateCanvas={handleCreateCanvas}
                onDeleteCanvas={handleDeleteCanvas}
                onRenameCanvas={handleRenameCanvas}
                onSetFormFactor={handleSetCanvasFormFactor}
                onSetRenderEngine={handleSetCanvasRenderEngine}
              />
            )}
          />
        </div>

        <div className="header-right">
          <HeaderDateTimeWeather />

          <button id="settings-btn" onClick={() => setShowSettings(true)}>
            <span className="settings-icon">⚙</span>
            <span>Settings</span>
          </button>
        </div>

        <div id="controlBarBtn" aria-hidden="true"></div>
      </header>

      {/* Control Bar with Toggles */}
      <div className="controlBar closed" id="controlBar">
        <ControlBar variant="bar" />
      </div>

      {/* Main Content */}
      <main className="app-main">
        <TileLayout
          layoutRow={getLayoutRow()}
          renderPanel={renderPanel}
          onColumnResize={updateColumnSizes}
          onStackResize={updateStackSizes}
          onMovePanel={movePanel}
        />
      </main>

      {/* Overlays */}
      <BriiztormOverlay
        isOpen={briiztormOpen}
        onClose={() => setBriiztormOpen(false)}
      />

      {actionDeckFloating && (
        <ActionDeckColumn
          floating
          onClose={closeActionDeck}
          onDock={dockActionDeck}
        />
      )}

      {/* Modals */}
      <OrganizerModal
        isOpen={organizerOpen}
        onClose={() => setOrganizerOpen(false)}
      />

      <CalendarModal
        isOpen={calendarOpen}
        onClose={() => setCalendarOpen(false)}
      />

      {/* Notes Widget */}
      <NotesWidget
        isOpen={notesOpen}
        onClose={() => setNotesOpen(false)}
        drawerPosition={workspace.notesDrawer ? { x: workspace.notesDrawer.x, y: workspace.notesDrawer.y } : null}
        drawerDimensions={workspace.notesDrawer ? { width: workspace.notesDrawer.width, height: workspace.notesDrawer.height } : null}
        onDrawerChange={(pos, size) => {
          updateWorkspace({
            notesDrawer: pos
              ? { x: pos.x, y: pos.y, width: size.width, height: size.height }
              : { width: size.width, height: size.height }
          });
        }}
      />

      {mediaOpen && (
        <MediaPanel
          floating
          onClose={() => setMediaOpen(false)}
          panelPosition={workspace.mediaPanel ? { x: workspace.mediaPanel.x, y: workspace.mediaPanel.y } : null}
          panelDimensions={workspace.mediaPanel ? { width: workspace.mediaPanel.width, height: workspace.mediaPanel.height } : null}
          onPanelChange={(pos, size) => {
            updateWorkspace({
              mediaPanel: pos
                ? { x: pos.x, y: pos.y, width: size.width, height: size.height }
                : { width: size.width, height: size.height }
            });
          }}
        />
      )}

      {/* Live Canvas */}
      <LiveCanvas
        isOpen={canvasOpen}
        onClose={() => {
          setCanvasOpen(false);
          setFloatingCanvas(null);
        }}
        canvasData={canvasData}
        title={canvasTitle}
        onSave={floatingCanvas ? handleSaveFloatingCanvas : undefined}
        isTileActive={floatingCanvas ? (() => {
          const factor = openCanvases[floatingCanvas.filename]?.formFactor || 'float';
          return factor === 'tile' || factor === 'hybrid';
        })() : false}
        isFloatActive={!!floatingCanvas}
        onToggleTile={floatingCanvas ? () => handleToggleCanvasMount(floatingCanvas.filename, 'tile') : undefined}
        onToggleFloat={floatingCanvas ? () => handleToggleCanvasMount(floatingCanvas.filename, 'float') : undefined}
        onPromoteBrowser={floatingCanvas ? () => handlePromoteCanvasToBrowser(floatingCanvas.filename) : undefined}
      />

      {/* Dashboard (replaces Settings Modal) */}
      <DashboardOverlay
        isOpen={showSettings}
        onClose={() => setShowSettings(false)}
      />

      {/* Login Overlay - Shows when not authenticated */}
      <LoginOverlay />

      {/* Bfast Bundle — toasts, snackbars, and margerin intent holds */}
      <BfastBundle />
    </div>
  );
}

// Main App component with AuthProvider wrapper
function App() {
  const layout = useLayout();

  return (
    <AuthProvider>
      <OrganizerProvider>
        <ChatSettingsProvider>
          <ToolProvider layoutHook={layout}>
            <AppContent layout={layout} />
          </ToolProvider>
        </ChatSettingsProvider>
      </OrganizerProvider>
    </AuthProvider>
  );
}

export default App;
</file>

<file path="src/hooks/useChat.js">
import { useState, useEffect, useCallback, useRef } from 'react';
import logger from '../lib/logger';
import ChatAPI from '../lib/chat-api';
import SystemPrompt from '../lib/system-prompt';
import BriizTools from '../lib/briizos-tools';
import {
  subscribeChatMessages,
  addChatMessage,
  addLog,
  clearChatMessages,
  getSelectedFiles as getSelectedFilesFirestore,
  subscribeRemoteChat,
  addRemoteChatMessage,
  markRemoteChatRead,
} from '../lib/firestore';
import { getCurrentUid } from '../lib/firebase';

const api = typeof window !== 'undefined' && window.api ? window.api : {};
const hasApi = typeof window !== 'undefined' && window.api;

const MODEL_STORAGE_KEY = 'briizos-selected-model';

const MODALITY_SKILL_MAP = {
  chat: null,
  research: 'deep-research',
  code: 'frontend-design',
  report: 'consulting-analysis',
  plan: null,
};

const FILE_CONTEXT_TOOL_CAPABILITIES = [
  '- `agentReadFile(path)`: Read file contents (subject to blacklist rules).',
  '- `agentListDir(path)`: List directory contents (subject to blacklist rules).',
  '- `agentWriteFile(path, content, opId?)`: Create/overwrite files.',
  '- `agentCopyFile(source, destination, opId?)`: Copy files or folders.',
  '- `agentMoveFile(source, destination, opId?)`: Move/rename files.',
  '- `agentDeleteFile(path, opId?)`: Delete files or folders.',
  '- `runCommand(command, cwd?, opId?)`: Run shell commands when needed.'
];

function buildFileContextAddendum(files = []) {
  if (!Array.isArray(files) || files.length === 0) return '';
  const lines = files
    .map((file) => file?.path)
    .filter(Boolean)
    .map((filePath) => `- ${filePath}`);
  if (lines.length === 0) return '';

  return [
    'Pinned filesystem context from the user:',
    ...lines,
    '',
    'Capabilities available for working with these paths (tools):',
    ...FILE_CONTEXT_TOOL_CAPABILITIES,
    '',
    'Prefer direct path-based tool calls when the user asks to inspect or modify pinned files.'
  ].join('\n');
}

export function useChat({ selectedModel } = {}) {
  const [messages, setMessages] = useState([]);
  const [isLoading, setIsLoading] = useState(false);
  const [isConfigured, setIsConfigured] = useState(true);
  const [tokenUsage, setTokenUsage] = useState(null);
  const [filesInContext, setFilesInContext] = useState([]);
  const [streamingContent, setStreamingContent] = useState('');
  const [currentStreamId, setCurrentStreamId] = useState(null);
  const [toolCalls, setToolCalls] = useState([]);
  const [pendingToolConfirmation] = useState(null);
  const [threadTitle, setThreadTitle] = useState(null);
  const threadTitleRef = useRef(null);
  const [modality, setModality] = useState('chat');
  const [subAgentTasks, setSubAgentTasks] = useState([]);
  const [suggestions, setSuggestions] = useState([]);
  const [suggestionsEnabled, setSuggestionsEnabled] = useState(() => {
    try {
      const stored = localStorage.getItem('briizos-suggestions-enabled');
      return stored !== null ? JSON.parse(stored) : true;
    } catch { return true; }
  });

  const streamContentRef = useRef('');
  const toolCallsRef = useRef([]);
  const selectedModelRef = useRef(selectedModel || null);
  // Mirror suggestionsEnabled into a ref so sendMessage's stable closure
  // always reads the current value (otherwise toggling mid-session would
  // not reach the next request).
  const suggestionsEnabledRef = useRef(suggestionsEnabled);

  const chatAPIRef = useRef(null);
  const briizToolsRef = useRef(null);

  useEffect(() => {
    chatAPIRef.current = new ChatAPI();
    window.systemPrompt = new SystemPrompt();
    briizToolsRef.current = new BriizTools();
    window.briizTools = briizToolsRef.current;
  }, []);

  useEffect(() => { selectedModelRef.current = selectedModel || null; }, [selectedModel]);

  useEffect(() => {
    try {
      localStorage.setItem('briizos-suggestions-enabled', JSON.stringify(suggestionsEnabled));
    } catch {}
    // Keep the ref in sync for sendMessage's stable closure.
    suggestionsEnabledRef.current = suggestionsEnabled;
    // When the user turns suggestions OFF, immediately drop any chips
    // currently on screen so the toggle feels responsive.
    if (!suggestionsEnabled) {
      setSuggestions([]);
    }
  }, [suggestionsEnabled]);

  const uid = getCurrentUid();

  useEffect(() => {
    if (!uid) return;
    const unsubscribe = subscribeChatMessages((firestoreMessages) => setMessages(firestoreMessages));
    return () => unsubscribe();
  }, [uid]);

  const checkConfig = useCallback(async () => {
    if (!hasApi) return;
    try {
      if (typeof api.isAIConfigured !== 'function') {
        setIsConfigured(true);
        return;
      }
      const configured = await api.isAIConfigured();
      setIsConfigured(configured);
    } catch (error) {
      logger.error('chat', 'Failed to check AI config', error?.message);
    }
  }, []);

  const loadSelectedFiles = useCallback(async () => {
    try {
      const files = await getSelectedFilesFirestore();
      const normalized = files.map((f) => ({ name: f.file_name, path: f.file_path }));
      setFilesInContext(normalized);
      return normalized;
    } catch (error) {
      logger.error('chat', 'Failed to load selected files', error?.message);
      return [];
    }
  }, []);

  useEffect(() => {
    checkConfig();
    loadSelectedFiles();
  }, [checkConfig, loadSelectedFiles]);

  const getSelectedModel = useCallback(() => {
    const fromProp = selectedModelRef.current;
    if (fromProp) return fromProp;
    try {
      return localStorage.getItem(MODEL_STORAGE_KEY) || null;
    } catch {
      return null;
    }
  }, []);

  const parseProviderFromModel = useCallback((modelName) => {
    if (!modelName) return 'gemini';
    const m = String(modelName).toLowerCase();
    if (m.includes('claude')) return 'claude';
    if (m.includes('gpt') || m.includes('o1') || m.includes('o3') || m.includes('openai')) return 'openai';
    if (m.includes('gemini')) return 'gemini';
    return 'gemini';
  }, []);

  const executeToolCall = useCallback(async (toolCall) => {
    const tc = {
      id: `tc-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,
      name: toolCall.tool,
      args: toolCall.params || {},
      status: 'running',
    };
    toolCallsRef.current = [...toolCallsRef.current, tc];
    setToolCalls([...toolCallsRef.current]);

    try {
      const result = await briizToolsRef.current.execute(toolCall.tool, toolCall.params || {});
      toolCallsRef.current = toolCallsRef.current.map((t) => (t.id === tc.id ? { ...t, status: 'done', result } : t));
      setToolCalls([...toolCallsRef.current]);
      return result;
    } catch (error) {
      // A margerin 💬 ("return to chat for refinement") is NOT a
      // failure — it's a deliberate user decision to keep discussing
      // the call in the chat instead of running it. Mark the tool
      // card as 'returned' so the UI shows a subtle neutral state
      // instead of a red failure, and rethrow so the stream consumer
      // can skip the "[Tool failed: ...]" append below.
      const returnedToChat = Boolean(error?.__returnedToChat);
      toolCallsRef.current = toolCallsRef.current.map((t) =>
        t.id === tc.id
          ? {
              ...t,
              status: returnedToChat ? 'returned' : 'failed',
              error: error?.message,
            }
          : t,
      );
      setToolCalls([...toolCallsRef.current]);
      throw error;
    }
  }, []);

  const sendMessage = useCallback(async (message, { isRemote = false } = {}) => {
    if (!message?.trim() || isLoading || !chatAPIRef.current) return null;

    setSuggestions([]);
    await addChatMessage('user', message);
    setIsLoading(true);

    try {
      let actualMessage = message;
      const skillName = MODALITY_SKILL_MAP[modality];
      if (skillName) actualMessage = `[Use skill: ${skillName}] ${message}`;
      else if (modality === 'plan') actualMessage = `[Plan mode] ${message}`;
      const selectedFiles = await loadSelectedFiles();
      const fileContextAddendum = buildFileContextAddendum(selectedFiles);

      const model = getSelectedModel() || 'gemini-2.5-flash';
      const provider = parseProviderFromModel(model);

      const streamId = `stream-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
      setCurrentStreamId(streamId);
      streamContentRef.current = '';
      setStreamingContent('');
      toolCallsRef.current = [];
      setToolCalls([]);

      const chatHistory = [...messages, { role: 'user', content: actualMessage }]
        .filter((m) => m.role === 'user' || m.role === 'assistant')
        .map((m) => ({ role: m.role, content: m.content }));

      // Don't ask for suggestions on relayed remote messages — the chips
      // are a UI affordance for the local interactive user only.
      const wantSuggestions = suggestionsEnabledRef.current && !isRemote;

      for await (const chunk of chatAPIRef.current.streamChat(
        chatHistory,
        provider,
        model,
        null,
        { suggestionsEnabled: wantSuggestions, contextAddendum: fileContextAddendum },
      )) {
        if (typeof chunk === 'string') {
          streamContentRef.current += chunk;
          setStreamingContent(streamContentRef.current);
        } else if (chunk && chunk.type === 'tool_call') {
          try {
            const result = await executeToolCall(chunk);
            const resultText = typeof result === 'string' ? result : (result?.summary || result?.message || JSON.stringify(result));
            streamContentRef.current += `\n\n[Tool executed: ${chunk.tool}]\n${resultText}`;
            setStreamingContent(streamContentRef.current);
          } catch (err) {
            // Returning the call to chat via the margerin 💬 icon is a
            // first-class user choice, not a failure. Leave the stream
            // text untouched — InteractionPanel's onChatReturn handler
            // will instead prepend a "re:" quote and refocus the
            // textarea so the user can discuss/refine the call.
            if (err && err.__returnedToChat) {
              // intentionally no-op on the streaming content
            } else {
              streamContentRef.current += `\n\n[Tool failed: ${chunk.tool}] ${err?.message || 'Unknown error'}`;
              setStreamingContent(streamContentRef.current);
            }
          }
        } else if (chunk && chunk.type === 'suggestions') {
          // Only update if the toggle is still on by the time the chunk
          // arrives — guards against the user flipping the switch off
          // mid-stream.
          if (suggestionsEnabledRef.current && Array.isArray(chunk.items) && chunk.items.length > 0) {
            setSuggestions(chunk.items);
          }
        }
      }

      if (streamContentRef.current) {
        await addChatMessage('assistant', streamContentRef.current);
        if (isRemote) {
          await addRemoteChatMessage('assistant', streamContentRef.current);
        }
        addLog('assistant_message', streamContentRef.current.slice(0, 1200)).catch(() => {});
      }

      setThreadTitle((prev) => prev || message.slice(0, 60));
    } catch (error) {
      logger.error('chat', 'Direct API stream failed', error?.message);
      await addChatMessage('assistant', `Error: ${error?.message || 'Unknown error'}`, true);
    } finally {
      setIsLoading(false);
      setCurrentStreamId(null);
      setStreamingContent('');
      streamContentRef.current = '';
    }

    return null;
  }, [isLoading, messages, modality, getSelectedModel, parseProviderFromModel, executeToolCall, loadSelectedFiles]);

  const isLoadingRef = useRef(false);
  useEffect(() => { isLoadingRef.current = isLoading; }, [isLoading]);

  const sendRemoteResponse = useCallback(async (remoteMsg) => {
    if (isLoadingRef.current || !remoteMsg?.content) return;
    await addChatMessage('user', `[Remote] ${remoteMsg.content}`);
    try { await markRemoteChatRead(remoteMsg.id); } catch {}
    await sendMessage(`[Remote message] ${remoteMsg.content}`, { isRemote: true });
  }, [sendMessage]);

  useEffect(() => {
    if (!uid) return;
    const unsubscribe = subscribeRemoteChat(
      () => {},
      (remoteMsg) => {
        sendRemoteResponse(remoteMsg);
      }
    );
    return () => unsubscribe();
  }, [uid, sendRemoteResponse]);

  const clearHistory = useCallback(async () => {
    try {
      await clearChatMessages();
      setMessages([]);
      setTokenUsage(null);
      setStreamingContent('');
      setCurrentStreamId(null);
      setToolCalls([]);
      toolCallsRef.current = [];
      setModality('chat');
      setSuggestions([]);
      setThreadTitle(null);
    } catch (error) {
      logger.error('chat', 'Failed to clear history', error?.message);
    }
  }, []);

  const refreshFilesInContext = useCallback(async () => {
    await loadSelectedFiles();
  }, [loadSelectedFiles]);

  const approveToolConfirmation = useCallback(async () => {}, []);
  const rejectToolConfirmation = useCallback(async () => {}, []);

  return {
    messages,
    isLoading,
    isConfigured,
    tokenUsage,
    filesInContext,
    streamingContent,
    currentStreamId,
    toolCalls,
    subAgentTasks,
    pendingToolConfirmation,
    modality,
    setModality,
    suggestions,
    suggestionsEnabled,
    setSuggestionsEnabled,
    threadTitle,
    threadTitleRef,
    sendMessage,
    clearHistory,
    loadHistory: () => {},
    checkConfig,
    refreshFilesInContext,
    approveToolConfirmation,
    rejectToolConfirmation,
  };
}

export default useChat;
