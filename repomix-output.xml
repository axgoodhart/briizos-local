    }

    .toggle-inline input {
      accent-color: var(--accent);
      cursor: pointer;
    }

    .mapping-grid {
      display: grid;
      gap: 10px;
    }

    .mapping-row {
      display: grid;
      grid-template-columns: 1fr 26px;
      gap: 10px;
      align-items: center;
      padding: 10px;
      border: 1px solid #282a32;
      border-radius: 8px;
      background: #141419;
    }

    .mapping-label {
      font-size: 11px;
      font-weight: 700;
      color: #e5e7eb;
