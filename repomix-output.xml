:root[data-theme='great-wave'] {
    --chat-input-text-color: lightgray;
    --palette-accent-primary: #4aa3a0;
    --palette-accent-primary-soft: #3e938f;
    --palette-neon-accent: #7bbf9e;
    --palette-success: #6a9f7a;
    --palette-warning: #d3b36a;
    --palette-danger: #c27063;
