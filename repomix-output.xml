  - agent/src/briizos/confirmation_middleware.py
  - electron/main.js
  - electron/langgraph-process.js
  - src/hooks/useChat.js
  - agent/src/agents/lead_agent/prompt.py
  - agent/src/agents/lead_agent/agent.py
