.control-bar-dock {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(10px, 1.5vw, 18px);
  width: 100%;
  max-width: 100%;
  min-height: 58px;
  padding: 0 clamp(12px, 2vw, 22px);
  overflow: visible;
}

.control-bar-rail {
  width: 100%;
  height: 100%;
}

.cb-canvases-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

.cb-toggle {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-width: 42px;
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 20px;
  cursor: pointer;
  color: inherit;
  transition: transform 0.28s ease, filter 0.3s ease, opacity 0.3s ease;
}

.cb-toggle::before {
  content: '';
  position: absolute;
  inset: -8px -10px -12px;
  border-radius: 18px;
  background: transparent;
  border:none;
  opacity: 0;
  transition: opacity 0.3s ease, background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
}

.cb-toggle::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -9px;
  width: 44px;
  height: 8px;
  border-radius: 999px;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.65), rgba(255, 255, 255, 0.2));
