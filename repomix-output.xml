        case 'jobPanel':
          return `
            <div class="job-panel-root" id="job-panel-${panel.id}" data-task-id="${panel.taskId || panel.id}">
              <div class="job-header">
                <div class="job-header-icon">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12,2A2,2 0 0,1 14,4C14,4.74 13.6,5.39 13,5.73V7H15A2,2 0 0,1 17,9V15A2,2 0 0,1 15,17H9A2,2 0 0,1 7,15V9A2,2 0 0,1 9,7H11V5.73C10.4,5.39 10,4.74 10,4A2,2 0 0,1 12,2M12,4A1,1 0 0,0 11,5A1,1 0 0,0 12,6A1,1 0 0,0 13,5A1,1 0 0,0 12,4M9,9V15H15V9H9M11,11H13V13H11V11Z"/></svg>
                </div>
                <h2 class="job-title">briizOS Tasks</h2>
              </div>
              <ul class="job-task-list" id="job-task-list-${panel.id}">
                <li class="job-task-item active" data-task-id="${(panel.taskId || panel.id).replace('tasks-', '')}">
                  <div class="job-status-light pink"></div>
                  <div class="job-task-title">"${panel.jobMessage || ''}"</div>
                  <div class="job-task-meta">
                    <span class="job-badge running">RUNNING...</span>
                  </div>
                </li>
              </ul>
              <aside class="job-details" id="job-details-${panel.id}">
                <div class="job-details-header">Task ID #<span class="job-id-display">${(panel.taskId || panel.id).replace('tasks-', '')}</span></div>
                <div class="job-details-content">
                  <div class="job-details-label">User:</div>
                  <div class="job-details-value">${panel.jobMessage || ''}</div>
                  <div class="job-details-label">Task.md:</div>
                  <div class="job-details-value job-task-md-status" style="color: #ff2a6d; font-style: italic;">not found</div>
                  <div class="job-details-label">Actions:</div>
                  <div class="job-details-value job-actions-list" data-actions-panel="${panel.id}">
                    <ol class="job-actions-ol"></ol>
                    <div class="job-action-add">
                      <input type="text" class="job-action-input" placeholder="+ Add action..." data-action-input="${panel.id}" />
                    </div>
                  </div>
                  <div class="job-details-label">Status:</div>
                  <div class="job-details-value job-status-text"><ol><li>Sent request to local machine</li></ol></div>
                </div>
