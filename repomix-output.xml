      color: #93a0b8;
    }

    .inspector-list {
      max-height: 260px;
      overflow: auto;
      display: grid;
      gap: 8px;
    }

    .inspector-item {
      display: grid;
      grid-template-columns: 18px 1fr;
      gap: 10px;
      padding: 9px 10px;
      border-radius: 8px;
      background: #141419;
      border: 1px solid #272a33;
    }

    .inspector-chip {
      width: 18px;
      height: 18px;
      border-radius: 5px;
      border: 1px solid rgba(255,255,255,0.18);
      margin-top: 2px;
      background: #111;
    }

    .inspector-main {
      min-width: 0;
    }

    .inspector-top {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
      margin-bottom: 5px;
    }

    .inspector-name {
      font-size: 11px;
      color: #f1f5f9;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }

    .inspector-value {
      font-size: 10px;
      color: #8b92a9;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .badge {
      padding: 3px 6px;
      border-radius: 999px;
      font-size: 9px;
      line-height: 1;
      letter-spacing: 0.3px;
      font-weight: 700;
      text-transform: lowercase;
    }

    .tone-panel   { color: #9ec2ff; background: rgba(122,162,247,0.14); }
    .tone-text    { color: #8ef2c9; background: rgba(16,185,129,0.14); }
    .tone-accent  { color: #f0abfc; background: rgba(217,70,239,0.14); }
    .tone-button  { color: #fdba74; background: rgba(249,115,22,0.14); }
    .tone-input   { color: #93c5fd; background: rgba(59,130,246,0.14); }
    .tone-frame   { color: #fca5a5; background: rgba(239,68,68,0.14); }
    .tone-kind    { color: #d1d5db; background: rgba(148,163,184,0.14); }
    .tone-sem     { color: #f9a8d4; background: rgba(236,72,153,0.14); }
    .tone-other   { color: #cbd5e1; background: rgba(148,163,184,0.14); }

    .empty-note {
      font-size: 11px;
      color: #8b92a9;
      padding: 8px 0;
    }

    .btn-group {
      display: flex;
      gap: 8px;
      margin-top: 12px;
    }

    button {
      flex: 1;
      border-radius: 8px;
      border: 1px solid #3b3f4b;
      background: #1c1e25;
      color: #f3f4f6;
      padding: 11px 12px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      transition: 0.18s ease;
    }

    button:hover {
      background: #252832;
      border-color: var(--accent);
    }

    button.primary {
      background: var(--accent);
      color: #081018;
      border-color: transparent;
    }

    .preview-stage {
      width: min(980px, calc(100vw - 620px));
      max-width: 100%;
      color: var(--dna-text, #e8ecff);
      font-family: var(--dna-font-family, system-ui);
    }

    .preview-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 16px 18px;
      margin-bottom: 16px;
    }

    .preview-panel {
      background: var(--dna-surface, #1a1b26);
      color: var(--dna-text, #e8ecff);
      border: var(--dna-panel-border-width, 1px) solid var(--dna-border, #38415c);
      border-radius: var(--dna-panel-radius, 16px);
      box-shadow: 0 16px 40px rgba(0,0,0,0.38);
    }

    .eyebrow {
      font-size: 10px;
      letter-spacing: 1.6px;
      text-transform: uppercase;
