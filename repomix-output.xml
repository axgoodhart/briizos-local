    <script type="module">
        // ============================================================
        // PHASE 0.1: ERROR BOUNDARIES & GLOBAL ERROR HANDLING
        // ============================================================

        // Global error logger
        const ErrorLogger = {
            errors: [],
            log(type, message, details = {}) {
                const entry = { type, message, details, timestamp: Date.now() };
                this.errors.push(entry);
                console.error(`[CELESTIA/${type}]`, message, details);
            },
            getRecent(count = 10) {
                return this.errors.slice(-count);
            }
        };

        // Global error handler for uncaught errors
        window.addEventListener('error', (event) => {
            ErrorLogger.log('UNCAUGHT', event.message, {
                filename: event.filename,
                lineno: event.lineno
            });
        });

        // Promise rejection handler
        window.addEventListener('unhandledrejection', (event) => {
            ErrorLogger.log('PROMISE', event.reason?.message || 'Unhandled rejection', {
                reason: event.reason
            });
        });

        // Show error modal to user
        function showErrorModal(title, message, retryCallback = null) {
            const existing = document.getElementById('celestia-error-modal');
            if (existing) existing.remove();

            const modal = document.createElement('div');
            modal.id = 'celestia-error-modal';
            modal.innerHTML = `
                <div style="position:fixed;inset:0;background:rgba(0,0,0,0.9);z-index:9999;display:flex;align-items:center;justify-content:center;">
                    <div style="background:rgba(10,20,30,0.95);border:1px solid rgba(255,0,100,0.5);border-radius:8px;padding:30px;max-width:400px;text-align:center;font-family:'Orbitron',sans-serif;">
                        <h2 style="color:#ff0066;margin:0 0 15px;font-size:1.5rem;">${title}</h2>
                        <p style="color:#e0faff;margin:0 0 20px;font-size:14px;">${message}</p>
                        ${retryCallback ? '<button id="celestia-retry-btn" style="background:#00ffff;color:#000;border:none;padding:10px 30px;cursor:pointer;font-family:inherit;margin-right:10px;border-radius:4px;">RETRY</button>' : ''}
                        <button id="celestia-dismiss-btn" style="background:#333;color:#fff;border:1px solid #555;padding:10px 30px;cursor:pointer;font-family:inherit;border-radius:4px;">DISMISS</button>
                    </div>
                </div>
            `;
            document.body.appendChild(modal);

            document.getElementById('celestia-dismiss-btn').onclick = () => modal.remove();
            if (retryCallback) {
                document.getElementById('celestia-retry-btn').onclick = () => {
                    modal.remove();
                    retryCallback();
                };
            }
        }

        // Show toast notification
        function showToast(message, type = 'info') {
            const toast = document.createElement('div');
            const colors = { info: '#00ffff', success: '#00ff88', error: '#ff0066', warning: '#ffaa00' };
            toast.style.cssText = `
                position:fixed;bottom:20px;left:50%;transform:translateX(-50%);
                background:rgba(10,20,30,0.95);border:1px solid ${colors[type]};
                padding:12px 24px;border-radius:4px;color:${colors[type]};
                font-family:'Orbitron',sans-serif;font-size:12px;z-index:9998;
                animation:fadeInUp 0.3s ease;
            `;
            toast.textContent = message;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }

        // ============================================================
        // THREE.JS IMPORTS WITH ERROR HANDLING
        // ============================================================

        let THREE;
        try {
            THREE = await import('three');
        } catch (e) {
            ErrorLogger.log('CDN', 'Failed to load Three.js', { error: e.message });
            showErrorModal(
                'RENDERING ENGINE OFFLINE',
                'Failed to load 3D engine. Check your connection and retry.',
                () => location.reload()
            );
            throw e;
        }

        // Non-critical addon - continue without if fails
        try {
            await import('three/addons/lights/RectAreaLightUniformsLib.js');
        } catch (e) {
            ErrorLogger.log('CDN', 'RectAreaLightUniformsLib failed - continuing without', { error: e.message });
        }

        // ============================================================
        // PHASE 0.3: CENTRALIZED STATE MANAGEMENT
        // ============================================================

        const AppState = {
            _state: {
                projects: [],
                ui: {
                    moveSpeed: 0,
                    selectedColor: '#00ffff',
                    currentlySelectedProject: null,
                    isHUDOpen: false,
                    isModalOpen: false
                },
                camera: {
                    position: { x: 0, y: 3, z: 5 }
                }
            },
            _listeners: new Map(),

            // Get state (returns copy to prevent direct mutation)
            get(path) {
                const keys = path.split('.');
                let value = this._state;
                for (const key of keys) {
                    if (value === undefined) return undefined;
                    value = value[key];
                }
                return value;
            },

            // Set state and notify listeners
            set(path, value) {
                const keys = path.split('.');
                const lastKey = keys.pop();
                let target = this._state;

                for (const key of keys) {
                    if (target[key] === undefined) target[key] = {};
                    target = target[key];
                }

                const oldValue = target[lastKey];
                target[lastKey] = value;

                // Notify listeners
                this._notify(path, value, oldValue);
            },

            // Subscribe to state changes
            subscribe(path, callback) {
                if (!this._listeners.has(path)) {
                    this._listeners.set(path, new Set());
                }
                this._listeners.get(path).add(callback);

                // Return unsubscribe function
                return () => this._listeners.get(path)?.delete(callback);
            },

            // Notify listeners of changes
            _notify(path, newValue, oldValue) {
                // Notify exact path listeners
                this._listeners.get(path)?.forEach(cb => cb(newValue, oldValue, path));

                // Notify parent path listeners (e.g., 'ui' gets notified when 'ui.moveSpeed' changes)
                const parts = path.split('.');
                while (parts.length > 1) {
                    parts.pop();
                    const parentPath = parts.join('.');
                    this._listeners.get(parentPath)?.forEach(cb => cb(this.get(parentPath), null, path));
                }
            },

            // Add project to state
            addProject(projectGroup) {
                this._state.projects.push(projectGroup);
                this._notify('projects', this._state.projects, null);
            },

            // Remove project from state
            removeProject(projectGroup) {
                const index = this._state.projects.indexOf(projectGroup);
                if (index > -1) {
                    this._state.projects.splice(index, 1);
                    this._notify('projects', this._state.projects, null);
                }
            },

            // Get all projects
            getProjects() {
                return this._state.projects;
            }
        };

        // ============================================================
        // GLOBAL STATE (Legacy references for compatibility)
        // ============================================================
        let camera, scene, renderer;
        let grid, grid2; // Two grids for infinite illusion
        let ambientLight, camLight, starField; // Store for theme updates
        const projects = AppState.getProjects(); // Reference to state projects

        // Computed getters/setters that sync with AppState
        Object.defineProperty(window, 'moveSpeed', {
            get: () => AppState.get('ui.moveSpeed'),
            set: (val) => AppState.set('ui.moveSpeed', val)
        });

        Object.defineProperty(window, 'selectedColor', {
            get: () => AppState.get('ui.selectedColor'),
            set: (val) => AppState.set('ui.selectedColor', val)
        });

        Object.defineProperty(window, 'currentlySelectedProject', {
            get: () => AppState.get('ui.currentlySelectedProject'),
            set: (val) => AppState.set('ui.currentlySelectedProject', val)
        });

        let isHovering = false;

        // ============================================================
        // PHASE 2: NAVIGATION & MOVEMENT CONTROLLER (Look-Based)
        // ============================================================

        const NavController = {
            // Velocity (scalar - we move in facing direction)
            speed: 0,

            // Camera rotation (Euler angles)
            pitch: 0,    // Up/down rotation (X axis)
            yaw: 0,      // Left/right rotation (Y axis)

            // Physics constants
            thrustPower: 0.015,       // How fast we accelerate
            deceleration: 0.94,       // Friction/damping
            maxSpeed: 0.6,            // Maximum velocity
            boostMultiplier: 2.5,     // Shift key multiplier

            // Look sensitivity
            lookSpeed: 0.003,         // How fast mouse rotates view
            pitchLimit: Math.PI / 2.2, // Max up/down angle (~80°)

            // Mouse look state
            mouseLook: {
                enabled: true,
                userEnabled: true, // User's preference (Tab toggle)
                lastX: 0,
                lastY: 0
            },

            // Update mouse look based on UI state
            updateMouseLook() {
                // Only enable if user wants it AND no UI panels are open
                const hudOpen = !document.getElementById('project-hud')?.classList.contains('hidden');
                const settingsOpen = document.getElementById('settings-drawer')?.classList.contains('open');
                const searchOpen = document.getElementById('search-panel')?.classList.contains('open');
                const modalOpen = document.querySelector('.fixed.inset-0:not(.hidden)') !== null; // Any visible modal

                const uiOpen = hudOpen || settingsOpen || searchOpen || modalOpen;
                const shouldEnable = this.mouseLook.userEnabled && !uiOpen;

                // Handle pointer lock
                const canvas = renderer?.domElement;
                if (canvas) {
                    if (shouldEnable && !document.pointerLockElement) {
                        canvas.requestPointerLock();
                    } else if (!shouldEnable && document.pointerLockElement) {
                        document.exitPointerLock();
                    }
                }

                this.mouseLook.enabled = shouldEnable;

                // Update body class for cursor control
                if (this.mouseLook.enabled) {
                    document.body.classList.add('mouse-look-enabled');
                } else {
                    document.body.classList.remove('mouse-look-enabled');
                }

                // Update cursor visuals
                const circle = document.getElementById('cursor-circle');
                const triangle = document.getElementById('cursor-triangle');
                if (circle && triangle) {
                    if (this.mouseLook.enabled) {
                        circle.style.opacity = '1';
                        triangle.style.opacity = '0';
                    } else {
                        circle.style.opacity = '0';
                        triangle.style.opacity = '1';
                    }
                }
            },

            // Update cursor position
            updateCursorPosition(x, y) {
                const circle = document.getElementById('cursor-circle');
                const triangle = document.getElementById('cursor-triangle');
                if (circle) {
                    circle.style.left = x + 'px';
                    circle.style.top = y + 'px';
                }
                if (triangle) {
                    triangle.style.left = x + 'px';
                    triangle.style.top = y + 'px';
                }
            },

            toggleMouseLook() {
                this.mouseLook.userEnabled = !this.mouseLook.userEnabled;
                this.updateMouseLook();
                showToast(this.mouseLook.userEnabled ? 'MOUSE LOOK ENABLED' : 'MOUSE LOOK DISABLED [Tab to re-enable]', 'info');
            },

            // Thruster gear system
            thrusterGear: 0,          // 0 = off, 1-4 = speed levels
            gearSpeeds: [0, 0.08, 0.18, 0.35, 0.55],
            gearNames: ['IDLE', 'CRUISE', 'BOOST', 'BURN', 'HYPERDRIVE'],

            // Input state
            keys: {
                lookUp: false,     // W
                lookDown: false,   // S
                lookLeft: false,   // A
                lookRight: false,  // D
                thrust: false,     // Space
                boost: false       // Shift
            },

            // Auto-pilot state
            autopilot: {
                active: false,
                targetPosition: null,
                targetProject: null,
                arrivalCallback: null
            },

            // Initialize controls
            init() {
                window.addEventListener('keydown', (e) => this.onKeyDown(e));
                window.addEventListener('keyup', (e) => this.onKeyUp(e));
                window.addEventListener('wheel', (e) => this.onWheel(e), { passive: false });
                window.addEventListener('mousemove', (e) => this.onMouseLook(e));

                // Handle pointer lock changes (e.g., CMD+Tab releases it)
                document.addEventListener('pointerlockchange', () => {
                    if (document.pointerLockElement) {
                        // Center custom cursor when pointer locked
                        this.updateCursorPosition(window.innerWidth / 2, window.innerHeight / 2);
                    } else {
                        // Pointer lock lost - disable mouse look
                        if (this.mouseLook.enabled) {
                            this.mouseLook.userEnabled = false;
                            this.updateMouseLook();
                            showToast('POINTER LOCK LOST [Tab to re-enable]', 'warning');
                        }
                    }
                });
            },

            // Mouse look handler
            onMouseLook(e) {
                // Always update cursor position (when not pointer locked)
                if (!document.pointerLockElement) {
                    this.updateCursorPosition(e.clientX, e.clientY);
                }

                // Only do look rotation if enabled
                if (!this.mouseLook.enabled) return;

                // Use pointer lock movement when available (unlimited movement!)
                let deltaX, deltaY;
                if (document.pointerLockElement) {
                    deltaX = e.movementX || 0;
                    deltaY = e.movementY || 0;
                } else {
                    // Fallback to position delta
                    deltaX = e.clientX - this.mouseLook.lastX;
                    deltaY = e.clientY - this.mouseLook.lastY;
                    this.mouseLook.lastX = e.clientX;
                    this.mouseLook.lastY = e.clientY;

                    // Skip huge jumps (first movement or re-entering window)
                    if (Math.abs(deltaX) > 100 || Math.abs(deltaY) > 100) return;
                }

                // Apply rotation
                this.yaw -= deltaX * this.lookSpeed;
                this.pitch -= deltaY * this.lookSpeed;

                // Clamp pitch
                this.pitch = Math.max(-this.pitchLimit, Math.min(this.pitchLimit, this.pitch));
            },

            onKeyDown(e) {
                // Don't capture if typing in input
                if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') return;

                switch(e.code) {
                    // WASD = Look controls
                    case 'KeyW': case 'ArrowUp':
                        this.keys.lookUp = true; break;
                    case 'KeyS': case 'ArrowDown':
                        this.keys.lookDown = true; break;
                    case 'KeyA': case 'ArrowLeft':
                        this.keys.lookLeft = true; break;
                    case 'KeyD': case 'ArrowRight':
                        this.keys.lookRight = true; break;

                    // Space = Thrust forward
                    case 'Space':
                        this.keys.thrust = true;
                        e.preventDefault();
                        break;

                    // Shift = Boost
                    case 'ShiftLeft': case 'ShiftRight':
                        this.keys.boost = true; break;

                    // Thruster gear controls (1-4 keys)
                    case 'Digit1': this.setGear(1); break;
                    case 'Digit2': this.setGear(2); break;
                    case 'Digit3': this.setGear(3); break;
                    case 'Digit4': this.setGear(4); break;
                    case 'Digit0': case 'Backquote':
                        this.setGear(0); break;

                    // Quick stop
                    case 'KeyX':
                        this.emergencyStop();
                        break;

                    // Tab = Toggle mouse look
                    case 'Tab':
                        e.preventDefault();
                        this.toggleMouseLook();
                        break;
                }
            },

            onKeyUp(e) {
                switch(e.code) {
                    case 'KeyW': case 'ArrowUp':
                        this.keys.lookUp = false; break;
                    case 'KeyS': case 'ArrowDown':
                        this.keys.lookDown = false; break;
                    case 'KeyA': case 'ArrowLeft':
                        this.keys.lookLeft = false; break;
                    case 'KeyD': case 'ArrowRight':
                        this.keys.lookRight = false; break;
                    case 'Space':
                        this.keys.thrust = false; break;
                    case 'ShiftLeft': case 'ShiftRight':
                        this.keys.boost = false; break;
                }
            },

            // Scroll wheel to adjust cruise speed (throttled for trackpads)
            scrollThrottle: 0,
            scrollCooldown: 150, // ms between gear changes

            onWheel(e) {
                if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;

                e.preventDefault();

                // Throttle scroll for Magic Trackpad / high-resolution scrolling
                const now = Date.now();
                if (now - this.scrollThrottle < this.scrollCooldown) return;
                this.scrollThrottle = now;

                if (e.deltaY < 0) {
                    // Scroll up = increase gear
                    this.setGear(Math.min(4, this.thrusterGear + 1));
                } else if (e.deltaY > 0) {
                    // Scroll down = decrease gear
                    this.setGear(Math.max(0, this.thrusterGear - 1));
                }
            },

            setGear(gear) {
                this.thrusterGear = gear;
                this.updateUI();

                if (gear === 0) {
                    showToast('THRUSTERS DISENGAGED', 'info');
                } else {
                    showToast(`${this.gearNames[gear]} MODE ENGAGED`, gear >= 3 ? 'warning' : 'info');
                }
            },

            cycleGear() {
                this.setGear((this.thrusterGear + 1) % 5);
            },

            emergencyStop() {
                this.speed = 0;
                this.thrusterGear = 0;
                this.autopilot.active = false;
                this.updateUI();
                showToast('FULL STOP', 'warning');
            },

            // Navigate to a specific project
            navigateTo(projectGroup, callback = null) {
                if (!projectGroup) return;

                this.autopilot.active = true;
                this.autopilot.targetProject = projectGroup;
                this.autopilot.arrivalCallback = callback;

                // Target position: in front of the project
                this.autopilot.targetPosition = {
                    x: projectGroup.position.x,
                    y: projectGroup.position.y + 1,
                    z: projectGroup.position.z + 8
                };

                showToast(`NAVIGATING TO ${projectGroup.userData.name}`, 'info');
            },

            // Get direction vector from current pitch/yaw
            getForwardVector() {
                return {
                    x: -Math.sin(this.yaw) * Math.cos(this.pitch),
                    y: Math.sin(this.pitch),
                    z: -Math.cos(this.yaw) * Math.cos(this.pitch)
                };
            },

            // Main update loop (called every frame)
            update(camera, deltaTime = 1) {
                if (this.autopilot.active) {
                    this.updateAutopilot(camera);
                } else {
                    this.updateManual(camera);
                }

                // Apply camera rotation
                camera.rotation.order = 'YXZ';
                camera.rotation.x = this.pitch;
                camera.rotation.y = this.yaw;

                // Clamp Y position (don't go below grid)
                camera.position.y = Math.max(0.5, camera.position.y);
            },

            updateManual(camera) {
                // Update look direction (WASD)
                if (this.keys.lookUp) this.pitch += this.lookSpeed;
                if (this.keys.lookDown) this.pitch -= this.lookSpeed;
                if (this.keys.lookLeft) this.yaw += this.lookSpeed;
                if (this.keys.lookRight) this.yaw -= this.lookSpeed;

                // Clamp pitch to prevent flipping
                this.pitch = Math.max(-this.pitchLimit, Math.min(this.pitchLimit, this.pitch));

                // Calculate thrust
                const thrusterSpeed = this.gearSpeeds[this.thrusterGear];
                const boostMult = this.keys.boost ? this.boostMultiplier : 1;

                // Apply thrust (spacebar or thruster gear)
                if (this.keys.thrust) {
                    this.speed += this.thrustPower * boostMult;
                }

                // Auto-cruise from thruster gear
                if (thrusterSpeed > 0) {
                    // Gradually accelerate to cruise speed
                    const targetSpeed = thrusterSpeed * boostMult;
                    this.speed += (targetSpeed - this.speed) * 2;
                }

                // Apply deceleration
                this.speed *= this.deceleration;

                // Clamp speed
                this.speed = this.speed * boostMult;

                // Move in facing direction
                if (Math.abs(this.speed) > 0.001) {
                    const forward = this.getForwardVector();
                    camera.position.x += forward.x * this.speed;
                    camera.position.y += forward.y * this.speed;
                    camera.position.z += forward.z * this.speed;
                }
            },

            updateAutopilot(camera) {
                const target = this.autopilot.targetPosition;
                if (!target) {
                    this.autopilot.active = false;
                    return;
                }

                // Calculate direction to target
                const dx = target.x - camera.position.x;
                const dy = target.y - camera.position.y;
                const dz = target.z - camera.position.z;
                const distance = Math.sqrt(dx*dx + dy*dy + dz*dz);

                // Arrived?
                if (distance < 2) {
                    this.autopilot.active = false;
                    this.speed = 0;

                    // Update pitch/yaw to face the project
                    this.yaw = Math.atan2(-dx, -dz);
                    this.pitch = Math.asin(dy / distance) * 0.3; // Gentle look angle

                    if (this.autopilot.arrivalCallback) {
                        this.autopilot.arrivalCallback();
                    }

                    showToast('DESTINATION REACHED', 'success');
                    return;
                }

                // Smoothly rotate toward target
                const targetYaw = Math.atan2(-dx, -dz);
                const targetPitch = Math.asin(dy / distance);

                this.yaw += (targetYaw - this.yaw) * 0.05;
                this.pitch += (targetPitch - this.pitch) * 0.05;

                // Move toward target
                const approachSpeed = Math.min(0.4, distance * 0.05);
                camera.position.x += (dx / distance) * approachSpeed;
                camera.position.y += (dy / distance) * approachSpeed;
                camera.position.z += (dz / distance) * approachSpeed;
            },

            updateUI() {
                const btn = document.getElementById('drive-btn');
                const status = document.getElementById('system-status');

                if (this.thrusterGear === 0) {
                    btn.innerText = 'Engage Thrusters';
                    status.innerText = 'ONLINE // STATIONARY';
                    btn.classList.remove('bg-cyan-500/20', 'text-white');
                } else {
                    btn.innerText = `GEAR ${this.thrusterGear} [${this.gearNames[this.thrusterGear]}]`;
                    status.innerText = `ONLINE // ${this.gearNames[this.thrusterGear]}`;
                    btn.classList.add('bg-cyan-500/20', 'text-white');
                }
            },

            // Get current speed for display
            getSpeed() {
                return Math.abs(this.speed);
            }
        };

        // ============================================================
        // WEATHER SYSTEM CONTROLLER
        // ============================================================

        // Create a soft radial texture to fake volumetric sprites (clouds/fog)
        function createSoftTexture(hexColor, innerAlpha = 0.55, outerAlpha = 0.0, size = 128) {
            const c = document.createElement('canvas');
            c.width = c.height = size;
            const ctx = c.getContext('2d');
            const color = new THREE.Color(hexColor);
            const gradient = ctx.createRadialGradient(size / 2, size / 2, size * 0.05, size / 2, size / 2, size * 0.5);
            const rgba = (a) => `rgba(${Math.round(color.r * 255)}, ${Math.round(color.g * 255)}, ${Math.round(color.b * 255)}, ${a})`;
            gradient.addColorStop(0, rgba(innerAlpha));
            gradient.addColorStop(1, rgba(outerAlpha));
            ctx.fillStyle = gradient;
            ctx.fillRect(0, 0, size, size);
            const tex = new THREE.CanvasTexture(c);
            tex.wrapS = tex.wrapT = THREE.ClampToEdgeWrapping;
            tex.minFilter = THREE.LinearMipMapLinearFilter;
            tex.magFilter = THREE.LinearFilter;
            return tex;
        }

        class WeatherSystem {
            constructor() {
                this.time = 0; // 0-24 hours
                this.speed = 1; // time multiplier
                this.activeSystem = null;
                this.enabled = false;
                this.clock = new THREE.Clock();

                // Particle systems
                this.groundFog = null;
                this.cloudFormations = [];
                this.skyClouds = null;
                this.rain = null;

                // Sprite textures
                this.cloudTexture = createSoftTexture(0xf6c996, 0.55, 0.0, 192);
                this.hazeTexture = createSoftTexture(0xf2b365, 0.4, 0.0, 192);

                // Lightning bolts
                this.activeBolts = [];

                // Atmospheric tuning
                this.windVector = new THREE.Vector3();
                this.hazeShell = null;
                this.currentVenusParams = {
                    wind: 0,
                    turbulence: 0.2,
                    hazeOpacity: 0.2,
                    cloudTint: 0xffc07a,
                    skyTint: 0xf7b46a,
                    fogTint: 0x8c522d,
                    rainTint: 0xe6ff7f,
                    rainIntensity: 0,
                    boltChance: 0.005,
                    boltColor: 0xfff7d5
                };
            }

            update() {
                if (!this.enabled || !this.activeSystem) return;

                const deltaTime = this.clock.getDelta();
                this.time += deltaTime * this.speed / 60;
                if (this.time >= 24) this.time = 0;

                const phase = Math.floor(this.time / 6); // 0=PEACEFUL, 1=LIVELY, 2=DIM, 3=EXTREME
                const phaseProgress = (this.time % 6) / 6; // 0-1 within current phase

                // Update active weather system
                if (this.activeSystem === 'venusian') {
                    this.updateVenusian(phase, phaseProgress, deltaTime);
                }
            }

            updateVenusian(phase, progress, deltaTime) {
                // Phase definitions tuned for Venusian brutality
                const phases = [
                    { fogColor: 0x2c160d, fogDensity: 0.0075, lightIntensity: 0.45, rainIntensity: 0.05, wind: 2.6, turbulence: 0.18, hazeOpacity: 0.18, cloudTint: 0xe7c08c, skyTint: 0xf8cfa1, fogTint: 0x8c522d, rainTint: 0xe6ff7f, boltChance: 0.004, boltColor: 0xfff7d5 }, // PEACEFUL
                    { fogColor: 0x5a2b0e, fogDensity: 0.0095, lightIntensity: 0.64, rainIntensity: 0.25, wind: 3.6, turbulence: 0.28, hazeOpacity: 0.22, cloudTint: 0xf4be7b, skyTint: 0xfcc48a, fogTint: 0xa65a2a, rainTint: 0xddff63, boltChance: 0.012, boltColor: 0xfff0c5 }, // LIVELY
                    { fogColor: 0x4b1c08, fogDensity: 0.0135, lightIntensity: 0.38, rainIntensity: 0.58, wind: 4.8, turbulence: 0.40, hazeOpacity: 0.27, cloudTint: 0xefaa63, skyTint: 0xf29d5c, fogTint: 0x7b3d1c, rainTint: 0xc9ff4a, boltChance: 0.020, boltColor: 0xfde9a5 }, // DIM
                    { fogColor: 0x7a2b05, fogDensity: 0.0185, lightIntensity: 0.55, rainIntensity: 0.95, wind: 6.4, turbulence: 0.60, hazeOpacity: 0.33, cloudTint: 0xffb347, skyTint: 0xff8c42, fogTint: 0xa64b1c, rainTint: 0xb4f52d, boltChance: 0.035, boltColor: 0xfff6d6 }  // EXTREME
                ];

                const current = phases[phase];
                const next = phases[(phase + 1) % 4];

                // Interpolate between phases
                const fogColor = this.lerpColor(current.fogColor, next.fogColor, progress);
                const fogDensity = THREE.MathUtils.lerp(current.fogDensity, next.fogDensity, progress);
                const lightIntensity = THREE.MathUtils.lerp(current.lightIntensity, next.lightIntensity, progress);
                const rainIntensity = THREE.MathUtils.lerp(current.rainIntensity, next.rainIntensity, progress);
                const wind = THREE.MathUtils.lerp(current.wind, next.wind, progress);
                const turbulence = THREE.MathUtils.lerp(current.turbulence, next.turbulence, progress);
                const hazeOpacity = THREE.MathUtils.lerp(current.hazeOpacity, next.hazeOpacity, progress);
                const cloudTint = this.lerpColor(current.cloudTint, next.cloudTint, progress);
                const skyTint = this.lerpColor(current.skyTint, next.skyTint, progress);
                const fogTint = this.lerpColor(current.fogTint, next.fogTint, progress);
                const rainTint = this.lerpColor(current.rainTint, next.rainTint, progress);
                const boltChance = THREE.MathUtils.lerp(current.boltChance, next.boltChance, progress);
                const boltColor = this.lerpColor(current.boltColor, next.boltColor, progress);

                this.currentVenusParams = {
                    wind,
                    turbulence,
                    hazeOpacity,
                    cloudTint,
                    skyTint,
                    fogTint,
                    rainTint,
                    rainIntensity,
                    boltChance,
                    boltColor
                };

                this.windVector.set(wind, 0, -wind * 0.35);

                // Apply to scene
                scene.fog.color.setHex(fogColor);
                scene.fog.density = fogDensity;
                if (ambientLight) {
                    ambientLight.intensity = lightIntensity;
                }

                this.updateHazeShell(fogTint, hazeOpacity, turbulence);

                // Update particle systems
                this.updateGroundFog(deltaTime);
                this.updateCloudFormations(deltaTime);
                this.updateSkyClouds(deltaTime);
                this.updateRain(deltaTime, rainIntensity);

                // Lightning frequency scales with phase intensity
                const boltProbability = boltChance * (0.6 + rainIntensity * 0.9 + turbulence * 0.6);
                if (Math.random() < boltProbability * deltaTime * 60) {
                    this.spawnLightning({
                        color: boltColor,
                        glowColor: skyTint,
                        width: 2 + rainIntensity * 2,
                        jaggedness: 1 + turbulence * 0.6,
                        lifetime: 420
                    });
                }

                // Clean up old bolts
                this.activeBolts = this.activeBolts.filter(bolt => {
                    const age = Date.now() - bolt.spawnTime;
                    const lifetime = bolt.lifetime || 300;
                    const fade = Math.max(0, 1 - age / lifetime);

                    if (bolt.mesh.material) {
                        bolt.mesh.material.opacity = 0.4 + 0.6 * fade;
                    }
                    if (bolt.glow.material) {
                        bolt.glow.material.opacity = 0.15 + 0.25 * fade;
                    }

                    if (age > lifetime) {
                        scene.remove(bolt.mesh);
                        scene.remove(bolt.glow);
                        return false;
                    }
                    return true;
                });
            }

            updateGroundFog(deltaTime) {
                if (!this.groundFog) return;

                const params = this.currentVenusParams || {};
                const dummy = new THREE.Object3D();

                if (this.groundFog.material) {
                    this.groundFog.material.color.setHex(params.fogTint || 0xaa6633);
                    this.groundFog.material.opacity = THREE.MathUtils.clamp(0.2 + (params.hazeOpacity || 0) * 0.6, 0.18, 0.7);
                    this.groundFog.material.needsUpdate = true;
                }

                for (let i = 0; i < 220; i++) {
                    this.groundFog.getMatrixAt(i, dummy.matrix);
                    dummy.matrix.decompose(dummy.position, dummy.quaternion, dummy.scale);

                    // Waft motion with lateral wind push
                    dummy.position.x += Math.sin(Date.now() * 0.00035 + i) * 0.06;
                    dummy.position.z += Math.cos(Date.now() * 0.00025 + i) * 0.05;
                    dummy.position.x += this.windVector.x * deltaTime * 6;
                    dummy.position.z += this.windVector.z * deltaTime * 3.8;
                    dummy.position.y = 0.4 + Math.sin(Date.now() * 0.0008 + i) * 0.35 * (params.turbulence || 0.2);

                    // Keep fog near ground, wrap around camera
                    const wrapRange = 140;
                    if (camera && Math.abs(dummy.position.x - camera.position.x) > wrapRange) {
                        dummy.position.x = camera.position.x + (Math.random() - 0.5) * wrapRange;
                    }
                    if (camera && Math.abs(dummy.position.z - camera.position.z) > wrapRange) {
                        dummy.position.z = camera.position.z + (Math.random() - 0.5) * wrapRange;
                    }

                    dummy.updateMatrix();
                    this.groundFog.setMatrixAt(i, dummy.matrix);
                }

                this.groundFog.instanceMatrix.needsUpdate = true;
            }

            updateCloudFormations(deltaTime) {
                const params = this.currentVenusParams || {};
                const driftX = this.windVector.x * deltaTime * 10;
                const driftZ = this.windVector.z * deltaTime * 6;
                const swirl = (params.turbulence || 0.2) * 0.35;
                const baseOpacity = THREE.MathUtils.clamp(0.28 + (params.hazeOpacity || 0) * 0.45, 0.18, 0.75);

                this.cloudFormations.forEach(cloud => {
                    // Drift and churn
                    cloud.position.x += driftX + Math.sin(Date.now() * 0.00022 + cloud.position.z * 0.01) * swirl;
                    cloud.position.z += driftZ + Math.cos(Date.now() * 0.00027 + cloud.position.x * 0.01) * swirl;
                    cloud.position.y += Math.sin(Date.now() * 0.00035 + cloud.position.x * 0.04) * 0.03 * (1 + swirl * 3);

                    cloud.rotation.y = 0;
                    cloud.rotation.x = 0;
                    cloud.children.forEach(mesh => {
                        if (mesh.material) {
                            mesh.material.color.setHex(params.cloudTint || 0xddaa77);
                            mesh.material.opacity = baseOpacity;
                        }
                        mesh.lookAt(camera.position);
                    });

                    // Wrap around view volume
                    const wrapRange = 220;
                    if (camera && cloud.position.x - camera.position.x > wrapRange) {
                        cloud.position.x = camera.position.x - wrapRange;
                    }
                    if (camera && cloud.position.x - camera.position.x < -wrapRange) {
                        cloud.position.x = camera.position.x + wrapRange;
                    }
                    if (camera && cloud.position.z - camera.position.z > wrapRange) {
                        cloud.position.z = camera.position.z - wrapRange;
                    }
                    if (camera && cloud.position.z - camera.position.z < -wrapRange) {
                        cloud.position.z = camera.position.z + wrapRange;
                    }
                });
            }

            updateSkyClouds(deltaTime) {
                if (!this.skyClouds) return;

                const params = this.currentVenusParams || {};
                if (this.skyClouds.material) {
                    this.skyClouds.material.color.setHex(params.skyTint || 0xffbb66);
                    this.skyClouds.material.opacity = THREE.MathUtils.clamp(0.08 + (params.hazeOpacity || 0) * 0.5, 0.08, 0.75);
                }

                const dummy = new THREE.Object3D();
                const driftX = this.windVector.x * deltaTime * 10;
                const driftZ = this.windVector.z * deltaTime * 6.5;
                const wobble = (params.turbulence || 0.2) * 0.32;

                for (let i = 0; i < 50; i++) {
                    this.skyClouds.getMatrixAt(i, dummy.matrix);
                    dummy.matrix.decompose(dummy.position, dummy.quaternion, dummy.scale);

                    // Drift and slight roll to keep the layer alive
                    dummy.position.x += driftX + Math.sin(Date.now() * 0.00025 + i) * wobble;
                    dummy.position.z += driftZ + Math.cos(Date.now() * 0.00018 + i) * wobble;
                    dummy.lookAt(camera.position);

                    // Wrap
                    if (camera && dummy.position.x - camera.position.x > 320) {
                        dummy.position.x = camera.position.x - 320;
                    }
                    if (camera && dummy.position.x - camera.position.x < -320) {
                        dummy.position.x = camera.position.x + 320;
                    }

                    dummy.updateMatrix();
                    this.skyClouds.setMatrixAt(i, dummy.matrix);
                }

                this.skyClouds.instanceMatrix.needsUpdate = true;
            }

            updateRain(deltaTime, intensity) {
                if (!this.rain) return;

                const params = this.currentVenusParams || {};
                if (this.rain.material) {
                    this.rain.material.color.setHex(params.rainTint || 0xaaaaaa);
                    this.rain.material.opacity = THREE.MathUtils.clamp(0.15 + intensity * 0.5, 0.1, 0.7);
                }

                this.rain.visible = intensity > 0.05;
                if (!this.rain.visible) return;

                const dummy = new THREE.Object3D();
                const fallSpeed = (4 + (params.wind || 1) * 0.5) * intensity;
                const driftX = this.windVector.x * deltaTime * 28;
                const driftZ = this.windVector.z * deltaTime * 18;

                for (let i = 0; i < 1000; i++) {
                    this.rain.getMatrixAt(i, dummy.matrix);
                    dummy.matrix.decompose(dummy.position, dummy.quaternion, dummy.scale);

                    // Fall with sideways blast
                    dummy.position.y -= fallSpeed * deltaTime * 60;
                    dummy.position.x += driftX;
                    dummy.position.z += driftZ;

                    // Slant streaks into the wind vector
                    dummy.lookAt(
                        dummy.position.x + this.windVector.x,
                        dummy.position.y - 1,
                        dummy.position.z + this.windVector.z
                    );

                    // Reset if below ground
                    if (dummy.position.y < 0) {
                        dummy.position.y = 50;
                        if (camera) {
                            dummy.position.x = camera.position.x + (Math.random() - 0.5) * 100;
                            dummy.position.z = camera.position.z + (Math.random() - 0.5) * 100;
                        }
                    }

                    dummy.updateMatrix();
                    this.rain.setMatrixAt(i, dummy.matrix);
                }

                this.rain.instanceMatrix.needsUpdate = true;
            }

            updateHazeShell(color, opacity, turbulence) {
                if (!this.hazeShell) return;

                this.hazeShell.position.copy(camera.position);
                this.hazeShell.material.color.setHex(color || 0xf2b365);
                const animatedOpacity = opacity + Math.sin(Date.now() * 0.0007) * 0.02;
                this.hazeShell.material.opacity = THREE.MathUtils.clamp(animatedOpacity, 0.08, 0.45);

                const pulse = 1 + (turbulence || 0.2) * 0.15 + Math.sin(Date.now() * 0.0005) * 0.03;
                this.hazeShell.scale.setScalar(pulse);
            }

            lerpColor(color1, color2, t) {
                const c1 = new THREE.Color(color1);
                const c2 = new THREE.Color(color2);
                return c1.lerp(c2, t).getHex();
            }

            spawnLightning(options = {}) {
                const settings = {
                    color: options.color || 0xffffff,
                    glowColor: options.glowColor || 0xffffaa,
                    width: options.width || 3,
                    jaggedness: options.jaggedness || 1.2,
                    lifetime: options.lifetime || 360
                };

                const points = [];
                let x = (Math.random() * 300 - 150) + (this.windVector.x * 8);
                let z = camera.position.z - 100 - Math.random() * 100;
                let y = 42 + Math.random() * 20;
                points.push(new THREE.Vector3(x, y, z));

                // Create jagged path
                for (let i = 0; i < 8; i++) {
                    y -= 4 + Math.random() * 5 * settings.jaggedness;
                    x += (Math.random() - 0.5) * 12 * settings.jaggedness;
                    z += (Math.random() - 0.5) * 9 * settings.jaggedness;
                    points.push(new THREE.Vector3(x, y, z));
                }

                // Main bolt (thick)
                const geometry = new THREE.BufferGeometry().setFromPoints(points);
                const material = new THREE.LineBasicMaterial({
                    color: settings.color,
                    linewidth: settings.width,
                    transparent: true,
                    opacity: 0.9
                });
                const bolt = new THREE.Line(geometry, material);
                scene.add(bolt);

                // Glow (even thicker, dimmer)
                const glowMaterial = new THREE.LineBasicMaterial({
                    color: settings.glowColor,
                    linewidth: settings.width * 2.6,
                    transparent: true,
                    opacity: 0.28
                });
                const glow = new THREE.Line(geometry.clone(), glowMaterial);
                scene.add(glow);

                this.activeBolts.push({
                    mesh: bolt,
                    glow: glow,
                    spawnTime: Date.now(),
                    lifetime: settings.lifetime
                });
            }

            createGroundFog() {
                const geometry = new THREE.PlaneGeometry(10, 10);
                const material = new THREE.MeshBasicMaterial({
                    color: 0xffffff,
                    map: this.hazeTexture,
                    transparent: true,
                    opacity: 0.4,
                    side: THREE.DoubleSide,
                    depthWrite: false,
                    blending: THREE.AdditiveBlending
                });

                this.groundFog = new THREE.InstancedMesh(geometry, material, 220);
                const dummy = new THREE.Object3D();

                for (let i = 0; i < 220; i++) {
                    dummy.position.set(
                        (Math.random() - 0.5) * 200,
                        0.5 + Math.random() * 2,
                        (Math.random() - 0.5) * 200
                    );
                    dummy.rotation.x = -Math.PI / 2;
                    dummy.scale.setScalar(2 + Math.random() * 2.2);
                    dummy.updateMatrix();
                    this.groundFog.setMatrixAt(i, dummy.matrix);
                }

                scene.add(this.groundFog);
            }

            createCloudFormations() {
                // Create 12 mid-level cloud sprites grouped into loose clusters
                for (let i = 0; i < 12; i++) {
                    const group = new THREE.Group();

                    // Each cloud is multiple billboard sprites using a soft texture
                    for (let j = 0; j < 6; j++) {
                        const geometry = new THREE.PlaneGeometry(12, 8);
                        const material = new THREE.MeshBasicMaterial({
                            map: this.cloudTexture,
                            color: 0xffffff,
                            transparent: true,
                            opacity: 0.4,
                            fog: false,
                            depthWrite: false,
                            blending: THREE.AdditiveBlending
                        });
                        const sprite = new THREE.Mesh(geometry, material);
                        sprite.position.set(
                            (Math.random() - 0.5) * 25,
                            (Math.random() - 0.5) * 10,
                            (Math.random() - 0.5) * 20
                        );
                        sprite.scale.multiplyScalar(1.2 + Math.random() * 1.5);
                        sprite.scale.x *= 1.8;
                        sprite.scale.y *= 1.25;
                        sprite.lookAt(camera.position);
                        group.add(sprite);
                    }

                    group.position.set(
                        (Math.random() - 0.5) * 400,
                        20 + Math.random() * 15,
                        camera.position.z - 100 - Math.random() * 100
                    );

                    this.cloudFormations.push(group);
                    scene.add(group);
                }
            }

            createSkyClouds() {
                const geometry = new THREE.PlaneGeometry(30, 18);
                const material = new THREE.MeshBasicMaterial({
                    color: 0xffffff,
                    map: this.cloudTexture,
                    transparent: true,
                    opacity: 0.4,
                    side: THREE.DoubleSide,
                    fog: false,
                    depthWrite: false,
                    blending: THREE.AdditiveBlending
                });

                this.skyClouds = new THREE.InstancedMesh(geometry, material, 50);
                const dummy = new THREE.Object3D();

                for (let i = 0; i < 50; i++) {
                    dummy.position.set(
                        (Math.random() - 0.5) * 600,
                        55 + Math.random() * 35,
                        camera.position.z + (Math.random() - 0.5) * 420
                    );
                    dummy.scale.set(2.8 + Math.random() * 2.2, 1.6 + Math.random() * 1.2, 1);
                    dummy.lookAt(camera.position);
                    dummy.updateMatrix();
                    this.skyClouds.setMatrixAt(i, dummy.matrix);
                }

                scene.add(this.skyClouds);
            }

            createRain() {
                const geometry = new THREE.PlaneGeometry(0.22, 3);
                const material = new THREE.MeshBasicMaterial({
                    color: 0xcde96e,
                    transparent: true,
                    opacity: 0.45,
                    side: THREE.DoubleSide,
                    depthWrite: false,
                    blending: THREE.AdditiveBlending
                });

                this.rain = new THREE.InstancedMesh(geometry, material, 1000);
                const dummy = new THREE.Object3D();

                for (let i = 0; i < 1000; i++) {
                    dummy.position.set(
                        (Math.random() - 0.5) * 200,
                        Math.random() * 50,
                        (Math.random() - 0.5) * 200
                    );
                    dummy.updateMatrix();
                    this.rain.setMatrixAt(i, dummy.matrix);
                }

                this.rain.visible = false;
                scene.add(this.rain);
            }

            createHazeShell() {
                const geometry = new THREE.SphereGeometry(260, 32, 32);
                const material = new THREE.MeshBasicMaterial({
                    color: 0xf2b365,
                    map: this.hazeTexture,
                    side: THREE.BackSide,
                    transparent: true,
                    opacity: 0.22,
                    depthWrite: false,
                    blending: THREE.AdditiveBlending
                });

                this.hazeShell = new THREE.Mesh(geometry, material);
                this.hazeShell.frustumCulled = false;
                scene.add(this.hazeShell);
            }

            enable() {
                this.enabled = true;
                this.activeSystem = 'venusian';
                this.time = 0;

                // Create all particle systems
                this.createHazeShell();
                this.createGroundFog();
                this.createCloudFormations();
                this.createSkyClouds();
                this.createRain();

                showToast('WEATHER SYSTEM ENABLED', 'info');
            }

            disable() {
                this.enabled = false;
                this.activeSystem = null;

                // Clean up particle systems
                if (this.groundFog) {
                    scene.remove(this.groundFog);
                    this.groundFog.geometry.dispose();
                    this.groundFog.material.dispose();
                    this.groundFog = null;
                }

                this.cloudFormations.forEach(cloud => scene.remove(cloud));
                this.cloudFormations = [];

                if (this.skyClouds) {
                    scene.remove(this.skyClouds);
                    this.skyClouds.geometry.dispose();
                    this.skyClouds.material.dispose();
                    this.skyClouds = null;
                }

                if (this.rain) {
                    scene.remove(this.rain);
                    this.rain.geometry.dispose();
                    this.rain.material.dispose();
                    this.rain = null;
                }

                if (this.hazeShell) {
                    scene.remove(this.hazeShell);
                    this.hazeShell.geometry.dispose();
                    this.hazeShell.material.dispose();
                    this.hazeShell = null;
                }

                this.activeBolts.forEach(bolt => {
                    scene.remove(bolt.mesh);
                    scene.remove(bolt.glow);
                });
                this.activeBolts = [];

                // Reset scene to theme colors
                if (currentTheme) {
                    updateSceneTheme(currentTheme);
                }

                showToast('WEATHER SYSTEM DISABLED', 'info');
            }
        }

        let weatherSystem = new WeatherSystem();

        // Raycaster for interaction
        const raycaster = new THREE.Raycaster();
        const mouse = new THREE.Vector2();

        // ============================================================
        // PHASE 0.2: MEMORY MANAGEMENT & CLEANUP
        // ============================================================

        // Label texture cache to avoid creating new canvases per project
        const labelTextureCache = new Map();

        // Dispose a Three.js object and its resources
        function disposeObject(obj) {
            if (!obj) return;

            // Dispose geometry
            if (obj.geometry) {
                obj.geometry.dispose();
            }

            // Dispose material(s)
            if (obj.material) {
                if (Array.isArray(obj.material)) {
                    obj.material.forEach(mat => disposeMaterial(mat));
                } else {
                    disposeMaterial(obj.material);
                }
            }

            // Recursively dispose children
            if (obj.children) {
                while (obj.children.length > 0) {
                    disposeObject(obj.children[0]);
                    obj.remove(obj.children[0]);
                }
            }
        }

        // Dispose material and its textures
        function disposeMaterial(material) {
            if (!material) return;

            // Dispose textures
            const textureProps = ['map', 'lightMap', 'bumpMap', 'normalMap', 'specularMap', 'envMap', 'alphaMap', 'aoMap', 'emissiveMap'];
            textureProps.forEach(prop => {
                if (material[prop]) {
                    material[prop].dispose();
                }
            });

            material.dispose();
        }

        // Delete a project and clean up all resources
        function deleteProject(projectGroup) {
            if (!projectGroup) return false;

            const projectName = projectGroup.userData?.name;
            const index = projects.indexOf(projectGroup);

            if (index === -1) {
                ErrorLogger.log('DELETE', 'Project not found in array', { name: projectName });
                return false;
            }

            // Remove from scene
            scene.remove(projectGroup);

            // Dispose all resources
            disposeObject(projectGroup);

            // Remove label from cache if exists
            if (projectName && labelTextureCache.has(projectName)) {
                const cachedTex = labelTextureCache.get(projectName);
                cachedTex.dispose();
                labelTextureCache.delete(projectName);
            }

            // Remove from state (syncs with projects array)
            AppState.removeProject(projectGroup);

            showToast(`Project "${projectName}" deleted`, 'info');
            return true;
        }

        // ============================================================
        // PHASE 1.1: LOCALSTORAGE PERSISTENCE WITH VERSIONING
        // ============================================================

        const Storage = {
            STORAGE_KEY: 'celestia_projects',
            SCHEMA_VERSION: 1,

            // Save projects to localStorage
            save() {
                try {
                    const projectData = projects.map(group => ({
                        name: group.userData.name,
                        category: group.userData.category,
                        color: group.userData.baseColor,
                        stats: group.userData.stats,
                        shards: group.userData.shardsCount,
                        pos: {
                            x: group.position.x,
                            y: group.userData.stats?.length * 0.2 || 2, // Base Y before float animation
                            z: group.position.z
                        },
                        date: group.userData.date,
                        createdAt: group.userData.createdAt || Date.now(),
                        updatedAt: Date.now()
                    }));

                    const payload = {
                        version: this.SCHEMA_VERSION,
                        savedAt: Date.now(),
                        projects: projectData
                    };

                    localStorage.setItem(this.STORAGE_KEY, JSON.stringify(payload));
                    return true;
                } catch (e) {
                    ErrorLogger.log('STORAGE', 'Failed to save projects', { error: e.message });
                    return false;
                }
            },

            // Load projects from localStorage
            load() {
                try {
                    const raw = localStorage.getItem(this.STORAGE_KEY);
                    if (!raw) return null;

                    const data = JSON.parse(raw);

                    // Handle schema migrations
                    if (data.version !== this.SCHEMA_VERSION) {
                        return this.migrate(data);
                    }

                    return data.projects;
                } catch (e) {
                    ErrorLogger.log('STORAGE', 'Failed to load projects', { error: e.message });
                    return null;
                }
            },

            // Migrate old schema to new
            migrate(data) {
                // Version 0 (no version) -> Version 1
                if (!data.version) {
                    // Old format was just an array
                    if (Array.isArray(data)) {
                        return data;
                    }
                }

                // Future migrations go here
                // if (data.version === 1) { ... migrate to v2 }

                return data.projects || [];
            },

            // Clear all saved data
            clear() {
                localStorage.removeItem(this.STORAGE_KEY);
                showToast('Storage cleared', 'info');
            },

            // Export projects as JSON file
            exportToFile() {
                const data = localStorage.getItem(this.STORAGE_KEY);
                if (!data) {
                    showToast('No projects to export', 'warning');
                    return;
                }

                const blob = new Blob([data], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `celestia-projects-${new Date().toISOString().split('T')[0]}.json`;
                a.click();
                URL.revokeObjectURL(url);
                showToast('Projects exported', 'success');
            },

            // Import projects from JSON file
            importFromFile(file) {
                return new Promise((resolve, reject) => {
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        try {
                            const data = JSON.parse(e.target.result);
                            localStorage.setItem(this.STORAGE_KEY, JSON.stringify(data));
                            resolve(data);
                            showToast('Projects imported - refresh to see changes', 'success');
                        } catch (err) {
                            ErrorLogger.log('IMPORT', 'Invalid file format', { error: err.message });
                            reject(err);
                        }
                    };
                    reader.onerror = reject;
                    reader.readAsText(file);
                });
            }
        };

        // Auto-save when projects change
        AppState.subscribe('projects', () => {
            Storage.save();
        });

        // Get or create cached label texture
        function getLabelTexture(name) {
            if (labelTextureCache.has(name)) {
                return labelTextureCache.get(name);
            }

            const canvas = document.createElement('canvas');
            const ctx = canvas.getContext('2d');
            canvas.width = 512;
            canvas.height = 128;
            ctx.font = 'Bold 40px Orbitron';
            ctx.fillStyle = 'rgba(0,255,255,0.8)';
            ctx.textAlign = 'center';
            ctx.shadowColor = 'cyan';
            ctx.shadowBlur = 10;
            ctx.fillText(name, 256, 80);

            const texture = new THREE.CanvasTexture(canvas);
            labelTextureCache.set(name, texture);
            return texture;
        }

        // ============================================================
        // PHASE 1.2: EXTENDED PROJECT MODEL
        // ============================================================

        // Available categories
