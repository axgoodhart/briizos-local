    let calDailyPinned = false;
    const showCalDaily = () => {
      if (!calDaily) return;
      calDaily.classList.add('show');
      calDaily.setAttribute('aria-hidden', 'false');
    };
    const hideCalDaily = () => {
      if (!calDaily || calDailyPinned) return;
      if (timeStack && timeStack.matches(':hover')) return;
      if (calDaily.matches(':hover')) return;
      calDaily.classList.remove('show');
      calDaily.setAttribute('aria-hidden', 'true');
    };
    const scheduleHide = () => setTimeout(hideCalDaily, 120);
    if (calDaily && timeStack) {
      if (!timeStack.hasAttribute('tabindex')) timeStack.setAttribute('tabindex', '0');
      timeStack.addEventListener('mouseenter', showCalDaily);
      timeStack.addEventListener('mouseleave', scheduleHide);
      timeStack.addEventListener('focusin', showCalDaily);
      timeStack.addEventListener('focusout', scheduleHide);
      timeStack.addEventListener('click', () => {
        calDailyPinned = !calDailyPinned;
        if (calDailyPinned) {
          showCalDaily();
        } else {
          scheduleHide();
        }
      });
      calDaily.addEventListener('mouseenter', showCalDaily);
      calDaily.addEventListener('mouseleave', scheduleHide);
      hideCalDaily();
    }
