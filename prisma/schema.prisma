model checkpoint_writes {
  thread_id     String
  checkpoint_ns String      @default("")
  checkpoint_id String
  task_id       String
  idx           Int
  channel       String
  value_json    String
  created_at    BigInt
  checkpoints   checkpoints @relation(fields: [thread_id, checkpoint_ns, checkpoint_id], references: [thread_id, checkpoint_ns, checkpoint_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([thread_id, checkpoint_ns, checkpoint_id, task_id, idx])
}

model checkpoints {
  thread_id            String
  checkpoint_ns        String              @default("")
  checkpoint_id        String
  parent_checkpoint_id String?
